ORGANIZATION_BLOCK MAIN:OB1
TITLE=// ============================================================
// // 文件: OB1_MAIN.stl
// // 功能: PLC主循环程序
// // 项目: 药液配置与加注控制系统
// // Story: AQEX-6 状态机骨架 + AQEX-9 急停调度顺序确认
// // PLC: S7-200 SMART CPU ST20
// // 说明: 本文件为语句表(STL)格式，可参考导入STEP 7-Micro/WIN SMART
// // 调度顺序: FC0(初始化)→FC2(急停,最高优先级)→FC4(Modbus)→FC3(报警)→FC22(RTC同步)
// //           →FC40(双倒计时器周期管理,v2.2新增)→FC1(状态调度)
// //           FC2在FC1之前,保证急停触发时同周期转S_ERROR
// //           FC40在FC1之前,保证M16.1下一轮S1触发脉冲及时响应
// //           【v2.2 修订 2026-09-15】FC40 从 FC1 内部调用移至 OB1 顶层调度
// // ============================================================
// 
// // 符号注释（实际导入时在符号表定义）
// // VW2     : 状态机当前状态 (0=S0,1=S1...8=S7,99=ERROR)
// // VW4     : 注射泵状态码
// // VW6     : 当前最高优先级报警码
// // VW8     : 实验总换水次数目标(=VD414×VD24/1440,单位:次)
// // V0.0    : CMD_Start (HMI→PLC启动命令)
// // V0.2    : CMD_Stop  (HMI→PLC停止命令)
// // V1.0    : STA_StartAck (PLC→HMI启动确认)
// // I1.1    : DI_EStop (急停反馈，常开NO，OFF=正常/ON=急停触发)  v1.3 改NO接法(原"常闭,ON=正常"注释已过期)
// // I0.3    : DI_Btn_SystemReset (系统复位按钮)
// 
// 
BEGIN
Network 1 
//  首次扫描初始化
//  SM0.1仅在首次扫描周期ON，调用FC0系统初始化
LD     SM0.1
=      L60.0                      // 局部存储器中转
LD     L60.0
CALL SysInit


// 急停与安全处理（每周期调用，优先级最高）
// SM0.0常ON，每周期调用FC2
LD     SM0.0
CALL   EStopHandling


// HMI停止命令(V0.2) - 自动运行中任意状态可停止
// ★ 2026-09-11 修复:
//   (1) 去掉 AW< VW2, 99 条件,允许 S_ERROR 态(VW2=99)也能停止
//       原逻辑只允许 VW2=1~8 停止, S_ERROR 锁死时点停止被忽略
//       新逻辑: VW2>0(非S0)就能停止, 急停/继电器故障锁存位由 FC19 管理
//   (2) 补清阀门诊断子状态 VB260~VB275 和诊断计时器 T50~T55
//       原三个清理路径(停止/冷启动/复位)全部遗漏,导致
//       FC11/FC15/FC17 的 AW=VW2xx,0 前置条件不成立,
//       开阀指令被跳过,表现为"点启动 M10.2=1 但系统不运行"
LD     V0.2
EU
AW>    VW2, 0                       // VW2>0(排除S0), VW2=1~8 或 99 都允许停止
LPS
R      Q0.0, 7                      // 泵停/阀关/NC电磁阀失电
R      T37, 1                       // 停S1计时器
R      M10.2, 1                     // 清S1首次进入标志
R      M10.7, 1                     // 清预规划标志
R      M11.6, 1                     // 清注射泵写请求
// ★ 新增: 清阀门诊断子状态+结果(VB260~VB275, 8字=16字节)
//   覆盖: 阀A子状态VB260~261, 阀B子状态VB262~263,
//         阀A/B结果VB266~269, 阀C诊断VB270~273, 其他辅助变量
FILL   0, VW260, 8
// ★ 新增: 清阀A/B诊断计时器 T50~T55
R      T50, 6
// 【v2.2新增】停止时清理上缸子流程状态 + 双倒计时器标志 + 定时器
MOVW   0, VW418                     // 上缸配液子流程状态清零
MOVW   0, VW400                     // 换水计数清零 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】
R      M16.0, 4                     // M16.0~M16.3 连续清零
R      T38, 1                       // 清 S2 搅拌定时器
R      T63, 1                       // [已修复 v2.2] 清 1s 脉冲定时器
R      T49, 1                       // 清 S4 转移计时器
MOVR   0.0, VD248                   // [已修复 v2.2] 清 TimerA_Elapsed
MOVR   0.0, VD252                   // [已修复 v2.2] 清 TimerB_Elapsed
MOVR   0.0, VD256                   // 清 TimerA 显示值
MOVR   0.0, VD244                   // 清 TimerB 显示值
MOVW   0, VW2                       // 回S0
R      V0.2, 1                      // 清停止命令
LPP


// Modbus通讯轮询（每周期调用）
LD     SM0.0
CALL ModbusPolling


// 报警处理（每周期调用）
LD     SM0.0
CALL AlarmHandling


// RTC时间同步处理（每周期调用）
// 处理HMI校时命令V0.6和5分钟超时保护
LD     SM0.0
CALL RTC_Sync


// v2.2 双倒计时器周期管理（每周期调用）
// ★ 必须在 FC1 状态调度之前调用,保证 M16.1 下一轮 S1 触发脉冲及时响应
// 替代原 AQEX-8 三层纠偏,严格保证 24h 换水次数硬约束 (VD414)
// 功能: 计算 T_cycle / 触发 S6 / 触发下一轮 S1 / 倒计时到 0 报警 / 双计时器显示值
LD     SM0.0
CALL RhythmCorrection


// 【v2.3 新增】M16.1 唯一消费点: FC40 触发下一轮 S1 → 上缸 VW418 4→1
// 置位方只有 FC40 NET5 (Prep_Needed 且距周期末 ≥ T_prep), FC10/FC15 不再置位
// 【2026-09-29修复】同步置 M10.2(S1首次进入标志),与FC10首轮播种口径一致,
//   否则下一轮S1因FC11入口门(LD M10.2)不通而空转
LD     M16.1
MOVW   1, VW418
S      M10.2, 1
R      M16.1, 1


// 状态机调度(急停时FC2会强制VW2=99)
// 每周期根据VW2调用对应状态FC
LD     SM0.0
CALL StateDispatcher


// 【v2.2 新增】上缸子流程调度(VW418)
// 在 FC1 下缸调度之后调用,处理上缸 S1/S2 并行流程
// VW418=1 → CALL FC11_State_S1_Inlet (上缸进水)
// VW418=2 → CALL FC1A_State_S2_MixDose (上缸搅拌+加药合并,v2.2 新建)
// VW418=0/3/4 → 无动作(空闲/配完等待/已转移由其他 FC 处理)
LD     SM0.0
AW=    VW418, 1
AW>    VW2, 0                       // 【2026-09-24修复】非S0(上缸随下缸运行才允许执行)
AW<    VW2, 99                      // 【2026-09-24修复】非S_ERROR(故障锁定禁止上缸动作)
CALL   State_S1_Inlet
LD     SM0.0
AW=    VW418, 2
AW>    VW2, 0                       // 【2026-09-24修复】同上
AW<    VW2, 99                      // 【2026-09-24修复】同上
CALL   State_S2_MixDose


// 手动控制处理（仅在S0态调用,在状态调度之后）
// 处理HMI画面3手动控制命令位V306.0~V307.1
//   (旧地址V2.4~V3.5因与VW2物理重叠已于2026-09-03迁移,详见FC20符号表)
// 由FC20使用M13.0~M13.4锁存输出,NC电磁阀自动跟随(详见FC20)
LD     SM0.0
LDW=   VW2, 0
CALL   ManualControl


// 手动注射泵控制（仅在S0态调用,在手动阀门控制之后）
// 处理V307.2/V307.3命令位
//   (旧地址V3.6/V3.7因与VW2物理重叠已于2026-09-03迁移,详见FC21符号表)
// 由FC21使用VD384/VW388/VW390执行单次/循环抽排(详见FC21)
LD     SM0.0
LDW=   VW2, 0
CALL   ManualSyringePump


// 非S0态清除手动控制锁存与手动注射泵状态,防止返回S0时误动作
LD     SM0.0
LDW=   VW2, 0
NOT
R      M13.0, 5                      // 清阀门/泵手动锁存
R      M13.5, 3                      // 清手动注射泵标志(M13.5~M13.7)
MOVW   0, VW390                      // 手动注射泵子状态复位为空闲


// M16.4/5/6 → V区镜像（供HMI读取，McgsPro S7-200 SMART以太网驱动不支持M区直接导入）
// V1.1=InitDone(原M16.4), V1.2=RTU1/Syringe在线(原M16.5), V0.1=RTU2/Flow在线(原M16.6)
LD     SM0.0
LD     M16.4
=      V1.1
LD     M16.5
=      V1.2
LD     M16.6
=      V0.1


// 系统总状态 → VB305 (0=良好,1=故障,2=急停)
// 急停: I1.1=ON(NO触点,ON=急停触发) OR V300.4 OR V300.5
// 故障: VW6≠0 AND 非急停
// 良好: 非急停 AND VW6=0 (默认值)
// 【2026-09-24修复】v1.3改NO接法后此处漏改: 原"LD I1.1 / NOT"把I1.1=OFF(正常)误判为急停,
//   导致急停释放后HMI标题栏永久显示"急停"; 故障分支的"A I1.1"同步改为"AN I1.1"

LD     SM0.0
MOVB   0, VB305                    // 默认良好
// 急停 → 2
LD     I1.1                        // NO触点: ON=急停触发
O      V300.4
O      V300.5
MOVB   2, VB305
// 非急停 + 有报警 → 1
LDW<>  VW6, 0
AN     I1.1                        // 急停未触发(NO触点OFF=正常)
AN     V300.4
AN     V300.5
MOVB   1, VB305


// 实验总换水次数目标计算(v2.2新增)
// VW8 = VD414(24h换水目标次数) × VD24(实验总时长min) / 1440
// 供HMI画面显示实验全程应完成的总换水次数
LD     SM0.0
MOVR   VD414, AC0
*R     VD24, AC0
/R     1440.0, AC0
ROUND  AC0, AC0
DTI    AC0, VW8


// ============================================================
// 文件结束
// 说明:
//   1. FC0/FC1/FC2/FC3/FC4 见各自独立文件
//   2. FC10~FC19 各状态FC见 State_Sxx.stl 文件
//   3. FC20 手动控制(新增,AQEX-34修复)
//   4. FC22 RTC时间同步处理(新增,AQEX-51)
//   5. 导入时需先建符号表，再逐个新建FC并粘贴代码
//   6. VB305 系统状态字(=0良好/1故障/2急停,AQEX-50新增)
// ============================================================

END_ORGANIZATION_BLOCK
SUBROUTINE_BLOCK SysInit:SBR0
TITLE=// ============================================================
// // 文件: FC0_SysInit.stl (调度骨架)
// // 功能: 系统初始化入口 — 首次扫描 + Modbus清零 + 冷启/断电路径调度
// // Story: AQEX-6 + AQEX-11 + AQEX-51
// // 说明: 拆分自原单一 FC0,冷启/断电恢复逻辑分别独立到 SBR25/SBR26
// //   跨 SBR 无 JMP/LBL 依赖,每个 SBR 内部 LBL 空间独立
// // LBL 分配: FC0 用 1(断电恢复入口)、2(完成汇合)
// //          SBR25 用 8/9/10/88/89(冷启动)
// //          SBR26 用 1/3/4/5/6/7(断电恢复)
// //   跨 SBR 编号相同不冲突,POU 内 LBL 空间独立
// // 修复记录:
// //   2026-09-13: 拆分前 FC0 12KB 导致 STEP7 下载"块过大"误判,
// //               拆分后 FC0(~3KB) + SBR25(~4KB) + SBR26(~4KB) 三个小块
// // ============================================================
// 
// // 符号说明:
// // M16.4: M_InitDone        初始化完成标志(断电保持;v2.2迁移自V304.0,2026-09-15)
// // VW198 : VW_Init_Step      初始化步骤号(调试用,0=完成)
// // ColdStart  : SBR25 冷启动路径
// // WarmRecovery: SBR26 断电恢复路径
// 
// 
BEGIN
Network 1 
//  SM0.1首次扫描 + Modbus库清零 + FC21计数器清零
//  ★ 2026-09-07修复: 每次首次扫描统一清零,库状态机在STOP→RUN后必须复位
LD     SM0.1
MOVW   1, VW198

LD     SM0.1
FILL   0, VW600, 143     // VB600~VB885清零(Modbus库存储区)
FILL   0, VW378, 2       // 清 VB378~VB381 (MBUS Error 4字节合并)
R      M10.0, 6           // 清M10.0~M10.5(Done位/降级标志)
R      M11.0, 1           // 清MBUS_CTRL Done位
MOVW   0, VW390           // 清手动注射泵子状态
R      M11.6, 1           // 清注射泵写请求
R      T104, 1            // 清回零冷却定时器


// 冷启/断电路径调度 + 完成汇合
// 判断冷启动/断电恢复
// M16.4=1 → JMP 1 (LBL 1: CALL WarmRecovery → JMP 2)
// M16.4=0 → 冷启动 → CALL ColdStart → RET回 FC0 继续到 LBL 2
// 【v2.2迁移 2026-09-15】M_InitDone 从 V304.0 迁至 M16.4（位对象，无字节级冲突）

LD     M16.4
JMP    1                  // M16.4=1 → 跳断电恢复路径

// ========== 冷启动路径 ==========
LD     SM0.1
AN     M16.4              // 冷启动(M16.4=0)
CALL   ColdStart          // SBR25: 出厂硬编码 + 用户默认覆盖 + TODR + 安全初始化
                          // ColdStart 自然结束返回
LD     SM0.0
JMP    2                  // ★ 关键: 无条件跳过 LBL 1,否则会形成死循环

// ========== 断电恢复路径 ==========
LBL    1
LD     SM0.1
CALL   WarmRecovery       // SBR26: TODR + RTC检测 + BCD转秒 + 状态机恢复
                          // WarmRecovery 自然结束后,顺序执行到 LBL 2 汇合

// ========== 初始化完成汇合 ==========
LBL    2
LD     SM0.1
S      M16.4, 1           // M_InitDone=1(初始化完成,断电保持;从V304.0迁移)
MOVW   0, VW198           // 步骤=0(完成)
// 汇合后自然结束 FC0,返回 OB1


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK StateDispatcher:SBR1
TITLE=// ============================================================
// // 文件: FC1_StateDispatcher.stl
// // 功能: 状态机调度器（每周期根据VW2调用对应下缸状态FC）
// // Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架)
// // 说明: v2.2 取消上缸流程作为下缸主状态的 S1/S2/S3/S3.5
// //       上缸流程已拆出到 VW418 State_UpTank 子流程,由 OB1 NET 7 直接调度
// //       本 FC1 仅调度下缸 VW2 路径: S0/S4/S5/S6/S7/S_ERROR
// //   修复记录:
// //     P1-NETWORK标题去掉冒号(错误66)
// //     P2-JMP/LBL跨NETWORK问题修复: 全部合并到NETWORK 1
// //     【v2.2 修订 2026-09-15】删除 S1/S2/S3/S3.5 LBL;上缸流程外移至 OB1
// // ============================================================
BEGIN
Network 1 
//  状态调度 (JMP/LBL必须在同一NETWORK内)
//  读取VW2并与各状态值比较，相等则调用对应FC
//  VW2 = 0 → S0初始化

JMP    1
// VW2 = 5 → S4上→下转移LDW=   VW2, 5JMP    2
// VW2 = 6 → S5实验运行中LDW=   VW2, 6JMP    3
// VW2 = 7 → S6下缸排水LDW=   VW2, 7JMP    4
// VW2 = 8 → S7实验结束LDW=   VW2, 8JMP    5
// VW2 = 99 → S_ERROR故障锁定LDW=   VW2, 99JMP    6
// 其他非法值 → 强制回S0LDW>=  VW2, 100JMP    7
// 若未匹配任何状态(0<VW2<99但非上述值),也回S0JMP    7
// S0入口LBL    1CALL State_S0_InitJMP    8
// S4入口LBL    2CALL State_S4_TransferJMP    8
// S5入口LBL    3CALL State_S5_RunJMP    8
// S6入口LBL    4CALL State_S6_DrainJMP    8
// S7入口LBL    5CALL State_S7_EndJMP    8
// S_ERROR入口LBL    6CALL State_ErrorJMP    8
// 非法状态处理(强制回S0)LBL    7MOVW   0, VW2                       // VW2=0
// 调度结束LBL    8// 状态调度完成,返回 OB1// 注: 上缸子流程(VW418=1/2)由 OB1 NET 7 在本 FC1 之后调度

// ============================================================// 文件结束// 说明://   1. JMP/LBL必须在同一NETWORK内//   2. 每个状态FC内部负责状态转移(修改VW2)//   3. 【v2.2】删除 S1/S2/S3/S3.5 入口:上缸流程移至 VW418 子流程//   4. 【v2.2】VW2 路径:0(S0)→5(S4)→6(S5)→7(S6)→8(S7) 或 99(S_ERROR)//   5. 【v2.2】VW418 路径:0(空闲)→1(S1)→2(S2搅拌+加药)→4(已转移)//                          或 3(配完等待),由 OB1 NET 7 调度 FC11/FC1A// ============================================================
JMP    1
LDW=   VW2, 5
JMP    2
LDW=   VW2, 6
JMP    3
LDW=   VW2, 7
JMP    4
LDW=   VW2, 8
JMP    5
LDW=   VW2, 99
JMP    6
LDW>=  VW2, 100
JMP    7
JMP    7
LBL    1
CALL   SBR5
JMP    8
LBL    2
CALL   SBR10
JMP    8
LBL    3
CALL   SBR11
JMP    8
LBL    4
CALL   SBR12
JMP    8
LBL    5
CALL   SBR13
JMP    8
LBL    6
CALL   SBR14
JMP    8
LBL    7
MOVW   0, VW2
LBL    8
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK EStopHandling:SBR2
TITLE=// ============================================================
// // 文件: FC2_EStopHandling.stl
// // 功能: 急停与安全处理（每周期调用，优先级最高）
// // Story: AQEX-6 状态机骨架 + AQEX-9 急停双通道+安全继电器反馈(详细实现)
// // 说明: 急停检测(I1.1 上升沿:NO 闭合)→锁存V300.4→转S_ERROR  v1.3 NO 进 I1.1
// //       安全继电器反馈延时校验(2秒)→V300.5继电器故障最高级报警
// //       输出强制安全(QB0=0,Q0.7声音开)
// //       急停解除与系统复位由FC19(State_Error)处理
// // ============================================================
// 
// // 符号说明:
// // I1.1  : DI_EStop           急停反馈(常开 NO,OFF=正常,ON=急停触发)  v1.3 改为接 NO 触点
// // I1.2  : DI_SafetyRelay_FB  安全继电器辅助反馈(ON=动力回路接通,OFF=动力回路断开)
// // V300.4: M_EStop_Latch      急停触发锁存(漫溢级,强制人工确认)
// // V300.5: M_Alarm_SafetyRelay 安全继电器故障(最高级,强制人工确认)
// // VW2   : 状态机状态(FC2写99转S_ERROR)
// // VW6   : 报警码(99=继电器故障,10=急停)
// // T35   : 安全继电器反馈延时(PT=20,2秒)
// // M10.7 : 预规划触发标志(急停时清,防止S5残留)
// 
// 
BEGIN
Network 1 
//  急停触发+锁存+转S_ERROR + 安全继电器反馈校验 + 输出强制安全(合并NET 1-3)
//  [已修复 v2.2] 用 V62.6 缓存 EU 结果,避免 S/R 链栈空;删除直接写 VW6(由 FC3 根据 V300.x 计算)
LD     I1.1
EU
AN     SM0.1                      // 首次扫描周期不触发（调试临时）
=      V62.6
LD     V62.6
S      V300.4, 1                  // M_EStop_Latch锁存
LD     V62.6
MOVW   99, VW2                    // VW2=99(转S_ERROR)
LD     V62.6
R      M10.7, 1                   // 清预规划标志

// 安全继电器反馈延时校验(2秒内I1.2应OFF,否则继电器故障)
LD     V300.4
A      I1.2
TON    T35, 20
LD     T35
EU
S      V300.5, 1                   // M_Alarm_SafetyRelay

// 急停锁存时输出强制安全
LD     V300.4
MOVB   0, QB0                     // 泵停/阀关/NC电磁阀失电(安全)
S      Q0.7, 1                     // 报警声音开


// 报警码写入(优先级:继电器故障99 > 急停10)
// [已修复 v2.2] 删除直接写 VW6,统一由 FC3 NETWORK1 根据 V300.4/V300.5 计算
// LD     V300.5
// MOVW   99, VW6
// LD     V300.4
// AN     V300.5
// MOVW   10, VW6

LBL    1


// 注: HMI停止命令由OB1 MAIN NETWORK 3统一处理(VW2>0即可停止),本FC不再处理
// 注: 急停解除与系统复位逻辑在FC19(State_Error)中处理
// 注: Q8.0报警灯光由FC3 AlarmHandling按VW6优先级统一管理(Story 1.6)
// 注: I1.2接线逻辑:ON=动力回路接通,OFF=动力回路断开(与代码注释一致)
// 注: 安全继电器反馈延时2秒兼顾机械动作时间与故障捕获灵敏度
// 注: 急停硬件回路(安全继电器切断动力电)不经过PLC,本FC仅处理软件层面


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK AlarmHandling:SBR3
TITLE=// ============================================================
// // 文件: FC3_AlarmHandling.stl
// // 功能: 报警处理（每周期调用）
// // Story: AQEX-6 状态机骨架 + AQEX-10 报警分级与消音/消光逻辑(详细实现)
// // 说明: 优先级链计算VW6 + 消音(I0.4/V0.4) + 消光(V0.3确认)
// //       自动恢复模式(V200.0=0时一般故障级条件消失自动复位)
// //       高优先级(漫溢/节奏滞后/继电器故障)强制人工确认,不受模式影响
// // ============================================================
// 
// // 符号说明:
// // VW6   : 当前最高优先级未确认报警码(0=无,99=继电器故障,10~14漫溢,20~21节奏,30~65一般)
// // V200.0: M_AlarmAckMode 报警确认模式(0=自动恢复,1=人工确认)
// // Q0.7  : 报警声音(FC2/FC19置位,FC3管理消音)
// // Q8.0  : 报警灯光(FC3统一管理,避免双写冲突)
// // I0.4  : 就地消音按钮(常开点动)
// // V0.3  : CMD_AckAlarm HMI报警确认命令
// // V0.4  : CMD_Mute HMI消音命令
// // V1.3  : STA_AlarmAckDone 报警确认握手
// // V1.4  : STA_MuteDone 消音握手
// // M11.1 : M_Sound_Latched 声音已消音标志(新报警时清,实现重鸣)
// // M11.2 : M_PrevAlarm 上一周期有报警标志(新报警检测用)
// 
// 
BEGIN
Network 1 
//  优先级链计算 VW6(最高优先级未确认报警码)
//  压缩版: 用 LDW=+A+MOVW 条件赋值,替代 LD/JMP/LBL 结构
//  优先级: 99 > 10~14 > 20~21 > 66 > 30~36 > 40~47 > 49 > 60~61 > 64~65
//  【v10.4硬件变更】链中已移除: 13(V300.3)/45(V302.5)/47(V302.7)/61(V303.1),
//    对应位均改为保留位,当前有效码不含13/45/47/61
//  原理: 从最高优先级开始逐个检查,VW6一旦被赋值,后续 LDW= VW6,0 为假,自动跳过
LD     SM0.0
MOVW   0, VW6                    // 默认无报警

// 1. 安全继电器故障(99)
LD     V300.5
MOVW   99, VW6

// 2. 漫溢级(10~14) - 逐位检查
// 【v10.4硬件变更】报警码13(V300.3,原NC球阀-下缸动作)已废弃,
//   Q0.6去除后无任何FC置位V300.3,优先级链移除该条目(V300.3为保留位)
LDW=   VW6, 0
A      V300.0
MOVW   10, VW6
LDW=   VW6, 0
A      V300.1
MOVW   11, VW6
LDW=   VW6, 0
A      V300.2
MOVW   12, VW6
LDW=   VW6, 0
A      V300.4
MOVW   14, VW6

// 3. 节奏滞后(20~21)
LDW=   VW6, 0
A      V300.6
MOVW   20, VW6
LDW=   VW6, 0
A      V300.7
MOVW   21, VW6

// 4. 单轮换水周期超时(66)
LDW=   VW6, 0
A      V303.6
MOVW   66, VW6

// 5. 阀A类(30~36) - 逐位检查
LDW=   VW6, 0
A      V301.0
MOVW   30, VW6
LDW=   VW6, 0
A      V301.2
MOVW   32, VW6
LDW=   VW6, 0
A      V301.3
MOVW   33, VW6
LDW=   VW6, 0
A      V301.4
MOVW   34, VW6
LDW=   VW6, 0
A      V301.5
MOVW   35, VW6
LDW=   VW6, 0
A      V301.6
MOVW   36, VW6

// 6. 阀B/C类(40~47) - 逐位检查
// 【v10.4硬件变更】报警码45(V302.5)/47(V302.7)已废弃(I0.2去除,FC32不再置位),
//   优先级链移除该两条目(V302.5/V302.7为保留位)
LDW=   VW6, 0
A      V302.0
MOVW   40, VW6
LDW=   VW6, 0
A      V302.1
MOVW   41, VW6
LDW=   VW6, 0
A      V302.2
MOVW   42, VW6
LDW=   VW6, 0
A      V302.3
MOVW   43, VW6
LDW=   VW6, 0
A      V302.4
MOVW   44, VW6
LDW=   VW6, 0
A      V302.6
MOVW   46, VW6

// 7. 其他类(49,60,64,65)
// 【v10.4硬件变更】报警码61(V303.1,原阀C关到位仍有流)已废弃(内漏判定依赖I0.2),
//   优先级链移除该条目;报警码60(V303.0)现覆盖关到位超时+排水超时两种触发
LDW=   VW6, 0
A      V303.2
MOVW   49, VW6
LDW=   VW6, 0
A      V303.0
MOVW   60, VW6
LDW=   VW6, 0
A      V303.4
MOVW   64, VW6
LDW=   VW6, 0
A      V303.5
MOVW   65, VW6


// 报警输出管理(灯光常亮 + 新报警声音重鸣)
// 有活动报警(VW6≠0) → 灯光Q8.0常亮
// 新报警(VW6由0变非0) → 清M_Sound_Latched,声音重鸣
LDW<> VW6, 0
S      Q8.0, 1                       // 灯光常亮

// 新报警检测: 本周期VW6≠0 且 上一周期M11.2=0(无报警) → 新报警
LDW<> VW6, 0
AN     M11.2                         // 上一周期无报警 → 新报警
R      M11.1, 1                      // 清消音标志(新报警重鸣)

// 声音管理: 有报警且未消音 → 声音开
LDW<> VW6, 0
AN     M11.1                         // 未消音
S      Q0.7, 1                       // 声音开

// 自动恢复模式: VW6=0且自动模式 → 自动消光
LDW= VW6, 0
AN     V200.0                        // M_AlarmAckMode=0(自动模式)
R      Q8.0, 1                       // 无报警自动消光
R      Q0.7, 1                       // 无报警关声音
R      M11.1, 1                      // 清消音标志

// 更新上一周期报警标志
LDW<> VW6, 0
=      M11.2                         // 记录本周期有报警(供下周期新报警检测)


// 消音处理(I0.4就地按钮 OR V0.4 HMI命令)
// [已修复 v2.2] 用 V62.7 缓存消音请求,避免 OLD 后 S/R 链栈空
// 消音源: I0.4上升沿 OR V0.4上升沿
LD     I0.4
EU
LD     V0.4
EU
OLD                                 // 两者任一上升沿
=      V62.7
LD     V62.7
R      Q0.7, 1                       // 关声音
LD     V62.7
S      M11.1, 1                      // 置消音标志(新报警时清)
LD     V62.7
S      V1.4, 1                       // STA_MuteDone握手
LD     V62.7
R      V0.4, 1                       // 清HMI消音命令
// 注: 消音只关声音,灯光Q8.0和报警位保持;新报警(VW6变化)时M11.1清,声音重鸣


// 报警确认处理(V0.3 HMI确认 → 条件消失才消光+清锁存)
// V0.3上升沿 = HMI报警确认命令(高优先级HMI侧二次确认,PLC只收V0.3)
// 确认规则: V0.3上升沿后,逐个检查报警位条件,条件消失的复位报警位,再由NETWORK1重算VW6
// ★ 关键修复(2026-09-04): NETWORK 4 缺 V0.3 上升沿门控(JMP),导致每周期无条件
//   执行所有条件复位,包括 LD V303.5; R V303.5, 1——使 S_ERROR 立即被清
//   修复: V0.3 无上升沿时跳过整个网络,避免误清报警位
// ★★★ 2026-09-11 发现 JMP 条件写反了！ ★★★
//   原代码 LD V0.3; EU; JMP 40：EU=1(有上升沿)时跳转 → 反而跳过了 R V0.3,1
//   正确：用 V60.5 缓存 EU 结果,LDN 取反后触发 JMP,再用 LD 恢复栈顶执行线圈
//   注意：STL 的 S/R/= 线圈指令依赖栈顶=1 才执行,不能用 NOT+JMP（会清掉栈顶）
//   注意：S7-200 SMART 不支持 JMPN 指令,必须用 JMP + LDN 中转
LD     V0.3
EU
=      V60.5                         // 缓存 EU 结果: 有上升沿=1, 无上升沿=0
LDN    V60.5                         // 无上升沿时栈顶=1
JMP    40                            // ★ 无上升沿则跳转到 LBL 40,跳过确认处理
LD     V60.5                         // 有上升沿时栈顶=1,恢复执行条件

S      V1.3, 1                       // STA_AlarmAckDone握手
R      V0.3, 1                       // 清确认命令

// 漫溢级: 条件消失才复位(液位计高位=OFF)
LD     V300.0                        // 上缸漫溢
AN     I0.5                          // 液位计A-高位已OFF
R      V300.0, 1                     // 复位
LD     V300.1                        // 下缸漫溢
AN     I0.7                          // 液位计B-高位已OFF
R      V300.1, 1
// NC阀动作: 由人工确认复位(无DI直接条件,保持锁存需HMI强制,此处不自动复位)
// 急停V300.4/继电器故障V300.5: 由FC19系统复位按钮/HMI高权限确认处理,FC3不碰

// 节奏滞后级: 条件消失(新一轮开始)由FC40重置,FC3不直接处理
// 但V0.3确认时,若V300.6/7已由FC40清除,NETWORK1会重算VW6

// 一般故障级: 条件消失则复位(调用公共子程序,与 NETWORK 5 共享)
CALL   AlarmReset_Common

// 单轮换水周期超时(66): V0.3人工确认复位 + 双计时器清零(本轮重新计时)
// 【2026-09-25补漏】V303.6置位后原无任何复位路径(锁存到冷启动);
//   FC40设计注4要求此报警"不受V200.0模式影响,必须V0.3人工确认",
//   故不放FC3A(避免NETWORK 5自动模式复用),仅在V0.3上升沿(本网络已门控)复位;
//   必须同时清零VD248/VD252: OB1中FC3先于FC40执行,若只清报警位,
//   NET6同扫描会因"Elapsed仍>=T_cycle且NET4被VW6=66封锁"立即重报形成死锁;
//   清零后条件消失,下一扫描VW6=0解锁NET4,节奏自动恢复
LD     SM0.0
R      V303.6, 1
MOVR   0.0, VD248                  // 确认=本轮重新计时
MOVR   0.0, VD252

LBL    40                            // ★ NETWORK 4 跳转目标(无V0.3上升沿时跳过确认处理)

// 注: 报警位复位后,下一周期NETWORK1重算VW6;若VW6=0,NETWORK2自动消光
// 注: 漫溢级(V300.0~2;V300.3已废弃为保留位)、急停(V300.4)、继电器故障(V300.5)不由FC3复位
//      由FC19系统复位按钮/HMI高权限确认处理


// 自动恢复模式(M_AlarmAckMode=0时一般故障级条件消失自动复位)
// 自动模式: V200.0=0时,一般故障级报警位条件消失自动R复位
// 漫溢/节奏滞后/继电器故障不受此模式影响,保持锁存
// ★ 2026-09-11 修复 AQEX-XX: 状态机已进S_ERROR(VW2=99)时禁止自动清报警位
//   原因: 一般故障触发MOVW 99,VW2后，若自动恢复立即清报警位，
//   会导致 VW2=99 + VW6=0 的状态机/报警系统不一致
//   场景: 阀A开到位超时(V301.4)后阀A终于开到位(I8.0=ON),
//         FC3 NETWORK 5 自动清V301.4→VW6=0,但VW2已锁99无人解锁,
//         OB1 NETWORK12 按VW6=0算VB305=0(良好),掩盖故障
//   防御: S_ERROR态暂停自动恢复,让FC19 NETWORK5自动解锁或人工复位处理
LDW=    VW2, 99
JMP    50                    // S_ERROR态 → 跳过自动恢复,报警位保持

LD     V200.0                        // M_AlarmAckMode
NOT                                     // =0(自动模式)时执行后续

// 一般故障级: 条件消失则复位(调用公共子程序,与 NETWORK 4 共享)
CALL   AlarmReset_Common

LBL    50                        // ★ S_ERROR态跳过自动恢复的跳转目标(2026-09-11新增)

// 注: 漫溢(V300.0~3)、急停(V300.4)、继电器故障(V300.5)、节奏滞后(V300.6/7)不在此处理
// 注: V303.6(单轮换水周期超时)也不在自动恢复范围,必须由V0.3人工确认(FC3 NETWORK 4)
// 注: 自动复位后下一周期NETWORK1重算VW6,NETWORK2自动消光


// NETWORK 6 报警日志已删除(压缩体积)
// HMI 侧已有完整报警历史记录,PLC 仅保留 VW6 供 HMI 轮询即可


// ============================================================
// 文件结束
// 说明:
//   1. FC3每周期调用,负责报警码计算+输出管理+确认处理+自动恢复+日志
//   2. 报警位置位由各FC(FC2/FC30~32/FC40等)负责,FC3只复位
//   3. Q8.0灯光由FC3统一管理,FC2/FC19不操作Q8.0(避免双写)
//   4. Q0.7声音由FC2/FC19置位(急停/故障态),FC3管理消音+新报警重鸣
//   5. 编址修正: M_AlarmAckMode=V200.0(避VD124冲突),SafetyRelayAck=V0.7(避V0.5冲突)
//   6. 高优先级(漫溢/节奏滞后/继电器故障)强制人工确认,不受M_AlarmAckMode影响
//   7. NETWORK4/5的报警位复位条件需与各FC置位条件严格对应(现场调试时核实)
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ModbusPolling:SBR4
TITLE=
BEGIN
Network 1 
//    MBUS_CTRL: 9600/8/N/1, 超时1000ms
LD     SM0.0
=      L60.0
LD     SM0.0
=      L63.7
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#0, 16#0, 1000, M11.0, VB378
//   T103: MBUS_MSG超时定时器(100ms时基, PT=100=10s)
//   任一任务活跃(M15.0~M15.4)时计时, 超时后强制切换任务
LD     M15.0
O      M15.1
O      M15.2
O      M15.3
O      M15.4
TON    T103, 100
//   任务0: 注射泵状态读(41001)
//   EN=VW290==0 AND M15.0, First=M15.0上升沿(EU)
LDW=   VW290, 0
=      L60.0
LD     M15.0
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A029, 16#1, &VB410, M10.0, VB379
//   任务1: 流量计读(40009)
//   EN=VW290==1 AND M15.1, First=M15.1上升沿(EU)
LDW=   VW290, 1
=      L60.0
LD     M15.1
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C49, 16#02, &VB410, M14.0, VB380
//   任务2: 注射泵位置读(41007)
//   EN=VW290==2 AND M15.2, First=M15.2上升沿(EU)
LDW=   VW290, 2
=      L60.0
LD     M15.2
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A02F, 16#1, &VB410, M10.1, VB381
//   任务3: 流量计瞬时流量读(40007) → VD94
//   EN=VW290==3 AND M15.3, First=M15.3上升沿(EU)
LDW=   VW290, 3
=      L60.0
LD     M15.3
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C47, 16#02, &VB410, M14.1, VB382
//   === 任务0: 成功/失败/切换 合并 (原 7/12/13) ===
//   任务0成功处理: VW410->VW4, 成功计数, 清失败计数
LD     M10.0
A      M15.0
AB=    VB379, 0
MOVW   VW410, VW4
AENO
MOVW   0, VW292
AENO
R      V303.4, 1
//   【2026-09-29修复】置位注射泵RTU在线标志: v2.2迁移丢失置位点(与M10.2同族)
//   只在此块(读成功)置位, 连续失败达滤波阈值(5次)才离线(见下方)
S      M16.5, 1
//   任务0失败计数
LD     M10.0
A      M15.0
AB<>   VB379, 0
INCW   VW292
//   【2026-09-29修复】注射泵连续读失败≥5次 → 离线标志复位
LDW>=  VW292, 5
R      M16.5, 1
//   任务0完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.1 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M10.0
O      T103
=      V60.1
LD     V60.1
R      M15.0, 1
LD     V60.1
S      M15.1, 1
LD     V60.1
MOVW   1, VW290
LD     V60.1
R      M10.0, 1
LD     V60.1
R      T103, 1
//   [已修复 v2.2] 删除 VW224→VW4 归一化死代码。任务0成功时已直接 MOVW VW410, VW4。
//   === 任务1: 成功/失败/切换 合并 (原 14/15/16) ===
//   任务1成功处理: VD410->VD86, 成功计数, 清失败计数
//   流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.0
A      M15.1
AB=    VB380, 0
MOVD   VD410, VD86
AENO
MOVW   0, VW294
//   【2026-09-29修复】置位流量计RTU在线标志: v2.2迁移丢失置位点(与M10.2同族)
//   只在此块(读成功)置位, 连续失败达滤波阈值(5次)才离线(见下方)
S      M16.6, 1
//   【2026-09-24修复】删除"AENO / R V303.6"：V303.6 已于 2026-09-08 起划归 FC40
//   报警66(单轮换水周期超时)，此处残留复位会在流量计读成功时悄悄清掉周期超时报警
//   任务1失败计数
LD     M14.0
A      M15.1
AB<>   VB380, 0
INCW   VW294
//   【2026-09-29修复】流量计连续读失败≥5次 → 离线标志复位
LDW>=  VW294, 5
R      M16.6, 1
//   任务1完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.2 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M14.0
O      T103
=      V60.2
LD     V60.2
R      M15.1, 1
LD     V60.2
S      M15.2, 1
LD     V60.2
MOVW   2, VW290
LD     V60.2
R      M14.0, 1
LD     V60.2
R      T103, 1
//   === 任务2: 成功/失败/切换 合并 (原 17/18/19) ===
//   任务2成功处理: VW410->VW222, 成功计数, 清失败计数
LD     M10.1
A      M15.2
AB=    VB381, 0
MOVW   VW410, VW222
AENO
MOVW   0, VW296
//   任务2失败计数
LD     M10.1
A      M15.2
AB<>   VB381, 0
INCW   VW296
//   任务2完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.6 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M10.1
O      T103
=      V60.6
LD     V60.6
R      M15.2, 1
LD     V60.6
S      M15.3, 1
LD     V60.6
MOVW   3, VW290
LD     V60.6
R      M10.1, 1
LD     V60.6
R      T103, 1
//   === 任务3: 成功/失败/切换 合并 (原 20/21/22-25) ===
//   任务3成功处理: VD410->VD94(瞬时流量), 成功计数, 清失败计数
//   流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.1
A      M15.3
AB=    VB382, 0
MOVD   VD410, VD94
AENO
MOVW   0, VW298
//   任务3失败计数
LD     M14.1
A      M15.3
AB<>   VB382, 0
INCW   VW298
//   任务3完成切换: 有写请求 → 任务4, 否则 → 任务0
//   用V60.0做完成事件中间继电器(仅此处赋值,无冲突)
LD     M14.1
O      T103
=      V60.0
//  // 复位任务3相关标志
LD     V60.0
R      M15.3, 1
R      M14.1, 1
R      T103, 1
//  // 进入任务4: 有写请求(M11.6=1)
LD     V60.0
A      M11.6
S      M15.4, 1
MOVW   4, VW290
//  // 未进入任务4则回任务0
LD     V60.0
AN     M15.4
S      M15.0, 1
MOVW   0, VW290
//   === 任务4: 写数据准备 + 写命令 合并 (原 27/29/30) ===
//   任务4写数据准备: 有写请求时把VW230复制到统一缓冲区VW410
//   DataPtr用&VB410, 避免直接使用&VW230导致MBUS_MSG写失败(Error=104)
LD     M11.6
MOVW   VW230, VW410
//   任务4: 注射泵写命令(仅在M11.6=1时执行)
//   EN=VW290==4 AND M15.4 AND M11.6, First=M15.4上升沿(EU)
//   写目标地址VD232由FC0/FC13/FC21设置(16#9C42=40002强停,16#9C43=40003复位,16#9C46=40006抽液,16#9C47=40007排液)
LDW=   VW290, 4
A      M15.4
A      M11.6
=      V60.3
LDW=   VW290, 4
A      M15.4
A      M11.6
=      L60.0
LD     M15.4
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#1, VD232, 16#1, &VB410, M12.0, VB383
//   === 任务4: 成功/失败/切换 合并 (原 31/32/33) ===
//   任务4成功处理: 清写请求, 成功计数, 清失败计数
//   ★关键: 写完成后立即清M11.6, 防止复位命令在轮询中反复写
LD     M12.0
A      M15.4
AB=    VB383, 0
R      M11.6, 1
R      M11.7, 1
MOVW   0, VW510
R      V303.4, 1
//   任务4失败计数 + 从站异常立即报警
LD     M12.0
A      M15.4
LPS
AB<>   VB383, 0
INCW   VW510
LPP
AB>=   VB383, 101
S      V303.4, 1
//   任务4完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.7 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
//   R M15.4, S M15.0, 更新VW290=0, 清握手, 清超时定时器
//  // ★M12.0不清! 由FC13/FC21请求方清零, 否则请求方看不到写完成
LD     M12.0
O      T103
=      V60.7
LD     V60.7
R      M11.6, 1
LD     V60.7
R      M11.7, 1
LD     V60.7
R      M15.4, 1
LD     V60.7
S      M15.0, 1
LD     V60.7
MOVW   0, VW290
LD     V60.7
R      T103, 1
//   === 软件滤波 合并 (原 34/35/36) ===
//   V303.4软件滤波: 连续读失败<5次时不报警
LDW<   VW292, 5
R      V303.4, 1
//   V303.4写任务软件滤波: 连续写失败<5次且无从站异常时不报警
LDW<   VW510, 5
AB<    VB383, 101
R      V303.4, 1
//   【2026-09-24修复】删除 V303.6 软件滤波(VW294<5 时复位)：V303.6 已划归 FC40
//   报警66(单轮换水周期超时)，Modbus任务1失败不再使用此位(通讯失败报警待Story1.1)


END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S0_Init:SBR5
TITLE=// ============================================================
// // 文件: FC10_State_S0_Init.stl
// // 功能: S0初始化状态 (VW2=0)
// // Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架)
// // 说明: v2.2 首轮由 FC10 一次性触发上缸 S1 (VW418=1) + 下缸进 S5 空等
// //       后续轮次由 FC17 在 S6 完成时切 M16.0 并清 M16.1,触发下一轮 S1
// //   修复记录:
// //     2026-09-11 新增硬件液位开关检查 (I0.6)
// //     【v2.2 修订 2026-09-15】首轮触发上缸 VW418=1 + 下缸 VW2=6 (S5 空等)
// //     【2026-09-29修复】启动网络重写: 补M10.2置位(v2.2丢失,致阀A永不动作) + V0.0两条路径都消费
// // ============================================================
BEGIN
Network 1 
//  S0状态输出(安全待命)
//  仅复位Q0.0~Q0.6(泵/阀/NC电磁阀),Q0.7报警声音由FC3统一管理
//  【v10.4硬件变更】Q0.6(下缸NC阀)已去除,保留未使用;R Q0.0,7清零无害
LD     SM0.0
R      Q0.0, 7                     // 泵停、阀A/B/C关、上缸NC阀失电,保留Q0.7


// v2.2 首轮启动逻辑
// 启动条件:
//   V0.0↑(CMD_Start 上升沿)
//   AND VW6=0  (无活动报警)
//   AND I0.6=ON (上缸排空,NPN常闭,液体低于探针闭合)
// 启动动作(一次性播种):
//   1. VW418 = 1 (上缸直接进入 S1 进水, OB1 上缸调度 FC11;
//      首轮不再需要 M16.1 触发脉冲, 避免与 FC40 NET5 触发路径双写)
//   2. S M10.2 = 1 (S1首次进入标志) 【2026-09-29修复】v2.2重构丢失的置位点:
//      无此置位则FC11入口门(LD M10.2/AW=VW260,0)永不通,阀A/上缸NC阀/诊断全部不启动
//   3. 清 M16.1 (防御性清旧触发脉冲, 首轮不置位)
//   4. S M16.0 = 1 (首轮固定使用 TimerA)
//   5. MOVW 6, VW2 (下缸直接进 S5 空等,不经过 S1/S2/S3/S4)
//   6. S V1.0 (启动确认)
//   7. R V0.0 (清启动命令位,成功/失败两条路径都消费)

// 【2026-09-29修复】原LPS/LPP+NOT+双LBL结构存在两个隐患:
//   (a) M10.2无置位点(本次修复);
//   (b) 条件不满足(JMP 1)时V0.0不被消费,启动命令悬空至HMI松键,语义不干净;
//   改为V60.0/V60.1草稿位缓存(与FC11的V61.1同套路),去掉全部栈操作。
// 注意: V60.0/V60.1为FC10专用扫描周期内草稿位,不跨块、不保持。

// 缓存启动脉冲(本扫描周期内有效)
LD     V0.0
EU
=      V60.0

// 三个条件全满足 → 允许播种
LD     V60.0
AW=    VW6, 0
A      I0.6
=      V60.1

// v2.2 首轮启动(一次性播种)
LD     V60.1
MOVW   1, VW418                     // 【v2.3修复】首轮直接播种上缸 S1 (原清0无意义,首轮无入口则液体永远转不下去)
S      M10.2, 1                     // 【2026-09-29修复】补S1首次进入标志置位(FC11入口门)
R      M16.1, 1                     // 防御性清旧触发脉冲(后续轮次由 OB1 消费 M16.1 置 VW418=1)
S      M16.0, 1                     // 首轮固定使用 TimerA (VD248)
// 【v2.2】下缸直接进 S5 空等(S4 转移由 FC40/FC17 触发,不再由 VW2=1~4 推进)
MOVW   6, VW2                      // VW2=6 (S5 实验运行态,S5 等待 S4 转移条件)
S      V1.0, 1                      // STA_StartAck=1

// 消费启动命令(仅脉冲周期执行;成功/失败两条路径都清,避免命令悬空)
LD     V60.0
R      V0.0, 1


// 注: 急停触发由 FC2 强制 VW2=99,此处不处理
// 注: S7 实验结束后 HMI 确认重启也走此路径(经 S_ERROR 解除后回 S0)
// 注: v2.2 与 v2.1 关键区别: 首轮不再走 S1→S2→S3→S4 串行上电逻辑
//       上缸配液 (VW418 子流程) 与下缸实验 (VW2 路径) 并行

// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S1_Inlet:SBR6
TITLE=// ============================================================
// // 文件: FC11_State_S1_Inlet.stl
// // 功能: S1上缸进水 (VW2=1)
// // Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成) + AQEX-8 节奏纠偏(已集成二次校正)
// // 说明: 开阀A进水，调用FC30阀A诊断(差值法+延时验证)
// //       诊断结果VW266: 0进行中/1正常完成/2故障
// //       诊断正常完成 → 调用FC40二次校正(模式1) → 更新VD_T_Rolling → 转S2
// // ============================================================
// 
// // 符号说明:
// // VW260 : Diag_State_A  阀A诊断子状态
// // VW266 : Diag_Result_A 阀A诊断结果
// // VW278 : VD_Timeout_ValveA×10 转换值(供FC30的T50用,已修正避FC32冲突)
// // VW280 : VD_Delay_ValveA_Verify×10 转换值(供FC30的T51用)
// // VD332 : VD358运算中间变量(避免修改HMI参数VD358)
// // VD316 : 目标进水量(HMI设定,SBR25冷启动默认10L,用户默认区VD500覆盖)
// 
// 
BEGIN
Network 1 
//  S1首次进入 - 开阀A+NC球阀+复位+流量计快照+参数计算+启动诊断(合并)
//  [已修复 v2.2] 用 V61.1 缓存 M10.2 AND VW260=0 条件,避免 S/R 指令链栈空
LD     M10.2
AW=    VW260, 0
=      V61.1
LD     V61.1
S      Q0.2, 1                     // 开阀A
LD     V61.1
S      Q0.5, 1                     // 开上缸NC球阀
LD     V61.1
R      T37, 1                      // 复位S1计时器
LD     V61.1
R      T51, 1                      // ★修复2026-09-30: 防御性清T51残留done位(子状态5报警路径不复位T51)
LD     SM0.0
TON    T37, 32767                  // 【v2.3.6修复2026-09-30】输入改SM0.0: 原V61.1单扫描脉冲致T37永不计时,VD70恒0                  // 【v2.3修复】启动S1实测计时(原只复位不启动,导致VD70恒为0)
LD     V61.1
R      V1.6, 1                     // 置上缸状态=空
LD     V61.1
MOVD   VD86, VD82                  // 流量计快照
LD     V61.1
MOVR   VD358, VD332                // 计算超时参数 VW278
*R     10.0, VD332
ROUND  VD332, AC0
MOVW   AC0, VW278
LD     V61.1
MOVR   VD66, VD320                 // 计算延时参数 VW280
*R     10.0, VD320
ROUND  VD320, AC0
MOVW   AC0, VW280
LD     V61.1
MOVW   1, VW260
MOVB   0, VB266                    // 清诊断结果
MOVB   0, VB267


// v2.3 双倒计时器: S1 首次进入时清零【非活动】Elapsed 计数器
// 【v2.3修复】原"清零当前活动计数器"与流水线时序矛盾:
//   S1 由 FC40 按"本轮剩余<=Prep_Needed"触发,启动于本轮中段,
//   活动计数器正服务本轮(NET4/NET6节奏判定),清零会导致本轮节奏失效;
//   非活动计数器属于下一轮,其计时从本轮S6完成切换后才开始,此处清零安全。
LDW=   VW418, 1                    // 上缸进入 S1
AN     M16.2                       // S1 尚未开始(防止重复启动)
S      M16.2, 1                    // 置 S1 已开始标志
LD     M16.0                       // 当前活动计时器为 TimerA?
MOVR   0.0, VD252                  // 清零【非活动】TimerB_Elapsed
LDN    M16.0                       // 当前活动计时器为 TimerB?
MOVR   0.0, VD248                  // 清零【非活动】TimerA_Elapsed


// 调用阀A诊断FC30
LD     SM0.0
CALL ValveA_Diag


// 检查阀A诊断结果 + 二次校正 + 转S2
// ★ 关键: FC30 用 MOVB 写 VB266(只写低字节,高字节VB267=0)
//   所以 VW266 = VB266×256, 必须用 LDB= 字节比较,不能用 AW= 字比较
//   字节值 0=进行中, 1=正常完成, 2=故障(FC30已转S_ERROR)
LDB=   VB266, 1                    // 诊断正常完成(字节比较,与FC30的MOVB匹配)
JMP    1                   // 是 → 跳转处理
LD     SM0.0
JMP    2                 // 否 → 结束本NETWORK

LBL    1
LD     SM0.0
MOVW   T37, VW236                   // 【v2.3修复】先读当前值再复位(R在前读到的恒为0)
ITD    VW236, VD444                 // 整数→双整数
DTR    VD444, VD70
/R     10.0, VD70                  // 【v2.3.6】100ms时基→秒                  // 双整数→实数(VD_S1_Actual)
R      T37, 1                      // 停S1计时(读后复位)
// 【v2.2 修订 2026-09-15】删除原 Story1.4 二次校正 FC40 调用
// v2.2 取消三层纠偏,FC40 改为双倒计时器周期管理(由 OB1 顶层调用)
// 原 VD354/VW182/VW184/VD150/154/158 全部废弃
// 保留位置仅为保留 S1 完成 → 转 S2/VW418=2 的状态机逻辑

// 【v2.2 新增】S1 完成时清 M16.2 (S1 已开始标志) + 切 M16.0 (计时器切换, 由 FC17 S6 完成时切)
LD     SM0.0
R      M16.2, 1                    // 清 S1 已开始标志
R      M16.3, 1                    // 清 S2 首次进入标志(防御性)

// 【v2.2】S1 完成 → 转 VW418=2 (上缸 S2 搅拌+加药)
// v2.2 取消原"二次校正 VW184≠4"条件,改为无条件转移
// (FC40 已删除三层纠偏, 不再有"人工介入→S_ERROR"分支)
// 累加本次进水量到本次实验累计流量
MOVR   VD90, AC0                   // AC0 = VD_Current_InletVolume
+R     AC0, VD406                  // VD_ExpTotal_Flow += 本次进水量 (原VD364,2026-09-29迁移:与VD366重叠2字节;VD402槽被VW402(T38_PT)占)
MOVW   2, VW418                    // 状态转移 S1→S2 (v2.2: VW418 上缸子流程而非 VW2)
R      M10.2, 1                    // 清S1首次进入标志
R      T38, 1                      // 进入S2前复位T38(防御性,FC1A 首次进入会再次启动 T38)

LBL    2


// 注: 漫溢保护、差值法计量、延时验证、内漏检测、开关到位诊断
//      全部由FC30统一处理，FC11仅负责状态转移调度
// 注: VD316(目标进水量)由HMI设定或SBR25用户默认覆盖写入,FC30用它做达标比较
// 注: 二次校正(Story 1.4)在转S2前调用
// 注: VD358运算已改用独立中间变量VD332,不再修改HMI设定参数
// 注: 断电恢复由FC0统一处理,VW2=1(S1阀A动作中断)时FC0转S_ERROR


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S2_MixDose:SBR7
TITLE=// ============================================================
// // 文件: FC1A_State_S2_MixDose.stl
// // 功能: S2 搅拌 + 加药合并子状态 (VW418=2)
// // Story: v2.2 流程重构 - 新建(由原 FC12 + FC13 合并)
// // 说明: v2.2 取消独立 S3 加药子状态,改为"搅拌 + 加药"组合子状态
// //       潜水泵常开(整个 S2 期间不停),T38 计时到达 VD28 (固定搅拌时长) + VW226=9 (加药完成)
// //       共同触发 VW418=3 (上缸配完等待转移)
// //
// // 调用方: OB1 NET 7 仅在 VW418=2 时调用本 FC
// // 关联 FC: 本 FC 内部调用 FC13_State_S3_Dosing 完成加药子状态机逻辑
// //         (FC13 文件保留,VW226 子状态机不变,仅由本 FC 触发)
// //
// // 【v2.2 合并说明】
// //   - 原 FC12(预循环搅拌)功能: S2 启动潜水泵 + T38 计时 → 已集成到本 FC NETWORK 1
// //   - 原 FC13(加药)功能: VW226 0~9 子状态机(15 个 NETWORK) → 本 FC 内部 CALL FC13
// //   - 原 FC14(S3.5 静止等候)功能: 取消(v2.2 取消静止等候环节)
// // ============================================================
// // 符号说明:
// // VW402 : T38_PT  S2搅拌定时器PT(VD28×10, v2.3.2由VW252迁入,避让VD252 TimerB_Elapsed低字)
// // VW226 : 加药子状态机 (0~9, FC13内部使用)
// 
BEGIN
Network 1 
//  首次进入 S2 - 启动潜水泵 + T38 计时 + 初始化加药子状态机
//  触发条件: VW418=2 (上缸 S2 入口) + M16.3=0 (首次进入门控)
//  启动动作: 开潜水泵1/2 + T38 PT = VD28 × 10 + 清 VW226 + R 注射泵异常 + 初始化 VD372/VD440
//  [已修复 v2.2] 用 V61.2 缓存 S2 首次进入条件,避免 S/R/LPS 后栈空
LDW=   VW418, 2
AN     M16.3
=      V61.2
LD     V61.2
S      M16.3, 1                     // 置 S2 首次进入标志
LD     V61.2
S      Q0.0, 1                      // 潜水泵1开
LD     V61.2
S      Q0.1, 1                      // 潜水泵2开
LD     V61.2
MOVR   VD28, VD336                  // T38 PT = VD28 × 10
*R     10.0, VD336
ROUND  VD336, AC0
MOVW   AC0, VW402                   // VW402 = T38 PT 【v2.3.2迁移: 原VW252与VD252(TimerB_Elapsed REAL)低字重叠,互踩】
LD     V61.2
TON    T38, VW402                   // 启动 S2 搅拌定时器
LD     V61.2
MOVW   0, VW226                     // 清 VW226 加药子状态机
LD     V61.2
R      V303.4, 1                    // 清注射泵异常报警
LD     V61.2
MOVR   VD584, VD372                 // VD_Remaining_Vol = 目标加药量
LD     V61.2
MOVR   0.0, VD440                   // 累计加药量清零


// 调用 FC13 加药子状态机(15 个 NETWORK,完整保留)
// FC13 内部使用 VW226 子状态 0~9 推进加药流程:
//   0: 初始化
//   1: 计算并写抽液步数
//   2: 等待 Modbus 写完成
//   3: 等待抽液动作完成
//   4: 计算并写排液步数
//   5: 等待 Modbus 写完成
//   6: 等待排液动作完成
//   7: 校验累计加药量
//   8: 完成判定
//   9: 已完成
LD     SM0.0
CALL State_S3_Dosing


// 完成判定 - 搅拌计时到 AND 加药子状态 9 → VW418=3 (上缸配完等待转移)
// [已修复 v2.2] 用 V61.3 缓存完成条件,避免 R 指令链栈空
// 潜水泵在判定完成后停止(Q0.0/Q0.1 复位)
LDW=   VW226, 9                    // 加药子状态 9 = 已完成
A      T38                         // 搅拌 T38 计时到
=      V61.3
LD     V61.3
R      Q0.0, 1                     // 潜水泵1关
LD     V61.3
R      Q0.1, 1                     // 潜水泵2关
LD     V61.3
R      T38, 1                      // 清 T38
LD     V61.3
MOVW   3, VW418                    // 上缸进入"配完等待转移"


// 注: S2 期间潜水泵与加药并行(同时进行),而非原"先搅拌后加药"
// 注: T38 计时由 VD28 (S2 固定时长) 决定,v2.2 严格不可压缩
// 注: VW226=9 + T38 到达 共同触发 VW418=3 (任一未达都不转)
// 注: 故障时 FC13 内部已置 V303.4 并转 S_ERROR,由 FC19 处理
// 注: 断电恢复时 VW418=2 由 SBR26 决定是否保持(详见 SBR26)

// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S3_Dosing:SBR8
TITLE=// ============================================================
// // 文件: FC13_State_S3_Dosing.stl
// // 功能: S3加药 (VW2=3)
// // Story: AQEX-6 状态机骨架 + 注射泵控制(AQEX-50)
// // 说明: 计算加药步数, 通过Modbus FC06依次下发抽液/排液指令,
// //       每次动作后发强停(40002=1)恢复96就绪态, 出错转S_ERROR
// //
// // 2026-09-06修正(基于FC99现场调试):
// //   1. 地址格式: 40006→16#9C46, 40007→16#9C47, 40002→16#9C42
// //   2. 状态码: VW4=0(96就绪), VW4=1(64空闲), VW4=2(100运动中), VW4≥4(错误)
// //   3. 强停恢复: 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪
// //      原因: 泵抽液/排液后状态变100(运动中), 需强停才能恢复96接受下条命令
// //   4. 运动检测: VW4=2→M12.1/M12.2置位(已开始), VW4≠2且已开始→运动完成
// //   5. 运动超时: T102(30秒)防止泵卡在运动态无法退出
// //   6. 全局错误: VW4≥4才报错(VW4=2运动中不算错误)
// //
// // 2026-09-15代码压缩:
// //   1. 提取公共错误退出逻辑到 FC13A_PumpErrExit(子程序符号 PumpErrExit)
// //      NETWORK 2/4/7/10/13 的重复错误处理统一为 CALL PumpErrExit
// //   2. 合并子状态1/5(写完成)、2/6(等运动)、3/7(强停)的重复NETWORK
// //      原15个NETWORK压缩至11个,减少程序体积
// // ============================================================
// 
// // 符号说明:
// // VW226 : S3_SubState  S3子状态机
// //          0=进入计算  1=写抽液  2=等抽液运动完成
// //          3=写强停恢复  4=等强停完成+恢复就绪
// //          5=写排液  6=等排液运动完成
// //          7=写强停恢复  8=等强停完成+计算/循环
// //          9=加药完成(闩锁,FC1A判定9+T38到后转出S2,下轮S2由FC1A清0复位)
// // VD90  : VD_Current_InletVolume 本次进水量(S1差值法结果)
// // VD584 : VD_Vol_Target    目标抽取母液体积(μL)
// // VD372 : VD_Remaining_Vol 本轮剩余待加药量(μL),S3进入时=VD_Vol_Target
// // VD102 : VD_Dose_Steps    本次循环目标步数(REAL)
// // VW204 : MB_Pump_Aspirate 抽液步数缓冲(映射40006)
// // VW206 : MB_Pump_Dispense 排液步数缓冲(映射40007)
// // VD232 : PumpWrite_Addr   FC06写目标Modbus地址
// // VW230 : PumpWrite_Data   FC06写数据
// // M11.6 : PumpWrite_Req    写请求(FC13置位,FC4执行后清零)
// // M11.7 : PumpWrite_Busy   写忙标志(FC4管理)
// // M12.0 : PumpWrite_Done   写完成(FC4置位,FC13清零)
// // M12.1 : Pump_Asp_Started 抽液运动已开始(VW4曾=2)
// // M12.2 : Pump_Disp_Started 排液运动已开始(VW4曾=2)
// // V303.4: M_Alarm_SyringePump 注射泵通讯/动作异常
// // VW4   : 注射泵归一化状态码(0=就绪96,1=空闲64,2=运动中100,≥4=错误)
// // VD346 : 运算中间变量(避免污染HMI设定区)
// // T102  : 运动超时定时器(30秒,子状态2/6复用)
// // 子程序: PumpErrExit(FC13A_PumpErrExit.stl) - 公共泵错误退出处理
// // ============================================================
// 
// 
BEGIN
Network 1 
//  S3进入/子状态0 - 计算目标加药量,初始化剩余量,启动潜水泵搅拌,清握手位
//  仅在VW226=0时执行一次(FC12进入S3时已清VW226=0)
//  [已修复 v2.2] 用 V61.4 缓存条件,避免 LPS/LPP 内 S/R 链栈空
LD     SM0.0
AW=    VW226, 0
=      V61.4
// ? v2.0 浓度参数删除: 目标加药量由用户直接输入VD370(HMI设定)
LD     V61.4
MOVR   VD584, VD372                  // VD_Remaining_Vol = 目标加药量
LD     V61.4
S      Q0.0, 1                       // 潜水泵1开
LD     V61.4
S      Q0.1, 1                       // 潜水泵2开
// 清写握手位,避免上一周期残留误判
LD     V61.4
R      M12.0, 1
LD     V61.4
R      M12.1, 1
LD     V61.4
R      M12.2, 1
LD     V61.4
R      M11.6, 1
LD     V61.4
R      M11.7, 1
LD     V61.4
R      T102, 1
LD     V61.4
MOVW   1, VW226                      // 进入子状态1:计算并写抽液步数


// S3全局错误检测 - 注射泵通讯/动作异常或状态码报错(≥4)
// 注: VW4=2(运动中)不算错误,不会触发此检测
// 错误处理统一调用子程序 PumpErrExit(停泵+转S_ERROR+清握手)
LD     V303.4                        // FC4已置位的通讯/动作故障
LD     SM0.0
AW=    VW2, 3
AW>=   VW4, 4                        // 状态码≥4(归一化错误码,不含运动中)
OLD
LPS
CALL   PumpErrExit                   // 公共错误退出(FC13A)
LPP


// 子状态1 - 计算本次循环步数并下发抽液指令(16#9C46)
// 条件: 无进行中的写请求/写忙/写完成
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
// 计算本次循环步数 = VD_Remaining_Vol / VD_StepResolution
MOVR   VD372, VD346                  // VD346 = VD_Remaining_Vol(μL)
/R     VD350, VD346                  // VD346 = steps(REAL)
// 限制最大6000步(25ml注射器容量)
LD     SM0.0
AR>=   VD346, 6000.0                 // steps >= 6000 ?
JMP    20                            // 是 -> 限制为6000
ROUND  VD346, AC0
MOVR   AC0, VD102                    // VD_Dose_Steps < 6000
JMP    21                            // 跳过限制分支
LBL    20
MOVR   6000.0, VD102                 // 限制为6000步
LBL    21
// 检查步数有效性(ROUND后剩余量不足一步时直接完成)
ROUND  VD102, AC0
LD     SM0.0
AR<=   AC0, 0.0                      // 本次循环步数 <= 0 ?
JMP    22                            // 是 -> 直接转完成
// 同步写入抽/排液步数缓冲(供HMI/调试查看)
MOVW   AC0, VW204
MOVW   AC0, VW206
// 重新建立执行条件后下发抽液指令
// ★泵就绪(VW4=0)才允许写, 避免运动中下发导致异常码4
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
MOVW   AC0, VW230                    // 写数据=本次循环步数
MOVD   16#9C46, VD232                // ★十六进制地址(40006=16#9C46)
S      M11.6, 1                      // 置写请求
JMP    23
LBL    22
// 剩余量不足一步,无需再加药,直接转完成
MOVW   9, VW226
LBL    23


// 子状态1/5 - 写完成处理(抽液/排液共享,公共错误路径)
// 错误路径(共享): 子状态1或5 + V303.4(写失败) → 调用 PumpErrExit
LD     M12.0
LD     SM0.0
AW=    VW226, 1
LD     SM0.0
AW=    VW226, 5
OLD
A      V303.4
CALL   PumpErrExit
// 成功: 子状态1→2(抽液写成功 → 等抽液运动完成)
LD     M12.0
AW=    VW226, 1
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   2, VW226                      // →子状态2:等抽液运动完成
// 成功: 子状态5→6(排液写成功 → 等排液运动完成)
LD     M12.0
AW=    VW226, 5
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   6, VW226                      // →子状态6:等排液运动完成


// 子状态2/6 - 等待运动完成(抽液M12.1/排液M12.2)
// T102: 30秒超时(防止泵卡在运动态),子状态2/6复用
// M12.1: 抽液运动已开始(VW4曾=2)
// M12.2: 排液运动已开始(VW4曾=2)
// 完成: (M12.x=1 AND VW4≠2) OR T102超时 → 子状态3/7(写强停)

// T102运行(子状态2或6)
LD     SM0.0
AW=    VW226, 2
LD     SM0.0
AW=    VW226, 6
OLD
TON    T102, 300                     // 30秒(300×100ms)

// 检测运动开始: 子状态2
LD     SM0.0
AW=    VW226, 2
AW=    VW4, 2
S      M12.1, 1
// 检测运动开始: 子状态6
LD     SM0.0
AW=    VW226, 6
AW=    VW4, 2
S      M12.2, 1

// 运动完成: 子状态2→3(写强停恢复)
LD     M12.1
AW=    VW226, 2
AW<>   VW4, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226

// 运动完成: 子状态6→7(写强停恢复)
LD     M12.2
AW=    VW226, 6
AW<>   VW4, 2
R      T102, 1
R      M12.2, 1
MOVW   7, VW226

// 超时: 子状态2→3(强停恢复,防止卡死)
LD     T102
AW=    VW226, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226

// 超时: 子状态6→7
LD     T102
AW=    VW226, 6
R      T102, 1
R      M12.2, 1
MOVW   7, VW226


// 子状态3/7 - 下发强停指令(16#9C42=1)恢复96就绪
// ★强停无需就绪门控: 用于紧急停止/恢复, 不检查VW4=0
LD     SM0.0
AW=    VW226, 3
LD     SM0.0
AW=    VW226, 7
OLD
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230                      // 强停数据=1
MOVD   16#9C42, VD232                // ★十六进制地址(40002=16#9C42)
S      M11.6, 1                      // 置写请求
LPP


// 子状态3/7 - 强停写完成处理(共享错误路径)
// 错误路径(共享): 子状态3或7 + V303.4(写失败) → 调用 PumpErrExit
LD     M12.0
LD     SM0.0
AW=    VW226, 3
LD     SM0.0
AW=    VW226, 7
OLD
A      V303.4
CALL   PumpErrExit
// 成功: 子状态3→4(等强停完成+恢复就绪)
LD     M12.0
AW=    VW226, 3
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   4, VW226                      // →子状态4:等恢复就绪
// 成功: 子状态7→8(等强停完成+计算/循环)
LD     M12.0
AW=    VW226, 7
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   8, VW226                      // →子状态8:等恢复就绪+计算/循环


// 子状态4 - 等待泵恢复就绪(VW4=0=96就绪态)
// 强停后泵从100→96, 需等待VW4回到0才能接受下一条命令
LD     SM0.0
AW=    VW226, 4
AW=    VW4, 0
MOVW   5, VW226                      // →子状态5:写排液步数


// 子状态5 - 下发排液指令(16#9C47)
// ★泵就绪(VW4=0)才允许写, 避免运动中下发导致异常码4
LD     SM0.0
AW=    VW226, 5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
LPS
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232                // ★十六进制地址(40007=16#9C47)
S      M11.6, 1
LPP


// 子状态8 - 等待泵恢复就绪 + 计算本轮体积 + 判断循环/完成
// 等待VW4=0(就绪), 然后计算本轮排出药量, 判断是否完成全部加药量
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
LPS
// 计算本次循环实际排出药量 = VD_Dose_Steps × VD_StepResolution
MOVR   VD102, AC0                    // AC0 = 本次循环步数(REAL)
*R     VD350, AC0                    // AC0 = 本次循环体积(μL)
// 累加本次循环排出药量到累计加药量
+R     AC0, VD440                    // VD_Dosed_Volume_Total += 本次循环体积
// 扣减剩余待加药量
-R     AC0, VD372                    // VD_Remaining_Vol -= 本次循环体积
LPP
// 判断是否完成全部加药量(与恢复就绪条件AND)
AR>=   VD440, VD584                  // 累计加药量 >= 目标量 ?
JMP    30                            // 是 -> 完成
// 未完成: 清本轮握手位,返回子状态1继续下一轮
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
AR<    VD440, VD584                  // 确认未完成
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
MOVW   1, VW226                      // 返回子状态1:下一轮抽液
JMP    31
LBL    30
// 完成: 转子状态9
LD     SM0.0
AW=    VW226, 8
MOVW   9, VW226
LBL    31


// 子状态9 - 加药完成(v2.3.4修订): 清握手+停运动超时, **保持VW226=9作"加药完成"闩锁**
// 【v2.3.4修订1】删除原"MOVW 0, VW226": FC13在FC1A的完成判定(LDW= VW226,9)之前
//   执行, 同扫描清零使判定永远看不到9 → 搅拌未结束时加药完成后子状态回0、VD372被
//   重置为全量 → 整量重复加药循环直到T38到点(每轮重打全量, VD440累计失控)。
//   保持9闩锁: FC1A看到"9+T38到"→VW418=3转出S2, FC1A不再被调用; 下轮S2由FC1A
//   首次进入(MOVW 0, VW226)复位, 语义闭环。
// 【v2.3.4修订2】删除原"R Q0.0/R Q0.1": v2.2中搅拌泵生命周期归FC1A(首次进入S、
//   完成判定R), FC13加药完成即停泵会砍掉剩余搅拌时间(加药约数分钟 vs 搅拌30min)。
// 【2026-09-30修复 v2.3.4修订3】删除"MOVW 4, VW2"(v1.x遗留的转S3.5写入):
//   v2.2已把上缸流程移至VW418并废除S3.5(FC14退役), 此遗留行在每次加药完成时
//   把下缸主状态VW2踩成4 → FC1调度器无状态4判非法强制回0 → FC10无V0.0脉冲
//   不自愈(VW2=6无法恢复,下缸卡死) → FC40 NET4"S6触发需VW2=6"永假
//   → 周期末Elapsed越界报"单轮换水周期超时"(报警66)。下缸主状态只应由
//   FC10/FC15/FC17/FC40/FC2/FC19写入, FC13(上缸加药子FC)无权写VW2。
LD     SM0.0
AW=    VW226, 9
LPS
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
LD     SM0.0
R      T39, 1                        // 复位T39(S3.5已废除,保留无害)
LPP


// ============================================================
// 文件结束
// 说明:
//   1. 采用VW226子状态机(0~9),抽液/排液分两步下发,每步等待FC4写完成(M12.0)
//   2. 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪态:
//      抽液→等运动→强停→等就绪→排液→等运动→强停→等就绪→计算/循环
//   3. 运动检测: VW4=2(100运动中)→M12.1/M12.2置位,VW4≠2且已运动→运动完成
//   4. 运动超时: T102(30秒)防止泵卡在运动态,T102超时直接发强停恢复
//   5. 支持多次抽液+排液循环:单循环步数限制6000步(25ml注射器容量),
//      每次排液后强停恢复→累加实际体积到VD378并扣减VD372,直到累计>=目标量
//   6. 全局错误: VW4≥4(不含VW4=2运动中)或V303.4立即转S_ERROR并安全停泵
//   7. S3期间Q0.0/Q0.1保持运行,完成/出错时停止
//   8. 所有Modbus地址使用十六进制格式(16#9C46/16#9C47/16#9C42)
//      避免十进制大数被解析为INT导致MBUS_MSG Error=6
//   9. 2026-09-15代码压缩: 提取公共错误退出逻辑到FC13A_PumpErrExit,
//      合并子状态1/5(写完成)、2/6(等运动)、3/7(强停)的重复NETWORK
//      原15个NETWORK压缩至11个,减少程序体积
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S4_Transfer:SBR10
TITLE=// ============================================================
// // 文件: FC15_State_S4_Transfer.stl
// // 功能: S4上→下转移 (VW2=5)
// // Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-7 阀门诊断)
// // 说明: v2.2 S4 是唯一的上下缸交汇点
// //       启动条件: VW2=5 AND V1.7=0 (下缸已排空) AND VW418=3 (上缸已配完)
// //       完成后: 切 VW418=4 (已转移) + 写 S6 滚动默认值 + 转 S5
// // ============================================================
BEGIN
Network 1 
//  S4 启动条件(v2.2 关键改动:必须 VW418=3 才能启动)
//  触发条件: VW2=5 (下缸 S4 入口) + V1.7=0 (下缸已排空) + VW418=3 (上缸配完等待) + VW6=0 (无报警)
//  启动动作: 开阀B + 启动 T49 计时 + 置 VW418=4 (上缸标记"已转移")
//  【v10.4硬件变更】下缸NC球阀Q0.6已去除(保留未使用),不再随S4启动
//  [已修复 v2.2] 用 V61.5 缓存 S4 启动条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空
//  【v2.3修复】首轮补入口: 下缸S5空等(VW2=6)且已排空(V1.7=0)且上缸已配完(VW418=3)
//    原仅响应VW2=5,首轮FC10直接置VW2=6,首罐液体永远无法转移

AW=    VW2, 5                       // S4 状态入口AN     V1.7                         // 下缸已排空AW=    VW418, 3                     // 上缸已配完AW=    VW6, 0                       // 无报警=      V61.5LD     SM0.0                        // 【v2.3】首轮入口(VW2=6空等,条件与上面等价)AW=    VW2, 6AN     V1.7AW=    VW418, 3AW=    VW6, 0O      V61.5                        // 两个入口取或=      V61.5LDN    V61.5JMP    1                           // 任一条件不满足 → 不启动// 条件满足 → 启动 S4 转液LD     V61.5S      Q0.3, 1                     // 开阀BLD     V61.5R      T49, 1LD     SM0.0TON    T49, VW288                  // 【v2.3修复】S4 实测计时,PT=VW288独立地址                                   // (原VW290被FC4 Modbus任务状态机占用,每周期改写,计时不确定)// 置 VW418=4 (上缸已转移)LD     V61.5MOVW   4, VW418JMP    2
LBL    1LBL    2// 注: 条件不满足时 S/R/计时/赋值指令全部不执行, FC31 诊断空转, 等待下一周期

// 【v2.2 兼容保留】S4 等待超时逻辑(下缸未排空时使用)// [已修复 v2.2] 用 V61.6 缓存 S4 等待条件,避免 LPS/LPP+NOT 配合下的栈空// v2.2 仍保留 V303.2 报警机制(仅提示不强制 S_ERROR)// 与 v2.1 区别: 增加"上缸配完"判断(原版只看 V1.7)LD     SM0.0AW=    VW2, 5// 启动条件:V1.7=1(下缸未空) AND VW418=3(上缸配完)A      V1.7AW=    VW418, 3=      V61.6LDN    V61.6JMP    3// 下缸未空,启动 T61 等待计时LD     V61.6MOVR   VD448, VD324                // VD_S4WaitTimeout*R     10.0, VD324ROUND  VD324, AC0MOVW   AC0, VW286                  // T61 PTLD     V61.6R      T61, 1LD     SM0.0TON    T61, VW286                  // S4 等待超时计时// 每秒累加 VD_S4Wait_Time (T62 1s 脉冲)LD     V61.6R      T62, 1LD     SM0.0TON    T62, 10LD     T62EU+R     1.0, VD444                  // VD_S4Wait_Time + 1sR      T62, 1// 超时报警LD     T61S      V303.2, 1                   // M_Alarm_S4TransferWaitTimeoutJMP    4
LBL    3LBL    4

// 调用阀B诊断LD     SM0.0CALL ValveB_Diag

// 检查阀B诊断结果 + S4 完成动作// [已修复 v2.2] 用 V61.7 缓存诊断完成条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空// v2.2 关键改动:完成时切 M16.0 = NOT M16.0(双倒计时器切换),写 VD116 (S6_actual 滚动)//   注: 首轮时 VD116 存 S4 实测时长,后续轮次存 S6 实测时长(用于 FC40 S6 触发阈值)LD     SM0.0AB=    VB268, 1                    // 阀B诊断正常完成(VB268=1)=      V61.7LDN    V61.7JMP    10                          // 未完成 → 跳到 NETWORK 4 末尾// 诊断完成 → 执行 S4 完成动作// 【v2.3修复】先读T49当前值再复位(R在前读到的恒为0)LD     V61.7MOVW   T49, AC0                    // T49 当前值(100ms 时基)ITD    AC0, VD444                  // → DINTDTR    VD444, VD444/R     10.0, VD444                  // 【v2.3.6】100ms时基→秒                // → REAL(原值秒)MOVR   VD444, VD116                // VD116 = S4 实测秒(首轮作 S6 默认)LD     V61.7R      T49, 1// 置下缸状态=满LD     V61.7S      V1.7, 1// 记录下缸变满时间戳LD     V61.7TODR   VB900MOVB   VB900, VB10MOVB   VB901, VB11MOVB   VB902, VB12MOVB   VB903, VB13MOVB   VB904, VB14MOVB   VB905, VB15MOVB   VB906, VB16MOVB   VB908, VB17// 下缸实验时长清零LD     V61.7MOVR   0.0, VD178                  // VD_S5_Elapsed 清零LD     V61.7R      M10.7, 1                    // 清预规划标志// S4 等待计时清零LD     V61.7R      T61, 2                     // 清 T61+T62 (连续2个定时器)LD     V61.7MOVR   0.0, VD444                  // VD_S4Wait_Time 清零(恢复原始中间变量用途)LD     V61.7R      V303.2, 1                   // 清 S4 等待超时报警// 【v2.3删除】原"切双倒计时器标记 M16.0 = NOT M16.0"已删://   M16.0 全程序仅在 FC17 S6 完成时切换一次(原S4/S6各切一次导致每周期翻转两次)// 【v2.3删除】原"触发下一轮 S1 脉冲 S M16.1"已删://   下一轮 S1 由 FC40 按 Elapsed>=T_cycle-Prep_Needed 触发(VW418=4 门控);//   此处置位会使上缸刚置"已转移"就立即启动下一轮,破坏24h周期约束// 状态转移 S4→S5LD     V61.7MOVW   6, VW2LBL    10

// 注: 漫溢保护、四态诊断、开关到位、超时保护全部由 FC31 统一处理// 注: 【v10.4硬件变更】下缸NC球阀已去除,FC31漫溢保护仅关阀B,不再操作Q0.6// 注: DT 时间戳格式需与 S7-200 SMART 的 DT 数据类型对齐// 注: 断电恢复由 FC0 统一处理,VW2=5 (S4 阀B动作中断) 时 FC0 转 S_ERROR
// ============================================================// 文件结束// ============================================================

LBL    2
LD     SM0.0
AW=    VW2, 5
A      V1.7
AW=    VW418, 3
=      V61.6
LDN    V61.6
JMP    3
LD     V61.6
MOVR   VD448, VD324
*R     10.0, VD324
ROUND  VD324, AC0
MOVW   AC0, VW286
LD     V61.6
R      T61, 1
LD     SM0.0
TON    T61, VW286
LD     V61.6
R      T62, 1
LD     SM0.0
TON    T62, 10
LD     T62
EU
+R     1.0, VD444
R      T62, 1
LD     T61
S      V303.2, 1
JMP    4
LBL    3
LBL    4
LD     SM0.0
CALL   SBR17
LD     SM0.0
AB=    VB268, 1
=      V61.7
LDN    V61.7
JMP    10
LD     V61.7
MOVW   T49, AC0
ITD    AC0, VD444
DTR    VD444, VD444
/R     10.0, VD444
MOVR   VD444, VD116
LD     V61.7
R      T49, 1
LD     V61.7
S      V1.7, 1
LD     V61.7
TODR   VB900
MOVB   VB900, VB10
MOVB   VB901, VB11
MOVB   VB902, VB12
MOVB   VB903, VB13
MOVB   VB904, VB14
MOVB   VB905, VB15
MOVB   VB906, VB16
MOVB   VB908, VB17
LD     V61.7
MOVR   0.0, VD178
LD     V61.7
R      M10.7, 1
LD     V61.7
R      T61, 2
LD     V61.7
MOVR   0.0, VD444
LD     V61.7
R      V303.2, 1
LD     V61.7
MOVW   6, VW2
LBL    10
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S5_Run:SBR11
TITLE=// ============================================================
// // 文件: FC16_State_S5_Run.stl
// // 功能: S5 实验运行中 (VW2=6)
// // Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-8 节奏纠偏)
// // 说明: v2.2 S5 仅负责:
// //       1. 下缸满计时 VD_S5_Elapsed 累加
// //       2. 实验时长累加 VD_ExperimentDuration_Accum
// //       3. 换水周期到达转 S6 (VD_S5_Elapsed >= 阈值, 阈值 = 86400/VD414 - VD426 - VD430)
// //       4. 实验时长达标转 S7
// //   v2.2 删除:
// //       - 原三层纠偏预规划 (VD_CycleSetpoint×60 触发)
// //       - 启动 VW2=1 (上缸配液) 触发逻辑 (改由 FC40 触发下一轮 S1)
// //       - VD354 / VW182 / VW184 / VD112 / VD150 / VD154 引用
// //       - M10.7 预规划标志 (改由 FC40 M16.1 替代)
// // ============================================================
// 
BEGIN
Network 1 
//  [已修复 v2.2] 删除 VD178 累加逻辑,统一由 FC40 双倒计时器管理周期
//  注: VD178 保留清零/初始化,仅作兼容显示,不再参与控制
//  实验时长累加(仅下缸=满期间,每分钟+1)
//  VD_ExperimentDuration_Accum(VD366)每分钟+1
LD     SM0.4                       // 系统分时钟(1min周期)
A      V1.7                         // 且下缸=满
EU                                  // 【v2.3.6修复2026-09-30】每满1分钟一脉冲; 原T47每扫描被R复位实测100Hz,VD366快100倍
+R     1.0, VD366                    // VD_ExperimentDuration_Accum + 1(分钟)


// [已修复 v2.2] 删除 S5→S6 的 VD178 触发逻辑,统一由 FC40 双倒计时器写 VW2=7


// 实验时长达标 - 转 S7 实验结束
// VD_ExperimentDuration_Accum >= VD_ExperimentTarget → 实验结束
// 同时检查换水次数: VW400 >= VD414 (24h 换水目标次数)
LD     SM0.0
LPS
AR>=   VD366, VD24                  // 累计时长 >= 目标时长(min)
ITD    VW400, AC0                   // 换水次数 INT → DINT 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】
DTR    AC0, AC0                     // → REAL
AR>=   AC0, VD414                   // 【v2.2 新增】换水次数 >= 目标次数
R      T41, 1                      // 停周期计时
R      T60, 1                      // 停下缸满计时器
R      M10.7, 1                    // 清预规划标志
MOVW   8, VW2                      // →S7 (VW2=8)
LPP


// 注: v2.2 S5 不再调 FC40 预规划(三层纠偏已删除)
// 注: v2.2 S5 不再触发 VW2=1(上缸配液,改由 FC40 M16.1 触发下一轮 S1)
// 注: v2.2 S5 不再调用 RhythmCorrection (FC40 改由 OB1 顶层调度,见 OB1 NET 6.5)
// 注: 周期阈值 VD186 在每周期 OB1 NET 6.5 调 FC40 时计算并刷新
// 注: HMI 手动停止命令由 FC2 统一处理(S1~S6 均响应),FC16 不再单独处理
// 注: 断电恢复由 FC0 统一处理,VW2=6 (S5 无阀门动作) 时 FC0 保持 S5 并重算 VD_S5_Elapsed

// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S6_Drain:SBR12
TITLE=// ============================================================
// // 文件: FC17_State_S6_Drain.stl
// // 功能: S6 下缸排水 (VW2=7)
// // Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-7 阀门诊断)
// // 说明: v2.2 S6 完成后状态转移按 VW418 分支:
// //       - VW418=3 (上缸已配完) + 结束条件满足 → S7
// //       - VW418=3 (上缸已配完) + 结束条件未满足 → S4 (VW2=5, 启动转移) + VW400+1 + M16.0 切
// //       - VW418≠3 (上缸未配完) → 保持等待,不报警
// //       后续下一轮 S1 由 FC40 (M16.1 触发条件) 在 FC15 S4 完成后切 M16.0 时启动
// // 【v10.4硬件变更】VW276=VD_Timeout_ValveC(VD54)×10、VW284=VD_Delay_ValveC_Verify(VD472)×10【2026-09-24由VD60迁来】,
// //       由本FC计算写入,供FC32(阀C诊断)作T56/T57/T58/T101的PT
// // ============================================================
BEGIN
Network 1 
//  S6 首次进入动作 - 开阀C
//  [已修复 v2.2] 用 V62.0 缓存 EU 结果,避免 LPS/LPP 内 S/R 链栈空
LD     M10.7                       // S6 首次进入脉冲(FC16 NET 3 触发 M10.7 后)
EU=      V62.0LD     V62.0S      Q0.4, 1                      // 开阀CLD     V62.0R      T42, 1LD     SM0.0TON    T42, 32767LD     V62.0MOVB   1, VB264LD     V62.0MOVB   0, VB265LD     V62.0MOVW   0, VW270// 计算 VD_Timeout_ValveC(VD54)×10 转换值LD     V62.0MOVR   VD54, VD328*R     10.0, VD328ROUND  VD328, AC0MOVW   AC0, VW276// 计算 VD_Delay_ValveC_Verify(VD472)×10 转换值【v10.4硬件变更新增】// 【2026-09-24迁移】原VD60废弃：VB60~VB63与v2.2修复的V60.x~V63.x EU缓存位区重叠,//   每扫描周期被各FC的"= V6x.x"线圈重写, 浮点值闪变/变NaN(位型污染), 迁至VD472(全程序无占用)LD     V62.0MOVR   VD472, VD328*R     10.0, VD328ROUND  VD328, AC0MOVW   AC0, VW284

// 调用阀C诊断LD     SM0.0CALL ValveC_Diag

// 检查阀C诊断结果// [已修复 v2.2] 用 V62.1 缓存诊断完成条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空LD     SM0.0AB=    VB270, 1                    // 阀C诊断正常完成(VB270=1)=      V62.1LDN    V62.1JMP    10                          // 未完成 → 跳过// 【v2.3修复】先读T42当前值再复位(R在前读到的恒为0)LD     V62.1MOVW   T42, AC0ITD    AC0, VD444                  // → DINTDTR    VD444, VD444/R     10.0, VD444                  // 【v2.3.6】100ms时基→秒                // → REAL(原值秒)LD     V62.1MOVR   VD444, VD116                // VD116 = S6 实测秒(后续轮次用)LD     V62.1R      T42, 1                      // 停S6计时(读后复位)LD     V62.1R      V1.7, 1                     // 【v2.3修复】排水完成→下缸=空                                   // (原无任何FC在S6完成时清V1.7, 下一轮S4的"AN V1.7"                                   //  永不满足, 换水循环在第二轮起卡死)LBL    10

// 排水完成 → 状态转移 (v2.2 按 VW418 分支)//// 情况 1: 上缸已配完 (VW418=3) + 结束条件满足 → S7LD     SM0.0AW=    VW418, 3                    // 上缸已配完AW=    VW6, 0                      // 无报警(FC3 管理)LPSAR>=   VD366, VD24                 // 实验时长累计 >= 目标(min)LPPLPSITD    VW400, AC0                  // 换水次数 INT → DINT 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】DTR    AC0, AC0                    // → REALAR>=   AC0, VD414                  // 换水次数 >= 目标LPPALD                                // 两个结束条件同时满足NOTJMP    11                          // 不满足 → 检查情况 2MOVW   8, VW2                      // → S7JMP    13                          // 跳到末尾
LBL    11// 情况 2: 上缸已配完 (VW418=3) + 结束条件未满足 → S4 + 计数 + 切计时器LD     SM0.0AW=    VW418, 3                    // 上缸已配完AW=    VW6, 0                      // 无报警NOTJMP    12                          // 上缸未配完 → 情况 3MOVW   5, VW2                      // → S4 (转移)INCW   VW400                       // 换水计数 +1 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】LD     M16.0NOT=      M16.0                       // 切双倒计时器标记JMP    13
LBL    12// 情况 3: 上缸未配完 (VW418≠3) → 保持等待,不报警// 无动作,等上缸配完自然进 S4// 注: 此时 V1.7=0(已排空)但上缸未配完,系统空转等待//      不会触发 24h 换水次数超时报警(那是 FC40 VD248/VD252 >= T_cycle 才报)
LBL    13

// 注: 【v10.4硬件变更】FC32已改为「液位低位+VD_Delay_ValveC_Verify延时验证」判定排水完成//      开关到位、超时保护仍由 FC32 统一处理// 注: VD_S6_Rolling 滚动平均算法由 FC17 直接覆盖(简单实现)// 注: 断电恢复由 FC0 统一处理,VW2=7 (S6 阀C动作中断) 时 FC0 转 S_ERROR// 注: 【v2.2】原"实验未结束 → S5,已结束 → S7"二元判断改为三元判断(增加上缸配完分支)
// ============================================================// 文件结束// ============================================================

LD     SM0.0
CALL   SBR18
LD     SM0.0
AB=    VB270, 1
=      V62.1
LDN    V62.1
JMP    10
LD     V62.1
MOVW   T42, AC0
ITD    AC0, VD444
DTR    VD444, VD444
/R     10.0, VD444
LD     V62.1
MOVR   VD444, VD116
LD     V62.1
R      T42, 1
LD     V62.1
R      V1.7, 1
LBL    10
LD     SM0.0
AW=    VW418, 3
AW=    VW6, 0
LPS
AR>=   VD366, VD24
LPP
LPS
ITD    VW400, AC0
DTR    AC0, AC0
AR>=   AC0, VD414
LPP
ALD
NOT
JMP    11
MOVW   8, VW2
JMP    13
LBL    11
LD     SM0.0
AW=    VW418, 3
AW=    VW6, 0
NOT
JMP    12
MOVW   5, VW2
INCW   VW400
LD     M16.0
NOT
=      M16.0
JMP    13
LBL    12
LBL    13
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_S7_End:SBR13
TITLE=// ============================================================
// // 文件: FC18_State_S7_End.stl
// // 功能: S7实验结束 (VW2=8)
// // Story: AQEX-6 状态机骨架
// // 说明: 实验完成，状态锁定，提示人工按系统复位后回S0
// // ★ v10重大变更: S7彻底屏蔽V0.0(CMD_Start),只响应I0.3(系统复位按钮)
// //   原实现V0.0↑→回S0,但FC10启动还需再按一次,两次按钮才能启动
// //   且V0.0在S7语义不干净(按钮名叫"启动"实际是"清计数器回S0")
// //   改后:S7唯一出口是物理I0.3系统复位按钮,回S0后V0.0正常工作
// //   实验结束提示由HMI侧用 VW2=8 条件弹窗（原V301.7为预留扩展位,已废弃）
// // ============================================================
// 
BEGIN
Network 1 
//  S7进入动作 - 安全停机
LD     SM0.0
// 复位Q0.0~Q0.6(泵/阀),Q0.7/Q8.0报警声光由FC3统一管理,避免与FC3双写导致闪亮
// 【v10.4硬件变更】Q0.6(下缸NC阀)已去除,保留未使用;R Q0.0,7清零无害
R      Q0.0, 7                     // 泵停、阀A/B/C关,保留Q0.7
// 停止实验时长累加(VD_ExperimentDuration_Accum锁定最终值)
R      T47, 1                      // 停1分钟基准计时
// 置实验结束标志(供S6判断是否走最终排水→S7路径)
S      M10.6, 1


// S7唯一出口 — 物理系统复位按钮I0.3（原 NETWORK 3，NETWORK 2 已废弃）
// 注：原 NETWORK 2 每周期 S V301.7 提示位已废弃，改为 HMI 侧用 VW2=8 条件弹窗
// v10重写: S7彻底屏蔽V0.0(CMD_Start),只响应I0.3(系统复位按钮)
// 原实现: V0.0↑→回S0 (已删除,改由I0.3负责)
// 复位条件(全部满足):
//   I1.1=OFF 急停已释放(和FC19/S_ERROR复位保持一致)
//   I0.3上升沿 系统复位按钮按下(就地面板物理按钮,非HMI软命令)
// 为什么S7用I0.3不用V0.0:
//   - V0.0语义是"启动实验",在S7里用它回S0是双重语义,不干净
//   - 改后V0.0只在S0有效,按钮语义单一
//   - 物理复位按钮比HMI软命令更安全(实验结束后强制人工确认)
LDN    I1.1                        // 急停已释放(常闭触点恢复ON=正常)
A      I0.3                        // 系统复位按钮按下
EU                                 // 上升沿(按下瞬间触发一次)
// 清实验结束标志
R      M10.6, 1
// 清握手位(由S0重新管理)
R      V1.0, 1
// 清零本次实验累计值,准备新一轮
MOVR   0.0, VD406                  // 清累计流量 (原VD364,2026-09-29迁移:与VD366重叠2字节;VD402槽被VW402(T38_PT)占)
MOVR   0.0, VD440                  // 清累计加药量
MOVR   0.0, VD372                  // 清S3剩余待加药量
// 状态回S0,后续由FC10接管
MOVW   0, VW2


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK State_Error:SBR14
TITLE=// ============================================================
// // 文件: FC19_State_Error.stl
// // 功能: S_ERROR故障锁定 (VW2=99)
// // Story: AQEX-6 状态机骨架 + AQEX-9 急停双通道+安全继电器反馈(详细实现) + AQEX-10 编址修正(V0.5→V0.7)
// // 说明: 急停或最高级报警触发后的故障锁定,强制输出安全状态
// //       继电器故障(V300.5)禁止复位,必须HMI高权限确认(V0.7)+I1.2正常后清除
// // 急停解除(I1.1=OFF,NO 触点释放)+系统复位按钮(I0.3)→回S0  v1.3 改 NO 接法
// // ============================================================
// 
// // 符号说明:
// // I1.1  : DI_EStop           急停反馈(常开 NO,OFF=正常,ON=急停触发)  v1.3 改为接 NO 触点
// // I1.2  : DI_SafetyRelay_FB  安全继电器辅助反馈(ON=动力回路已断开确认)
// // I0.3  : DI_Btn_SystemReset 系统复位按钮(无源常开点动)
// // V0.7  : CMD_SafetyRelayAck HMI高权限确认继电器故障已检修(需二次确认/高权限)
// // V300.4: M_EStop_Latch      急停触发锁存(漫溢级)
// // V300.5: M_Alarm_SafetyRelay 安全继电器故障(最高级)
// // V1.6  : M_TankA_State      上缸状态(0=空,1=满)
// // V1.7  : M_TankB_State      下缸状态(0=空,1=满)
// // VW2   : 状态机状态(FC19写0回S0)
// // VW6   : 报警码
// 
// 
BEGIN
Network 1 
//  故障态输出强制安全(与FC2 NETWORK3双保险)
//  S_ERROR态双保险:即使FC2未执行,QB0也强制安全
LD     SM0.0
MOVB   0, QB0                      // 潜水泵停/阀关/上缸NC阀失电(关闭=安全;Q0.6已去除,保留未使用)
S      Q0.7, 1                     // 报警声音(FC3管理消音)
// Q8.0灯光由FC3按报警优先级管理(急停/继电器故障=常亮)


// 继电器故障禁止复位检测
// 9.4: 继电器故障不允许任何自动恢复,必须人工检修
// V300.5=1时,即使I1.1恢复+I0.3按下,也不允许回S0
LD     V300.5                      // 继电器故障=1
JMP    1               // 跳过系统复位,转NETWORK4检查HMI确认
// V300.5=0(无继电器故障) → 继续NETWORK3系统复位


// 急停解除+系统复位按钮 → 回S0
// 复位条件(全部满足):
//   I1.1=OFF(急停按钮已释放,NO 触点恢复)
//   I0.3上升沿(系统复位按钮按下)
//   V300.5=0(NETWORK2已确认无继电器故障)
LDN    I1.1                        // 急停已释放(常开 NO 触点恢复 OFF)  v1.3 改 NO 接法
A      I0.3                        // 系统复位按钮按下
EU                                 // 上升沿(按下瞬间)
=      V61.0                       // [已修复 v2.2] 缓存 EU 结果,避免后续 R 指令链栈空
// 清急停锁存
LD     V61.0
R      V300.4, 1                   // M_EStop_Latch=0
// 清漫溢级报警(这些锁存位需系统复位清除)
// 【v10.4硬件变更】V300.3已废弃为保留位(下缸NC阀Q0.6去除),仍一并清零无害
LD     V61.0
R      V300.0, 4                   // V300.0~V300.3=0
// 【2026-09-29修复】系统复位同时清一般故障级报警位V301~V303
// 原因: 阀A开到位超时(V301.4)等报警的自动复位条件是"物理条件消失"(如I8.0=ON),
//   但阀关闭的待机态与故障态同为I8.0=OFF,条件复位永远等不到; 而FC10启动门槛要求VW6=0,
//   形成死锁(报警消不掉+无法重启)。系统复位=系统级人工确认;
//   复位后故障若仍存在会被各FC重新置位重新报警,不会丢失故障。
// 注: V303.6(周期超时)在此清位安全——VD248/252双计时器已在下方同批清零,
//   不会同扫描被FC40 NET6重报(问题#6死锁对策已具备)
LD     V61.0
R      V301.0, 8                   // 阀A类全部(V301.0~V301.7)
LD     V61.0
R      V302.0, 8                   // 阀B/C类全部(V302.0~V302.7)
LD     V61.0
R      V303.0, 8                   // 阀C/注射泵/RTC/周期超时全部(V303.0~V303.7)
// 强制上下缸状态置空(9.3:复位后上下缸状态强制置"空")
LD     V61.0
R      V1.6, 1                     // 上缸=空
LD     V61.0
R      V1.7, 1                     // 下缸=空
// ★ 2026-09-11 新增: 清阀门诊断子状态和计时器
// 与OB1停止命令同根因: FC11/FC15/FC17的AW=VW2xx,0前置条件
LD     V61.0
FILL   0, VW260, 8                 // 清 VB260~VB275 (阀A/B/C 诊断)
LD     V61.0
R      T50, 6                      // 清 T50~T55 (阀A/B 诊断计时器)
// 转S0初始化(9.3:回到S0重新开始,不支持从中断点继续)
LD     V61.0
MOVW   0, VW2                      // VW2=0(S0)
// 清报警码
LD     V61.0
MOVW   0, VW6
// 清启动命令残留,防止复位后MCGS残留V0.0=1导致立即重启动
LD     V61.0
R      V0.0, 1
// 【2026-09-29新增】清S1首次进入标志(与VW418清零配套,防止复位后S1门控残留)
LD     V61.0
R      M10.2, 1
// 停报警声音(灯光由FC3按确认流程管理)
LD     V61.0
R      Q0.7, 1
// ★ 2026-09-24 新增: 清上缸子流程状态 + 双倒计时器标志 + 定时器
//   与OB1停止命令块/SBR26同款清理, 修复"系统复位后VW418残留→上缸跳过S1自启动"
LD     V61.0
MOVW   0, VW418                     // 上缸配液子流程状态清零
LD     V61.0
MOVW   0, VW400                     // 换水计数清零
LD     V61.0
R      M16.0, 4                     // M16.0~M16.3 连续清零(双倒计时器标志+S1/S2首次进入门控)
LD     V61.0
R      T38, 1                       // 清 S2 搅拌定时器
LD     V61.0
R      T63, 1                       // 清 1s 脉冲定时器
LD     V61.0
R      T49, 1                       // 清 S4 转移计时器
LD     V61.0
MOVR   0.0, VD248                   // 清 TimerA_Elapsed
LD     V61.0
MOVR   0.0, VD252                   // 清 TimerB_Elapsed
LD     V61.0
MOVR   0.0, VD256                   // 清 TimerA 显示值
LD     V61.0
MOVR   0.0, VD244                   // 清 TimerB 显示值
JMP    2                    // 复位完成,结束


// 继电器故障HMI高权限确认清除
// 9.4: 继电器故障确认需更高权限/二次确认,通过HMI下发V0.7命令
// V0.7=1表示HMI高权限确认"继电器已检修,动力回路已验证正常"
// 此时要求I1.2=ON(反馈确实正常)才允许清除V300.5
LBL    1
LD     V0.7                        // HMI高权限确认命令(编址修正:V0.5→V0.7)
EU                                 // 上升沿(命令下发瞬间)
A      I1.2                        // 且安全继电器反馈确实正常(已检修)
R      V300.5, 1                   // 清除继电器故障报警
R      V0.7, 1                     // 清确认命令
// 注: 清除V300.5后,下一周期NETWORK2不再跳过,NETWORK3允许系统复位按钮回S0
// 注: 若I1.2仍OFF(检修未完成),V300.5保持,不允许清除


// ★ 自动解锁: S_ERROR锁死但所有报警已被自动恢复清除
// 2026-09-11 修复 AQEX-XX: FC3 NETWORK5自动恢复清一般故障报警位
//   (如V301.4阀A开到位超时→I8.0终于ON→FC3自动R V301.4)，
//   导致 VW2=99(状态机锁S_ERROR) + VW6=0(报警清零) 的状态不一致，
//   OB1 NETWORK12按VW6=0计算VB305=0(良好)，掩盖故障。
// 覆盖场景: V301.4/V301.5/V302.0/V302.1/V303.4 等所有可自恢复的一般故障级
// 解锁条件(全部满足):
//   VW2=99(确实锁在S_ERROR) AND VW6=0(报警系统已清零)
//   AND V300.4=0(非急停锁存) AND V300.5=0(非继电器故障)
//   AND I1.1=OFF(急停按钮已释放,NO触点) AND V303.5=0(非RTC丢失)
LDW=    VW2, 99
AW=     VW6, 0
AN      V300.4               // 不是急停锁存
AN      V300.5               // 不是继电器故障
AN      I1.1                 // 急停按钮已释放(NO触点OFF)
AN      V303.5               // 不是RTC丢失(RTC不会被自动清,保险检查)
// ★ 2026-09-11 新增: 清阀门诊断子状态和计时器(同OB1停止/系统复位根因)
FILL    0, VW260, 8
R       T50, 6
// ★ 2026-09-24 新增: 清上缸子流程+双倒计时器(同系统复位路径根因, 防止VW418残留自启动)
MOVW    0, VW418             // 上缸配液子流程状态清零
MOVW    0, VW400             // 换水计数清零
R       M16.0, 4             // M16.0~M16.3 连续清零(双倒计时器标志+S1/S2首次进入门控)
R       M10.2, 1             // 【2026-09-29新增】清S1首次进入标志(与VW418清零配套)
R       T38, 1               // 清 S2 搅拌定时器
R       T63, 1               // 清 1s 脉冲定时器
R       T49, 1               // 清 S4 转移计时器
MOVR    0.0, VD248           // 清 TimerA_Elapsed
MOVR    0.0, VD252           // 清 TimerB_Elapsed
MOVR    0.0, VD256           // 清 TimerA 显示值
MOVR    0.0, VD244           // 清 TimerB 显示值
// 【2026-09-29修复】自动解锁同步清一般故障级报警位V301~V303(同系统复位路径根因)
R       V301.0, 8            // 阀A类全部
R       V302.0, 8            // 阀B/C类全部
R       V303.0, 8            // 阀C/注射泵/RTC/周期超时全部(VD248/252上方已清零,不会同扫描重报)
MOVW    0, VW2               // 自动回S0
MOVW    0, VW6               // 清报警码
R       Q0.7, 1              // 关报警声音
// 注: 不清V1.6/V1.7(缸状态),让FC0/FC10正常处理
// 注: 不碰V300.4/V300.5,上面AN已确认它们为0
JMP     2                    // → FC19结束


// FC19结束
LBL    2


// 注: 继电器故障(V300.5)优先级最高,禁止系统复位按钮清除
// 注: 继电器故障清除必须HMI高权限V0.7+I1.2双确认,防止误清除
// 注: 系统复位后上下缸状态强制置空,从S0重新开始(不支持断点续运行)
// 注: Q8.0报警灯光由FC3统一管理,本FC不操作


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ManualControl:SBR15
TITLE=// ============================================================
// // 文件: FC20_ManualControl.stl
// // 功能: 手动控制FC (由OB1仅在S0态调用)
// // Story: AQEX-60 手动控制页
// // 说明:
// //       由OB1在S0态调用；非S0态不调用，避免覆盖其他状态输出
// //       手动命令为脉冲方式(按1松0),由M位锁存输出状态
// //       手动开阀A自动打开串联的上缸NC球阀(Q0.5),关阀自动关闭
// //       【v10.4硬件变更】下缸NC球阀Q0.6已去除(保留未使用),阀B不再联动NC阀
// // 修复记录:
// //   P1-改为M位锁存,解决FC10每周期清QB0导致手动输出无法保持的问题
// //   P2-NC球阀串联主路,手动开阀时自动打开对应NC阀(现仅阀A→Q0.5)
// //   P3-【重大修复2026-09-03】手动命令位从V2.4~V3.7迁移至V306.0~V307.3
// //      原地址V2.4~V3.7与VW2(状态机当前状态)物理地址完全重叠(VB2+VB3),
// //      写入任何手动命令位会直接改写VW2,触发非预期状态切换(如V3.1=1→VW2=2→S2预循环→两台泵同时启动)
// //      新地址V306.0~V307.3落在地址表"预留扩展区",与VW2/VW6等状态/报警字无冲突
// //   P4-【2026-09-03 调试模式】新增V303.5调试模式开关,=1时跳过阀B/阀C的液位联锁(V1.6/V1.7)
// //      联机调试时上下缸无水,V1.6/V1.7=0,导致阀B/阀C手动永远卡死
// //      调试期间V303.5置1可绕过联锁直接开阀;生产前必须V303.5=0(默认)
// // ============================================================
// 
// // 符号表:
// // V306.0 : CMD_Manual_ValveA_Open  手动开阀A   (旧地址V2.4,2026-09-03迁移避开VW2重叠)
// // V306.1 : CMD_Manual_ValveA_Close 手动关阀A   (旧地址V2.5)
// // V306.2 : CMD_Manual_ValveB_Open  手动开阀B   (旧地址V2.6)
// // V306.3 : CMD_Manual_ValveB_Close 手动关阀B   (旧地址V2.7)
// // V306.4 : CMD_Manual_ValveC_Open  手动开阀C   (旧地址V3.0)
// // V306.5 : CMD_Manual_ValveC_Close 手动关阀C   (旧地址V3.1)
// // V306.6 : CMD_Manual_Pump1_On     手动启泵1   (旧地址V3.2)
// // V306.7 : CMD_Manual_Pump1_Off    手动停泵1   (旧地址V3.3)
// // V307.0 : CMD_Manual_Pump2_On     手动启泵2   (旧地址V3.4)
// // V307.1 : CMD_Manual_Pump2_Off    手动停泵2   (旧地址V3.5)
// // V309.0 : M_DebugMode_BypassInterlock 调试模式-跳过液位联锁(0=生产/1=调试,默认0,调试结束后必须清0)
// // V1.6   : STA_TankA_State         上缸液位状态(自动流程FC12置1/FC15清0)
// // V1.7   : STA_TankB_State         下缸液位状态(自动流程FC15/FC16维护)
// // Q0.2   : DO_ValveA 阀A输出
// // Q0.3   : DO_ValveB 阀B输出
// // Q0.4   : DO_ValveC 阀C输出
// // Q0.5   : DO_NCValve_Top NC球阀-上缸(常闭型,得电打开)
// // Q0.6   : 保留/未使用【v10.4硬件变更:下缸NC球阀已去除,程序不再操作】
// // M13.0  : 阀A手动锁存(=1开阀A,=0关阀A)
// // M13.1  : 阀B手动锁存
// // M13.2  : 阀C手动锁存
// // M13.3  : 泵1手动锁存
// // M13.4  : 泵2手动锁存
// // ============================================================
// 
BEGIN
Network 1 
//  手动阀A控制(开/关)
LD     SM0.0
A      V306.0
EU
S      M13.0, 1
R      V306.0, 1

LD     SM0.0
A      V306.1
EU
R      M13.0, 1
R      V306.1, 1

// 手动阀B控制(开/关)
// 联锁条件: 上缸满(V1.6) AND 下缸空(V1.7=0) [生产]
// 调试模式: V309.0=1 跳过联锁(空缸调试用,生产前必须V309.0=0)
LD     SM0.0
A      V306.2
EU
LD     V1.6
AN     V1.7
O      V309.0
ALD
S      M13.1, 1
R      V306.2, 1

LD     SM0.0
A      V306.3
EU
R      M13.1, 1
R      V306.3, 1

// 手动阀C控制(开/关)
// 联锁条件: 下缸满(V1.7) [生产]
// 调试模式: V309.0=1 跳过联锁(空缸调试用,生产前必须V309.0=0)
LD     SM0.0
A      V306.4
EU
LD     V1.7
O      V309.0
ALD
S      M13.2, 1
R      V306.4, 1

LD     SM0.0
A      V306.5
EU
R      M13.2, 1
R      V306.5, 1

// 手动泵1控制(启/停)
LD     SM0.0
A      V306.6
EU
S      M13.3, 1
R      V306.6, 1

LD     SM0.0
A      V306.7
EU
R      M13.3, 1
R      V306.7, 1

// 手动泵2控制(启/停)
LD     SM0.0
A      V307.0
EU
S      M13.4, 1
R      V307.0, 1

LD     SM0.0
A      V307.1
EU
R      M13.4, 1
R      V307.1, 1

// 手动输出映射到Q点 + NC球阀自动跟随(合并)
// 在S0态用=线圈覆盖FC10_State_S0_Init中的QB0清零
LD     M13.0
=      Q0.2
LD     M13.1
=      Q0.3
LD     M13.2
=      Q0.4
LD     M13.3
=      Q0.0
LD     M13.4
=      Q0.1
// NC球阀自动跟随(上缸NC阀Q0.5跟随阀A)
// 【v10.4硬件变更】下缸NC阀联动已删(原 LD Q0.3 / = Q0.6),Q0.6保留未使用
LD     Q0.2
=      Q0.5

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ValveA_Diag:SBR16
TITLE=// ============================================================
// // 文件: FC30_ValveA_Diag.stl
// // 功能: 阀A诊断（差值法计量+延时验证4项并行+漫溢保护）
// // Story: AQEX-7 阀门诊断
// // 调用方: FC11(S1上缸进水)
// // 说明: 阀A不使用四态诊断，采用差值法+延时验证
// //       诊断子状态VW260: 0空闲/1等开到位/2开启完成/3运行中/5关闭后验证
// //
// //   修复记录:
// //   P1 - MOVR/-R 替换 MOVD/-D: 流量计数据为REAL浮点,之前用双整数指令导致VD90=NAN
// //   P2 - 单NETWORK合并: 所有JMP/LBL在同一NETWORK内,解决STEP7导入跨NETWORK跳转失效
// //   P3 - I8.0 去掉EU: 子状态1→2改用常开触点,PLC冷启动时阀已开到位也能正常进入子状态2
// //   P4 - 关阀快照MOVD改MOVR: 语义一致,REAL数据用MOVR搬运
// //   P5 - 子状态5 RLO修复: 比较指令(AR>/AR<=)会切断RLO,改用LD T51 + LPS/ALD维持AND链
// //   P6 - 进水量达标后补关Q0.5(NC球阀),避免S1→S2后NC阀常开
// // ============================================================
// 
// // 符号说明:
// // VW260 : Diag_State_A     阀A诊断子状态
// // VW266 : Diag_Result_A    阀A诊断结果(0进行中/1正常/2故障)
// // VD308 : VD_FlowMeter_CloseSnapshot  阀A关阀瞬间流量计快照(保留供HMI查看)
// // VD312 : 已删除(原阀A内漏差值,2026-09-14废弃)
// // VD316 : 目标进水量(HMI设定)
// // T50   : 阀A开到位超时(100ms时基)
// // T51   : 阀A关阀后延时验证(100ms时基)
// // T52   : 开到位但无流2s确认(100ms时基)
// // I0.0  : 流量开关A(有流=ON)
// // I0.5  : 液位计A高位(漫溢=ON)
// // I8.0  : 阀A开到位反馈
// // I8.1  : 阀A关到位反馈
// // Q0.2  : 阀A(电动球阀)
// // Q0.5  : NC球阀-上缸
// 
// 
BEGIN
Network 1 
//  ============================================================
//  NETWORK 1 - 单NETWORK版 FC30
//  所有JMP/LBL在同一NETWORK内,避免STEP7导入后跳转失效
//  ============================================================
//  ========== 第一部分: 漫溢保护(优先级最高,全程监控) ==========
LD     I0.5                        // 液位计A高位=漫溢
S      V300.0, 1                   // M_Alarm_Overflow_AHigh
S      V300.2, 1                   // M_Alarm_NCValve_Top
R      Q0.5, 1                     // 关NC球阀(切断水流)
R      Q0.2, 1                     // 关阀A
MOVW   99, VW2                     // 转S_ERROR
MOVB   2, VB266                    // Diag_Result_A=2故障
JMP    1                           // 跳到结束


// ==== Part 2: Sub-state dispatch (VW260 word) ====
// VW260 word storage: MOVW write + LDW= compare (matches FC31/FC32)
//
LDW=   VW260, 0
JMP    2                           // 子状态0: 空闲
LDW=   VW260, 1
JMP    3                           // 子状态1: 等开到位
LDW=   VW260, 2
JMP    4                           // 子状态2: 等流量开关
LDW=   VW260, 3
JMP    5                           // 子状态3: ★运行中算VD90★
LDW=   VW260, 5
JMP    6                           // 子状态5: 关阀后延时验证
JMP    1                           // 兜底: 非法状态跳到结束


// ========== 第三部分: 子状态0 - 空闲 ==========
LBL    2
// 等待FC11触发置VW260=1, 无额外动作
JMP    1


// ========== 第四部分: 子状态1 - 等待开到位 ==========
LBL    3
// T50超时计时(PT=VW278, 由FC11计算VD358×10写入)
LD     SM0.0
TON    T50, VW278

// I8.0开到位反馈=ON → 转子状态2
// ★P3修复: 去掉EU(上升沿),改用常开触点
//   正常: 阀A打开后I8.0从OFF→ON,直接触发
//   异常: PLC冷启动时阀已开到位(I8.0本来就是ON),也能立即进入子状态2
LD     I8.0
MOVW   2, VW260                    // VW260=2
R      T50, 1                      // 复位超时计时
JMP    1

// T50超时 → 开到位超时报警
LD     T50
S      V301.4, 1                   // M_Alarm_ValveA_OpenTimeout
MOVW   99, VW2
MOVB   2, VB266
JMP    1


// ========== 第五部分: 子状态2 - 等待流量开关 ==========
LBL    4
// I0.0流量开关A=ON → 正常有流, 转子状态3运行中
LD     I0.0
MOVW   3, VW260                    // VW260=3运行中
JMP    1

// 开到位但无流 → 加2s延时确认避免瞬时波动
LD     I8.0                        // 阀确实已开到位
AN     I0.0                        // 但无流量
TON    T52, 20                     // 2s确认(20×100ms)
LD     T52
S      V301.5, 1                   // M_Alarm_ValveA_OpenNoFlow
MOVW   99, VW2
MOVB   2, VB266
JMP    1


// ========== 第六部分: 子状态3 - ★运行中差值法持续计量★ ==========
LBL    5
// ★P1修复: 用MOVR/-R实数指令计算进水量(原MOVD/-D导致NAN)
// VD_Current_InletVolume(VD90) = VD86(当前累计) - VD82(开启快照)
LD     SM0.0
MOVR   VD86, AC0                   // ★MOVR: 实数搬运
-R     VD82, AC0                   // ★-R: 实数减法
MOVR   AC0, VD90                   // 当前进水量

// 进水量达标 → 关阀A + 快照关阀瞬间流量计值 + 转子状态5
// [已修复 v2.2] 用 V63.0 缓存达标条件,避免 LPS/LPP 内 R 指令链栈空
LD     SM0.0
AR>=   VD90, VD316                 // 当前进水量 ≥ 目标进水量
=      V63.0
LD     V63.0
R      Q0.2, 1                     // 关阀A
LD     V63.0
R      Q0.5, 1                     // 关上缸NC球阀
LD     V63.0
MOVR   VD86, VD308                 // VD_FlowMeter_CloseSnapshot
LD     V63.0
MOVW   5, VW260                    // VW260=5(关闭后验证)
LD     V63.0
R      T51, 1                      // ★修复2026-09-30: 进关阀验证前清T51残留done位(上轮报警退出后T51保持done,会跳过验证窗口立即误判)
LD     V63.0
R      T52, 1                      // 复位开到位无流确认计时
JMP    1


// ========== 第七部分: 子状态5 - 关阀后延时验证(4项并行) ==========
LBL    6
// T51延时验证计时(PT=VW280, 由FC11计算VD66×10写入)
LD     SM0.0
TON    T51, VW280

// --- 延时到达后3项并行校验 ---
// ★ 2026-09-14: 删除原校验2(流量计差值法内漏,V301.1),仅保留流量开关/关到位相关校验
//   关键修复: 每项必须在 T51 到达后才置位, 且用 ALD 维持 RLO 串联,
//   防止比较指令(AR>/AR<=)切断 RLO 导致误触发

// 校验1: 关阀后仍有流(流量开关A=ON)
LD     T51                         // RLO=T51
A      I0.0                        // RLO=T51 AND I0.0
S      V301.0, 1                   // M_Alarm_ValveA_CloseFlow

// 校验2: 关到位反馈超时(I8.1=OFF)
LD     T51
AN     I8.1                        // RLO=T51 AND (NOT I8.1)
S      V301.2, 1                   // M_Alarm_ValveA_CloseTimeout

// 校验3: 关到位但仍有流(交叉验证)
LD     T51
A      I8.1                        // RLO=T51 AND I8.1
A      I0.0                        // RLO=T51 AND I8.1 AND I0.0
S      V301.3, 1                   // M_Alarm_ValveA_CloseLeak


// --- 校验结果判定 ---
// 3项全通过: T51到 AND 流量开关OFF AND 关到位ON
// 用 LPS/ALD 维持 AND 链
LD     T51
LPS
AN     I0.0                        // RLO=T51 AND (NOT I0.0)
LPS
A      I8.1                        // RLO=I8.1
ALD                                // (NOT I0.0) AND I8.1
ALD                                // AND T51
// → 诊断正常完成
MOVW   0, VW260                    // VW260=0空闲(等待下轮)
MOVB   1, VB266                    // Diag_Result_A=1正常完成
R      T51, 1                      // 复位延时计时
JMP    1
LPP
LPP

// 任一项报警 → 转S_ERROR
// 先OR 3个报警标志, 最后再 AND T51, 防止旧的报警位在T51复位后误触发
LD     V301.0                      // RLO=V301.0
O      V301.2
O      V301.3
A      T51                         // RLO=(任意报警) AND T51
MOVW   99, VW2                     // 转S_ERROR
MOVB   2, VB266                    // 故障
R      T51, 1                      // ★修复2026-09-30: 报警退出同步复位T51,防残留done位污染下一轮S1
JMP    1


// ========== 结束 ==========
LBL    1


// ============================================================
// 文件结束
// 说明:
//   1. FC11调用本FC前需置VW260=1启动诊断
//   2. FC11检查VW266: 0=进行中等待, 1=正常完成转S2, 2=故障(已转S_ERROR)
//   3. VD316(目标进水量)由HMI设定或SBR25用户默认覆盖写入
//   4. VW278=T50×10(开到位超时), VW280=T51×10(延时验证), 由FC11计算写入
//   5. 2026-09-14: 已删除流量计差值法内漏判定(V301.1),保留VD308快照供查看
//   6. 所有JMP/LBL在单NETWORK内, 避免STEP7导入后跳转失效(P2修复)
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ValveB_Diag:SBR17
TITLE=// ============================================================
// // 文件: FC31_ValveB_Diag.stl
// // 功能: 阀B诊断（四态诊断+开关到位+超时保护+漫溢保护）
// // Story: AQEX-7 阀门诊断 + v10.4 硬件变更(去下缸NC阀)
// // 调用方: FC15(S4上→下转移)
// // 说明: 阀B四态诊断(流量开关B+液位计A低位)
// //       【v10.4 硬件变更 2026-09-20】下缸NC球阀Q0.6已去除(保留未使用),
// //       漫溢保护不再联动NC阀,仅关阀B;报警码13/V300.3废弃(保留位)
// //       诊断子状态VW262: 0空闲/1等开到位/2开启完成/3运行中/4等关到位
// // ============================================================
// 
// // 符号说明:
// // VW262 : Diag_State_B     阀B诊断子状态
// // VW268 : Diag_Result_B    阀B诊断结果(0/1/2)
// // T53   : 阀B开到位超时
// // T54   : 阀B流量开关超时保护
// // T55   : 阀B关到位超时
// // I0.1  : 流量开关B
// // I0.6  : 液位计A低位(上缸排空)
// // I0.7  : 液位计B高位(下缸漫溢)
// // I8.2  : 阀B开到位反馈
// // I8.3  : 阀B关到位反馈
// // Q0.3  : 阀B
// 
// 
BEGIN
Network 1 
//  ============================================================
//  NETWORK 1 - 单NETWORK版 FC31
//  P2修复: 单NETWORK合并, 所有JMP/LBL在同一NETWORK内,避免STEP7导入后跳转失效
//  ============================================================
//  漫溢保护（全程，优先级最高）
//  液位计B高位=ON立即报警+关阀B+转S_ERROR
//  【v10.4硬件变更】下缸NC球阀已去除,漫溢保护不再联动NC阀(原S V300.3/R Q0.6已删)
LD     I0.7
S      V300.1, 1                   // M_Alarm_Overflow_BHigh
R      Q0.3, 1                     // 关阀B
MOVW   99, VW2
MOVB   2, VB268                    // 故障
JMP    1


// 诊断子状态调度
LDW=   VW262, 0
JMP    2
LDW=   VW262, 1
JMP    3
LDW=   VW262, 2
JMP    4
LDW=   VW262, 3
JMP    5
LDW=   VW262, 4
JMP    6
JMP    1


// ---- 子状态0: 空闲 ----
// S0空闲
LBL    2
JMP    1


// ---- 子状态1: 等待开到位 ----
// S1等待开到位
LBL    3
// T53开到位超时 + T54流量开关超时(两套独立判据)
LD     SM0.0
TON    T53, VW274                  // PT=VD_Timeout_ValveB(VD362)×10
TON    T54, VW274                  // 流量开关超时(同参数，独立计时)

// 开到位=ON → 转S2
// [已修复 v2.2] 用 V63.1 缓存 EU 结果,避免 R 指令链栈空
LD     I8.2
EU
=      V63.1
LD     V63.1
MOVW   2, VW262
LD     V63.1
R      T53, 1
LD     V63.1
R      T54, 1
JMP    1

// 开到位超时 → 报警
LD     T53
S      V302.1, 1                   // M_Alarm_ValveB_OpenTimeout
MOVW   99, VW2
MOVB   2, VB268
JMP    1

// 流量开关超时(开阀后一直无流) → 报警
LD     T54
AN     I0.1                        // 确认流量开关B仍OFF
S      V302.2, 1                   // M_Alarm_ValveB_OpenNoFlow
MOVW   99, VW2
MOVB   2, VB268
JMP    1


// ---- 子状态2: 开启完成检查 ----
// S2开启完成检查
LBL    4
// 流量开关B=ON → 正常，转S3
LD     I0.1
MOVW   3, VW262
JMP    1

// 开到位但无流 → 报警
LD     I8.2
AN     I0.1
S      V302.2, 1                   // M_Alarm_ValveB_OpenNoFlow
MOVW   99, VW2
MOVB   2, VB268
JMP    1


// ---- 子状态3: 运行中(四态诊断持续扫描) ----
// S3四态诊断
LBL    5
// 四态诊断: 流量开关B(I0.1) + 液位计A低位(I0.6)
// 状态3: 流量开关OFF + 液位低位ON → 上缸排空，关阀触发
LD     I0.6                        // 液位计A低位=ON(上缸空)
AN     I0.1                        // 且流量开关B=OFF(转移结束)
R      Q0.3, 1                     // 关阀B
MOVW   4, VW262                    // 转S4等关到位
JMP    1

// 状态4: 流量开关OFF + 液位低位OFF → 设备故障
LD     I0.1                        // 流量开关B
NOT
AN     I0.6                        // 且液位低位OFF
// 注:需排除刚开始转移时的瞬时(流量开关尚未ON)
// 简化: 直接判定状态4
S      V302.0, 1                   // M_Alarm_ValveB_Diag
MOVW   99, VW2
MOVB   2, VB268
JMP    1

// 状态1/2: 流量开关ON → 正常转移中/即将排空，继续
LD     I0.1
JMP    1


// ---- 子状态4: 等待关到位 ----
// S4等待关到位
LBL    6
// T55关到位超时
LD     SM0.0
TON    T55, VW274                  // PT=VD_Timeout_ValveB×10

// 关到位=ON AND 流量开关=OFF → 正常完成
LD     I8.3
AN     I0.1
MOVW   0, VW262                    // VW262=0空闲
MOVB   1, VB268                    // Diag_Result_B=1正常完成
R      T55, 1
JMP    1

// 关到位=ON AND 流量开关=ON → 内漏
LD     I8.3
A      I0.1
S      V302.4, 1                   // M_Alarm_ValveB_CloseLeak
MOVW   99, VW2
MOVB   2, VB268
JMP    1

// 关到位超时 → 报警
LD     T55
AN     I8.3
S      V302.3, 1                   // M_Alarm_ValveB_CloseTimeout
MOVW   99, VW2
MOVB   2, VB268
JMP    1


// 诊断结束
LBL    1


// ============================================================
// 文件结束
// 说明:
//   1. FC15调用本FC前置VW262=1启动
//   2. FC15检查VW268: 0等待, 1正常完成转S5, 2故障
//   3. VW274=VD_Timeout_ValveB(VD362)×10转换值
//   4. 四态诊断状态4需排除转移初期瞬时，实际需加延时确认
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ValveC_Diag:SBR18
TITLE=// ============================================================
// // 文件: FC32_ValveC_Diag.stl
// // 功能: 阀C诊断（液位低位+延时验证+开关到位+超时保护）
// // Story: AQEX-7 阀门诊断 + v10.4 硬件变更(去流量开关C)
// // 调用方: FC17(S6下缸排水)
// // 说明: 【v10.4 硬件变更 2026-09-20】去除流量开关C(I0.2,保留未使用)
// //       排水完成判定改为「液位计B低位(I1.0)持续ON达VD_Delay_ValveC_Verify(VD472)」
// //       报警码45/47/61废弃(V302.5/V302.7/V303.1改为保留位,不再置位)
// //       排水超时(液位低位未到)与关到位超时统一由报警码60(V303.0)覆盖
// //       诊断子状态VW264: 0空闲/1等开到位/2排水中/3延时验证/4等关到位
// // ============================================================
// 
// // 符号说明:
// // VW264 : Diag_State_C     阀C诊断子状态
// // VW270 : Diag_Result_C    阀C诊断结果(0/1/2)
// // VW276 : VD_Timeout_ValveC(VD54)×10 转换值(FC17计算写入)
// // VW284 : VD_Delay_ValveC_Verify(VD472)×10 转换值(FC17计算写入)【v10.4新增】
// // T56   : 阀C开到位超时
// // T57   : 阀C排水超时(液位低位到达超时)【v10.4改制: 原流量开关超时】
// // T58   : 阀C关到位超时
// // T101   : 阀C液位低位延时验证【v10.4新增】【v3.1.1修正: 原用T64编译报错——T0/T64为1ms保持型TONR,不能用TON指令;最终定址T101(100ms TON/TOF,新旧代码均无占用,避开v2.2前FC15曾用的T40以防工程内旧块混版冲突)】
// // I1.0  : 液位计B低位(下缸排空)
// // I8.4  : 阀C开到位反馈
// // I8.5  : 阀C关到位反馈
// // Q0.4  : 阀C
// // V303.0: M_Alarm_ValveC_CloseTimeout(报警码60,覆盖关到位超时+排水超时)
BEGIN
Network 1 
//  ============================================================
//  NETWORK 1 - 单NETWORK版 FC32
//  P2修复: 单NETWORK合并, 所有JMP/LBL在同一NETWORK内
//  解决STEP7导入跨NETWORK跳转失效
//  ============================================================
//  漫溢保护（全程，优先级最高）
//  [v2.2] 阀C增加下缸漫溢保护:液位计B高位=ON立即报警+关阀C+转S_ERROR

S      V300.1, 1                   // M_Alarm_Overflow_BHighR      Q0.4, 1                     // 关阀CMOVW   99, VW2MOVB   2, VB270                    // 故障JMP    6
// 诊断子状态调度LDW=   VW264, 0JMP    1LDW=   VW264, 1JMP    2LDW=   VW264, 2JMP    3LDW=   VW264, 3JMP    4LDW=   VW264, 4JMP    5JMP    6
// ---- 子状态0: 空闲 ----// S0空闲LBL    1JMP    6
// ---- 子状态1: 等待开到位 ----// S1等待开到位LBL    2// T56开到位超时 + T57排水超时(两套独立判据, PT均=VW276)LD     SM0.0TON    T56, VW276                  // PT=VD_Timeout_ValveC(VD54)×10TON    T57, VW276                  // 排水超时: 液位低位未在VD_Timeout_ValveC内到达
// 开到位=ON → 转S2排水中// [已修复 v2.2] 用 V63.2 缓存 EU 结果,避免 R 指令链栈空LD     I8.4EU=      V63.2LD     V63.2MOVW   2, VW264LD     V63.2R      T56, 1LD     V63.2R      T57, 1JMP    6
// 开到位超时 → 报警46LD     T56S      V302.6, 1                   // M_Alarm_ValveC_OpenTimeoutMOVW   99, VW2MOVW   2, VW270JMP    6
// 排水超时(开阀后液位低位仍未到达) → 报警60LD     T57AN     I1.0                        // 确认液位计B低位仍OFFS      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout(排水超时同用码60)MOVW   99, VW2MOVW   2, VW270JMP    6
// ---- 子状态2: 排水中(等待液位低位) ----// S2排水中LBL    3// 液位计B低位=ON → 转S3延时验证LD     I1.0MOVW   3, VW264JMP    6// 液位低位=OFF → 继续排水,无动作
// ---- 子状态3: 延时验证(液位低位须持续ON) ----// S3延时验证LBL    4// I1.0持续ON达VD_Delay_ValveC_Verify → 排水完成,关阀C// 注: I1.0中途OFF时TON输入断开,T101自动清零,液位低位须连续保持LD     I1.0TON    T101, VW284                  // PT=VD_Delay_ValveC_Verify(VD472)×10LD     T101R      Q0.4, 1                     // 关阀CMOVW   4, VW264                    // 转S4等关到位JMP    6// 液位低位丢失 → 回S2排水中(T101已自动复位)LDN    I1.0MOVW   2, VW264JMP    6
// ---- 子状态4: 等待关到位 ----// S4等待关到位LBL    5// T58关到位超时LD     SM0.0TON    T58, VW276                  // PT=VD_Timeout_ValveC×10
// 关到位=ON → 正常完成// [已修复 v2.2] 用 V63.3 缓存条件,避免 R 指令链栈空LD     I8.5=      V63.3LD     V63.3MOVW   0, VW264                    // VW264=0空闲LD     V63.3MOVW   1, VW270                    // Diag_Result_C=1正常完成LD     V63.3R      T58, 1JMP    6
// 关到位超时 → 报警60LD     T58AN     I8.5S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeoutMOVW   99, VW2MOVW   2, VW270                    // Diag_Result_C=2故障(已修正:用MOVW)JMP    6
// 诊断结束LBL    6

// ============================================================// 文件结束// 说明://   1. FC17调用本FC前置VW264=1启动//   2. FC17检查VW270: 0等待, 1正常完成转S5/S7, 2故障//   3. VW276=VD_Timeout_ValveC(VD54)×10转换值//      VW284=VD_Delay_ValveC_Verify(VD472)×10转换值【v10.4新增】//   4. 【v10.4硬件变更】I0.2保留未使用//      V302.5/V302.7/V303.1改为保留位(报警码45/47/61废弃,不再置位)//      T57由"流量开关超时"改制为"排水超时"(液位低位到达超时)//      排水异常=开到位超时(46)或排水/关到位超时(60)//   5. VW270写入统一用MOVW(写完整WORD),确保FC17的AW=VW270判断正确// ============================================================

JMP    6
LBL    1
JMP    6
LBL    2
LD     SM0.0
TON    T56, VW276
TON    T57, VW276
LD     I8.4
EU
=      V63.2
LD     V63.2
MOVW   2, VW264
LD     V63.2
R      T56, 1
LD     V63.2
R      T57, 1
JMP    6
LD     T56
S      V302.6, 1
MOVW   99, VW2
MOVW   2, VW270
JMP    6
LD     T57
AN     I1.0
S      V303.0, 1
MOVW   99, VW2
MOVW   2, VW270
JMP    6
LBL    3
LD     I1.0
MOVW   3, VW264
JMP    6
LBL    4
LD     I1.0
TON    T101, VW284
LD     T101
R      Q0.4, 1
MOVW   4, VW264
JMP    6
LDN    I1.0
MOVW   2, VW264
JMP    6
LBL    5
LD     SM0.0
TON    T58, VW276
LD     I8.5
=      V63.3
LD     V63.3
MOVW   0, VW264
LD     V63.3
MOVW   1, VW270
LD     V63.3
R      T58, 1
JMP    6
LD     T58
AN     I8.5
S      V303.0, 1
MOVW   99, VW2
MOVW   2, VW270
JMP    6
LBL    6
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK RhythmCorrection:SBR19
TITLE=// ============================================================
// // 文件: FC40_RhythmCorrection.stl
// // 功能: 双倒计时器周期管理(v2.2 重写,替代原三层纠偏)
// // Story: v2.2 流程重构 (替代 AQEX-8 节奏纠偏)
// // 说明: v2.2 取消原"三层自动纠偏"机制,改为通过 FC40 管理两个交替工作
// //       的 32 位秒计数器(VD248/VD252),严格保证 24h 换水次数硬约束
// // 调用: OB1 每周期调用(在 FC1 状态调度之前)
// // 输出: 触发 S6 排水 / 触发下一轮 S1 / 倒计时到 0 报警 / 双计时器显示值
// // ============================================================
// 
// // 符号说明:
// // VD414 : VD_24h_Target           24h 换水目标次数 (HMI 设定)
// // VD426 : VD_Transfer_Margin      周期尾端转移余量 (秒, 默认 30, HMI 设定)
// // VD430 : VD_Prep_Safety_Margin   上缸配液安全余量 (秒, 默认 10, HMI 设定)
// // VD186 : VD_T_cycle              本轮倒计时总时长(秒,内部中间变量)
// // VD248 : VD_TimerA_Elapsed       TimerA 已运行秒数(32 位 REAL)
// // VD252 : VD_TimerB_Elapsed       TimerB 已运行秒数(32 位 REAL)
// // VD256 : VD_TimerA_Display       TimerA 显示值(秒, DINT, HMI 读取)
// // VD244 : VD_TimerB_Display       TimerB 显示值(秒, DINT, HMI 读取)
// // T63   : T_1s_Pulse              1 秒脉冲发生器(100ms 时基,PT=10)
// // V63.4 : M_1s_Pulse              1 秒脉冲 EU 缓存
// // V63.5 : M_S6Trig_Cache          S6触发条件缓存(v2.3, 避免LPS/LPP/ALD栈消耗)
// // V63.6 : M_NextS1Trig_Cache      下一轮S1触发条件缓存(v2.3)
// // V63.7 : M_CycleTimeout_Cache    周期超时报警条件缓存(v2.3)
// // AC2   : 运算中间值(v2.3 NET5 T_cycle-Prep_Needed 阈值)
// // VW2   : 下缸主状态机
// // VW418 : 上缸配液子流程状态
// // VW6   : 当前报警码 (=0 才允许触发)
// // VW400 : 已完成换水次数 (v2.3.2由VW306迁入, 避让手动命令位V306.0~V307.3)
// // VD70  : S1 实测时长 (秒)
// // VD28  : S2 搅拌固定时长 (秒)
// // VD116 : S6 滚动实测时长 (秒,首轮为S4实测值)
// // M16.0 : M_TimerA_Active         当前下缸轮次使用 TimerA 标志
// // M16.1 : M_NextCycleTrigger      触发下一轮 S1 脉冲
// // V303.6: M_Alarm_CycleTimeout    单轮换水周期超时报警
BEGIN
Network 1 
//  计算 T_single 和 T_cycle
//  T_single = 86400.0 / VD414          // 单次目标周期(秒)
//  T_cycle = T_single - VD426 - VD430  // 实际倒计时总时长(秒)
LD     SM0.0MOVR   86400.0, VD186/R     VD414, VD186                 // T_single-R     VD426, VD186                 // - Transfer_Margin-R     VD430, VD186                 // - Safety_Margin = T_cycle

// T_cycle <= 0 检查:周期参数过激进,报警并禁止启动LD     SM0.0AR>    VD186, 0.0                   // T_cycle > 0 ?JMP    10                          // 是 → 正常路径// 否 → 参数过激进LD     SM0.0S      V303.6, 1                   // M_Alarm_CycleTimeout=1(强制人工确认)JMP    9                           // → 跳到本FC末尾
LBL    10// 正常路径继续JMP    10
LD     SM0.0
S      V303.6, 1
JMP    9
LBL    10
Network 2 
//  1 秒脉冲发生器(SM0.5秒时钟EU, 2026-09-30改, 原T63结构实测100Hz)
//  [v2.3.6修复2026-09-30] 原"R T63+TON T63,10每扫描自复位"实测输出~100Hz(100ms时基异常),
//    致NET3计数快100倍,双计时器140秒触顶,报警66/异常S6横跳(问题#20); 改用SM0.5
LD     SM0.5                       // 系统秒时钟(0.5s ON/0.5s OFF)EU                                 // 上升沿=每秒一个脉冲=      V63.4                       // 1 秒脉冲 EU 缓存Network 3 
//  双倒计时器累加:本轮进行中,每秒给当前活动计时器 +1
//  【v2.3修复】原门控"仅VW418=1(S1期间)"导致Elapsed只计到S1结束,
//    NET4/NET5的T_cycle比较式永远无法触发;改为"本轮进行中"门控:
//    VW418≠0(上缸子流程进行中) 且 VW2?{0,7,8,99}(非S0/S6/S7/S_ERROR)
//    计时区间为 本轮S6完成→本轮S6触发(排水窗口冻结,与NET4阈值语义对齐)
//  【2026-09-25修复】增加 VW2≠7: S6排水期间冻结计数,消除排水末越界误报
LD     V63.4                       // 1 秒脉冲AW<>   VW418, 0                    // 上缸子流程进行中(1/2/3/4)AW<>   VW2, 0                      // 非S0AW<>   VW2, 7                      // 【2026-09-25修复】非S6(排水窗口冻结计数,消除越界误报)AW<>   VW2, 8                      // 非S7AW<>   VW2, 99                     // 非S_ERRORA      M16.0                       // TimerA 活动?+R     1.0, VD248                  // TimerA_Elapsed + 1LD     V63.4                       // 1 秒脉冲AW<>   VW418, 0                    // 上缸子流程进行中AW<>   VW2, 0                      // 非S0AW<>   VW2, 7                      // 【2026-09-25修复】非S6(排水窗口冻结计数)AW<>   VW2, 8                      // 非S7AW<>   VW2, 99                     // 非S_ERRORAN     M16.0                       // TimerB 活动?+R     1.0, VD252                  // TimerB_Elapsed + 1Network 4 
//  S6 触发条件
//  【v2.3修复】原实现"Elapsed <= VD116"比较方向与语义相反(且代码注释与指令矛盾),
//    按设计语义改为: 本轮剩余 <= S6_actual ? Elapsed >= T_cycle - VD116
//  S6_actual 统一使用 VD116:首轮为S4实测值(由FC15写入),后续为S6滚动实测值(由FC17写入)
LD     SM0.0LPSA      M16.0                       // 当前 TimerA?MOVR   VD248, AC0                  // AC0 = TimerA_ElapsedLPPLPSAN     M16.0                       // 当前 TimerB?MOVR   VD252, AC0                  // AC0 = TimerB_ElapsedLPPOLD                                // 选择当前活动 ElapsedMOVR   VD186, AC1                  // AC1 = T_cycle-R     VD116, AC1                  // AC1 = T_cycle - S6_actual (S6触发阈值)-R     AC1, AC0                    // AC0 = Elapsed - 阈值AR>=   AC0, 0.0                    // Elapsed >= T_cycle - S6_actual ?AW=    VW2, 6                      // 当前在 S5AW=    VW6, 0                      // 无报警=      V63.5                       // 缓存S6触发条件(避免LPS/LPP/ALD栈消耗丢弃门控)LD     V63.5MOVW   7, VW2                      // 转 S6 排水LD     V63.5S      M10.7, 1                    // 【v2.3修复】置S6首次进入脉冲(原FC16已删除置位,FC17无源可取)AW=    VW2, 6
AW=    VW6, 0
=      V63.5
LD     V63.5
MOVW   7, VW2
LD     V63.5
S      M10.7, 1
Network 5 
//  下一轮 S1 触发条件
//  【v2.3修复】原实现"Elapsed >= Prep_Needed"漏T_cycle项,且要求VW418=0(死条件);
//    按设计语义改为: 本轮剩余 <= Prep_Needed ? Elapsed >= T_cycle - Prep_Needed,
//    门控改为 VW418=4(上缸已转移,可启动下一轮配液)
//  Prep_Needed = VD70 + VD28 + VD430 (S1 实测 + S2 固定 + 上缸安全余量)
LD     SM0.0LPSA      M16.0                       // 当前 TimerA?MOVR   VD248, AC0                  // AC0 = TimerA_ElapsedLPPLPSAN     M16.0                       // 当前 TimerB?MOVR   VD252, AC0                  // AC0 = TimerB_ElapsedLPPOLD                                // 选择当前活动 ElapsedMOVR   VD70, AC1                   // AC1 = S1_Actual+R     VD28, AC1                   // + S2 固定+R     VD430, AC1                  // + 安全余量 = Prep_NeededMOVR   VD186, AC2                  // AC2 = T_cycle-R     AC1, AC2                    // AC2 = T_cycle - Prep_Needed (下一轮S1触发阈值)-R     AC2, AC0                    // AC0 = Elapsed - 阈值AR>=   AC0, 0.0                    // Elapsed >= T_cycle - Prep_Needed ?AW=    VW418, 4                    // 【v2.3修复】上缸已转移(原VW418=0为死状态)AW=    VW6, 0                      // 无报警=      V63.6                       // 缓存触发条件LD     V63.6S      M16.1, 1                    // 触发下一轮 S1 脉冲(由OB1消费: VW418 4→1)AR>=   AC0, 0.0
AW=    VW418, 4
AW=    VW6, 0
=      V63.6
LD     V63.6
S      M16.1, 1
Network 6 
//  倒计时到 0 报警 (V303.6)
//  报警语义: "错过S6触发窗口"才报 —— Elapsed >= T_cycle 且 NET4 本扫描未触发 S6
//  【2026-09-25修复】原门控仅"不在S7",导致:
//    (a) VD116=0(首轮)时 NET4/NET6 同阈值,NET4先置VW2=7,NET6同扫描误报;
//    (b) S6排水期间 NET3 继续累加,排水末 Elapsed 必然越界,每轮末必报
//    修复: AN V63.5(S6触发缓存) + 排除 VW2=7(S6排水窗口,计数已冻结)
//  【v2.3修复】原LPS/LPP/ALD结构会丢弃门控,改用V位缓存
LD     SM0.0LPSA      M16.0                       // 当前 TimerA?MOVR   VD248, AC0                  // AC0 = TimerA_ElapsedLPPLPSAN     M16.0                       // 当前 TimerB?MOVR   VD252, AC0                  // AC0 = TimerB_ElapsedLPPOLD                                // 选择当前活动 Elapsed-R     VD186, AC0                  // AC0 = Elapsed - T_cycleAR>=   AC0, 0.0                    // Elapsed >= T_cycle ?AN     V63.5                       // 【2026-09-25】NET4未在本扫描触发S6(错过窗口才报)AW<>   VW2, 7                      // 【2026-09-25】不在S6排水窗口(计数冻结,Elapsed不再增长)AW<>   VW2, 8                      // 不在 S7=      V63.7                       // 缓存报警条件LD     V63.7S      V303.6, 1                   // 单轮换水周期超时报警AN     V63.5
AW<>   VW2, 7
AW<>   VW2, 8
=      V63.7
LD     V63.7
S      V303.6, 1
Network 7 
//  双倒计时器显示值写入 (HMI 读取)
//  [已修复 v2.2] VD256/VD244 直接显示 Elapsed 秒数(DINT)
LD     M16.0                       // 当前使用 TimerA?
ROUND  VD248, VD256                // VD_TimerA_Display = TimerA_Elapsed (秒)LDN    M16.0                       // 当前使用 TimerB?ROUND  VD252, VD244                // VD_TimerB_Display = TimerB_Elapsed (秒)

LBL    9// 本FC结束// 返回 OB1 (OB1 在调度 FC1 之前调用本FC,保证 M16.1 下一轮 S1 触发脉冲及时响应)

// ============================================================// 文件结束// ============================================================// 说明://   1. 调用时机: OB1 在 FC22(RTC Sync) 之后、FC1(状态调度) 之前调用//   2. 计数器清零: FC11 在 S1 首次进入时清零【非活动】计数器//      (S1启动于本轮中段,活动计数器属于本轮,不能清;计时区间为 S6完成→S6触发)//   3. 计时器切换: S6 完成后由 FC17 切 M16.0 = NOT M16.0(全程序唯一切换点)//   4. 报警 V303.6: 不受 V200.0 模式影响,必须 V0.3 人工确认;//      置位条件为"错过S6触发窗口"(NET4未触发且Elapsed>=T_cycle且不在S6/S7);//      复位由 FC3 NETWORK 4 (V0.3上升沿) 执行: 清V303.6 + 清零VD248/VD252(本轮重新计时),//      FC3A 公共复位不含此位(2026-09-25补漏); 不清计时器则确认后同扫描被NET6重报(死锁)//   5. T_cycle <= 0: 直接报警并跳过本周期其他计算(跳到 LBL 9)//   6. 显示值 VD256/VD244: 真空闲区(原 VD442/VD446 与 VD440/444 字节重叠已迁移)// ============================================================

LBL    9
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK MBUS_CTRL:SBR20
TITLE=This code is property of Siemens Industry, Inc. 
VAR_INPUT
Mode:BOOL;	//  1 = Modbus, 0 = PPI (stop Modbus)
Baud:DWORD;	//  1200, 2400 ... 115200
Parity:BYTE;	//  0 = none, 1 = odd, 2 = even
Port:BYTE;	// 0 or 1
Timeout:INT;	//  slave response timeout in milliseconds
END_VAR
VAR_OUTPUT
Done:BOOL;	//  Done flag (always set)
Error:BYTE;	//  Error status
END_VAR
VAR
AC0save:DWORD;
AC1save:DWORD;
AC2save:DWORD;
AC3save:DWORD;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK MBUS_MSG:SBR21
TITLE=This code is property of Siemens Industry, Inc. 
VAR_INPUT
First:BOOL;	// New message (Set to a 1 for only one scan for a new request)
Slave:BYTE;	// Slave address (0 - 247)
RW:BYTE;	// Read = 0, Write = 1
Addr:DWORD;	// Modbus addr (ie 40001)
Count:INT;	// Number of elements (1- 120 words or 1 to 1920 bits)
DataPtr:DWORD;	// Pointer to data (ie &VB100)
END_VAR
VAR_OUTPUT
Done:BOOL;	// Done flag (0 = busy, 1 = done)
Error:BYTE;	// Error (0 = no error)
END_VAR
VAR
AC0save:DWORD;
AC1save:DWORD;
AC2save:DWORD;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK MBUSM1:SBR22
TITLE=This code is property of Siemens Industry, Inc. 
VAR_OUTPUT
crc:WORD;
END_VAR
VAR
count:INT;
ptr:DWORD;
END_VAR
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ManualSyringePump:SBR23
TITLE=
BEGIN
Network 1 
//  孤儿态自恢复
//  [已修复 v2.2] 用 V62.2 缓存条件,避免 R 指令链栈空
LDW<>  VW390, 0
AW<>   VW390, 30
AN     M11.6
AN     M11.7
AN     M12.0
AN     M13.5
AN     M13.6
=      V62.2
LD     V62.2
MOVW   0, VW390
LD     V62.2
R      M13.7, 1


// 启动命令检测 - 仅空闲态(VW390=0)响应
// [已修复 v2.2] 用 V62.3 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.2
EU
AW=    VW390, 0
=      V62.3
LD     V62.3
MOVR   0.0, VD392
LD     V62.3
MOVR   VD452, VD396
LD     V62.3
R      M13.7, 1
LD     V62.3
R      M13.5, 1
LD     V62.3
R      M13.6, 1
LD     V62.3
R      M12.0, 1
LD     V62.3
R      M11.6, 1
LD     V62.3
R      M11.7, 1
LD     V62.3
MOVW   1, VW390
LD     V62.3
R      V307.2, 1


// 停止命令检测 - 非空闲态响应
// [已修复 v2.2] 用 V62.4 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.3
EU
AW<>   VW390, 0
=      V62.4
LD     V62.4
S      M13.7, 1
LD     V62.4
R      V307.3, 1


// 全局错误检测
// [已修复 v2.2] 用 V62.5 缓存全局错误条件,避免 R 指令链栈空
LDW=   VW390, 1
OW=    VW390, 2
OW=    VW390, 3
LD     V303.4
LD     SM0.0
AW>=   VW4, 4
OLD
ALD
=      V62.5
LD     V62.5
MOVW   99, VW390
LD     V62.5
R      M13.5, 1
LD     V62.5
R      M13.6, 1
LD     V62.5
R      M13.7, 1
LD     V62.5
R      M12.0, 1
LD     V62.5
R      M11.6, 1
LD     V62.5
R      M11.7, 1


// 子状态1-1 - 计算本次抽液步数
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD396, VD102
/R     VD350, VD102
AR>=   VD102, 6000.0
JMP    10
ROUND  VD102, AC0
MOVR   AC0, VD102
JMP    11
LBL    10
MOVR   6000.0, VD102
LBL    11


// 子状态1-2 - 检查步数并下发抽液指令(40006)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V60.4
LD     V60.4
ROUND  VD102, AC0
AR>    AC0, 0.0
JMP    12
// [已修复 v2.2] 复用 V60.4 缓存条件,补齐 R/S 链前面的 LD
LD     V60.4
R      M12.0, 1
LD     V60.4
R      M11.6, 1
LD     V60.4
R      M11.7, 1
LD     V60.4
MOVW   3, VW390
JMP    13
LBL    12
MOVW   AC0, VW204
MOVW   AC0, VW230
MOVD   16#9C46, VD232
LD     V60.4
S      M11.6, 1
LD     V60.4
S      M13.5, 1
LBL    13


// 子状态1-3 - 抽液写失败处理
// [已修复 v2.2] 用 V64.0 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
A      V303.4
=      V64.0
LD     V64.0
MOVW   99, VW390
LD     V64.0
R      M13.5, 1
LD     V64.0
R      M13.7, 1
LD     V64.0
R      M12.0, 1
LD     V64.0
R      M11.6, 1
LD     V64.0
R      M11.7, 1


// 子状态1-3 - 抽液写成功处理
// [已修复 v2.2] 用 V64.1 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
AN     V303.4
=      V64.1
LD     V64.1
R      M12.0, 1
LD     V64.1
R      M11.6, 1


// 子状态1-4 - 等待抽液执行完成
// [已修复 v2.2] 用 V65.4 缓存条件,避免 R 指令链栈空
LD     M13.5
AW=    VW390, 1
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V65.4
LD     V65.4
R      M13.5, 1
LD     V65.4
MOVW   2, VW390


// 子状态2-1 - 下发排液指令(40007)
// [已修复 v2.2] 用 V65.3 缓存条件,避免 S 指令链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V65.3
LD     V65.3
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232
LD     V65.3
S      M11.6, 1
LD     V65.3
S      M13.6, 1


// 子状态2-2 - 排液写失败处理
// [已修复 v2.2] 用 V64.2 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 2
A      V303.4
=      V64.2
LD     V64.2
MOVW   99, VW390
LD     V64.2
R      M13.6, 1
LD     V64.2
R      M13.7, 1
LD     V64.2
R      M12.0, 1
LD     V64.2
R      M11.6, 1
LD     V64.2
R      M11.7, 1


// 子状态2-2 - 排液写成功处理
// [已修复 v2.2] 用 V64.3 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 2
AN     V303.4
=      V64.3
LD     V64.3
R      M12.0, 1
LD     V64.3
R      M11.6, 1


// 子状态2-3 - 等待排液执行完成,累加本循环体积
// [已修复 v2.2] 用 V64.4 缓存条件,避免 S/R 链栈空
LD     M13.6
AW=    VW390, 2
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V64.4
LD     V64.4
MOVR   VD102, AC0
LD     V64.4
*R     VD350, AC0
LD     V64.4
+R     AC0, VD392
LD     V64.4
-R     AC0, VD396
LD     V64.4
R      M13.6, 1


// 子状态2-4 - 判断分支: 停止请求 → 回零
// [已修复 v2.2] 用 V64.5 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
A      M13.7
=      V64.5
LD     V64.5
R      M12.0, 1
LD     V64.5
R      M11.6, 1
LD     V64.5
R      M11.7, 1
LD     V64.5
MOVW   3, VW390


// 子状态2-4 - 判断分支: 单次模式 → 回零
// [已修复 v2.2] 用 V64.6 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 0
=      V64.6
LD     V64.6
R      M12.0, 1
LD     V64.6
R      M11.6, 1
LD     V64.6
R      M11.7, 1
LD     V64.6
MOVW   3, VW390


// 子状态2-4 - 判断分支: 循环模式且累计>=目标 → 回零
// [已修复 v2.2] 用 V64.7 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR>=   VD392, VD452
=      V64.7
LD     V64.7
R      M12.0, 1
LD     V64.7
R      M11.6, 1
LD     V64.7
R      M11.7, 1
LD     V64.7
MOVW   3, VW390


// 子状态2-4 - 判断分支: 循环模式且未完成 → 返回子状态1
// [已修复 v2.2] 用 V65.0 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR<    VD392, VD452
=      V65.0
LD     V65.0
R      M12.0, 1
LD     V65.0
R      M11.6, 1
LD     V65.0
R      M11.7, 1
LD     V65.0
MOVW   1, VW390


// 子状态3-1 - 下发回零(复位)指令 40003=1
LD     SM0.0
LDW=   VW390, 3
OW=    VW390, 30
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
AW=    VW510, 0
O      T104
MOVW   1, VW230
MOVD   16#9C43, VD232
S      M11.6, 1
MOVW   30, VW390


// T104冷却定时器
LD     M12.0
AW=    VW390, 30
AW>    VW510, 0
TON    T104, 50


// 子状态3-2 - 回零写失败处理
// [已修复 v2.2] 用 V65.1 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 30
A      V303.4
=      V65.1
LD     V65.1
MOVW   99, VW390
LD     V65.1
R      M13.7, 1
LD     V65.1
R      M12.0, 1
LD     V65.1
R      M11.6, 1
LD     V65.1
R      M11.7, 1
LD     V65.1
R      T104, 1


// 子状态3-2 - 回零写成功处理
// [已修复 v2.2] 用 V65.2 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 30
AN     V303.4
=      V65.2
LD     V65.2
R      M12.0, 1
LD     V65.2
R      M13.5, 1
LD     V65.2
R      M13.6, 1
LD     V65.2
R      M13.7, 1
LD     V65.2
R      M11.6, 1
LD     V65.2
R      M11.7, 1
LD     V65.2
R      T104, 1
LD     V65.2
MOVW   4, VW390

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK RTC_Sync:SBR24
TITLE=// ============================================================
// // 文件: FC22_RTC_Sync.stl
// // 功能: RTC时间同步处理
// // Story: AQEX-51 PLC长时间停机后HMI校时
// // 说明: 
// //   1. HMI通过McgsPro将当前时间(BCD格式)写入VB900~VB905
// //   2. HMI置位V0.6(CMD_RTC_Sync)
// //   3. 本FC检测V0.6上升沿，调用TODW将VB900~VB907写入PLC RTC
// //   4. 写入成功后复位V303.7(M_Need_RTC_Sync)和V0.6
// //   5. 若V303.7=1持续5分钟(300秒)未同步，置V303.5并转S_ERROR
// // ============================================================
// 
// // 符号说明:
// // V0.6  : CMD_RTC_Sync     HMI校时命令(上升沿触发)
// // V303.5: M_Alarm_RTC_Lost RTC时钟丢失报警(超时未同步后置位)
// // V303.7: M_Need_RTC_Sync  请求HMI同步PLC时间
// // VB900~VB907: RTC时间缓冲区(BCD格式)
// // T59   : 校时超时定时器(100ms时基,5分钟=3000×100ms)子程序注释
BEGIN
Network 1 
//  HMI校时命令上升沿检测
//  检测V0.6上升沿 -> 跳到LBL1执行TODW写入RTC
LD     V0.6
EU
JMP    1

// 超时保护: V303.7=1时启动5分钟超时定时器
LD     V303.7
TON    T59, 3000
LD     T59
EU
S      V303.5, 1
MOVW   99, VW2
JMP    2

// 正常路径: 无校时命令且未超时，直接结束
LD     SM0.0
JMP    2

// ============================================================
// LBL1: 执行TODW写入RTC
// ============================================================
LBL    1
LD     SM0.0
MOVB   0, VB906
MOVB   0, VB907
TODW   VB900
R      V303.7, 1
R      V0.6, 1

// ============================================================
// LBL2: 结束
// ============================================================
LBL    2
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK ColdStart:SBR25
TITLE=// ============================================================
// // 文件: SBR25_ColdStart.stl
// // 功能: 冷启动路径 — 出厂硬编码 + 用户默认覆盖 + TODR + 安全初始化
// // 调用: 由 FC0_SysInit 在 M16.4=0 (冷启动) 时 CALL
// // 返回: SBR 自然结束回到 FC0,FC0 继续执行 LBL 2 (S M16.4,1)
// // 【v2.2迁移 2026-09-15】M_InitDone 从 V304.0 迁至 M16.4
// // LBL 分配: 8/9/10(用户默认覆盖)、88/89(RTC异常处理)
// // 说明: 拆分自原单一 FC0,内部无跨 SBR JMP/LBL 依赖
// // ★ 重要: S7-200 SMART STL 的 JMP/LBL 必须在同一 NETWORK 内,
// //   因此本 SBR 只保留一个 NETWORK,所有 JMP/LBL 全部在此 NETWORK 中
// // ============================================================
// 
BEGIN
Network 1 
//  冷启动完整路径(单一NETWORK):
//    1) 出厂硬编码
//    2) 用户默认覆盖(LBL 8/9/10)
//    3) TODR读RTC + 合法性检查(LBL 88/89)
//    4) 安全初始化,SBR 自然结束返回 FC0
//  注射泵单步分辨率(25ml注射器标准6000步模式)
MOVR   4.1667, VD350               // VD_StepResolution

// 6.2 时间周期参数
// 【v2.2 修订 2026-09-15】取消 VD_CycleSetpoint (改用 VD414 24h 目标次数)
//                       取消 VD_PreMixTime_MinSafe / VD_RestTime / VD_RestTime_Min
//                       取消 VD_CycleExtend_Max / VD_T_Default (三层纠偏已删除)
MOVR   10080.0, VD24      // VD_ExperimentTarget 实验总时长(min,默认7天)
MOVR   1800.0, VD28       // VD_PreMixTime S2搅拌固定时长(s,默认30min,v2.2 严格不可压缩)
MOVR   6.0, VD414         // 【v2.2新增】VD_24h_Target 24h换水目标次数(默认6)
MOVR   180.0, VD426       // 【v2.2新增】VD_Transfer_Margin 周期尾端转移余量(s,默认3min)
MOVR   180.0, VD430       // 【v2.2新增】VD_Prep_Safety_Margin 上缸配液安全余量(s,默认3min)

// 6.2.1 工艺目标参数
MOVR   10.0, VD316        // 目标进水量(L,默认10L)
MOVR   5000.0, VD584      // VD_Vol_Target 默认加药量(μL,默认5mL)

// 6.3 超时保护参数
MOVR   60.0, VD358        // VD_Timeout_ValveA 阀A开/关到位超时(s)
MOVR   60.0, VD362        // VD_Timeout_ValveB 阀B开/关到位超时(s)
MOVR   60.0, VD54         // VD_Timeout_ValveC 阀C开/关到位超时(s)
MOVR   60.0, VD66                  // VD_Delay_ValveA_Verify 阀A关后延时验证(s)
MOVR   5.0, VD472                  // 【v10.4新增,2026-09-24由VD60迁来】VD_Delay_ValveC_Verify 阀C液位B低位延时验证(s)
MOVW   1800, VW288        // 【v2.3.2新增】VW_S4_Transfer_PT S4转移计时T49的PT(100ms单位,1800=180s)
                          //   PLC侧无运行时写入方(FC15只读用),此处给冷启动初值,HMI参数页可改

// 7.4 其他超时阈值
MOVR   1800.0, VD448      // VD_S4WaitTimeout S4等待超时阈值(s)
MOVR   10000.0, VD452     // VD_ManualDose_Target 手动总加药量(μL,默认10mL)
MOVW   0, VW388           // VW_ManualDose_Mode 手动模式(0=单次,1=循环)

// ===== 用户默认参数覆盖 =====
LDB=   VB456, 1              // VB456 == 1 (用户默认有效)?
JMP    8                     // 是 → 跳 LBL 8 执行用户默认覆盖
LD     SM0.0                 // 强制 C0=1
JMP    9                     // 无条件跳 LBL 9 (跳过覆盖)

LBL    8                     // ====== 用户默认覆盖区 ======
// 【v2.2 修订 2026-09-15】删除 VD468/VD472/VD476/VD480/VD496/VD508 等已废弃变量覆盖
// 【v2.2.1 修订 2026-09-17】VD468/VD476/VD480 重新分配为 v2.2 时间参数 (VD414/426/430)
//                         的用户默认镜像 (经字节级 + 字级 + 双字级 + 间接访问四维核实,
//                         VW236 (bytes 472-473) / VW252 (bytes 504-505) 不与新地址重叠);
//                         VD496/VD508 仍保留为空 (待未来扩展); VD472 已于 2026-09-24 分配给 VD_Delay_ValveC_Verify
MOVR   VD460, VD24           // VD_ExperimentTarget
MOVR   VD464, VD28           // VD_PreMixTime (S2搅拌固定时长)
MOVR   VD484, VD54           // VD_Timeout_ValveC
MOVR   VD488, VD66           // VD_Delay_ValveA_Verify
// 【2026-09-24决策】恢复无条件覆盖：出厂默认防0的责任在HMI侧——HMI首次运行/参数页打开时
//   须把出厂默认值写入整个镜像区(VD460~VD536)并置VB456=1，PLC不做非0门控
MOVR   VD492, VD472          // 【v3.1新增,2026-09-24由VD60迁来】UD_VD60_DelayC → VD_Delay_ValveC_Verify 排液完成验证延时
                             //   (原VD60因与V60.x~V63.x EU缓存位区重叠而废弃; VD472经字节/字/双字/位四维核实无占用)
MOVR   VD500, VD316          // VD_TargetInletVolume
MOVR   VD504, VD350          // VD_StepResolution
MOVR   VD512, VD358          // VD_Timeout_ValveA
MOVR   VD516, VD362          // VD_Timeout_ValveB
MOVR   VD520, VD584          // VD_Vol_Target
MOVR   VD524, VD448          // VD_S4WaitTimeout
MOVR   VD528, VD452          // VD_ManualDose_Target
MOVR   VD468, VD414          // UD_VD414_24h_Target         (v2.2 新增, 24h 换水目标次数, 默认6)
MOVR   VD476, VD426          // UD_VD426_Transfer_Margin    (v2.2 新增, 周期尾端转移余量, 默认180s)
MOVR   VD480, VD430          // UD_VD430_Safety_Margin      (v2.2 新增, 上缸配液安全余量, 默认180s)

// WORD: VW388 ManualDose_Mode
MOVB   VB532, VB388           // 复制低字节
MOVB   0, VB389               // 高字节清零

// BIT: V200.0 AlarmAckMode
LDB=   VB536, 1
JMP    10                     // VB536 == 1 → 跳去 S V200.0
R      V200.0, 1              // VB536 != 1 → 清 V200.0
LD     SM0.0
JMP    9                      // 无条件跳汇合点
LBL    10
S      V200.0, 1              // VB536 == 1 → 置 V200.0

// LBL 9 汇合 → TODR读RTC + 合法性检查 (LBL 88/89)
LBL    9                     // ====== 覆盖后汇合点 ======

// 实验总换水次数目标计算(v2.2新增)
// VW8 = VD414(24h换水目标次数) × VD24(实验总时长min) / 1440
LD     SM0.0
MOVR   VD414, AC0
*R     VD24, AC0
/R     1440.0, AC0
ROUND  AC0, AC0
DTI    AC0, VW8

// ★ 2026-09-13: 冷启动也要读PLC内部RTC到VB900~VB907
LD     SM0.1
TODR   VB900

// RTC自身合法性检查(RTC字段越界+年份归零→请求校时)
// ★ 2026-09-13新增: 年份合理性检查(超级电容归零→VB900=00→2000年)
LDB<   VB900, 20          // 年<20(2020年前) → RTC不可信
JMP    88
LDB>   VB901, 12          // 月>12
JMP    88
LDB<   VB901, 1           // 月<1
JMP    88
LDB>   VB902, 31          // 日>31
JMP    88
LDB<   VB902, 1           // 日<1
JMP    88
LDB>   VB903, 23          // 时>23
JMP    88
LDB>   VB904, 59          // 分>59
JMP    88
LDB>   VB905, 59          // 秒>59
JMP    88
LD     SM0.0              // RTC正常 → 跳过异常处理
JMP    89

LBL    88                 // 冷启动RTC异常
LD     SM0.1
S      V303.7, 1          // 请求HMI校时

LBL    89                 // 汇合点

// 状态机初始化为S0
MOVW   0, VW2             // VW2=0(S0)
// 冷启动也清阀门诊断子状态和计时器
FILL   0, VW260, 8        // 清 VB260~VB275
R      T50, 6             // 清 T50~T55
R      V1.6, 1            // 上缸=空
R      V1.7, 1            // 下缸=空

// 复位所有DO输出(安全状态)
MOVB   0, QB0             // Q0.0~Q0.7=0
MOVB   0, QB8             // Q8.0~Q8.7=0

// 清除急停锁存
R      V300.4, 1          // M_EStop_Latch=0

// 清除报警字和报警码
// 【2026-09-29修复】FILL第三操作数是字数非字节数: 原"4"实际清VW300/302/304/306(VB300~307),
//   每次冷启动把上缸子流程状态VW418连带清0(交叉引用实证)。改为2字=VB300~303, 与注释一致
FILL   0, VW300, 2        // VW300~VW301(=VB300~VB303)清零
MOVW   0, VW6             // VW6=0(无报警)

// 清除FC3内部继电器
R      M11.1, 1           // M_Sound_Latched=0
R      M11.2, 1           // M_PrevAlarm=0

// 冷启动必须清 VB0,防止 V0.x 命令位断电保持后卡1
MOVB   0, VB0             // V0.0~V0.7 全部清0
R      V1.0, 6            // V1.0~V1.5=0

// 本次实验累计流量清零
MOVR   0.0, VD406         // VD_ExpTotal_Flow=0(L) (原VD364,2026-09-29迁移:与VD366重叠2字节;VD402槽被VW402(T38_PT)占)

// 本次实验累计加药量清零
MOVR   0.0, VD440         // VD_Dosed_Volume_Total=0(μL)

// S4等待时长清零
MOVR   0.0, VD444

// S3剩余待加药量清零
MOVR   0.0, VD372         // VD_Remaining_Vol=0(μL)

// 清下缸满计时器+预规划标志
MOVR   0.0, VD178         // VD_S5_Elapsed=0
R      M10.7, 1
R      M10.2, 1           // 【2026-09-29新增】清S1首次进入标志(v2.2重构丢失置位点后的防御性清理)

// 初始化Modbus轮询计数器与状态
FILL   0, VW290, 4        // VW290~VW296 清零
R      M10.0, 6
LD     SM0.1
R      T103, 1
S      M15.0, 1           // 首次扫描启动任务0
R      M15.1, 1
R      M15.2, 1
R      V60.0, 8           // [已修复 v2.2] 扩展到 V60.7,覆盖 FC4 任务切换新增中间继电器
R      M11.0, 1
R      M11.6, 3                    // M11.6, M11.7, M12.0 (连续3位)
R      M16.5, 1                    // 清注射泵在线标志(v2.2迁移自V304.1)
R      M16.6, 1                    // 清流量计在线标志(v2.2迁移自V304.2)
R      M12.1, 2                    // M12.1, M12.2 (连续2位)
R      M13.0, 5                    // 清手动控制锁存
R      M13.5, 3           // 清手动注射泵标志
MOVW   0, VW390           // 手动注射泵子状态=0
MOVR   0.0, VD392
MOVR   0.0, VD396

// 清错误码/写目标地址
FILL   0, VW378, 3        // 清 VB378~VB383 (6字节合并)
MOVR   0.0, VD374
MOVW   0, VW226
MOVD   0, VD232
MOVW   0, VW230
// ★ 冗余段已删除: 不再重复清 VD232/VW230/M11.6 (上面已清)
// ★ 冗余段已删除: VD414/VD426/VD430 已在出厂硬编码段设置

// 【v2.2 新增】冷启动时初始化上缸子流程 + 双倒计时器显示值清零
MOVW   0, VW418                     // 上缸配液子流程状态清零(防御性)
MOVW   0, VW400                     // 换水计数清零 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】
R      M16.0, 4                     // M16.0~M16.3 连续清零
R      T63, 1                       // [已修复 v2.2] 清 1s 脉冲定时器
MOVR   0.0, VD248                   // TimerA_Elapsed 清零
MOVR   0.0, VD252                   // TimerB_Elapsed 清零
MOVR   0.0, VD256                   // TimerA 显示值清零
MOVR   0.0, VD244                   // TimerB 显示值清零

MOVW   2, VW198           // 步骤=2(冷启动完成)
// SBR 自然结束,返回到 FC0 的 LBL 2 (S M16.4,1)


// ============================================================
// 文件结束
// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK WarmRecovery:SBR26
TITLE=// ============================================================
// // 文件: SBR26_WarmRecovery.stl
// // 功能: 断电恢复路径 — RTC检测 + BCD转秒 + 状态机恢复
// // 调用: 由 FC0_SysInit 在 M16.4=1 (断电恢复) 时 CALL
// // 返回: SBR 自然结束回到 FC0,FC0 继续执行 LBL 2 (S M16.4,1)
// // 【v2.2迁移 2026-09-15】M_InitDone 从 V304.0 迁至 M16.4
// // LBL 分配: 1(入口)、3(RTC正常)、4(RTC异常)、5(状态恢复)、6(保持)、7(S_ERROR)、10(S_ERROR回S0清理,兼S5残留清理落点)
// // 【2026-09-29修复】S5保持加前提(V1.7=1或VW418≠0),无前提时跳LBL10复用清理段回S0(不为S5单写副本,省程序存储器)
// // 说明: 拆分自原单一 FC0,原来的 JMP 2(跳FC0完成点) 全部改为 SBR 自然结束
// //   注意: 断电恢复路径不清报警字,VW300~303/VW6/V300.x 由 FC3/FC19 按确认流程处理
// // ★ 重要: S7-200 SMART STL 的 JMP/LBL 必须在同一 NETWORK 内,
// //   因此本 SBR 只保留一个 NETWORK,所有 JMP/LBL 全部在此 NETWORK 中
// // ============================================================
BEGIN
Network 1 
//  断电恢复完整路径(单一NETWORK):
//    1) TODR读RTC + 合法性检查 + DT10比较(LBL 1/3/4)
//    2) BCD转秒 + VD_S5_Elapsed重算(LBL 3/5)
//    3) 状态机恢复策略(LBL 5/6/7),SBR 自然结束返回 FC0
//  LBL 1: 入口 (FC0 通过 CALL WarmRecovery 进入,从 LBL 1 开始执行)

// 【2026-09-24新增】暖启动参数NaN自愈: 新PLC未清除V区/异常写入可能使REAL为NaN,//   暖启动不执行SBR25出厂默认段, NaN会永久残留, 并导致HMI参数页"应用设置"把NaN缓冲//   往返写回(表现为改了参数值不变)。利用IEEE754规则"NaN与自身不等"检测, 命中即恢复出厂默认LD     SM0.0AR<>   VD472, VD472                  // VD472是NaN ? (NaN<>NaN恒真)MOVR   5.0, VD472                    // 是 → 恢复出厂默认5.0LD     SM0.1TODR VB900                // 读RTC到VB900~VB907(BCD)
// RTC自身合法性检查(RTC字段越界→请求校时)LDB>   VB901, 12          // 月>12JMP    4LDB<   VB901, 1           // 月<1JMP    4LDB>   VB902, 31          // 日>31JMP    4LDB<   VB902, 1           // 日<1JMP    4LDB>   VB903, 23          // 时>23JMP    4LDB>   VB904, 59          // 分>59JMP    4LDB>   VB905, 59          // 秒>59JMP    4
// RTC丢失检测: 比较RTC与DT10(VB10~VB17)LDB=   VB10, 0            // DT10未写入 → 跳过检测JMP    3
// DT10数据合法性检查（防止历史垃圾数据误触发RTC丢失）LDB<   VB11, 1            // 月<1JMP    4LDB>   VB11, 12           // 月>12JMP    4LDB<   VB12, 1            // 日<1JMP    4LDB>   VB12, 31           // 日>31JMP    4LDB>   VB13, 23           // 时>23JMP    4LDB>   VB14, 59           // 分>59JMP    4LDB>   VB15, 59           // 秒>59JMP    4
// 逐字段BCD比较(年→月→日→时→分→秒)LDB<   VB900, VB10        // RTC年 < DT10年 → RTC丢失JMP    4LDB>   VB900, VB10        // RTC年 > DT10年 → 正常JMP    3LDB<   VB901, VB11        // 比月JMP    4LDB>   VB901, VB11JMP    3LDB<   VB902, VB12        // 比日JMP    4LDB>   VB902, VB12JMP    3LDB<   VB903, VB13        // 比时JMP    4LDB>   VB903, VB13JMP    3LDB<   VB904, VB14        // 比分JMP    4LDB>   VB904, VB14JMP    3LDB<   VB905, VB15        // 比秒JMP    4LD     SM0.0              // 全部>= → RTC正常JMP    3
// RTC异常/丢失 → 请求HMI校时LBL    4LD     SM0.1S      V303.7, 1          // M_Need_RTC_SyncMOVR   0.0, VD178         // VD_S5_Elapsed=0(无法重算)MOVW   3, VW198           // 步骤=3(RTC需校时)JMP    5                  // → 状态恢复
// RTC正常，继续LBL    3LD     SM0.1MOVW   3, VW198           // 步骤=3(RTC正常)
// BCD转秒 - RTC(VD_RTC_Now_Sec)MOVR   0.0, VD186         // 清VD_RTC_Now_SecBTI    VB903, AC0         // BCD→INT(时)ITD    AC0, AC0           // INT→DINTDTR    AC0, AC0           // DINT→REAL*R     3600.0, AC0        // ×3600+R     AC0, VD186         // 累加到VD_RTC_Now_SecBTI    VB904, AC0         // 分ITD    AC0, AC0DTR    AC0, AC0*R     60.0, AC0+R     AC0, VD186BTI    VB905, AC0         // 秒ITD    AC0, AC0DTR    AC0, AC0+R     AC0, VD186
// BCD转秒 - DT10(VD_DT10_Sec)MOVR   0.0, VD190         // 清VD_DT10_SecBTI    VB13, AC0          // DT10时ITD    AC0, AC0DTR    AC0, AC0*R     3600.0, AC0+R     AC0, VD190BTI    VB14, AC0          // 分ITD    AC0, AC0DTR    AC0, AC0*R     60.0, AC0+R     AC0, VD190BTI    VB15, AC0          // 秒ITD    AC0, AC0DTR    AC0, AC0+R     AC0, VD190MOVW   4, VW198           // 步骤=4(BCD转秒完成)
// VD_S5_Elapsed重算(仅保持S5且下缸=满时)LD     V1.7               // 下缸=满AW=    VW2, 6             // 且状态机=S5MOVR   VD186, VD178       // 满足:VD_S5_Elapsed = RTC秒-R     VD190, VD178       // - DT10秒 = 断电期间经过秒数MOVW   5, VW198           // 步骤=5(Elapsed重算完成)JMP    5                  // → 状态恢复
// 下缸=空 或 非S5 时VD_S5_Elapsed=0LD     SM0.0MOVR   0.0, VD178         // Elapsed=0MOVW   5, VW198
// ===== 状态机恢复策略 =====LBL    5LDW=   VW2, 0JMP    6                  // S0保持
// S5保持(断电续跑) —— 【2026-09-29修复】加前提://   仅当下缸=满(实验确实在跑,V1.7=1)或上缸有配液任务(VW418≠0)时才续跑;//   否则判定为断电残留死状态(典型现象: 上电后上缸空闲+下缸显示S5空等,//   停止/启动都脱不了困,只能断电复位), 清状态回S0(复用LBL 10清理段)。// 用V60.2/V60.3草稿位缓存条件,避免LDW+V1.7/OLD栈混叠。LDW=   VW2, 6=      V60.2              // V60.2=断电时处于S5LD     V1.7               // 下缸=满LDW<>  VW418, 0           // 或上缸子流程有任务OLD=      V60.3              // V60.3=S5续跑前提成立LD     V60.2A      V60.3JMP    6                  // 前提满足 → S5保持(断电续跑)LD     V60.2AN     V60.3JMP    10                 // 无前提 → 残留死状态,复用S_ERROR回S0清理段(LBL 10)
LDW=   VW2, 8JMP    6                  // S7保持(锁定态)
// S_ERROR: 无实际故障则转S0，否则保持LDW=   VW2, 99JMP    7
// S1~S6: 阀门/泵动作中断 → 转S_ERRORLD     SM0.0MOVB   0, QB0             // 阀门关/泵停/NC电磁阀失电(安全)MOVW   99, VW2            // 转S_ERRORS      V300.4, 1          // 置急停锁存(需人工复位)// ★ 2026-09-14新增: 清运行中间状态,防止断电恢复后带半拉子S1状态运行R      V1.0, 1            // 清启动握手位R      M10.2, 1           // 清S1首次进入标志 【2026-09-29新增】FILL   0, VW260, 8        // 清 VB260~VB275 (阀A/B/C诊断子状态)R      T50, 6             // 清 T50~T55 (阀A/B诊断计时器)MOVW   7, VW198           // 步骤=7(状态机转S_ERROR)
// S_ERROR特殊处理LBL    7LD     V300.4             // 急停锁存O      V300.5             // 或继电器故障O      I1.1               // 或急停触发LDW<>  VW6, 0             // 或有活动报警OLDJMP    6                  // 任一满足 → 保持S_ERROR
// 无实际故障 → 转S0// 【2026-09-29】本段同时是S5残留死状态的清理落点(S5无续跑前提时JMP 10),//   复用同一段清理指令,不为S5单写副本(省程序存储器,ST20仅剩12KB余量紧张)LBL    10LD     SM0.1MOVB   0, QB0             // 输出安全状态R      Q0.7, 1            // 清报警声音MOVW   0, VW2             // 转S0// ★ 2026-09-14新增: 从S_ERROR回S0时同样清理残留状态R      V1.0, 1            // 清启动握手位R      M10.2, 1           // 清S1首次进入标志 【2026-09-29新增】FILL   0, VW260, 8        // 清 VB260~VB275 (阀A/B/C诊断子状态)R      T50, 6             // 清 T50~T55 (阀A/B诊断计时器)// 【v2.2 新增】断电恢复时清理上缸子流程 + 双倒计时器MOVW   0, VW418                     // 上缸配液子流程状态清零MOVW   0, VW400                     // 换水计数清零(防御性) 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】R      M16.0, 4                     // M16.0~M16.3 连续清零R      T63, 1                       // [已修复 v2.2] 清 1s 脉冲定时器R      T49, 1                       // 清 S4 转移计时器MOVR   0.0, VD248                   // [已修复 v2.2] 清 TimerA_ElapsedMOVR   0.0, VD252                   // [已修复 v2.2] 清 TimerB_ElapsedMOVR   0.0, VD256                   // 清 TimerA 显示值MOVR   0.0, VD244                   // 清 TimerB 显示值MOVW   6, VW198           // 步骤=6(状态恢复完成)
// 保持原状态LBL    6MOVW   6, VW198           // 步骤=6(状态恢复完成)// SBR 自然结束,返回到 FC0 的 LBL 2 (S M16.4,1)

// ============================================================// 文件结束// ============================================================

BTI    VB14, AC0
ITD    AC0, AC0
DTR    AC0, AC0
*R     60.0, AC0
+R     AC0, VD190
BTI    VB15, AC0
ITD    AC0, AC0
DTR    AC0, AC0
+R     AC0, VD190
MOVW   4, VW198
LD     V1.7
AW=    VW2, 6
MOVR   VD186, VD178
-R     VD190, VD178
MOVW   5, VW198
JMP    5
LD     SM0.0
MOVR   0.0, VD178
MOVW   5, VW198
LBL    5
LDW=   VW2, 0
JMP    6
LDW=   VW2, 6
=      V60.2
LD     V1.7
LDW<>  VW418, 0
OLD
=      V60.3
LD     V60.2
A      V60.3
JMP    6
LD     V60.2
AN     V60.3
JMP    10
LDW=   VW2, 8
JMP    6
LDW=   VW2, 99
JMP    7
LD     SM0.0
MOVB   0, QB0
MOVW   99, VW2
S      V300.4, 1
R      V1.0, 1
R      M10.2, 1
FILL   0, VW260, 8
R      T50, 6
MOVW   7, VW198
LBL    7
LD     V300.4
O      V300.5
O      I1.1
LDW<>  VW6, 0
OLD
JMP    6
LBL    10
LD     SM0.1
MOVB   0, QB0
R      Q0.7, 1
MOVW   0, VW2
R      V1.0, 1
R      M10.2, 1
FILL   0, VW260, 8
R      T50, 6
MOVW   0, VW418
MOVW   0, VW400
R      M16.0, 4
R      T63, 1
R      T49, 1
MOVR   0.0, VD248
MOVR   0.0, VD252
MOVR   0.0, VD256
MOVR   0.0, VD244
MOVW   6, VW198
LBL    6
MOVW   6, VW198
END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK PumpErrExit:SBR27
TITLE=// ============================================================
// // 文件: FC13A_PumpErrExit.stl
// // 功能: FC13 公共泵错误退出处理(停泵+转S_ERROR+清握手)
// // Story: 压缩 FC13 程序体积,提取 NETWORK 2/4/7/10/13 重复的错误退出代码
// // 说明: 本 FC 由 FC13 各错误路径 CALL 调用,统一执行:
// //       1. 安全停潜水泵 Q0.0/Q0.1
// //       2. 置位注射泵报警位 V303.4
// //       3. 状态机转 S_ERROR(VW2=99)
// //       4. 清 S3 子状态 VW226=0
// //       5. 清写握手位 M12.0/M11.6/M11.7
// //       6. 清运动标志 M12.1/M12.2
// //       7. 清超时定时器 T102
// // 调用方: FC13 NETWORK 2(全局错误检测) / NETWORK 4(子状态1/5写失败)
// //         NETWORK 7(子状态3/7写失败)
// // ============================================================
BEGIN
Network 1 
//  FC13泵错误退出公共处理
//  由FC13各错误路径CALL,统一执行安全停泵+转S_ERROR+清握手
R      Q0.0, 1                     // 停潜水泵1
R      Q0.1, 1                       // 停潜水泵2S      V303.4, 1                     // 确保报警位MOVW   99, VW2                       // 转S_ERRORMOVW   0, VW226                      // 清子状态R      M12.0, 1                      // 清写完成R      M12.1, 1                      // 清抽液运动标志R      M12.2, 1                      // 清排液运动标志R      M11.6, 1                      // 清写请求R      M11.7, 1                      // 清写忙R      T102, 1                       // 清超时定时器

// ============================================================// 文件结束// 说明://   1. 本 FC 仅在错误路径被 CALL 调用,不单独从 OB1 调用//   2. 调用前由调用方保证执行条件(已检测到 V303.4 或 VW4≥4)//   3. 所有复位操作为幂等,重复调用安全// ============================================================

END_SUBROUTINE_BLOCK
SUBROUTINE_BLOCK AlarmReset_Common:SBR28
TITLE=// ============================================================
// // 文件: FC3A_AlarmReset_Common.stl
// // 功能: FC3 公共报警位复位逻辑（条件消失则复位）
// // Story: 压缩 FC3 程序体积，提取 NETWORK 4/5 重复代码
// // 说明: 本 FC 仅包含一般故障级报警位的条件消失自动复位逻辑，
// //       漫溢级(V300.0~3)、急停(V300.4)、继电器故障(V300.5)、
// //       节奏滞后(V300.6/7)不由本 FC 处理。
// //       V303.6(单轮换水周期超时)也由 FC3 NETWORK 4 (V0.3上升沿) 单独复位(2026-09-25):
// //       FC40注4要求必须人工确认,不受V200.0自动模式影响,放入本FC会被
// //       NETWORK 5(自动恢复)每扫描调用而自动清除,故刻意排除。
// //       注意: FC3复位时同步清零VD248/VD252,否则NET6同扫描重报(死锁)
// // 调用方: FC3 NETWORK 4(人工确认时)、FC3 NETWORK 5(自动恢复模式)
// // ============================================================
// 
BEGIN
Network 1 
//  阀A类：条件消失则复位
LD     V301.0                      // 阀A关后仍有流
AN     I0.0                          // 流量开关A已OFF
R      V301.0, 1

LD     V301.2                        // 阀A关到位超时
A      I8.1                          // 阀A关到位反馈已ON
R      V301.2, 1

LD     V301.3                        // 阀A关到位但仍有流
AN     I0.0                          // 流量开关A已OFF
R      V301.3, 1

LD     V301.4                        // 阀A开到位超时
A      I8.0                          // 阀A开到位反馈已ON
R      V301.4, 1

LD     V301.5                        // 阀A开到位但无流
A      I0.0                          // 流量开关A已ON
R      V301.5, 1

LD     V301.6                        // S5触发S1时上缸≠空
AN     V1.6                          // 上缸已=空
R      V301.6, 1


// 阀B/C类：条件消失则复位
LD     V302.0                        // 阀B诊断异常
LD     I0.1                          // 流量开关B=ON
O      I0.6                          // 或液位计A-低位=ON
ALD
R      V302.0, 1

LD     V302.1                        // 阀B开到位超时
A      I8.2
R      V302.1, 1

LD     V302.2                        // 阀B开到位但无流
A      I0.1
R      V302.2, 1

LD     V302.3                        // 阀B关到位超时
A      I8.3
R      V302.3, 1

LD     V302.4                        // 阀B关到位但仍有流
AN     I0.1
R      V302.4, 1

// 【v10.4硬件变更】V302.5(报警码45)/V302.7(报警码47)已废弃为保留位,
//   FC32不再置位,此处删除原基于I0.2的复位条件
LD     V302.6                        // 阀C开到位超时
A      I8.4
R      V302.6, 1


// 其他类：条件消失则复位
// 注: V303.0(报警码60)现覆盖关到位超时+排水超时两种触发,
//     复位条件统一为阀C关到位反馈I8.5=ON
LD     V303.0                        // 阀C关到位超时/排水超时
A      I8.5
R      V303.0, 1

// 【v10.4硬件变更】V303.1(报警码61,阀C关到位仍有流)已废弃为保留位,
//   内漏判定依赖I0.2已去除,此处删除原复位条件
LD     V303.4                        // 注射泵通讯异常
AW=    VW4, 0                        // 状态码=0(空闲正常)
R      V303.4, 1

// 注: V303.5(RTC丢失)不自动清除，需HMI校时后确认


// ============================================================
// 文件结束
// 说明:
//   1. 本 FC 被 FC3 调用，不要单独从 OB1 调用
//   2. 调用前由调用方保证执行时机（NETWORK 4 的 V0.3 上升沿 / NETWORK 5 的自动模式）
//   3. 报警位复位后，下一周期 FC3 NETWORK 1 会重算 VW6
// ============================================================

END_SUBROUTINE_BLOCK
INTERRUPT_BLOCK MBUSM2:INT0
TITLE=This code is property of Siemens Industry, Inc. 
BEGIN
Network 1 // 此 POU 针对编辑和查看设置了密码保护.

END_INTERRUPT_BLOCK
