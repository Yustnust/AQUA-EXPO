// ============================================================
// 文件: FC15_State_S4_Transfer.stl
// 功能: S4上→下转移 (VW2=5)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-7 阀门诊断)
// 说明: v2.2 S4 是唯一的上下缸交汇点
//       启动条件: VW2=5 AND V1.7=0 (下缸已排空) AND VW304=3 (上缸已配完)
//       完成后: 切 VW304=4 (已转移) + 写 S6 滚动默认值 + 转 S5
// ============================================================

NETWORK 1
// S4 启动条件(v2.2 关键改动:必须 VW304=3 才能启动)
// 触发条件: VW2=5 (下缸 S4 入口) + V1.7=0 (下缸已排空) + VW304=3 (上缸配完等待) + VW6=0 (无报警)
// 启动动作: 开阀B + 启动 T49 计时 + 置 VW304=4 (上缸标记"已转移")
// 【v10.4硬件变更】下缸NC球阀Q0.6已去除(保留未使用),不再随S4启动

// [已修复 v2.2] 用 V61.5 缓存 S4 启动条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空
// 【v2.3修复】首轮补入口: 下缸S5空等(VW2=6)且已排空(V1.7=0)且上缸已配完(VW304=3)
//   原仅响应VW2=5,首轮FC10直接置VW2=6,首罐液体永远无法转移
LD     SM0.0
AW=    VW2, 5                       // S4 状态入口
AN     V1.7                         // 下缸已排空
AW=    VW304, 3                     // 上缸已配完
AW=    VW6, 0                       // 无报警
=      V61.5
LD     SM0.0                        // 【v2.3】首轮入口(VW2=6空等,条件与上面等价)
AW=    VW2, 6
AN     V1.7
AW=    VW304, 3
AW=    VW6, 0
O      V61.5                        // 两个入口取或
=      V61.5
LDN    V61.5
JMP    1                           // 任一条件不满足 → 不启动
// 条件满足 → 启动 S4 转液
LD     V61.5
S      Q0.3, 1                     // 开阀B
LD     V61.5
R      T49, 1
TON    T49, VW288                  // 【v2.3修复】S4 实测计时,PT=VW288独立地址
                                   // (原VW290被FC4 Modbus任务状态机占用,每周期改写,计时不确定)
// 置 VW304=4 (上缸已转移)
LD     V61.5
MOVW   4, VW304
JMP    2

LBL    1
LBL    2
// 注: 条件不满足时 S/R/计时/赋值指令全部不执行, FC31 诊断空转, 等待下一周期


// 【v2.2 兼容保留】S4 等待超时逻辑(下缸未排空时使用)
// [已修复 v2.2] 用 V61.6 缓存 S4 等待条件,避免 LPS/LPP+NOT 配合下的栈空
// v2.2 仍保留 V303.2 报警机制(仅提示不强制 S_ERROR)
// 与 v2.1 区别: 增加"上缸配完"判断(原版只看 V1.7)
LD     SM0.0
AW=    VW2, 5
// 启动条件:V1.7=1(下缸未空) AND VW304=3(上缸配完)
A      V1.7
AW=    VW304, 3
=      V61.6
LDN    V61.6
JMP    3
// 下缸未空,启动 T61 等待计时
LD     V61.6
MOVR   VD448, VD324                // VD_S4WaitTimeout
*R     10.0, VD324
ROUND  VD324, AC0
MOVW   AC0, VW286                  // T61 PT
LD     V61.6
R      T61, 1
TON    T61, VW286                  // S4 等待超时计时
// 每秒累加 VD_S4Wait_Time (T62 1s 脉冲)
LD     V61.6
R      T62, 1
TON    T62, 10
LD     T62
EU
+R     1.0, VD444                  // VD_S4Wait_Time + 1s
R      T62, 1
// 超时报警
LD     T61
S      V303.2, 1                   // M_Alarm_S4TransferWaitTimeout
JMP    4

LBL    3
LBL    4


// 调用阀B诊断
LD     SM0.0
CALL ValveB_Diag


// 检查阀B诊断结果 + S4 完成动作
// [已修复 v2.2] 用 V61.7 缓存诊断完成条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空
// v2.2 关键改动:完成时切 M16.0 = NOT M16.0(双倒计时器切换),写 VD116 (S6_actual 滚动)
//   注: 首轮时 VD116 存 S4 实测时长,后续轮次存 S6 实测时长(用于 FC40 S6 触发阈值)
LD     SM0.0
AB=    VB268, 1                    // 阀B诊断正常完成(VB268=1)
=      V61.7
LDN    V61.7
JMP    10                          // 未完成 → 跳到 NETWORK 4 末尾
// 诊断完成 → 执行 S4 完成动作
// 【v2.3修复】先读T49当前值再复位(R在前读到的恒为0)
LD     V61.7
MOVW   T49, AC0                    // T49 当前值(100ms 时基)
ITD    AC0, VD444                  // → DINT
DTR    VD444, VD444                // → REAL(原值秒)
MOVR   VD444, VD116                // VD116 = S4 实测秒(首轮作 S6 默认)
LD     V61.7
R      T49, 1
// 置下缸状态=满
LD     V61.7
S      V1.7, 1
// 记录下缸变满时间戳
LD     V61.7
TODR   VB900
MOVB   VB900, VB10
MOVB   VB901, VB11
MOVB   VB902, VB12
MOVB   VB903, VB13
MOVB   VB904, VB14
MOVB   VB905, VB15
MOVB   VB906, VB16
MOVB   VB908, VB17
// 下缸实验时长清零
LD     V61.7
MOVR   0.0, VD178                  // VD_S5_Elapsed 清零
LD     V61.7
R      M10.7, 1                    // 清预规划标志
// S4 等待计时清零
LD     V61.7
R      T61, 2                     // 清 T61+T62 (连续2个定时器)
LD     V61.7
MOVR   0.0, VD444                  // VD_S4Wait_Time 清零(恢复原始中间变量用途)
LD     V61.7
R      V303.2, 1                   // 清 S4 等待超时报警
// 【v2.3删除】原"切双倒计时器标记 M16.0 = NOT M16.0"已删:
//   M16.0 全程序仅在 FC17 S6 完成时切换一次(原S4/S6各切一次导致每周期翻转两次)
// 【v2.3删除】原"触发下一轮 S1 脉冲 S M16.1"已删:
//   下一轮 S1 由 FC40 按 Elapsed>=T_cycle-Prep_Needed 触发(VW304=4 门控);
//   此处置位会使上缸刚置"已转移"就立即启动下一轮,破坏24h周期约束
// 状态转移 S4→S5
LD     V61.7
MOVW   6, VW2
LBL    10


// 注: 漫溢保护、四态诊断、开关到位、超时保护全部由 FC31 统一处理
// 注: 【v10.4硬件变更】下缸NC球阀已去除,FC31漫溢保护仅关阀B,不再操作Q0.6
// 注: DT 时间戳格式需与 S7-200 SMART 的 DT 数据类型对齐
// 注: 断电恢复由 FC0 统一处理,VW2=5 (S4 阀B动作中断) 时 FC0 转 S_ERROR

// ============================================================
// 文件结束
// ============================================================
