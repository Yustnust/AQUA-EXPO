// ============================================================
// 文件: FC15_State_S4_Transfer.stl
// 功能: S4上→下转移 (VW2=5)
// Story: AQEX-6 状态机骨架
// 说明: 开阀B将上缸溶液转移至下缸，漫溢保护，排空检测
//       阀B四态诊断由Story 1.3补充
// ============================================================

NETWORK 1: S4进入动作
LD     SM0.0
S      Q0.3, 1                     // 阀B开
R      T40, 1
TON    T40, 32767                  // S4计时(记录VD_S4_Actual)
R      V1.6, 1                     // 上缸状态=空(开始转移)


NETWORK 2: 下缸漫溢保护
// I0.7(液位计B高位)=ON → 漫溢报警 + NC电磁阀下缸动作 + 转S_ERROR
LD     I0.7
S      V300.1, 1                   // M_Alarm_Overflow_BHigh
S      Q0.6, 1                     // NC电磁阀-下缸得电(安全)
MOVB   99, VB2
MOVB   0, VB3


NETWORK 3: 阀B开启超时检测（骨架）
LD     Q0.3                        // 阀B已开
AN     I0.1                        // 流量开关B未到
TON    T46, +300                   // 临时30s超时
LD     T46
S      V302.1, 1                   // M_Alarm_ValveB_OpenTimeout
MOVB   99, VB2
MOVB   0, VB3


NETWORK 4: 转移完成检测（上缸空+无流量）
// I0.6(液位计A低位)=ON AND I0.1(流量开关B)=OFF → 转移完成
LD     I0.6                        // 上缸已排空
AN     I0.1                        // 且无流量(转移结束)
R      Q0.3, 1                    // 关阀B
// 记录S4实测时长
MOVD   T40, VD74                  // VD_S4_Actual = T40计时值
// 置下缸状态=满
S      V1.7, 1
// 【关键】记录下缸变满时间戳(用于换水周期计算和断电恢复)
// DT10 = 当前RTC时间
// S7-200 SMART用READ_RTC读取RTC到DT10
// 简化：调用READ_RTC
LD     SM0.0
READ_RTC VB900                     // 读RTC到VB900开始的8字节(待调整地址映射)
MOVB   VB900, VB10                 // DT10 = 当前时间(年)
MOVB   VB901, VB11
MOVB   VB902, VB12
MOVB   VB903, VB13
MOVB   VB904, VB14
MOVB   VB905, VB15
MOVB   VB906, VB16
MOVB   VB908, VB17                 // 跳过星期
// 状态转移：S4→S5
MOVB   6, VB2                     // VW2=6(S5)
MOVB   0, VB3


// 注: 阀B四态诊断、内漏检测由Story 1.3补充
// 注: DT时间戳格式需与S7-200 SMART的DT数据类型对齐(T#格式)


// ============================================================
// 文件结束
// ============================================================
