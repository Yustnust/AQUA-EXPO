// ============================================================
// 文件: FC15_State_S4_Transfer.stl
// 功能: S4上→下转移 (VW2=5)
// Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成) + AQEX-8 节奏纠偏(已集成下缸满计时器清零)
// v1.1: S4入口增加下缸排空互锁(AN V1.7),静默等待 S6 排空后自动开阀
// v1.2: 新增 S4 等待计时(VD_S4Wait_Time)与超时报警(V303.2),用于补偿 S4 等待对
//       VD_S5_Elapsed 的影响,确保下缸有效实验时间严格按 VD_CycleSetpoint 跑满
// 说明: 开阀B转移,调用FC31阀B诊断(四态诊断+开关到位+超时)
//       诊断结果VW268: 0进行中/1正常完成/2故障
//       诊断正常完成 → 清零VD_S5_Elapsed+VD_S4Wait_Time+M10.7(供S5纠偏) → 转S5
// ============================================================

// 符号说明:
// v1.2 新增:
// VD380 : VD_S4Wait_Time    S4 等待时长(秒), S4 入口 V1.7=1 期间每秒 +1, S4 完成时清零
// VD382 : VD_S4WaitTimeout  S4 等待超时阈值(秒, 默认 1800=30min, HMI 可调)
// T61   : S4 等待计时器(100ms 时基, PT=VD_S4WaitTimeout×10)
// VW286 : VD_S4WaitTimeout×10 转换值(供 T61 用)
// V303.2: M_Alarm_S4TransferWaitTimeout  S4 等待超时报警(一般级, VW6=49, 仅提示不强制 S_ERROR)


NETWORK 1
// S4转液动作 + 下缸排空互锁(同NETWORK内,符合S7-200 SMART约束)
// 【业务约束】S4开始前必须确认下缸已排空(V1.7=0)
//   上缸S1~S3.5配液与下缸S6排水可并行(S5预规划不阻塞),
//   仅S4入口检查下缸状态:
//     - 下缸已空(V1.7=0)→ 启动S4转液
//     - 下缸仍满(V1.7=1)→ 等待(不报错、不停机),
//                            每周期轮询直至下缸排空完成
//   S5会在换水周期到时自动转S6排水,本FC每周期检测V1.7,
//   一旦V1.7=0,下一扫描周期自动开阀B转液
// 触发条件: 状态=S4 (VW2=5) 且 下缸=空 (V1.7=0)
// 不用 M10.4 EU:避免首周期V1.7=1时错过启动的隐患
LD     SM0.0                        // 永真,每周期执行
AW=    VW2, 5                       // 仅在S4状态(VW2=5)生效
LPS
AN     V1.7                         // 互锁闸门: V1.7=1(下缸满)屏蔽本段
// 开启阀B + 下缸NC球阀(串联主路,需得电导通)
S      Q0.3, 1
S      Q0.6, 1
// 启动S4计时器
R      T40, 1
TON    T40, 32767
// 置上缸状态=空
R      V1.6, 1
// 启动阀B诊断: 置诊断子状态=1
MOVB   1, VB262
MOVB   0, VB263
// 清诊断结果
MOVB   0, VB268
MOVB   0, VB269
// 计算VD_Timeout_ValveB(VD362)×10转换值
MOVR   VD362, VD324
*R     10.0, VD324
ROUND  VD324, AC0
MOVW   AC0, VW274
LPP
// 注: 当V1.7=1(下缸未排空)时,AN V1.7条件为假,本段S/R/计时/赋值指令全部不执行,
//     FC31(阀B诊断)在NETWORK 2 中仍会被CALL,但因Diag_State_B=0(未启动)而空转,
//     故不会产生虚假报警。下缸排空后(V1.7=0),下一周期自动开阀B转液。
// 注: 状态转出S4(VW2≠5)后,本段AW=条件不满足,本段所有动作停止。


// 【v1.2 新增】S4 等待计时 + 超时报警分支(同 NETWORK 1 内,与转液逻辑并列)
// 触发条件: 状态=S4 且 V1.7=1(下缸未空,正在等待)
//   - 启动 T61 计时器(100ms 时基, PT=VD_S4WaitTimeout×10)
//   - 每秒 VD_S4Wait_Time + 1(由 T62 1s 脉冲驱动)
//   - 等待时间 >= 阈值 → 置位 V303.2 + VW6=49(仅提示, 不强制 S_ERROR)
// 等待期间 AN V1.7 失败(转液已开始),T61 在 NETWORK 3 完成后清零
LD     SM0.0
AW=    VW2, 5                       // 仅在S4状态
A      V1.7                         // V1.7=1(下缸满)正在等待
LPS
// 首次进入 S4(V1.7=1)时计算 T61 PT(用 VD_S4WaitTimeout×10)
LD     SM0.0
EU                                  // 上升沿(仅首次进入时计算一次)
MOVR   VD382, VD384                 // VD_S4WaitTimeout → 中间变量
*R     10.0, VD384
ROUND  VD384, AC0
MOVW   AC0, VW286                   // VW286 = VD_S4WaitTimeout×10
LPP
// T61 计时(每周期执行, V1.7=1 期间计时)
LD     SM0.0
A      V1.7                         // 等待期间持续计时
R      T61, 1
TON    T61, VW286                   // PT=VD_S4WaitTimeout×10
// 每秒累加 VD_S4Wait_Time(T62 1s 脉冲)
LD     SM0.0
A      V1.7                         // 等待期间
LPS
R      T62, 1
TON    T62, 10                      // 1s(10×100ms)
LPP
LD     T62
EU
+R     1.0, VD380                   // VD_S4Wait_Time + 1s
R      T62, 1
// 超时报警: T61 到 → 置位 V303.2 + VW6=49
LD     T61
S      V303.2, 1                    // M_Alarm_S4TransferWaitTimeout
MOVW   49, VW6                      // 报警码 49(归到过程级, 与 V300.6=20 节奏级区分)
LPP
// 注: 超时报警不强制 S_ERROR, 系统继续等待, 操作员收到 HMI 提示后
//     可手动确认/调整 S6 排水, 或修改 VD_S4WaitTimeout
// 注: T61/T62 在 S4 完成时(NETWORK 3)清零; V303.2 在 S4 完成时清零

NETWORK 2
// 调用阀B诊断FC31
// FC31内部处理漫溢保护+四态诊断+开关到位+超时
LD     SM0.0
CALL ValveB_Diag


NETWORK 3
// 检查阀B诊断结果
LD     SM0.0
LPS
// 诊断正常完成 → 转S5
AW=    VW268, 1
R      T40, 1                     // 停S4计时
// 记录S4实测时长
MOVW   T40, VW380                  // 暂存定时器值(16位整数)
ITD    VW380, VD380                // 整数→双整数
DTR    VD380, VD74                 // 双整数→实数(VD_S4_Actual)
// 置下缸状态=满
S      V1.7, 1
// 【关键】记录下缸变满时间戳
LD     SM0.0
TODR VB900
MOVB   VB900, VB10                 // DT10 = 当前时间
MOVB   VB901, VB11
MOVB   VB902, VB12
MOVB   VB903, VB13
MOVB   VB904, VB14
MOVB   VB905, VB15
MOVB   VB906, VB16
MOVB   VB908, VB17
// 【Story1.4】下缸变满,清零下缸满计时器+预规划标志(供S5纠偏用)
LD     SM0.0
MOVR   0.0, VD178                  // VD_S5_Elapsed清零,开始新一轮计时
R      M10.7, 1                    // 清预规划触发标志(下轮S5重新触发)
// 【v1.2 新增】S4 等待计时清零(T61/T62/VD_S4Wait_Time/V303.2)
// 等待时长 VD_S4Wait_Time 已在 NETWORK 1 累加, 此处仅清零, FC16 改用其补偿转 S6 阈值
LD     SM0.0
R      T61, 1                      // 停 S4 等待超时计时
R      T62, 1                      // 停 S4 等待秒累加计时
MOVR   0.0, VD380                  // VD_S4Wait_Time 清零
R      V303.2, 1                   // 清 S4 等待超时报警
// 状态转移 S4→S5
LD     SM0.0
MOVW   6, VW2
LPP


// 注: 漫溢保护、四态诊断、开关到位、超时保护全部由FC31统一处理
// 注: DT时间戳格式需与S7-200 SMART的DT数据类型对齐
// 注: 断电恢复由FC0统一处理,VW2=5(S4阀B动作中断)时FC0转S_ERROR


// ============================================================
// 文件结束
// ============================================================