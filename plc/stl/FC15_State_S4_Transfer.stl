// ============================================================
// 文件: FC15_State_S4_Transfer.stl
// 功能: S4上→下转移 (VW2=5)
// Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成) + AQEX-8 节奏纠偏(已集成下缸满计时器清零)
// 说明: 开阀B转移，调用FC31阀B诊断(四态诊断+开关到位+超时)
//       诊断结果VW268: 0进行中/1正常完成/2故障
//       诊断正常完成 → 清零VD_S5_Elapsed+M10.7(供S5纠偏) → 转S5
// ============================================================

// 符号说明:
// VW262 : Diag_State_B  阀B诊断子状态
// VW268 : Diag_Result_B 阀B诊断结果
// VW274 : VD_Timeout_ValveB×10 转换值(供FC31用)


NETWORK 1
// S4首次进入动作
LD     M10.4                        // S4首次进入脉冲
EU
LPS
// 开启阀B
S      Q0.3, 1
// 启动S4计时器
R      T40, 1
TON    T40, 32767
// 置上缸状态=空
R      V1.6, 1
// 启动阀B诊断: 置诊断子状态=1
MOVB   1, VB262
MOVB   0, VB263
// 清诊断结果
MOVB   0, VB268
MOVB   0, VB269
// 计算VD_Timeout_ValveB(VD362)×10转换值
MOVR   VD362, VD324
*R     10.0, VD324
ROUND  VD324, AC0
MOVW   AC0, VW274
LPP


NETWORK 2
// 调用阀B诊断FC31
// FC31内部处理漫溢保护+四态诊断+开关到位+超时
LD     SM0.0
CALL ValveB_Diag


NETWORK 3
// 检查阀B诊断结果
LD     SM0.0
LPS
// 诊断正常完成 → 转S5
AW=    VW268, 1
R      T40, 1                     // 停S4计时
// 记录S4实测时长
MOVW   T40, VW300                  // 暂存定时器值(16位整数)
ITR    VW300, VD74                 // 转浮点存入VD74(VD_S4_Actual)
// 置下缸状态=满
S      V1.7, 1
// 【关键】记录下缸变满时间戳
LD     SM0.0
TODR VB900
MOVB   VB900, VB10                 // DT10 = 当前时间
MOVB   VB901, VB11
MOVB   VB902, VB12
MOVB   VB903, VB13
MOVB   VB904, VB14
MOVB   VB905, VB15
MOVB   VB906, VB16
MOVB   VB908, VB17
// 【Story1.4】下缸变满,清零下缸满计时器+预规划标志(供S5纠偏用)
LD     SM0.0
MOVR   0.0, VD178                  // VD_S5_Elapsed清零,开始新一轮计时
R      M10.7, 1                    // 清预规划触发标志(下轮S5重新触发)
// 状态转移 S4→S5
LD     SM0.0
MOVB   6, VB2
MOVB   0, VB3
LPP


// 注: 漫溢保护、四态诊断、开关到位、超时保护全部由FC31统一处理
// 注: DT时间戳格式需与S7-200 SMART的DT数据类型对齐
// 注: 断电恢复由FC0统一处理,VW2=5(S4阀B动作中断)时FC0转S_ERROR


// ============================================================
// 文件结束
// ============================================================
