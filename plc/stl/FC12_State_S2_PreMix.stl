// ============================================================
// 文件: FC12_State_S2_PreMix.stl
// 功能: S2预循环搅拌 (VW2=2)
// Story: AQEX-6 状态机骨架
// 说明: 开潜水泵1/2搅拌，计时到达VD_S2_Target转S3
// ============================================================

NETWORK 1: S2进入动作
// 启动潜水泵1和2
LD     SM0.0
S      Q0.0, 1                     // 潜水泵1开
S      Q0.1, 1                     // 潜水泵2开
// 启动S2计时器(对比VD_S2_Target, 单位秒需转换为100ms时基)
// VD_S2_Target(VD120)为REAL秒，T38为100ms时基，PT=VD_S2_Target×10
// 简化：用整数比较，骨架阶段假设VD_S2_Target已转换为100ms计数值存VW252
R      T38, 1
TON    T38, VW252                  // PT=VD_S2_Target转换值(待Story 1.4补充转换)
// 置上缸状态=满
S      V1.6, 1


NETWORK 2: 潜水泵流量检测（骨架）
// 潜水泵1启动后VD_Timeout_Pump1(VD58)内I0.3应ON
LD     Q0.0                        // 潜泵1已开
AN     I0.3                        // 流量开关未到
TON    T44, +100                   // 临时10s超时
LD     T44
S      V303.2, 1                   // M_Alarm_Pump1_Abnormal
MOVB   99, VB2
MOVB   0, VB3

// 潜水泵2同理
LD     Q0.1
AN     I0.4
TON    T45, +100
LD     T45
S      V303.3, 1                   // M_Alarm_Pump2_Abnormal
MOVB   99, VB2
MOVB   0, VB3


NETWORK 3: 预循环完成转移至S3
LD     T38                         // 计时到达
R      Q0.0, 1                    // 停潜水泵1
R      Q0.1, 1                    // 停潜水泵2
MOVB   3, VB2                     // VW2=3(S3)
MOVB   0, VB3


// ============================================================
// 文件结束
// ============================================================
