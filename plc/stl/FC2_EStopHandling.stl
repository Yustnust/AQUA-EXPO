// ============================================================
// 文件: FC2_EStopHandling.stl
// 功能: 急停与安全处理（每周期调用，优先级最高）
// Story: AQEX-6 状态机骨架 + AQEX-9 急停双通道+安全继电器反馈(详细实现)
// 说明: 急停检测(I1.1 上升沿:NO 闭合)→锁存V300.4→转S_ERROR  v1.3 NO 进 I1.1
//       安全继电器反馈延时校验(2秒)→V300.5继电器故障最高级报警
//       输出强制安全(QB0=0,Q0.7声音开)
//       急停解除与系统复位由FC19(State_Error)处理
// ============================================================

// 符号说明:
// I1.1  : DI_EStop           急停反馈(常开 NO,OFF=正常,ON=急停触发)  v1.3 改为接 NO 触点
// I1.2  : DI_SafetyRelay_FB  安全继电器辅助反馈(ON=动力回路已断开确认)
// V300.4: M_EStop_Latch      急停触发锁存(漫溢级,强制人工确认)
// V300.5: M_Alarm_SafetyRelay 安全继电器故障(最高级,强制人工确认)
// VW2   : 状态机状态(FC2写99转S_ERROR)
// VW6   : 报警码(99=继电器故障,10=急停)
// T35   : 安全继电器反馈延时(PT=20,2秒)
// M10.7 : 预规划触发标志(急停时清,防止S5残留)


NETWORK 1
// 急停触发检测(I1.1 上升沿) + 锁存 + 转S_ERROR  v1.3: NO 进 PLC,上升沿触发
// I1.1接常开 NO:OFF=正常,ON=急停触发 (v1.3 NC 改去 MSR-P,NO 进 PLC I1.1)
// NO 触点按下时 I1.1 变 ON,EU 上升沿检测"按下瞬间"
LD     I1.1
EU
S      V300.4, 1                  // M_EStop_Latch锁存
MOVW   99, VW2                    // VW2=99(转S_ERROR)
// 清预规划标志(防止S5残留干扰)
R      M10.7, 1


NETWORK 2
// 安全继电器反馈延时校验
// 急停锁存后,2秒内I1.2应反馈"动力回路已断开"(I1.2=ON)
// I1.2定义:ON=动力回路已断开确认(辅助触点反馈)
// 若2秒后I1.2仍OFF → 主触点可能粘连,继电器故障
LD     V300.4                      // 急停已锁存
AN     I1.2                        // 且反馈未到位(动力回路未确认断开)
TON    T35, 20                     // 2秒延时(20×100ms)

LD     T35                         // 延时到达
EU
S      V300.5, 1                   // M_Alarm_SafetyRelay(最高级报警)


NETWORK 3
// 急停锁存时输出强制安全
// 急停锁存时,每周期强制QB0=0(泵停/阀关/NC电磁阀失电=安全)
// Q0.7报警声音开(急停立即报警)
// Q8.0灯光不在此处理,由FC3报警处理统一管理(避免双写冲突)
LD     V300.4                      // M_EStop_Latch
MOVB   0, QB0                     // 潜水泵停/阀A/B/C关/NC电磁阀失电(关闭=安全)
S      Q0.7, 1                     // 报警声音开


NETWORK 4
// 报警码写入(优先级:继电器故障99 > 急停10)
LD     V300.5                      // 继电器故障(最高级)
MOVW   99, VW6                    // VW6=99
JMP    1

LD     V300.4                      // 急停(无继电器故障)
AN     V300.5
MOVW   10, VW6                    // VW6=10

LBL    1


// 注: 急停解除与系统复位逻辑在FC19(State_Error)中处理
// 注: Q8.0报警灯光由FC3 AlarmHandling按VW6优先级统一管理(Story 1.6)
// 注: 安全继电器反馈延时2秒兼顾机械动作时间与故障捕获灵敏度
// 注: 急停硬件回路(安全继电器切断动力电)不经过PLC,本FC仅处理软件层面


// ============================================================
// 文件结束
// ============================================================
