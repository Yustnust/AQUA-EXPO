// ============================================================
// 文件: FC2_EStopHandling.stl
// 功能: 急停与安全处理（每周期调用，优先级最高）
// Story: AQEX-6 状态机骨架（详细逻辑由Story 1.5填充）
// 说明: 急停检测→强制转S_ERROR；安全继电器反馈检测
// ============================================================

NETWORK 1: 急停触发检测
// I1.1为急停按钮第二组常闭触点，ON=正常，OFF=急停触发
LD     I1.1                         // 急停反馈(常闭)
NOT                                 // 取反：急停按下时I1.1=OFF，NOT后=ON
=      L60.0                        // 中转

// 急停触发：强制转S_ERROR + 锁存
LD     L60.0
EU                                 // 上升沿检测（急停按下瞬间）
MOVB   99, VB2                     // VW2=99(S_ERROR)
MOVB   0, VB3
S      V300.4, 1                   // M_EStop_Latch=1


NETWORK 2: 安全继电器反馈检测
// I1.2为安全继电器辅助反馈触点
// 若M_EStop_Latch=1(急停已锁存)且I1.2超时未反馈→继电器故障
// 骨架阶段简化：急停锁存后T35计时2s，若I1.2仍OFF则报警
LD     V300.4                      // M_EStop_Latch
AN     I1.2                        // 且安全继电器未反馈(动力回路未切断)
TON    T35, 20                     // 2秒延时(20×100ms=2s)

LD     T35                         // 延时到达
S      V300.5, 1                   // M_Alarm_SafetyRelay=1(最高级报警)


NETWORK 3: 急停状态下的输出强制安全
// 无论当前VW2是什么状态，急停锁存时强制输出安全状态
LD     V300.4                      // M_EStop_Latch
MOVB   0, QB0                      // 潜水泵停、电动球阀关、NC电磁阀失电(关闭=安全)
R      Q1.0, 1                     // 报警灯光关(由FC3统一管理报警输出)
S      Q0.7, 1                     // 报警声音开(急停触发立即报警)


// 注: 急停解除与系统复位逻辑在FC19(State_Error)中处理
// 注: 详细安全联锁、双通道诊断由Story 1.5补充


// ============================================================
// 文件结束
// ============================================================
