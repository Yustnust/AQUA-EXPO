// ============================================================
// 文件: FC16_State_S5_Run.stl
// 功能: S5 实验运行中 (VW2=6)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-8 节奏纠偏)
// 说明: v2.2 S5 仅负责:
//       1. 下缸满计时 VD_S5_Elapsed 累加
//       2. 实验时长累加 VD_ExperimentDuration_Accum
//       3. 换水周期到达转 S6 (VD_S5_Elapsed >= 阈值, 阈值 = 86400/VD414 - VD426 - VD430)
//       4. 实验时长达标转 S7
//   v2.2 删除:
//       - 原三层纠偏预规划 (VD_CycleSetpoint×60 触发)
//       - 启动 VW2=1 (上缸配液) 触发逻辑 (改由 FC40 触发下一轮 S1)
//       - VD354 / VW182 / VW184 / VD112 / VD150 / VD154 引用
//       - M10.7 预规划标志 (改由 FC40 M16.1 替代)
// ============================================================

NETWORK 1
// 下缸满计时器 VD_S5_Elapsed 累加(仅下缸=满期间,每秒+1)
LD     SM0.0
LPS
A      V1.7                         // 下缸=满才计时
R      T60, 1
TON    T60, 10                      // 1秒(10×100ms)
LPP
LD     T60
EU
+R     1.0, VD178                   // VD_S5_Elapsed + 1
R      T60, 1                       // 重置进入下一秒
// 注: 断电恢复时 VD_S5_Elapsed 由 FC0_SysInit 用 RTC 重算


NETWORK 2
// 实验时长累加(仅下缸=满期间,每分钟+1)
// VD_ExperimentDuration_Accum(VD366)每分钟+1
LD     V1.7                         // 下缸=满
R      T47, 1
TON    T47, 600                     // 60秒(600×100ms)
LD     T47
EU
+R     1.0, VD366                    // VD_ExperimentDuration_Accum + 1(分钟)


NETWORK 3
// 换水周期到达 - 转 S6 排水
// 【v2.2 改动】换水周期阈值由 VD_CycleSetpoint×60 改为 T_single = 86400/VD414
//   v2.2 T_single = 86400 / VD414 - VD426 - VD430 (FC40 NETWORK 1 已算在 VD186)
//   但 S5 不直接调 FC40, 这里用简化判断: VD_S5_Elapsed >= 阈值
//   阈值由 FC40 NETWORK 4 准备 (VW194 = S6_actual × 10), 但 PV 是 100ms 时基比较麻烦
//   简化: 直接用 VD186 (T_cycle 秒值) 与 VD_S5_Elapsed 比较

LD     SM0.0
LPS
AR>=   VD178, VD186                // VD_S5_Elapsed >= T_cycle(秒)?
R      M10.7, 1                    // 清预规划标志(防御性,保留兼容)
R      T60, 1                      // 停下缸满计时器
MOVW   7, VW2                      // →S6 排水(VW2=7)
LPP


NETWORK 4
// 实验时长达标 - 转 S7 实验结束
// VD_ExperimentDuration_Accum >= VD_ExperimentTarget → 实验结束
// 同时检查换水次数: VW306 >= VD414 (24h 换水目标次数)
LD     SM0.0
LPS
AR>=   VD366, VD24                  // 累计时长 >= 目标时长(min)
AR>=   VW306, VD414                // 【v2.2 新增】换水次数 >= 目标次数
R      T41, 1                      // 停周期计时
R      T60, 1                      // 停下缸满计时器
R      M10.7, 1                    // 清预规划标志
MOVW   8, VW2                      // →S7 (VW2=8)
LPP


// 注: v2.2 S5 不再调 FC40 预规划(三层纠偏已删除)
// 注: v2.2 S5 不再触发 VW2=1(上缸配液,改由 FC40 M16.1 触发下一轮 S1)
// 注: v2.2 S5 不再调用 RhythmCorrection (FC40 改由 OB1 顶层调度,见 OB1 NET 6.5)
// 注: 周期阈值 VD186 在每周期 OB1 NET 6.5 调 FC40 时计算并刷新
// 注: HMI 手动停止命令由 FC2 统一处理(S1~S6 均响应),FC16 不再单独处理
// 注: 断电恢复由 FC0 统一处理,VW2=6 (S5 无阀门动作) 时 FC0 保持 S5 并重算 VD_S5_Elapsed

// ============================================================
// 文件结束
// ============================================================