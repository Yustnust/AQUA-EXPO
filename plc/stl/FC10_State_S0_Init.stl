// ============================================================
// 文件: FC10_State_S0_Init.stl
// 功能: S0初始化状态 (VW2=0)
// Story: AQEX-6 状态机骨架
// 说明: 等待HMI启动命令，无活动报警时转S1
// ============================================================

NETWORK 1
// S0状态输出（安全待命）
// 仅复位Q0.0~Q0.6(泵/阀/NC电磁阀),Q0.7报警声音由FC3统一管理,避免本FC与FC3双写导致闪亮
LD     SM0.0
R      Q0.0, 7                     // 泵停、阀A/B/C关、NC电磁阀失电(关闭),保留Q0.7


NETWORK 2
// 检测启动命令 - 带上缸液位前置条件
// V0.0(CMD_Start)上升沿 AND 无活动报警(VW6=0) AND 上缸空(I0.6=ON) → 转S1
// ★ 2026-09-11 新增硬件液位开关检查
// 原实现只查 VW6=0，遗漏了上缸必须排空才能启动的前置条件
// 用户现场: 上缸有液体(I0.6=OFF=低位开关未闭合=未排空)时点启动,
//           系统直接进S1开阀A进水,等于往未排空的缸里继续加液,与设计不符
// 为什么只查上缸(I0.6)不查下缸(I1.0):
//   S1是上缸进水阶段,只动上缸;下缸有水不影响S1的任何动作,
//   所以启动前置只卡 I0.6(上缸排空)即可,下缸状态在S4/S6阶段各自互锁
// 为什么用硬件开关而不是软件V1.6:
//   V1.6/V1.7 是软件标志,冷启动/复位时被 FC0 强制复位为1(空),
//   是假阳性;必须用硬件液位开关 I0.6(NPN常闭,液体低于探针闭合=I=1=上缸排空)
// 启动条件:
//   V0.0↑        — 用户点启动
//   AND VW6=0    — 无活动报警(FC3管理)
//   AND I0.6=ON  — 上缸排空(NPN常闭低液位,闭合=液体低于探针)
//
// STL实现说明:
//   1. MOVR/MOVW/S/R 等盒指令依赖 RLO(EN),必须用 LD SM0.0 强制 EN=1 才能无条件执行。
//   2. JMP 是条件跳转,RLO=1 才跳,所以"条件不满足"要先 NOT 再 JMP。
//   3. 用 LPS/LPP 保存/恢复 V0.0 的 EU 上升沿结果,确保 R V0.0 只在有启动脉冲时执行。
// 结构:
//   EU触发 → (VW6=0 AND I0.6=ON)?
//     是 → 播种+转态 → JMP到 LBL2 清 V0.0
//     否 → JMP到 LBL1/2 → 恢复 EU → 仅 EU=1 时清 V0.0
// V301.7 提示位已废弃,HMI 侧用 VW2=0 AND I0.6=OFF 条件弹窗。

// 保存启动脉冲,串联三个条件
LD     V0.0                        // CMD_Start
EU                                 // 上升沿检测,只触发一次
LPS                                // 压栈保存 EU 结果
AW=    VW6, 0                      // AND 无活动报警
A      I0.6                        // AND 上缸排空(NPN常闭,I0.6=ON=液体低于探针)
NOT                                // 条件不满足时 RLO=1
JMP    1                           // 任一条件不满足 → 跳到 LBL1 只清命令位

// 三个条件全满足 → 执行启动
LD     SM0.0                       // 强制 EN=1,盒指令无条件执行
// 【首轮播种】滚动值初始化为HMI设定的默认值
MOVR   VD144, VD112                // T滚动值 ← T默认值(HMI设定)
MOVR   VD108, VD116                // S6滚动值 ← S6默认值(HMI设定)
// 状态转移：S0→S1
MOVW   1, VW2                      // VW2=1(S1)
// 握手确认
S      V1.0, 1                     // STA_StartAck=1
JMP    2                           // 跳到 LBL2 清命令位

LBL    1                           // ← 条件不满足入口
LBL    2                           // ← 结束汇聚点
LPP                                // 弹栈恢复 EU 结果
// 清除启动命令位(只有检测到上升沿时才清,防止每周期无条件清0)
R      V0.0, 1


// 注: 急停触发由FC2强制VW2=99，此处不处理
// 注: S7实验结束后HMI确认重启也走此路径(经S_ERROR解除后回S0)


// ============================================================
// 文件结束
// ============================================================
