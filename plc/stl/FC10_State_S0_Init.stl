// ============================================================
// 文件: FC10_State_S0_Init.stl
// 功能: S0初始化状态 (VW2=0)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架)
// 说明: v2.2 首轮由 FC10 一次性触发上缸 S1 (VW418=1) + 下缸进 S5 空等
//       后续轮次由 FC17 在 S6 完成时切 M16.0 并清 M16.1,触发下一轮 S1
//   修复记录:
//     2026-09-11 新增硬件液位开关检查 (I0.6)
//     【v2.2 修订 2026-09-15】首轮触发上缸 VW418=1 + 下缸 VW2=6 (S5 空等)
//     【2026-09-29修复】启动网络重写: 补M10.2置位(v2.2丢失,致阀A永不动作) + V0.0两条路径都消费
// ============================================================

NETWORK 1
// S0状态输出(安全待命)
// 仅复位Q0.0~Q0.6(泵/阀/NC电磁阀),Q0.7报警声音由FC3统一管理
// 【v10.4硬件变更】Q0.6(下缸NC阀)已去除,保留未使用;R Q0.0,7清零无害
LD     SM0.0
R      Q0.0, 7                     // 泵停、阀A/B/C关、上缸NC阀失电,保留Q0.7


// v2.2 首轮启动逻辑
// 启动条件:
//   V0.0↑(CMD_Start 上升沿)
//   AND VW6=0  (无活动报警)
//   AND I0.6=ON (上缸排空,NPN常闭,液体低于探针闭合)
// 启动动作(一次性播种):
//   1. VW418 = 1 (上缸直接进入 S1 进水, OB1 上缸调度 FC11;
//      首轮不再需要 M16.1 触发脉冲, 避免与 FC40 NET5 触发路径双写)
//   2. S M10.2 = 1 (S1首次进入标志) 【2026-09-29修复】v2.2重构丢失的置位点:
//      无此置位则FC11入口门(LD M10.2/AW=VW260,0)永不通,阀A/上缸NC阀/诊断全部不启动
//   3. 清 M16.1 (防御性清旧触发脉冲, 首轮不置位)
//   4. S M16.0 = 1 (首轮固定使用 TimerA)
//   5. MOVW 6, VW2 (下缸直接进 S5 空等,不经过 S1/S2/S3/S4)
//   6. S V1.0 (启动确认)
//   7. R V0.0 (清启动命令位,成功/失败两条路径都消费)

// 【2026-09-29修复】原LPS/LPP+NOT+双LBL结构存在两个隐患:
//   (a) M10.2无置位点(本次修复);
//   (b) 条件不满足(JMP 1)时V0.0不被消费,启动命令悬空至HMI松键,语义不干净;
//   改为V60.0/V60.1草稿位缓存(与FC11的V61.1同套路),去掉全部栈操作。
// 注意: V60.0/V60.1为FC10专用扫描周期内草稿位,不跨块、不保持。

// 缓存启动脉冲(本扫描周期内有效)
LD     V0.0
EU
=      V60.0

// 三个条件全满足 → 允许播种
LD     V60.0
AW=    VW6, 0
A      I0.6
=      V60.1

// v2.2 首轮启动(一次性播种)
LD     V60.1
MOVW   1, VW418                     // 【v2.3修复】首轮直接播种上缸 S1 (原清0无意义,首轮无入口则液体永远转不下去)
S      M10.2, 1                     // 【2026-09-29修复】补S1首次进入标志置位(FC11入口门)
R      M16.1, 1                     // 防御性清旧触发脉冲(后续轮次由 OB1 消费 M16.1 置 VW418=1)
S      M16.0, 1                     // 首轮固定使用 TimerA (VD248)
// 【v2.2】下缸直接进 S5 空等(S4 转移由 FC40/FC17 触发,不再由 VW2=1~4 推进)
MOVW   6, VW2                      // VW2=6 (S5 实验运行态,S5 等待 S4 转移条件)
S      V1.0, 1                      // STA_StartAck=1

// 消费启动命令(仅脉冲周期执行;成功/失败两条路径都清,避免命令悬空)
LD     V60.0
R      V0.0, 1


// 注: 急停触发由 FC2 强制 VW2=99,此处不处理
// 注: S7 实验结束后 HMI 确认重启也走此路径(经 S_ERROR 解除后回 S0)
// 注: v2.2 与 v2.1 关键区别: 首轮不再走 S1→S2→S3→S4 串行上电逻辑
//       上缸配液 (VW418 子流程) 与下缸实验 (VW2 路径) 并行

// ============================================================
// 文件结束
// ============================================================
