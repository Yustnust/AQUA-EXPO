// ============================================================
// 文件: FC10_State_S0_Init.stl
// 功能: S0初始化状态 (VW2=0)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架)
// 说明: v2.2 首轮由 FC10 一次性触发上缸 S1 (VW304=1) + 下缸进 S5 空等
//       后续轮次由 FC17 在 S6 完成时切 M16.0 并清 M16.1,触发下一轮 S1
//   修复记录:
//     2026-09-11 新增硬件液位开关检查 (I0.6)
//     【v2.2 修订 2026-09-15】首轮触发上缸 VW304=1 + 下缸 VW2=6 (S5 空等)
// ============================================================

NETWORK 1
// S0状态输出(安全待命)
// 仅复位Q0.0~Q0.6(泵/阀/NC电磁阀),Q0.7报警声音由FC3统一管理
LD     SM0.0
R      Q0.0, 7                     // 泵停、阀A/B/C关、NC电磁阀失电,保留Q0.7


// v2.2 首轮启动逻辑
// 启动条件:
//   V0.0↑(CMD_Start 上升沿)
//   AND VW6=0  (无活动报警)
//   AND I0.6=ON (上缸排空,NPN常闭,液体低于探针闭合)
// 启动动作(一次性播种):
//   1. VW304 = 1 (上缸进入 S1 进水, OB1 NET 7 调度 FC11)
//   2. 清 M16.1 (清旧触发脉冲)
//   3. 置 M16.1 (触发首轮 S1)
//   4. S M16.0 = 1 (首轮固定使用 TimerA)
//   5. MOVW 6, VW2 (下缸直接进 S5 空等,不经过 S1/S2/S3/S4)
//   6. S V1.0 (启动确认)
//   7. R V0.0 (清启动命令位)

// 保存启动脉冲,串联三个条件
LD     V0.0
EU
LPS
AW=    VW6, 0
A      I0.6
NOT
JMP    1

// 三个条件全满足 → v2.2 首轮启动
LD     SM0.0
// 【v2.2新增】上缸子流程状态初始化
MOVW   0, VW304                     // 上缸状态清零(防御性)
R      M16.1, 1                     // 清旧触发脉冲
S      M16.1, 1                     // 触发首轮 S1 (OB1/FC11 响应)
S      M16.0, 1                     // 首轮固定使用 TimerA (VD248)
// 【v2.2】下缸直接进 S5 空等(S4 转移由 FC40/FC17 触发,不再由 VW2=1~4 推进)
MOVW   6, VW2                      // VW2=6 (S5 实验运行态,S5 等待 S4 转移条件)
S      V1.0, 1                      // STA_StartAck=1
JMP    2

LBL    1
LBL    2
LPP
R      V0.0, 1                      // 清启动命令位(仅 EU=1 时清)


// 注: 急停触发由 FC2 强制 VW2=99,此处不处理
// 注: S7 实验结束后 HMI 确认重启也走此路径(经 S_ERROR 解除后回 S0)
// 注: v2.2 与 v2.1 关键区别: 首轮不再走 S1→S2→S3→S4 串行上电逻辑
//       上缸配液 (VW304 子流程) 与下缸实验 (VW2 路径) 并行

// ============================================================
// 文件结束
// ============================================================
