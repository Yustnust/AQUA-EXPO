// ============================================================
// 文件: FC10_State_S0_Init.stl
// 功能: S0初始化状态 (VW2=0)
// Story: AQEX-6 状态机骨架
// 说明: 等待HMI启动命令，无活动报警时转S1
// ============================================================

NETWORK 1
// S0状态输出（安全待命）
// 仅复位Q0.0~Q0.6(泵/阀/NC电磁阀),Q0.7报警声音由FC3统一管理,避免本FC与FC3双写导致闪亮
LD     SM0.0
R      Q0.0, 7                     // 泵停、阀A/B/C关、NC电磁阀失电(关闭),保留Q0.7


NETWORK 2
// 检测启动命令
// V0.0(CMD_Start)上升沿 AND 无活动报警(VW6=0) → 转S1
LD     V0.0                        // CMD_Start
EU                                 // 上升沿检测
LPS
AW=    VW6, 0                      // 无活动报警
// 状态转移：S0→S1
MOVW   1, VW2                     // VW2=1(S1)
// 握手确认
S      V1.0, 1                    // STA_StartAck=1
// 清除启动命令位（防止重复触发）
R      V0.0, 1
LPP


// 注: 急停触发由FC2强制VW2=99，此处不处理
// 注: S7实验结束后HMI确认重启也走此路径(经S_ERROR解除后回S0)


// ============================================================
// 文件结束
// ============================================================
