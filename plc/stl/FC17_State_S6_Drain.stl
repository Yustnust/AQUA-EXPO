// ============================================================
// 文件: FC17_State_S6_Drain.stl
// 功能: S6 下缸排水 (VW2=7)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-7 阀门诊断)
// 说明: v2.2 S6 完成后状态转移按 VW304 分支:
//       - VW304=3 (上缸已配完) + 结束条件满足 → S7
//       - VW304=3 (上缸已配完) + 结束条件未满足 → S4 (VW2=5, 启动转移) + VW306+1 + M16.0 切
//       - VW304≠3 (上缸未配完) → 保持等待,不报警
//       后续下一轮 S1 由 FC40 (M16.1 触发条件) 在 FC15 S4 完成后切 M16.0 时启动
// ============================================================

NETWORK 1
// S6 首次进入动作 - 开阀C
LD     M10.7                        // S6 首次进入脉冲(FC16 NET 3 触发 M10.7 后)
EU
LPS
S      Q0.4, 1                      // 开阀C
R      T42, 1
TON    T42, 32767
MOVB   1, VB264
MOVB   0, VB265
MOVW   0, VW270
// 计算 VD_Timeout_ValveC(VD54)×10 转换值
MOVR   VD54, VD328
*R     10.0, VD328
ROUND  VD328, AC0
MOVW   AC0, VW276
LPP


NETWORK 2
// 调用阀C诊断
LD     SM0.0
CALL ValveC_Diag


NETWORK 3
// 检查阀C诊断结果
LD     SM0.0
LPS
AW=    VW270, 1                    // 阀C诊断正常完成
R      T42, 1                      // 停S6计时
// 记录 S6 实测时长到 VD116 (用于 FC40 S6 触发阈值)
MOVW   T42_PV, AC0
ITD    AC0, VD444                  // → DINT
DTR    VD444, VD444                // → REAL(原值秒)
MOVR   VD444, VD116                // VD116 = S6 实测秒(后续轮次用)
LPP


NETWORK 4
// 排水完成 → 状态转移 (v2.2 按 VW304 分支)
//
// 情况 1: 上缸已配完 (VW304=3) + 结束条件满足 → S7
LD     SM0.0
AW=    VW304, 3                    // 上缸已配完
AW=    VW6, 0                      // 无报警(FC3 管理)
AR>=   VD366, VD24                 // 实验时长累计 >= 目标(min)
AR>=   VW306, VD414                // 换水次数 >= 目标
MOVW   8, VW2                      // → S7

// 情况 2: 上缸已配完 (VW304=3) + 结束条件未满足 → S4 + 计数 + 切计时器
LD     SM0.0
AW=    VW304, 3                    // 上缸已配完
AW=    VW6, 0                      // 无报警
AN     (结束条件)
MOVW   5, VW2                      // → S4 (转移)
INCW   VW306                       // 换水计数 +1
NOT    M16.0                       // 切双倒计时器标记
// VW304 仍保持 3 (FC15 S4 启动后改为 4)

// 情况 3: 上缸未配完 (VW304≠3) → 保持等待,不报警
LDW<>  VW304, 3
// 无动作,等上缸配完自然进 S4
// 注: 此时 V1.7=0(已排空)但上缸未配完,系统空转等待
//      不会触发 24h 换水次数超时报警(那是 FC40 T46/T48 到 0 才报)


// 注: 四态诊断、开关到位、超时保护全部由 FC32 统一处理
// 注: VD_S6_Rolling 滚动平均算法由 FC17 直接覆盖(简单实现)
// 注: 断电恢复由 FC0 统一处理,VW2=7 (S6 阀C动作中断) 时 FC0 转 S_ERROR
// 注: 【v2.2】原"实验未结束 → S5,已结束 → S7"二元判断改为三元判断(增加上缸配完分支)

// ============================================================
// 文件结束
// ============================================================