// ============================================================
// 文件: FC17_State_S6_Drain.stl
// 功能: S6下缸排水 (VW2=7)
// Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成)
// 说明: 开阀C排水，调用FC32阀C诊断(四态诊断+开关到位+超时)
//       诊断结果VW270: 0进行中/1正常完成/2故障
// ============================================================

// 符号说明:
// VW264 : Diag_State_C  阀C诊断子状态
// VW270 : Diag_Result_C 阀C诊断结果
// VW276 : VD_Timeout_ValveC×10 转换值(供FC32用)


NETWORK 1
// S6首次进入动作
LD     M10.7                        // S6首次进入脉冲
EU
LPS
// 开启阀C
S      Q0.4, 1
// 启动S6计时器
R      T42, 1
TON    T42, 32767
// 启动阀C诊断: 置诊断子状态=1
MOVB   1, VB264
MOVB   0, VB265
// 清诊断结果
MOVW   0, VW270
// 计算VD_Timeout_ValveC(VD54)×10转换值
MOVR   VD54, VD328
*R     10.0, VD328
ROUND  VD328, AC0
MOVW   AC0, VW276
LPP


NETWORK 2
// 调用阀C诊断FC32
// FC32内部处理四态诊断+开关到位+超时(阀C无漫溢保护)
LD     SM0.0
CALL ValveC_Diag


NETWORK 3
// 检查阀C诊断结果
LD     SM0.0
LPS
// 诊断正常完成 → 排水完成处理
AW=    VW270, 1
R      T42, 1                     // 停S6计时
// 记录S6实测时长
MOVD   T42, VD78                  // VD_S6_Actual
// 更新VD_S6_Rolling(滚动实测)
MOVR   VD78, VD116                // VD_S6_Rolling
// 置下缸状态=空
R      V1.7, 1
LPP


NETWORK 4
// 排水后状态转移
// 若实验未结束(换水周期内) → 返回S5
// 若实验已结束(M10.6标志) → 转S7
LD     SM0.0
LPS
AN     M10.6                       // 实验未结束
MOVB   6, VB2                     // 返回S5
MOVB   0, VB3
LPP

LD     M10.6                       // 实验已结束
R      M10.6, 1
MOVB   8, VB2                     // 转S7
MOVB   0, VB3


// 注: 四态诊断、开关到位、超时保护全部由FC32统一处理
// 注: VD_S6_Rolling滚动平均算法(非直接覆盖)由Story 1.4细化


// 注: 断电恢复由FC0统一处理,VW2=7(S6阀C动作中断)时FC0转S_ERROR
// ============================================================
// 文件结束
// ============================================================
