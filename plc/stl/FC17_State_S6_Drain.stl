// ============================================================
// 文件: FC17_State_S6_Drain.stl
// 功能: S6 下缸排水 (VW2=7)
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架 + AQEX-7 阀门诊断)
// 说明: v2.2 S6 完成后状态转移按 VW304 分支:
//       - VW304=3 (上缸已配完) + 结束条件满足 → S7
//       - VW304=3 (上缸已配完) + 结束条件未满足 → S4 (VW2=5, 启动转移) + VW400+1 + M16.0 切
//       - VW304≠3 (上缸未配完) → 保持等待,不报警
//       后续下一轮 S1 由 FC40 (M16.1 触发条件) 在 FC15 S4 完成后切 M16.0 时启动
// 【v10.4硬件变更】VW276=VD_Timeout_ValveC(VD54)×10、VW284=VD_Delay_ValveC_Verify(VD472)×10【2026-09-24由VD60迁来】,
//       由本FC计算写入,供FC32(阀C诊断)作T56/T57/T58/T101的PT
// ============================================================

NETWORK 1
// S6 首次进入动作 - 开阀C
// [已修复 v2.2] 用 V62.0 缓存 EU 结果,避免 LPS/LPP 内 S/R 链栈空
LD     M10.7                        // S6 首次进入脉冲(FC16 NET 3 触发 M10.7 后)
EU
=      V62.0
LD     V62.0
S      Q0.4, 1                      // 开阀C
LD     V62.0
R      T42, 1
TON    T42, 32767
LD     V62.0
MOVB   1, VB264
LD     V62.0
MOVB   0, VB265
LD     V62.0
MOVW   0, VW270
// 计算 VD_Timeout_ValveC(VD54)×10 转换值
LD     V62.0
MOVR   VD54, VD328
*R     10.0, VD328
ROUND  VD328, AC0
MOVW   AC0, VW276
// 计算 VD_Delay_ValveC_Verify(VD472)×10 转换值【v10.4硬件变更新增】
// 【2026-09-24迁移】原VD60废弃：VB60~VB63与v2.2修复的V60.x~V63.x EU缓存位区重叠,
//   每扫描周期被各FC的"= V6x.x"线圈重写, 浮点值闪变/变NaN(位型污染), 迁至VD472(全程序无占用)
LD     V62.0
MOVR   VD472, VD328
*R     10.0, VD328
ROUND  VD328, AC0
MOVW   AC0, VW284


// 调用阀C诊断
LD     SM0.0
CALL ValveC_Diag


// 检查阀C诊断结果
// [已修复 v2.2] 用 V62.1 缓存诊断完成条件,避免 LPS/LPP+NOT 配合下的 S/R 链栈空
LD     SM0.0
AB=    VB270, 1                    // 阀C诊断正常完成(VB270=1)
=      V62.1
LDN    V62.1
JMP    10                          // 未完成 → 跳过
// 【v2.3修复】先读T42当前值再复位(R在前读到的恒为0)
LD     V62.1
MOVW   T42, AC0
ITD    AC0, VD444                  // → DINT
DTR    VD444, VD444                // → REAL(原值秒)
LD     V62.1
MOVR   VD444, VD116                // VD116 = S6 实测秒(后续轮次用)
LD     V62.1
R      T42, 1                      // 停S6计时(读后复位)
LD     V62.1
R      V1.7, 1                     // 【v2.3修复】排水完成→下缸=空
                                   // (原无任何FC在S6完成时清V1.7, 下一轮S4的"AN V1.7"
                                   //  永不满足, 换水循环在第二轮起卡死)
LBL    10


// 排水完成 → 状态转移 (v2.2 按 VW304 分支)
//
// 情况 1: 上缸已配完 (VW304=3) + 结束条件满足 → S7
LD     SM0.0
AW=    VW304, 3                    // 上缸已配完
AW=    VW6, 0                      // 无报警(FC3 管理)
LPS
AR>=   VD366, VD24                 // 实验时长累计 >= 目标(min)
LPP
LPS
ITD    VW400, AC0                  // 换水次数 INT → DINT 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】
DTR    AC0, AC0                    // → REAL
AR>=   AC0, VD414                  // 换水次数 >= 目标
LPP
ALD                                // 两个结束条件同时满足
NOT
JMP    11                          // 不满足 → 检查情况 2
MOVW   8, VW2                      // → S7
JMP    13                          // 跳到末尾

LBL    11
// 情况 2: 上缸已配完 (VW304=3) + 结束条件未满足 → S4 + 计数 + 切计时器
LD     SM0.0
AW=    VW304, 3                    // 上缸已配完
AW=    VW6, 0                      // 无报警
NOT
JMP    12                          // 上缸未配完 → 情况 3
MOVW   5, VW2                      // → S4 (转移)
INCW   VW400                       // 换水计数 +1 【v2.3.2迁移: 原VW306与手动命令位V306.0~V307.3重叠】
LD     M16.0
NOT
=      M16.0                       // 切双倒计时器标记
JMP    13

LBL    12
// 情况 3: 上缸未配完 (VW304≠3) → 保持等待,不报警
// 无动作,等上缸配完自然进 S4
// 注: 此时 V1.7=0(已排空)但上缸未配完,系统空转等待
//      不会触发 24h 换水次数超时报警(那是 FC40 VD248/VD252 >= T_cycle 才报)

LBL    13


// 注: 【v10.4硬件变更】FC32已改为「液位低位+VD_Delay_ValveC_Verify延时验证」判定排水完成
//      开关到位、超时保护仍由 FC32 统一处理
// 注: VD_S6_Rolling 滚动平均算法由 FC17 直接覆盖(简单实现)
// 注: 断电恢复由 FC0 统一处理,VW2=7 (S6 阀C动作中断) 时 FC0 转 S_ERROR
// 注: 【v2.2】原"实验未结束 → S5,已结束 → S7"二元判断改为三元判断(增加上缸配完分支)

// ============================================================
// 文件结束
// ============================================================
