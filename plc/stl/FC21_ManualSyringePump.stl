NETWORK 1
// 孤儿态自恢复
// [已修复 v2.2] 用 V62.2 缓存条件,避免 R 指令链栈空
LDW<>  VW390, 0
AW<>   VW390, 30
AN     M11.6
AN     M11.7
AN     M12.0
AN     M13.5
AN     M13.6
=      V62.2
LD     V62.2
MOVW   0, VW390
LD     V62.2
R      M13.7, 1


// 启动命令检测 - 仅空闲态(VW390=0)响应
// [已修复 v2.2] 用 V62.3 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.2
EU
AW=    VW390, 0
=      V62.3
LD     V62.3
MOVR   0.0, VD392
LD     V62.3
MOVR   VD452, VD396
LD     V62.3
R      M13.5, 3                       // 【2026-10-08 v2.4.0】连续复位M13.5~M13.7
                                       //   (警告830超界精简; M13.5/6/7位相邻)
LD     V62.3
R      M12.0, 1
LD     V62.3
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7,
                                       //   M11.7全程序无置位点,合并安全
LD     V62.3
MOVW   1, VW390
LD     V62.3
R      V307.2, 1


// 停止命令检测 - 非空闲态响应
// [已修复 v2.2] 用 V62.4 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.3
EU
AW<>   VW390, 0
=      V62.4
LD     V62.4
S      M13.7, 1
LD     V62.4
R      V307.3, 1


// 全局错误检测
// [已修复 v2.2] 用 V62.5 缓存全局错误条件,避免 R 指令链栈空
LDW=   VW390, 1
OW=    VW390, 2
OW=    VW390, 3
LD     V303.4
LD     SM0.0
AW>=   VW4, 4
OLD
ALD
=      V62.5
LD     V62.5
MOVW   99, VW390
LD     V62.5
R      M13.5, 3                       // 【2026-10-08 v2.4.0】连续复位M13.5~M13.7
LD     V62.5
R      M12.0, 1
LD     V62.5
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7


// 子状态1-1 - 计算本次抽液步数
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD396, VD102
/R     VD350, VD102
ROUND  VD102, AC0
DTR    AC0, VD102                // 【2026-10-08修复 v2.3.9】MOVR→DTR:
                                 //   ROUND输出DINT(4800=0x00001290),MOVR位拷贝后
                                 //   按REAL解读为denormal≈0,步数蒸发→恒走回零分支
LD     SM0.0
AR>=   VD102, 6000.0             // 【2026-10-08 v2.4.0】原JMP 10/LBL结构改直通比较覆盖:
MOVR   6000.0, VD102             //   先ROUND/DTR再判>=6000覆盖,与原分支逐值等价,省4条指令


// 子状态1-2 - 检查步数并下发抽液指令(40006)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V60.4
LD     V60.4
AR>    VD102, 0.0                // 【2026-10-08修复 v2.3.9】直接REAL比较:
                                 //   原ROUND后AC0为DINT,小整数bit模式=denormal≈0,
                                 //   AR>恒假→永远走回零,与VD452设定无关
JMP    12
// [已修复 v2.2] 复用 V60.4 缓存条件,补齐 R/S 链前面的 LD
LD     V60.4
R      M12.0, 1
LD     V60.4
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V60.4
MOVW   3, VW390
JMP    13
LBL    12
ROUND  VD102, AC0                // 【2026-10-08修复 v2.3.9】ROUND从比较前移至这里
MOVW   AC0, VW204
MOVW   AC0, VW230
MOVD   16#9C46, VD232
LD     V60.4
S      M11.6, 1
LD     V60.4
S      M13.5, 1
LBL    13


// 子状态1-3 - 抽液写失败处理
// [已修复 v2.2] 用 V64.0 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
A      V303.4
=      V64.0
LD     V64.0
MOVW   99, VW390
LD     V64.0
R      M13.5, 3                       // 【2026-10-08 v2.4.0】连M13.6一并清: 状态1下
                                       //   M13.6必为0(仅2-1置位,那时VW390=2),等价
LD     V64.0
R      M12.0, 1
LD     V64.0
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7


// 子状态1-3 - 抽液写成功处理
// [已修复 v2.2] 用 V64.1 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
AN     V303.4
=      V64.1
LD     V64.1
R      M12.0, 1
LD     V64.1
R      M11.6, 1


// 子状态1-4 - 等待抽液执行完成
// [已修复 v2.2] 用 V65.4 缓存条件,避免 R 指令链栈空
LD     M13.5
AW=    VW390, 1
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V65.4
LD     V65.4
R      M13.5, 1
LD     V65.4
MOVW   2, VW390


// 子状态1-5 - 【2026-10-08新增 v2.3.9】抽液段响应停止请求 → 转回零
// 原设计缺陷: 停止请求M13.7仅在排液完成后(2-4)消费,抽液段(VW390=1)按"关"
//   只置位无人响应 → 活塞停在抽取位无法回零。此处补上抽液段的停止消费点。
// 门控VW4<>2: 泵运动(100)中先等它停(就绪0/空闲1均可停),停止期间不再下发新写
LD     SM0.0
AW=    VW390, 1
A      M13.7
AN     M11.6
AN     M11.7
AN     M12.0
AW<>   VW4, 2
=      V66.0
LD     V66.0
R      M13.5, 3                       // 【2026-10-08 v2.4.0】连M13.6一并清(状态1下必为0)
LD     V66.0
R      M12.0, 1
LD     V66.0
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V66.0
MOVW   3, VW390


// 子状态2-1 - 下发排液指令(40007)
// [已修复 v2.2] 用 V65.3 缓存条件,避免 S 指令链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V65.3
LD     V65.3
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232
LD     V65.3
S      M11.6, 1
LD     V65.3
S      M13.6, 1


// 子状态2-2 - 排液写失败处理
// [已修复 v2.2] 用 V64.2 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 2
A      V303.4
=      V64.2
LD     V64.2
MOVW   99, VW390
LD     V64.2
R      M13.6, 2                       // 【2026-10-08 v2.4.0】连续复位M13.6~M13.7
LD     V64.2
R      M12.0, 1
LD     V64.2
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7


// 子状态2-2 - 排液写成功处理
// [已修复 v2.2] 用 V64.3 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 2
AN     V303.4
=      V64.3
LD     V64.3
R      M12.0, 1
LD     V64.3
R      M11.6, 1


// 子状态2-3 - 等待排液执行完成,累加本循环体积
// [已修复 v2.2] 用 V64.4 缓存条件,避免 S/R 链栈空
LD     M13.6
AW=    VW390, 2
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V64.4
LD     V64.4
MOVR   VD102, AC0
LD     V64.4
*R     VD350, AC0
LD     V64.4
+R     AC0, VD392
LD     V64.4
-R     AC0, VD396
LD     V64.4
R      M13.6, 1


// 子状态2-4 - 判断分支: 停止请求 → 回零
// [已修复 v2.2] 用 V64.5 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
A      M13.7
=      V64.5
LD     V64.5
R      M12.0, 1
LD     V64.5
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V64.5
MOVW   3, VW390


// 子状态2-4 - 判断分支: 单次模式 → 回零
// [已修复 v2.2] 用 V64.6 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 0
=      V64.6
LD     V64.6
R      M12.0, 1
LD     V64.6
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V64.6
MOVW   3, VW390


// 子状态2-4 - 判断分支: 循环模式且累计>=目标 → 回零
// [已修复 v2.2] 用 V64.7 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR>=   VD392, VD452
=      V64.7
LD     V64.7
R      M12.0, 1
LD     V64.7
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V64.7
MOVW   3, VW390


// 子状态2-4 - 判断分支: 循环模式且未完成 → 返回子状态1
// [已修复 v2.2] 用 V65.0 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR<    VD392, VD452
=      V65.0
LD     V65.0
R      M12.0, 1
LD     V65.0
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V65.0
MOVW   1, VW390


// 子状态3-1 - 下发回零(复位)指令 40003=1
LD     SM0.0
LDW=   VW390, 3
OW=    VW390, 30
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
AW=    VW510, 0
O      T104
MOVW   1, VW230
MOVD   16#9C43, VD232
S      M11.6, 1
MOVW   30, VW390


// T104冷却定时器
LD     M12.0
AW=    VW390, 30
AW>    VW510, 0
TON    T104, 50


// 子状态3-2 - 回零写失败处理
// [已修复 v2.2] 用 V65.1 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 30
A      V303.4
=      V65.1
LD     V65.1
MOVW   99, VW390
LD     V65.1
R      M13.7, 1
LD     V65.1
R      M12.0, 1
LD     V65.1
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V65.1
R      T104, 1


// 子状态3-2 - 回零写成功处理
// [已修复 v2.2] 用 V65.2 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 30
AN     V303.4
=      V65.2
LD     V65.2
R      M12.0, 1
LD     V65.2
R      M13.5, 3                       // 【2026-10-08 v2.4.0】连续复位M13.5~M13.7
LD     V65.2
R      M11.6, 2                       // 【2026-10-08 v2.4.0】连续复位M11.6~M11.7
LD     V65.2
R      T104, 1
LD     V65.2
MOVW   4, VW390
