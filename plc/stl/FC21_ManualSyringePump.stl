// ============================================================
// 文件: FC21_ManualSyringePump.stl
// 功能: 手动注射泵控制 (由OB1仅在S0态调用)
// Story: AQEX-60 手动控制页 + 手动注射泵控制
// 说明:
//       手动启停注射泵,按参数页设定的总加药量执行单次/循环吸液排液
//       单次模式: 吸液→排液→回零→完成
//       循环模式: 循环吸/排直至累计量>=总加药量,然后回零完成
//       停止按钮为"软停止": 置停止请求,当前吸/排液周期完成后回零
//       复用FC4任务4写接口(VD232/VW230/M11.6/M11.7/M12.0)
//       仅在S0态由OB1调用,与S3(FC13)互斥,不会同时使用写接口
// ============================================================

// 符号说明:
// V3.6  : CMD_Manual_SyringePump_Start 手动注射泵启动(脉冲)
// V3.7  : CMD_Manual_SyringePump_Stop  手动注射泵停止/回零(脉冲)
// VD384 : VD_ManualDose_Target 手动总加药量(µL,HMI设定)
// VW388 : VW_ManualDose_Mode   手动模式 0=单次 1=循环
// VW390 : VW_ManualDose_State  手动子状态
//         0=空闲 1=抽液中 2=排液中 3=回零中 4=完成 99=错误
// VD392 : VD_ManualDose_Dosed     手动本轮累计加药量(µL,内部)
// VD396 : VD_ManualDose_Remaining 手动剩余待加药量(µL,内部)
// VD350 : VD_StepResolution 单步分辨率(µL/步)
// VD102 : VD_Dose_Steps 本次循环步数(REAL,复用FC13临时区,S0/S3互斥)
// VW204 : MB_Pump_Aspirate 抽液步数缓冲(映射40006)
// VW206 : MB_Pump_Dispense 排液步数缓冲(映射40007)
// VD232 : PumpWrite_Addr FC06写目标Modbus地址
// VW230 : PumpWrite_Data FC06写数据
// M11.6 : PumpWrite_Req    写请求(FC21置位,FC4任务4执行后清零)
// M11.7 : PumpWrite_Busy   写忙标志(FC4管理)
// M12.0 : PumpWrite_Done   写完成(FC4置位,FC21清零)
// M13.5 : ManualPump_Asp_Issued  手动抽液已下发(已下发40006)
// M13.6 : ManualPump_Disp_Issued 手动排液已下发(已下发40007)
// M13.7 : ManualPump_StopReq     手动停止请求
// V303.4: M_Alarm_SyringePump 注射泵通讯/动作异常
// VW4   : 注射泵归一化状态码(0=就绪,1=运行,>=4=错误)
// ============================================================


NETWORK 1
// 启动命令检测 - 仅空闲态(VW390=0)响应
LD     SM0.0
A      V3.6
EU
AW=    VW390, 0
MOVR   0.0, VD392
MOVR   VD384, VD396
R      M13.7, 1
R      M13.5, 1
R      M13.6, 1
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   1, VW390
R      V3.6, 1


NETWORK 2
// 停止命令检测 - 非空闲态响应
LD     SM0.0
A      V3.7
EU
AW<>   VW390, 0
S      M13.7, 1
R      V3.7, 1


NETWORK 3
// 全局错误检测 - 仅忙碌子状态(1/2/3)且(通讯故障或状态码错误)
LDW=   VW390, 1
OW=    VW390, 2
OW=    VW390, 3
LD     V303.4
LD     SM0.0
AW>=   VW4, 4
OLD
ALD
MOVW   99, VW390
R      M13.5, 1
R      M13.6, 1
R      M13.7, 1
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1


NETWORK 4
// 子状态1-1 - 计算本次抽液步数
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD396, VD102
/R     VD350, VD102
AR>=   VD102, 6000.0
JMP    10
ROUND  VD102, AC0
MOVR   AC0, VD102
JMP    11
LBL    10
MOVR   6000.0, VD102
LBL    11


NETWORK 5
// 子状态1-2 - 检查步数有效性并下发抽液指令(40006)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
ROUND  VD102, AC0
AR>    AC0, 0.0
JMP    12
// 步数<=0: 直接回零
LD     SM0.0
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   3, VW390
JMP    13
LBL    12
// 步数>0: 下发抽液
MOVW   AC0, VW204
MOVW   AC0, VW230
MOVD   40006, VD232
S      M11.6, 1
S      M13.5, 1
LBL    13


NETWORK 6
// 子状态1-3 - 抽液写失败处理
LD     M12.0
AW=    VW390, 1
A      V303.4
MOVW   99, VW390
R      M13.5, 1
R      M13.7, 1
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1


NETWORK 7
// 子状态1-3 - 抽液写成功处理
LD     M12.0
AW=    VW390, 1
AN     V303.4
R      M12.0, 1
R      M11.6, 1


NETWORK 8
// 子状态1-4 - 等待抽液执行完成(状态码=0就绪)
LD     M13.5
AW=    VW390, 1
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
R      M13.5, 1
MOVW   2, VW390


NETWORK 9
// 子状态2-1 - 下发排液指令(40007)
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AN     M11.6
AN     M11.7
AN     M12.0
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   40007, VD232
S      M11.6, 1
S      M13.6, 1


NETWORK 10
// 子状态2-2 - 排液写失败处理
LD     M12.0
AW=    VW390, 2
A      V303.4
MOVW   99, VW390
R      M13.6, 1
R      M13.7, 1
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1


NETWORK 11
// 子状态2-2 - 排液写成功处理
LD     M12.0
AW=    VW390, 2
AN     V303.4
R      M12.0, 1
R      M11.6, 1


NETWORK 12
// 子状态2-3 - 等待排液执行完成,累加本循环体积
LD     M13.6
AW=    VW390, 2
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD102, AC0
*R     VD350, AC0
+R     AC0, VD392
-R     AC0, VD396
R      M13.6, 1


NETWORK 13
// 子状态2-4 - 判断分支: 停止请求 → 回零
LD     SM0.0
AW=    VW390, 2
AN     M13.6
A      M13.7
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   3, VW390


NETWORK 14
// 子状态2-4 - 判断分支: 单次模式 → 回零
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 0
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   3, VW390


NETWORK 15
// 子状态2-4 - 判断分支: 循环模式且累计>=目标 → 回零
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR>=   VD392, VD384
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   3, VW390


NETWORK 16
// 子状态2-4 - 判断分支: 循环模式且未完成 → 返回子状态1继续
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR<    VD392, VD384
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
MOVW   1, VW390


NETWORK 17
// 子状态3-1 - 下发回零(复位)指令 40003=1
LD     SM0.0
AW=    VW390, 3
AN     M11.6
AN     M11.7
AN     M12.0
MOVW   1, VW230
MOVD   40003, VD232
S      M11.6, 1


NETWORK 18
// 子状态3-2 - 回零写失败处理
LD     M12.0
AW=    VW390, 3
A      V303.4
MOVW   99, VW390
R      M13.7, 1
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1


NETWORK 19
// 子状态3-2 - 回零写成功处理
LD     M12.0
AW=    VW390, 3
AN     V303.4
R      M12.0, 1
R      M13.5, 1
R      M13.6, 1
R      M13.7, 1
R      M11.6, 1
R      M11.7, 1
MOVW   4, VW390


// ============================================================
// 文件结束
// 说明:
//   1. 子状态机VW390: 0空闲/1抽液中/2排液中/3回零中/4完成/99错误
//   2. 每次吸/排液通过FC4任务4(VD232/VW230/M11.6)下发,FC4置M12.0完成
//   3. M13.5/M13.6记录"已下发",M13.7记录软停止请求
//   4. 手动模式用独立累计VD392/剩余VD396,不影响自动S3的VD370/VD372/VD378
//   5. 停止按钮为软停止(M13.7),当前吸/排周期完成后回零
//   6. 通讯异常(V303.4)或状态码错误(VW4>=4)时立即转错误(VW390=99)
//   7. 步数不足(剩余<1步)直接回零,不追加无效吸排
// ============================================================