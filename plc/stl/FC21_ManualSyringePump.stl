// ============================================================
// 文件: FC21_ManualSyringePump.stl
// 功能: 手动注射泵控制(HMI画面3, 命令位V307.2启动/V307.3停止)
// 项目: 药液配置与加注控制系统
// PLC: S7-200 SMART CPU ST20
// 说明: 本文件为语句表(STL)格式，可参考导入STEP 7-Micro/WIN SMART
//
// 【2026-10-08 v2.4.1 重构】对齐FC13泵协议,修复"只能吸液"等4项缺陷:
//   1.【用户报修】原流程吸液后无强停(9C42),泵停在100态回不到96就绪,
//     排液指令永不下发→手动"开"只能执行吸液。
//     现全链路采用FC13同款协议: 写抽液→等运动→强停→等就绪→写排液
//     →等运动→强停→等就绪→结算,吸/排液连续自动执行完毕。
//   2.【竞争冒险】原"等执行完成"仅判VW4=0,无运动开始检测:
//     写完成瞬间泵尚未起振(VW4仍=0)即误判完成,可能跳过吸液直发排液。
//     现引入FC13同款M12.1/M12.2运动标志(VW4=2曾出现才认完成)。
//     M12.1/M12.2与FC13共用安全: FC13仅VW418=2(自动S2)执行,
//     FC21仅VW2=0(S0手动)执行,两FC调用条件互斥(见OB1)。
//   3.【看门狗误杀】原NET1孤儿态看门狗排除表只有{0,30}:
//     状态3(回零)及排液结算后(M13.6=0)均被下一扫描判"无活动"强制清0,
//     导致回零从未执行、排液后分支判断不可达。现NET1重定义为
//     "非法值回收"(仅拦截非{0~9,90,99}的损坏值),状态前进改由
//     T102/V303.4/FC4超时保证;99错误态显式1扫描自恢复(原由看门狗
//     顺带实现,语义不变)。
//   4.【超时保护】原手动流程无运动超时,泵卡100态死等。现补T102(30s),
//     超时按FC13同款策略走强停恢复而非报错;回零等待另加T102看门狗。
//   附: 原停止请求在吸液段的消费点(1-5)改为转强停(原直转回零,
//     泵在100态时回零写永远等不到VW4=0,死锁),强停后统一在状态4判停止。
//
// 状态表(VW390):
//   0  空闲(启动命令仅空闲态响应)
//   1  写抽液+等抽液运动(40006;M13.5=吸液阶段进行中;
//      M12.1运动开始检测+T102 30s超时)
//   2  【保留未用】
//   3  强停1(40002=1,恢复96就绪)
//   4  等就绪1(VW4=0;停止请求M13.7→9回零,否则→5)
//   5  写排液+等排液运动(40007;M13.6=排液阶段进行中;
//      M12.2运动开始检测+T102 30s超时)
//   6  【保留未用】
//   7  强停2(40002=1)
//   8  等就绪2+结算(VD392累计/VD396扣减;单次/完成/停止→9,循环→1)
//   9  回零(40003=1,活塞归零;T102看门狗防VW4卡非0)
//   90 回零冷却(T104 5s,VW510连续写失败时延迟重试)
//   99 错误(1扫描后自恢复回0,报警由V303.4经FC3上报告警画面)
//
// 符号说明:
// V307.2 : CMD_Manual_SyringePump_Start (HMI→PLC启动命令,EU触发)
// V307.3 : CMD_Manual_SyringePump_Stop  (HMI→PLC停止/回零命令,EU触发)
// VW388  : ManualDose_Mode 手动模式(0=单次,1=循环,SBR25冷启动置0)
// VW390  : 手动注射泵子状态(见状态表,HMI只读)
// VD392  : ManualDose_Dosed 已加药累计(uL)
// VD396  : ManualDose_Remaining 剩余待加药量(uL)
// VD452  : ManualDose_Target 手动注射泵总加药量目标(uL,HMI设定)
// VD350  : StepResolution 单步分辨率(uL/步)
// VD102  : 本次循环步数(REAL,与FC13共用显示/调试地址)
// VW204  : MB_Pump_Aspirate 抽液步数缓冲(调试查看)
// VW206  : MB_Pump_Dispense 排液步数缓冲(调试查看)
// VD232/VW230 : FC06写目标地址/数据(FC4任务4消费)
// M11.6  : PumpWrite_Req 写请求(FC21置位,FC4执行后清零)
// M11.7  : PumpWrite_Busy 写忙(FC4管理)
// M12.0  : PumpWrite_Done 写完成(FC4置位,FC21清零)
// M12.1  : Pump_Asp_Started 抽液运动已开始(VW4曾=2,与FC13共用)
// M12.2  : Pump_Disp_Started 排液运动已开始(VW4曾=2,与FC13共用)
// M13.5  : 吸液阶段进行中(状态1~4保护标志,防NET1误回收)
// M13.6  : 排液阶段进行中(状态5~8保护标志)
// M13.7  : 停止请求(停止命令置位,状态4/8消费,回零成功清除)
// VW4    : 注射泵归一化状态码(0=就绪96,1=空闲64,2=运动中100,>=4=错误)
// V303.4 : M_Alarm_SyringePump 注射泵通讯/动作异常(FC4置位)
// VW510  : 写任务连续失败计数(FC4管理,>=5次置V303.4)
// T102   : 运动/回零超时定时器(30s,与FC13共用,互斥安全)
// T104   : 回零写冷却定时器(5s)
// ============================================================

NETWORK 1
// 非法状态自恢复(v2.4.1重定义: 仅回收损坏值,不再充当活动看门狗)
// 原看门狗条件(AN M13.5/M13.6判"无活动")会误杀正常流程:
//   ①旧状态3(回零)不在排除表→转入后1扫描即被清0,回零从未执行;
//   ②旧2-3排液结算清M13.6后→下一扫描被清0,分支判断永远不可达。
// v2.4.1起各状态前进由T102/V303.4/FC4通讯超时保证,无需活动看门狗。
LDW<   VW390, 0
LDW>   VW390, 9
AW<>   VW390, 90
AW<>   VW390, 99
OLD
=      V62.2
LD     V62.2
MOVW   0, VW390
LD     V62.2
R      M13.5, 3
LD     V62.2
R      M12.0, 3
LD     V62.2
R      M11.6, 2
LD     V62.2
R      T102, 1
LD     V62.2
R      T104, 1


// 启动命令检测 - 仅空闲态(VW390=0)响应
// v2.4.1: 清零扩展M12.1/M12.2(运动标志)与T102,防上一轮残留
LD     SM0.0
A      V307.2
EU
AW=    VW390, 0
=      V62.3
LD     V62.3
MOVR   0.0, VD392
LD     V62.3
MOVR   VD452, VD396
LD     V62.3
R      M13.5, 3
LD     V62.3
R      M12.0, 3
LD     V62.3
R      M11.6, 2
LD     V62.3
R      T102, 1
LD     V62.3
MOVW   1, VW390
LD     V62.3
R      V307.2, 1


// 停止命令检测 - 非空闲态置停止请求,由状态4/8统一消费
LD     SM0.0
A      V307.3
EU
AW<>   VW390, 0
=      V62.4
LD     V62.4
S      M13.7, 1
LD     V62.4
R      V307.3, 1


// 全局错误检测 - 所有活动状态(0/99除外)
// v2.4.1: 由原仅{1,2,3}扩为全活动态,强停/等就绪/回零段错误不漏检
LDW<>  VW390, 0
AW<>   VW390, 99
LD     V303.4
LD     SM0.0
AW>=   VW4, 4
OLD
ALD
=      V62.5
LD     V62.5
MOVW   99, VW390
LD     V62.5
R      M13.5, 3
LD     V62.5
R      M12.0, 3
LD     V62.5
R      M11.6, 2
LD     V62.5
R      T102, 1


// 子状态1-1 - 计算本次抽液步数(剩余量/单步分辨率,上限6000步)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD396, VD102
/R     VD350, VD102
ROUND  VD102, AC0
DTR    AC0, VD102                // 【2026-10-08 v2.3.9】MOVR→DTR:
                                 //   ROUND输出DINT,MOVR位拷贝按REAL解读为
                                 //   denormal≈0,步数蒸发→恒走回零分支
LD     SM0.0
AR>=   VD102, 6000.0             // 【2026-10-08 v2.4.0】先ROUND/DTR后比较覆盖:
MOVR   6000.0, VD102             //   与原JMP/LBL分支逐值等价,省4条指令


// 子状态1-2 - 检查步数并下发抽液指令(40006)
// v2.4.1: 不足一步→回零(原→3,语义不变,编号变了)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V60.4
LD     V60.4
AR>    VD102, 0.0                // 【2026-10-08 v2.3.9】直接REAL比较
JMP    12
LD     V60.4
R      M12.0, 1
LD     V60.4
R      M11.6, 2
LD     V60.4
MOVW   9, VW390
JMP    13
LBL    12
ROUND  VD102, AC0
MOVW   AC0, VW204
MOVW   AC0, VW230
MOVD   16#9C46, VD232            // ★十六进制地址(40006=16#9C46)
LD     V60.4
S      M11.6, 1
LD     V60.4
S      M13.5, 1                  // 吸液阶段开始(状态1~4保护标志)
LBL    13


// 子状态1-3 - 抽液写失败处理
LD     M12.0
AW=    VW390, 1
A      V303.4
=      V64.0
LD     V64.0
MOVW   99, VW390
LD     V64.0
R      M13.5, 3
LD     V64.0
R      M12.0, 1
LD     V64.0
R      M11.6, 2


// 子状态1-3 - 抽液写成功处理(清握手,留在状态1等运动)
LD     M12.0
AW=    VW390, 1
AN     V303.4
=      V64.1
LD     V64.1
R      M12.0, 1
LD     V64.1
R      M11.6, 1


// 子状态1段 - 【v2.4.1新增】等抽液运动完成(替代原"只判VW4=0"的1-4)
// T102: 30秒超时(防止泵卡100态),超时走强停恢复而非报错(同FC13策略)
// M12.1: 抽液运动已开始(VW4曾=2),未开始不认完成(修竞争冒险)
LD     SM0.0
AW=    VW390, 1
A      M13.5
TON    T102, 300                 // 30秒(300×100ms)
LD     SM0.0
AW=    VW390, 1
A      M13.5
AW=    VW4, 2
S      M12.1, 1
// 运动完成→强停1
LD     M12.1
AW=    VW390, 1
AW<>   VW4, 2
R      T102, 1
MOVW   3, VW390
// 超时→强停1(防止卡死,同FC13)
LD     T102
AW=    VW390, 1
R      T102, 1
MOVW   3, VW390


// 子状态1-4 - 【v2.4.1修订】吸液段停止请求 → 转强停(原直转回零会死锁:
// 泵若已起振停在100态,回零写等VW4=0永远不满足;强停可恢复96再回零)
// 门控VW4<>2: 泵运动中先等它停,与T102超时路径互补
LD     SM0.0
AW=    VW390, 1
A      M13.7
AN     M11.6
AN     M11.7
AN     M12.0
AW<>   VW4, 2
=      V66.0
LD     V66.0
R      T102, 1
LD     V66.0
MOVW   3, VW390


// 子状态3 - 强停1(40002=1,恢复96就绪)
// ★强停无需就绪门控: 用于运动恢复,不检查VW4=0(同FC13子状态3/7)
LD     SM0.0
AW=    VW390, 3
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230                  // 强停数据=1
MOVD   16#9C42, VD232            // ★十六进制地址(40002=16#9C42)
S      M11.6, 1
LPP


// 子状态3 - 强停1写失败处理
LD     M12.0
AW=    VW390, 3
A      V303.4
=      V66.1
LD     V66.1
MOVW   99, VW390
LD     V66.1
R      M13.5, 3
LD     V66.1
R      M12.0, 1
LD     V66.1
R      M11.6, 2


// 子状态3 - 强停1写成功处理 → 等就绪1
LD     M12.0
AW=    VW390, 3
AN     V303.4
=      V66.2
LD     V66.2
R      M12.0, 1
LD     V66.2
R      M11.6, 1
LD     V66.2
MOVW   4, VW390


// 子状态4 - 等泵恢复就绪(VW4=0=96就绪态),消费停止请求
// v2.4.1: 停止请求在此统一判定(原在吸液/排液各自段内零散处理)
LD     SM0.0
AW=    VW390, 4
AW=    VW4, 0
=      V66.3
// 停止请求→回零
LD     V66.3
A      M13.7
=      V66.4
LD     V66.4
R      M13.5, 3                  // 清吸液阶段标志+停止请求
LD     V66.4
R      M12.0, 3                  // 清M12.1运动标志
LD     V66.4
R      M11.6, 2
LD     V66.4
R      T102, 1
LD     V66.4
MOVW   9, VW390
// 正常→写排液
LD     V66.3
AN     M13.7
=      V66.5
LD     V66.5
R      M13.5, 1
LD     V66.5
R      M12.0, 3                  // 清M12.1运动标志
LD     V66.5
R      M11.6, 2
LD     V66.5
R      T102, 1
LD     V66.5
MOVW   5, VW390


// 子状态5-1 - 下发排液指令(40007)
LD     SM0.0
AW=    VW390, 5
AN     M13.6
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V65.3
LD     V65.3
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232            // ★十六进制地址(40007=16#9C47)
LD     V65.3
S      M11.6, 1
LD     V65.3
S      M13.6, 1                  // 排液阶段开始(状态5~8保护标志)


// 子状态5-2 - 排液写失败处理
LD     M12.0
AW=    VW390, 5
A      V303.4
=      V64.2
LD     V64.2
MOVW   99, VW390
LD     V64.2
R      M13.6, 2
LD     V64.2
R      M12.0, 1
LD     V64.2
R      M11.6, 2


// 子状态5-2 - 排液写成功处理(清握手,留在状态5等运动)
LD     M12.0
AW=    VW390, 5
AN     V303.4
=      V64.3
LD     V64.3
R      M12.0, 1
LD     V64.3
R      M11.6, 1


// 子状态5段 - 【v2.4.1新增】等排液运动完成(替代原"只判VW4=0"的2-3)
LD     SM0.0
AW=    VW390, 5
A      M13.6
TON    T102, 300                 // 30秒(300×100ms)
LD     SM0.0
AW=    VW390, 5
A      M13.6
AW=    VW4, 2
S      M12.2, 1
// 运动完成→强停2
LD     M12.2
AW=    VW390, 5
AW<>   VW4, 2
R      T102, 1
MOVW   7, VW390
// 超时→强停2
LD     T102
AW=    VW390, 5
R      T102, 1
MOVW   7, VW390


// 子状态7 - 强停2(40002=1)
LD     SM0.0
AW=    VW390, 7
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230
MOVD   16#9C42, VD232
S      M11.6, 1
LPP


// 子状态7 - 强停2写失败处理
LD     M12.0
AW=    VW390, 7
A      V303.4
=      V67.0
LD     V67.0
MOVW   99, VW390
LD     V67.0
R      M13.6, 2
LD     V67.0
R      M12.0, 1
LD     V67.0
R      M11.6, 2


// 子状态7 - 强停2写成功处理 → 等就绪2
LD     M12.0
AW=    VW390, 7
AN     V303.4
=      V67.1
LD     V67.1
R      M12.0, 1
LD     V67.1
R      M11.6, 1
LD     V67.1
MOVW   8, VW390


// 子状态8 - 等泵恢复就绪+结算(仅首个VW4=0扫描执行,M13.6门控防重复累加)
// v2.4.1: 结算从原2-3(排液写后)移至此处(排液运动真正完成后),口径与
//   FC13子状态8一致: 只有排液实际执行过,才累计VD392/扣减VD396
LD     SM0.0
AW=    VW390, 8
AW=    VW4, 0
A      M13.6
=      V67.2
LD     V67.2
MOVR   VD102, AC0                // AC0 = 本次循环步数(REAL)
LD     V67.2
*R     VD350, AC0                // AC0 = 本次循环体积(µL)
LD     V67.2
+R     AC0, VD392                // 累计已加药量
LD     V67.2
-R     AC0, VD396                // 扣减剩余量
LD     V67.2
R      M13.6, 1                  // 结算完成,放行分支判断
LD     V67.2
R      M12.0, 3                  // 清M12.2运动标志
LD     V67.2
R      M11.6, 2
LD     V67.2
R      T102, 1


// 子状态8 - 分支a: 停止请求 → 回零
LD     SM0.0
AW=    VW390, 8
AN     M13.6
A      M13.7
=      V64.5
LD     V64.5
MOVW   9, VW390
// 子状态8 - 分支b: 单次模式 → 回零
LD     SM0.0
AW=    VW390, 8
AN     M13.6
AW=    VW388, 0
=      V64.6
LD     V64.6
MOVW   9, VW390
// 子状态8 - 分支c: 循环模式且累计>=目标 → 回零
LD     SM0.0
AW=    VW390, 8
AN     M13.6
AW=    VW388, 1
AR>=   VD392, VD452
=      V64.7
LD     V64.7
MOVW   9, VW390
// 子状态8 - 分支d: 循环模式且未完成 → 返回状态1下一轮
LD     SM0.0
AW=    VW390, 8
AN     M13.6
AW=    VW388, 1
AR<    VD392, VD452
=      V65.0
LD     V65.0
MOVW   1, VW390


// 子状态9 - 回零(40003=1,活塞归零)
// v2.4.1: T102兼作回零看门狗——泵若卡非0态(VW4≠0),30秒后报99,
//   不再无限等待;正常路径进9时泵已就绪(状态4/8以VW4=0为转移条件)
LD     SM0.0
AW=    VW390, 9
TON    T102, 300
LD     T102
AW=    VW390, 9
MOVW   99, VW390
// 写回零指令
LD     SM0.0
AW=    VW390, 9
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
AW=    VW510, 0                  // 无连续写失败才写(VW510>0等T104冷却)
O      T104
MOVW   1, VW230
MOVD   16#9C43, VD232            // ★十六进制地址(40003=16#9C43)
S      M11.6, 1
MOVW   90, VW390


// T104冷却定时器(回零写连续失败时,5秒后允许重试)
LD     M12.0
AW=    VW390, 90
AW>    VW510, 0
TON    T104, 50                  // 5秒(50×100ms)


// 子状态90 - 回零写失败处理
LD     M12.0
AW=    VW390, 90
A      V303.4
=      V65.1
LD     V65.1
MOVW   99, VW390
LD     V65.1
R      M13.7, 1
LD     V65.1
R      M12.0, 1
LD     V65.1
R      M11.6, 2
LD     V65.1
R      T104, 1


// 子状态90 - 回零写成功处理 → 回空闲
// v2.4.1: 直接回0(原→4由孤儿看门狗间接回0,现显式化,少一个状态)
LD     M12.0
AW=    VW390, 90
AN     V303.4
=      V65.2
LD     V65.2
R      M12.0, 1
LD     V65.2
R      M13.5, 3                  // 清停止请求及全部阶段标志
LD     V65.2
R      M11.6, 2
LD     V65.2
R      T104, 1
LD     V65.2
R      T102, 1
LD     V65.2
MOVW   0, VW390


// 子状态99 - 错误自恢复(1扫描后回空闲)
// v2.4.1: 原由NET1看门狗顺带实现(99不在排除表→1扫描清0),NET1重定义
//   后此处显式实现,语义不变;报警可见性由V303.4经FC3报警画面保证
LDW=   VW390, 99
=      V67.3
LD     V67.3
R      M13.5, 3
LD     V67.3
R      M12.0, 3
LD     V67.3
R      M11.6, 2
LD     V67.3
R      T102, 1
LD     V67.3
MOVW   0, VW390


// ============================================================
// 文件结束
// 说明:
//   1. 全流程与FC13(自动加药)同一泵协议: 每段运动后发强停(40002=1)
//      恢复96就绪态,再执行下一段——这是"只能吸液"问题的根治
//   2. 运动检测: VW4=2(100运动中)→M12.1/M12.2置位,VW4≠2且已开始→完成
//   3. 运动超时: T102(30秒)防泵卡死,超时走强停恢复(同FC13,不报错);
//      回零等待另由T102看门狗保护(卡非0态30秒后报99)
//   4. M12.1/M12.2/T102与FC13共用安全: FC13仅VW418=2执行,FC21仅
//      VW2=0执行,互斥(OB1调度保证);SBR25冷启动已清M12.1/12.2
//   5. NET1(非法值回收)只拦截非{0~9,90,99}的损坏值;各状态前进由
//      T102/V303.4/FC4超时保证,不再需要活动看门狗
//      (2/6为保留未用编号,NET1合法集含之无害)
//   6. HMI地址零变化: VW388/VW390/VD392/VD396/V307.2/V307.3语义不变
//      (VW390状态编号已重排,见文件头状态表;HMI仅显示累计/剩余量,
//      不显示子状态编号)
//   7. 所有Modbus地址使用十六进制格式(16#9C46/16#9C47/16#9C42/16#9C43)
//      避免十进制大数被解析为INT导致MBUS_MSG Error=6
//   8. JMP/LBL(12/13)在本NETWORK内,无跨NETWORK跳转问题(问题#21教训)
// ============================================================
