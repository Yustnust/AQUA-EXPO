// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-33修复 + AQEX-5完善(错误重试+降级)
// 说明: 轮询注射泵(站号1)+流量计(站号2),基于Done位顺序轮询
//       含3次重试机制 + 降级模式(连续失败5次→进入降级,使用上一有效值)
//       超时检测(10秒/任务无Done响应→报警)
//
// ★★★ 2026-09-08 重大重构: 单MBUS_MSG结构 ★★★
//   原因: STL中CALL MBUS_MSG是无条件调用,即使EN=0也会进入子程序
//         4个CALL MBUS_MSG同时存在时,库状态机被反复进入导致Error=6
//   解决: 参照FC99设计,只用1个CALL MBUS_MSG
//         用VW290任务号选择参数(VB400~VW406变量)
//         DataPtr统一用&VB410,读完再复制到目标地址
//
// ★★★ 重要! STL调用Modbus RTU Master库函数必须用符号名! ★★★
//   正确: CALL MBUS_CTRL, 参数...
//   正确: CALL MBUS_MSG, 参数...
//   错误: CALL SBR20, ...
//   错误: CALL SBR21, ...
// ============================================================

// 符号说明:
// VW290 : 轮询任务号(0=注射泵状态码, 1=流量计累计值, 2=注射泵位置, 4=写命令)
// VW292 : 当前任务重试计数(0~3,3次失败标记本任务失败)
// VW294 : 注射泵连续失败计数(≥5次→降级模式)
// VW296 : 流量计连续失败计数(≥5次→降级模式)
// M10.0 : 当前任务Done位(MBUS_MSG输出,LAD引脚,复用)
// M10.4 : 注射泵降级模式标志(1=使用上一有效值)
// M10.5 : 流量计降级模式标志
// M11.0 : MBUS_CTRL Done位(LAD引脚,每周期脉冲)
// M11.6 : PumpWrite_Req  注射泵写请求(FC13/FC20置位,FC4清零)
// M11.7 : PumpWrite_Busy 注射泵写忙标志(FC4置位/清零)
// M12.0 : PumpWrite_Done 注射泵写完成(FC4置位,请求方清零)
// VW288 : Modbus字节顺序转换临时字(浮点转换用)
// VB378 : MBUS_CTRL Error错误码(LAD引脚)
// VB379 : 当前任务Error错误码(MBUS_MSG输出,LAD引脚,复用)
// VW4   : 注射泵状态码(归一化后:0=就绪(96),1=空闲(64),2=运动中(100),≥4=错误)
// VW224 : 注射泵状态码原始值(41001原始值,调试用)
// VD86  : 流量计当前计量值(映射自40009)
// VW222 : 注射泵位置反馈(映射自41007)
// VD232 : PumpWrite_Addr  FC06写目标Modbus地址(FC13/FC20写入)
// VW230 : PumpWrite_Data  FC06写数据(FC13/FC20写入)
// VW96  : 注射泵状态码上一有效值(降级用,归一化后)
// VD374 : 流量计累计值上一有效值(降级用)
// VB400 : MBUS_MSG站号参数(动态,BYTE)
// VB401 : MBUS_MSG读写参数(动态,BYTE,0=读1=写)
// VD402 : MBUS_MSG地址参数(动态,DWORD)
// VW406 : MBUS_MSG字数参数(动态,INT)
// VW410 : Modbus统一数据缓冲区(读:数据存这里;写:数据从这里取)
// T43   : 注射泵读任务超时(10秒,任务0/2复用)
// T44   : 流量计轮询超时(10秒)
// T45   : 注射泵写任务超时(10秒)
// T101  : 2000ms脉冲发生器(读任务First触发,100ms时基)


NETWORK 1
// Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600, Parity=0(无), Port=0, Timeout=1000ms
LD     SM0.0
=      L60.0                          // EN
LD     SM0.0
=      L63.7                          // Mode=1(RTU)
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#00, 16#00, 1000, M11.0, VB378


NETWORK 2
// 任务参数选择 - 根据VW290设置MBUS_MSG参数(VB400~VW406)
// ★ 所有任务的DataPtr统一用&VB410,读完再复制到目标

// 任务0: 注射泵状态码(站1,41001,读1字)
LD     SM0.0
AW=    VW290, 0
MOVB   1, VB400                       // 站号1
MOVB   0, VB401                       // 读
MOVD   16#0000A029, VD402             // 地址41001
MOVW   1, VW406                       // 1字

// 任务1: 流量计累计值(站2,40009,读2字)
LD     SM0.0
AW=    VW290, 1
MOVB   2, VB400                       // 站号2
MOVB   0, VB401                       // 读
MOVD   16#00009C49, VD402             // 地址40009
MOVW   2, VW406                       // 2字

// 任务2: 注射泵位置(站1,41007,读1字)
LD     SM0.0
AW=    VW290, 2
MOVB   1, VB400                       // 站号1
MOVB   0, VB401                       // 读
MOVD   16#0000A02F, VD402             // 地址41007
MOVW   1, VW406                       // 1字

// 任务4: 写命令(站1,VD232地址,写1字)
// 写之前把VW230复制到VW410(统一缓冲区)
LD     SM0.0
AW=    VW290, 4
MOVB   1, VB400                       // 站号1
MOVB   1, VB401                       // 写
MOVD   VD232, VD402                   // 写地址(FC13/FC20设定)
MOVW   1, VW406                       // 1字
MOVW   VW230, VW410                   // 写数据复制到缓冲区


NETWORK 3
// ★ 单MBUS_MSG调用(参数从VB400~VW406变量读取,DataPtr固定&VB410)
// EN: 读任务(0/1/2)非降级模式 OR 写任务(4)有写请求
// First: 读任务用T101脉冲(2000ms), 写任务用M11.6的EU

// EN计算:
//   任务0/2(注射泵读): 非M10.4 → L60.0
//   任务1(流量计读): 非M10.5 → L60.3
//   任务4(写): M11.6 → L60.1
//   最终EN = L60.0 OR L60.3 OR L60.1 → L60.2
//   M14.7 = 读任务活跃(任务0/1/2, 用于驱动T101)

// 任务0: 非注射泵降级
LD     SM0.0
AW=    VW290, 0
AN     M10.4
=      L60.0                          // 任务0 EN
LD     SM0.0
AW=    VW290, 0
AN     M10.4
=      M14.7                          // 任务0读活跃

// 任务2: 非注射泵降级
LD     SM0.0
AW=    VW290, 2
AN     M10.4
O      L60.0
=      L60.0                          // 注射泵读EN(任务0 OR 任务2)
LD     SM0.0
AW=    VW290, 2
AN     M10.4
O      M14.7
=      M14.7                          // 注射泵读活跃(任务0 OR 任务2)

// 任务1: 非流量计降级
LD     SM0.0
AW=    VW290, 1
AN     M10.5
=      L60.3                          // 流量计读EN
LD     SM0.0
AW=    VW290, 1
AN     M10.5
O      M14.7
=      M14.7                          // 读活跃(任务0 OR 任务2 OR 任务1)

// 任务4: 有写请求
LD     SM0.0
AW=    VW290, 4
A      M11.6
=      L60.1                          // 写EN

// 最终EN
LD     L60.0
O      L60.3
O      L60.1
=      L60.2                          // 最终EN

// T101: 2000ms脉冲发生器(仅读任务时计时,100ms时基)
// ★ 使用T101,避免与FC11(T37)/FC15(T40)冲突
LD     M14.7                          // 读任务活跃标志
AN     T101                           // T101自复位
TON    T101, 20                       // 2000ms(20×100ms)

// First计算: 读任务=T101脉冲, 写任务=M11.6的EU
// 读First: (L60.0 OR L60.3) AND T101
LD     L60.0
O      L60.3                          // 读任务活跃?
A      T101                           // T101脉冲
=      L63.7                          // First(读)

LD     L60.1                          // 写任务活跃?
A      M11.6
EU
O      L63.7
=      L63.7                          // First(读+写合并)

// ★ 唯一的CALL MBUS_MSG(参数从VB400~VW406变量读取,DataPtr固定&VB410)
LD     L60.2                          // EN
=      L60.0
LD     L60.0
CALL   MBUS_MSG, L63.7, VB400, VB401, VD402, VW406, &VB410, M10.0, VB379


NETWORK 4
// 任务0完成处理 - 注射泵状态码(归一化+SWAP)
// ★ 去掉EU改电平检测(同FC99), 完成后清零Done防止重复执行
LD     M10.0
AW=    VW290, 0
AB=    VB379, 0
R      M10.0, 1                        // 先清Done, 防止重复执行
MOVW   VW410, VW4                     // 从缓冲区复制
SWAP   VW4                             // 大端→小端
MOVW   VW4, VW224                      // 保存原始状态码
MOVW   VW4, AC0
ANDW   16#000F, AC0
MOVW   AC0, VW4
LDW<>  VW4, 0
JMP    10
LD     SM0.0
MOVW   VW224, AC0
ANDW   16#0020, AC0
LDW<>  AC0, 0                         // bit5=1 → 就绪(96)
MOVW   0, VW4
LDW=   AC0, 0                         // bit5=0 → 空闲(64)
MOVW   1, VW4
JMP    11

LBL    10
+I     4, VW4
LD     SM0.0
LDW=   VW224, 100
MOVW   2, VW4

LBL    11
MOVW   VW4, VW96
MOVW   0, VW294
MOVW   0, VW292
R      V303.4, 1
S      V304.1, 1
R      T43, 1
MOVW   1, VW290

// 任务0超时
LD     T43
AW=    VW290, 0
R      T43, 1                        // 先清T43, 防止重复执行
INCW   VW292
R      T43, 1
R      V304.1, 1
LDW<   VW292, 3
LDW>=  VW292, 3
S      V303.4, 1
INCW   VW294
MOVW   0, VW292
LDW>=  VW294, 5
S      M10.4, 1
R      V304.1, 1
LD     SM0.0
MOVW   1, VW290
R      T43, 1


NETWORK 5
// 任务1完成处理 - 流量计累计值(32位浮点SWAP+字交换)
// ★ 去掉EU改电平检测, 完成后清零Done
LD     M10.0
AW=    VW290, 1
AB=    VB379, 0
R      M10.0, 1                        // 先清Done
MOVD   VD410, VD86                    // 从缓冲区复制
SWAP   VW86
SWAP   VW88
MOVW   VW86, VW288
MOVW   VW88, VW86
MOVW   VW288, VW88
MOVD   VD86, VD374
MOVW   0, VW296
MOVW   0, VW292
R      V303.6, 1
S      V304.2, 1
R      T44, 1
MOVW   2, VW290

// 任务1超时
LD     T44
AW=    VW290, 1
R      T44, 1                        // 先清T44
INCW   VW292
R      T44, 1
R      V304.2, 1
LDW<   VW292, 3
LDW>=  VW292, 3
S      V303.6, 1
INCW   VW296
MOVW   0, VW292
LDW>=  VW296, 5
S      M10.5, 1
R      V304.2, 1
LD     SM0.0
MOVW   2, VW290
R      T44, 1


NETWORK 6
// 任务2完成处理 - 注射泵位置(16位SWAP)
// ★ 去掉EU改电平检测, 完成后清零Done
LD     M10.0
AW=    VW290, 2
AB=    VB379, 0
R      M10.0, 1                        // 先清Done
MOVW   VW410, VW222                   // 从缓冲区复制
SWAP   VW222
MOVW   0, VW292
R      T43, 1
LD     M11.6
MOVW   4, VW290
LDN    M11.6
MOVW   0, VW290

// 任务2超时
LD     T43
AW=    VW290, 2
R      T43, 1                        // 先清T43
INCW   VW292
R      T43, 1
LDW<   VW292, 3
LDW>=  VW292, 3
MOVW   0, VW292
LD     SM0.0
MOVW   0, VW290
R      T43, 1


NETWORK 7
// 任务4完成处理 - 注射泵写命令
// 写就绪门控: VW4=0(就绪)或强停命令(VD232=16#9C42)
LD     SM0.0
AW=    VW290, 4
AN     M11.6
AN     M11.7
MOVW   0, VW290                        // 无写请求→回任务0

LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7
LDD=   VD232, 16#9C42                 // 是强停命令?
JMP    20
LDW<>  VW4, 0                          // 非强停,且VW4≠0
MOVW   0, VW290
LBL    20

LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7
S      M11.7, 1
R      M10.0, 1
R      M12.0, 1

// 任务4完成
LD     M10.0
AW=    VW290, 4
AB=    VB379, 0
MOVW   0, VW292
R      T45, 1
R      M10.0, 1
R      M11.6, 1
R      M11.7, 1
S      M12.0, 1
MOVW   0, VW290

// 任务4超时
LD     T45
AN     M10.0
AW=    VW290, 4
S      V303.4, 1
MOVW   0, VW292
R      T45, 1
R      M10.0, 1
R      M11.6, 1
R      M11.7, 1
S      M12.0, 1
MOVW   0, VW290


NETWORK 8
// 降级模式: 用上一有效值
LD     M10.4
AW=    VW290, 0
MOVW   VW96, VW4

LD     M10.5
AW=    VW290, 1
MOVD   VD374, VD86

// 启动超时计时器
LD     SM0.0
AW=    VW290, 0
AN     M10.4
TON    T43, 100

LD     SM0.0
AW=    VW290, 1
AN     M10.5
TON    T44, 100

LD     SM0.0
AW=    VW290, 2
AN     M10.4
TON    T43, 100

LD     SM0.0
AW=    VW290, 4
TON    T45, 100


NETWORK 9
// 降级模式退出检测
LD     M10.4
EU
TODR   VB520
LD     M10.5
EU
TODR   VB530


// ============================================================
// 文件结束
// 说明:
//   1. 2026-09-08重大重构: 单MBUS_MSG结构(参照FC99)
//      原因: 4个CALL MBUS_MSG同时存在导致库状态机冲突→Error=6
//      解决: 只用1个CALL MBUS_MSG,参数用VB400~VW406变量动态选择
//            DataPtr统一用&VB410,读完再复制到目标(VW4/VD86/VW222)
//   2. 降级模式: 使用上一有效值(VW4←VD96, VD86←VD374)
//   3. 通讯恢复: 一次成功即退出降级(自动恢复)
//   4. 报警逻辑: 超时3次→置V303.4(注射泵)/V303.6(流量计)
//   5. MBUS_CTRL/MBUS_MSG在STL中必须用符号名调用
//   6. 状态码41001原始值存VW224,归一化后存VW4
//   7. BPM32FC积算仪: 16位SWAP, 32位浮点SWAP+字交换
//   8. 任务4写完成/失败均置M12.0=1,请求方清零
//   9. ★ 注: CALL MBUS_MSG的参数可以用变量(VB400/VB401/VD402/VW406)
//      STL编译器在编译时确定参数地址,运行时从变量读取值
// ============================================================
