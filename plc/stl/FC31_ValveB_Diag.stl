// ============================================================
// 文件: FC31_ValveB_Diag.stl
// 功能: 阀B诊断（四态诊断+开关到位+超时保护+漫溢保护）
// Story: AQEX-7 阀门诊断 + v10.4 硬件变更(去下缸NC阀)
// 调用方: FC15(S4上→下转移)
// 说明: 阀B四态诊断(流量开关B+液位计A低位)
//       【v10.4 硬件变更 2026-09-20】下缸NC球阀Q0.6已去除(保留未使用),
//       漫溢保护不再联动NC阀,仅关阀B;报警码13/V300.3废弃(保留位)
//       诊断子状态VW262: 0空闲/1等开到位/2开启完成/3运行中/4等关到位
//       【v2.3.8 2026-09-30】同FC30去JMP/LBL化: 状态条件直接门控直线结构
//       (阀诊断块调度跳转编译后贯穿执行,见FC30 P7记录;本块同构同病同修)
// ============================================================

// 符号说明:
// VW262 : Diag_State_B     阀B诊断子状态
// VW268 : Diag_Result_B    阀B诊断结果(0/1/2)
// T53   : 阀B开到位超时(输入=VW262=1门控)
// T54   : 阀B流量开关超时保护(输入=VW262=1门控)
// T55   : 阀B关到位超时(输入=VW262=4门控)
// I0.1  : 流量开关B
// I0.6  : 液位计A低位(上缸排空)
// I0.7  : 液位计B高位(下缸漫溢)
// I8.2  : 阀B开到位反馈
// I8.3  : 阀B关到位反馈
// Q0.3  : 阀B


NETWORK 1
// ============================================================
// v2.3.8 直线结构版 FC31 - 无JMP/LBL
// 结构: 漫溢保护 → 子状态1(等开到位) → 子状态2(开启完成检查)
//       → 子状态3(四态诊断) → 子状态4(等关到位)
// ============================================================

// 漫溢保护（全程，优先级最高）
// 液位计B高位=ON立即报警+关阀B+转S_ERROR
// 【v10.4硬件变更】下缸NC球阀已去除,漫溢保护不再联动NC阀(原S V300.3/R Q0.6已删)
LD     I0.7
S      V300.1, 1                   // M_Alarm_Overflow_BHigh
R      Q0.3, 1                     // 关阀B
MOVW   99, VW2
MOVB   2, VB268                    // 故障


// ---- 子状态1: 等待开到位 ----
// T53开到位超时 + T54流量开关超时(两套独立判据)
// 【v2.3.8】输入=VW262=1门控: 仅子状态1内计时,离开自动复位
LDW=   VW262, 1
TON    T53, VW274                  // PT=VD_Timeout_ValveB(VD362)×10
TON    T54, VW274                  // 流量开关超时(同参数，独立计时)

// 开到位=ON(上升沿) → 转S2
// [已修复 v2.2] 用 V63.1 缓存 EU 结果,避免 R 指令链栈空
LDW=   VW262, 1
A      I8.2
EU
=      V63.1
LD     V63.1
LPS
MOVW   2, VW262
LPS
R      T53, 1
LPS
R      T54, 1
LPP
LPP
LPP

// 开到位超时 → 报警(仅子状态1内判定)
LDW=   VW262, 1
A      T53
LPS
S      V302.1, 1                   // M_Alarm_ValveB_OpenTimeout
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP

// 流量开关超时(开阀后一直无流) → 报警(仅子状态1内判定)
LDW=   VW262, 1
A      T54
AN     I0.1                        // 确认流量开关B仍OFF
LPS
S      V302.2, 1                   // M_Alarm_ValveB_OpenNoFlow
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP


// ---- 子状态2: 开启完成检查 ----
// 流量开关B=ON → 正常，转S3
LDW=   VW262, 2
A      I0.1
MOVW   3, VW262

// 开到位但无流 → 报警(仅子状态2内判定)
LDW=   VW262, 2
A      I8.2
AN     I0.1
LPS
S      V302.2, 1                   // M_Alarm_ValveB_OpenNoFlow
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP


// ---- 子状态3: 运行中(四态诊断持续扫描) ----
// 四态诊断: 流量开关B(I0.1) + 液位计A低位(I0.6)
// 状态3: 流量开关OFF + 液位低位ON → 上缸排空，关阀触发
LDW=   VW262, 3
A      I0.6                        // 液位计A低位=ON(上缸空)
AN     I0.1                        // 且流量开关B=OFF(转移结束)
LPS
R      Q0.3, 1                     // 关阀B
LPS
MOVW   4, VW262                    // 转S4等关到位
LPP
LPP

// 状态4: 流量开关OFF + 液位低位OFF → 设备故障(仅子状态3内判定)
LDW=   VW262, 3
AN     I0.1                        // 流量开关B=OFF
AN     I0.6                        // 且液位低位=OFF
LPS
S      V302.0, 1                   // M_Alarm_ValveB_Diag
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP

// 状态1/2: 流量开关ON → 正常转移中/即将排空，继续(无动作)


// ---- 子状态4: 等待关到位 ----
// T55关到位超时
// 【v2.3.8】输入=VW262=4门控
LDW=   VW262, 4
TON    T55, VW274                  // PT=VD_Timeout_ValveB×10

// 关到位=ON AND 流量开关=OFF → 正常完成
LDW=   VW262, 4
A      I8.3
AN     I0.1
LPS
MOVW   0, VW262                    // VW262=0空闲
LPS
MOVB   1, VB268                    // Diag_Result_B=1正常完成
LPS
R      T55, 1
LPP
LPP
LPP

// 关到位=ON AND 流量开关=ON → 内漏(仅子状态4内判定)
LDW=   VW262, 4
A      I8.3
A      I0.1
LPS
S      V302.4, 1                   // M_Alarm_ValveB_CloseLeak
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP

// 关到位超时 → 报警(仅子状态4内判定)
LDW=   VW262, 4
A      T55
AN     I8.3
LPS
S      V302.3, 1                   // M_Alarm_ValveB_CloseTimeout
LPS
MOVW   99, VW2
LPS
MOVB   2, VB268
LPP
LPP
LPP


// ============================================================
// 文件结束
// 说明:
//   1. FC15调用本FC前置VW262=1启动
//   2. FC15检查VW268: 0等待, 1正常完成转S5, 2故障
//   3. VW274=VD_Timeout_ValveB(VD362)×10转换值
//   4. 四态诊断状态4需排除转移初期瞬时，实际需加延时确认
//   5. 【v2.3.8】全块无JMP/LBL;定时器输入全部状态门控,离开子状态自动复位
// ============================================================
