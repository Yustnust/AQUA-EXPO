// ============================================================
// 文件: FC11_State_S1_Inlet.stl
// 功能: S1上缸进水 (VW2=1)
// Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成) + AQEX-8 节奏纠偏(已集成二次校正)
// 说明: 开阀A进水，调用FC30阀A诊断(差值法+延时验证)
//       诊断结果VW266: 0进行中/1正常完成/2故障
//       诊断正常完成 → 调用FC40二次校正(模式1) → 更新VD_T_Rolling → 转S2
// ============================================================

// 符号说明:
// VW260 : Diag_State_A  阀A诊断子状态
// VW266 : Diag_Result_A 阀A诊断结果
// VW278 : VD_Timeout_ValveA×10 转换值(供FC30的T50用,已修正避FC32冲突)
// VW280 : VD_Delay_ValveA_Verify×10 转换值(供FC30的T51用)
// VD332 : VD358运算中间变量(避免修改HMI参数VD358)
// VD250 : 目标进水量(HMI设定)


NETWORK 1: S1首次进入动作
// 用M10.2作为S1首次进入标志(由FC1状态调度置位)
LD     M10.2                        // S1首次进入脉冲
EU
LPS
// 记录流量计快照（差值法基准，供FC30使用）
MOVD   VD86, VD82                  // VD_FlowMeter_Snapshot
// 开启阀A
S      Q0.2, 1
// 启动S1计时器
R      T37, 1
TON    T37, 32767
// 置上缸状态=空
R      V1.6, 1
// 启动阀A诊断: 置诊断子状态=1(等待开到位)
MOVB   1, VB260
MOVB   0, VB261
// 清诊断结果
MOVB   0, VB266
MOVB   0, VB267
// 计算VD参数转换值供FC30使用(已修正:用独立中间变量VD332,不修改HMI参数VD358)
// VW278 = VD_Timeout_ValveA(VD358) × 10
MOVR   VD358, VD332                  // 复制到中间变量(避免修改HMI设定值)
*R     10.0, VD332
ROUND  VD332, AC0
MOVW   AC0, VW278
// VW280 = VD_Delay_ValveA_Verify(VD66) × 10
MOVR   VD66, VD320
*R     10.0, VD320
ROUND  VD320, AC0
MOVW   AC0, VW280
LPP


NETWORK 2: 调用阀A诊断FC30
// 每周期调用FC30，FC30内部管理诊断子状态机
LD     SM0.0
CALL   FC30:V ValveA_Diag


NETWORK 3: 检查阀A诊断结果 + 二次校正(Story1.4) + 转S2
// VW266=0 进行中，继续等待
// VW266=1 正常完成 → 二次校正 → 转S2
// VW266=2 故障(FC30已转S_ERROR)，本周期结束
LD     SM0.0
AW=    VW266, 1                    // 诊断正常完成?
JMP    nS1DiagOK                   // 是 → 跳转处理
JMP    nS1CheckEnd                 // 否 → 结束本NETWORK

nS1DiagOK:
LD     SM0.0
R      T37, 1                      // 停S1计时
MOVD   T37, VD70                   // 记录S1实测时长 VD_S1_Actual
// 【Story1.4】二次校正(7.3): 用S1实测值重核S2/S3.5目标
// Available' = CycleSetpoint×60 + S6_Rolling - S5_Elapsed(已含S1耗时)
LD     SM0.0
MOVR   VD354, VD150                 // VD_CycleSetpoint(min)
*R     60.0, VD150                 // →秒
+R     VD116, VD150                // + VD_S6_Rolling
-R     VD178, VD150                // - VD_S5_Elapsed = Available'
// Needed' = S2_Target(预规划已定) + S3_Estimate + RestTime_Target(预规划已定)
MOVR   VD120, VD154                // VD_S2_Target
+R     VD174, VD154                // + VD_S3_Estimate
+R     VD124, VD154                // + VD_RestTime_Target = Needed'
MOVW   1, VW182                    // 模式=1(二次校正)
CALL   FC40:V RhythmCorrection
// 更新VD_T_Rolling(取标称值,7.5): S1实测+S2标称+S3估算+S3.5标称
LD     SM0.0
MOVR   VD70, VD112                 // VD_S1_Actual
+R     VD28, VD112                 // + VD_PreMixTime(S2标称)
+R     VD174, VD112                // + VD_S3_Estimate
+R     VD36, VD112                 // + VD_RestTime(S3.5标称) = 新VD_T_Rolling
// 二次校正非人工介入(4) → 转S2
LD     SM0.0
AW<>   VW184, 4
MOVB   2, VB2                      // 状态转移 S1→S2
MOVB   0, VB3

nS1CheckEnd:
LBL    nS1CheckEnd


// 注: 漫溢保护、差值法计量、延时验证、内漏检测、开关到位诊断
//      全部由FC30统一处理，FC11仅负责状态转移调度
// 注: VD250(目标进水量)由HMI设定或FC11进入时计算
// 注: 二次校正(Story 1.4)在转S2前调用
// 注: VD358运算已改用独立中间变量VD332,不再修改HMI设定参数
// 注: 断电恢复由FC0统一处理,VW2=1(S1阀A动作中断)时FC0转S_ERROR


// ============================================================
// 文件结束
// ============================================================
