// ============================================================
// 文件: FC14_State_S35_Rest.stl
// 功能: S3.5静止等候 (VW2=4)
// Story: AQEX-6 状态机骨架
// 说明: 加药后静止沉降，计时到达VD_RestTime_Target转S4
// ============================================================

NETWORK 1: S3.5进入动作 - 启动计时
// T39对比VD_RestTime_Target(VD124)，需转换为100ms时基值
LD     SM0.0
R      T39, 1
// VD_RestTime_Target为REAL秒，PT=VD_RestTime_Target×10
// 简化：用VW254存放转换值(待Story 1.4补充)
TON    T39, VW254


NETWORK 2: 静止等候完成转移至S4
LD     T39                         // 计时到达
MOVB   5, VB2                     // VW2=5(S4)
MOVB   0, VB3


// S3.5无输出动作，仅计时
// ============================================================
// 文件结束
// ============================================================
