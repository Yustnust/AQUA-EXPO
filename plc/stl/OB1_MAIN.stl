// ============================================================
// 文件: OB1_MAIN.stl
// 功能: PLC主循环程序
// 项目: 药液配置与加注控制系统
// Story: AQEX-6 状态机骨架 + AQEX-9 急停调度顺序确认
// PLC: S7-200 SMART CPU ST20
// 说明: 本文件为语句表(STL)格式，可参考导入STEP 7-Micro/WIN SMART
// 调度顺序: FC0(初始化)→FC2(急停,最高优先级)→FC4(Modbus)→FC3(报警)→FC22(RTC同步)
//           →FC40(双倒计时器周期管理,v2.2新增)→FC1(状态调度)
//           FC2在FC1之前,保证急停触发时同周期转S_ERROR
//           FC40在FC1之前,保证M16.1下一轮S1触发脉冲及时响应
//           【v2.2 修订 2026-09-15】FC40 从 FC1 内部调用移至 OB1 顶层调度
// ============================================================

// 符号注释（实际导入时在符号表定义）
// VW2     : 状态机当前状态 (0=S0,1=S1...8=S7,99=ERROR)
// VW4     : 注射泵状态码
// VW6     : 当前最高优先级报警码
// VW8     : 实验轮次计数
// V0.0    : CMD_Start (HMI→PLC启动命令)
// V0.2    : CMD_Stop  (HMI→PLC停止命令)
// V1.0    : STA_StartAck (PLC→HMI启动确认)
// I1.1    : DI_EStop (急停反馈，常闭，ON=正常)
// I0.3    : DI_Btn_SystemReset (系统复位按钮)


NETWORK 1
// 首次扫描初始化
// SM0.1仅在首次扫描周期ON，调用FC0系统初始化
LD     SM0.1
=      L60.0                      // 局部存储器中转
LD     L60.0
CALL SysInit


// 急停与安全处理（每周期调用，优先级最高）
// SM0.0常ON，每周期调用FC2
LD     SM0.0
CALL   EStopHandling


// HMI停止命令(V0.2) - 自动运行中任意状态可停止
// ★ 2026-09-11 修复:
//   (1) 去掉 AW< VW2, 99 条件,允许 S_ERROR 态(VW2=99)也能停止
//       原逻辑只允许 VW2=1~8 停止, S_ERROR 锁死时点停止被忽略
//       新逻辑: VW2>0(非S0)就能停止, 急停/继电器故障锁存位由 FC19 管理
//   (2) 补清阀门诊断子状态 VB260~VB275 和诊断计时器 T50~T55
//       原三个清理路径(停止/冷启动/复位)全部遗漏,导致
//       FC11/FC15/FC17 的 AW=VW2xx,0 前置条件不成立,
//       开阀指令被跳过,表现为"点启动 M10.2=1 但系统不运行"
LD     V0.2
EU
AW>    VW2, 0                       // VW2>0(排除S0), VW2=1~8 或 99 都允许停止
LPS
R      Q0.0, 7                      // 泵停/阀关/NC电磁阀失电
R      T37, 1                       // 停S1计时器
R      M10.2, 1                     // 清S1首次进入标志
R      M10.7, 1                     // 清预规划标志
R      M11.6, 1                     // 清注射泵写请求
// ★ 新增: 清阀门诊断子状态+结果(VB260~VB275, 8字=16字节)
//   覆盖: 阀A子状态VB260~261, 阀B子状态VB262~263,
//         阀A/B结果VB266~269, 阀C诊断VB270~273, 其他辅助变量
FILL   0, VW260, 8
// ★ 新增: 清阀A/B诊断计时器 T50~T55
R      T50, 6
// 【v2.2新增】停止时清理上缸子流程状态 + 双倒计时器标志 + 定时器
MOVW   0, VW304                     // 上缸配液子流程状态清零
MOVW   0, VW306                     // 换水计数清零
R      M16.0, 4                     // M16.0~M16.3 连续清零
R      T38, 1                       // 清 S2 搅拌定时器
R      T46, 1                       // 清 TimerA
R      T48, 1                       // 清 TimerB
R      T49, 1                       // 清 S4 转移计时器
MOVR   0.0, VD256                   // 清 TimerA 显示值
MOVR   0.0, VD244                   // 清 TimerB 显示值
MOVW   0, VW2                       // 回S0
R      V0.2, 1                      // 清停止命令
LPP


// Modbus通讯轮询（每周期调用）
LD     SM0.0
CALL ModbusPolling


// 报警处理（每周期调用）
LD     SM0.0
CALL AlarmHandling


// RTC时间同步处理（每周期调用）
// 处理HMI校时命令V0.6和5分钟超时保护
LD     SM0.0
CALL RTC_Sync


// v2.2 双倒计时器周期管理（每周期调用）
// ★ 必须在 FC1 状态调度之前调用,保证 M16.1 下一轮 S1 触发脉冲及时响应
// 替代原 AQEX-8 三层纠偏,严格保证 24h 换水次数硬约束 (VD414)
// 功能: 计算 T_cycle / 触发 S6 / 触发下一轮 S1 / 倒计时到 0 报警 / 双计时器显示值
LD     SM0.0
CALL RhythmCorrection


// 状态机调度(急停时FC2会强制VW2=99)
// 每周期根据VW2调用对应状态FC
LD     SM0.0
CALL StateDispatcher


// 【v2.2 新增】上缸子流程调度(VW304)
// 在 FC1 下缸调度之后调用,处理上缸 S1/S2 并行流程
// VW304=1 → CALL FC11_State_S1_Inlet (上缸进水)
// VW304=2 → CALL FC1A_State_S2_MixDose (上缸搅拌+加药合并,v2.2 新建)
// VW304=0/3/4 → 无动作(空闲/配完等待/已转移由其他 FC 处理)
LD     SM0.0
AW=    VW304, 1
CALL   State_S1_Inlet
LD     SM0.0
AW=    VW304, 2
CALL   State_S2_MixDose


// 手动控制处理（仅在S0态调用,在状态调度之后）
// 处理HMI画面3手动控制命令位V306.0~V307.1
//   (旧地址V2.4~V3.5因与VW2物理重叠已于2026-09-03迁移,详见FC20符号表)
// 由FC20使用M13.0~M13.4锁存输出,NC电磁阀自动跟随(详见FC20)
LD     SM0.0
LDW=   VW2, 0
CALL   ManualControl


// 手动注射泵控制（仅在S0态调用,在手动阀门控制之后）
// 处理V307.2/V307.3命令位
//   (旧地址V3.6/V3.7因与VW2物理重叠已于2026-09-03迁移,详见FC21符号表)
// 由FC21使用VD384/VW388/VW390执行单次/循环抽排(详见FC21)
LD     SM0.0
LDW=   VW2, 0
CALL   ManualSyringePump


// 非S0态清除手动控制锁存与手动注射泵状态,防止返回S0时误动作
LD     SM0.0
LDW=   VW2, 0
NOT
R      M13.0, 5                      // 清阀门/泵手动锁存
R      M13.5, 3                      // 清手动注射泵标志(M13.5~M13.7)
MOVW   0, VW390                      // 手动注射泵子状态复位为空闲


// M16.4/5/6 → V区镜像（供HMI读取，McgsPro S7-200 SMART以太网驱动不支持M区直接导入）
// V1.1=InitDone(原M16.4), V1.2=RTU1/Syringe在线(原M16.5), V0.1=RTU2/Flow在线(原M16.6)
LD     SM0.0
LD     M16.4
=      V1.1
LD     M16.5
=      V1.2
LD     M16.6
=      V0.1


// 系统总状态 → VB305 (0=良好,1=故障,2=急停)
// 急停: I1.1=OFF OR V300.4 OR V300.5
// 故障: VW6≠0 AND 非急停
// 良好: 非急停 AND VW6=0 (默认值)

LD     SM0.0
MOVB   0, VB305                    // 默认良好
// 急停 → 2
LD     I1.1
NOT
O      V300.4
O      V300.5
MOVB   2, VB305
// 非急停 + 有报警 → 1
LDW<>  VW6, 0
A      I1.1
AN     V300.4
AN     V300.5
MOVB   1, VB305


// ============================================================
// 文件结束
// 说明:
//   1. FC0/FC1/FC2/FC3/FC4 见各自独立文件
//   2. FC10~FC19 各状态FC见 State_Sxx.stl 文件
//   3. FC20 手动控制(新增,AQEX-34修复)
//   4. FC22 RTC时间同步处理(新增,AQEX-51)
//   5. 导入时需先建符号表，再逐个新建FC并粘贴代码
//   6. VB305 系统状态字(=0良好/1故障/2急停,AQEX-50新增)
// ============================================================
