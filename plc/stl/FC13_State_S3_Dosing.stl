// ============================================================
// 文件: FC13_State_S3_Dosing.stl
// 功能: S3加药 (VW2=3)
// Story: AQEX-6 状态机骨架
// 说明: 计算加药步数，控制注射泵抽液+排液，轮询状态码等待完成
// ============================================================

NETWORK 1: S3进入动作 - 计算加药步数
// VD_Vol_Target = VD_C_Set × VD_Current_InletVolume / VD_C_Stock
// VD_Dose_Steps = VD_Vol_Target / VD_StepResolution
LD     SM0.0
LPS
// 计算目标体积(µL)
*R     VD10, VD90                  // VD_C_Set × VD_Current_InletVolume (暂用浮点近似)
// 实际需除以VD_C_Stock(VD14)，骨架简化
/R     VD14, AC0                   // ÷ VD_C_Stock
MOVR   AC0, VD370                   // VD_Vol_Target
// 计算目标步数
/R     VD350, AC0                   // ÷ VD_StepResolution
ROUND  AC0, AC0                    // 取整
MOVR   AC0, VD102                  // VD_Dose_Steps
LPP


NETWORK 2: 下发注射泵抽液+排液指令
// 写入40006(抽液步数)和40007(排液步数)
// 通过Modbus写指令(FC4触发或本FC内触发)
// 简化：将步数写入VW204/VW206(映射缓冲区)，由FC4实际下发
LD     SM0.0
LPS
// VD_Dose_Steps是REAL，需转INT写入VW204
ROUND  VD102, AC0
MOVW   AC0, VW204                  // MB_Pump_Aspirate = 抽液步数
MOVW   AC0, VW206                  // MB_Pump_Dispense = 排液步数
// 置"待下发"标志，由FC4检测并执行MBUS_MSG写
S      M10.3, 1                    // M10.3=注射泵指令待下发
LPP


NETWORK 3: 轮询注射泵状态码等待完成
// VW4映射自41001：0=完成，1=运行中，2=抽液，3=排液，其他=错误
LD     SM0.0
LPS
// 状态码=0(完成) → 转S3.5
AW=    VW4, 0
MOVB   4, VB2                     // VW2=4(S3.5)
MOVB   0, VB3
R      M10.3, 1                   // 清除待下发标志
LPP

// 状态码非0且非1/2/3 → 错误，报警转S_ERROR
LD     SM0.0
LPS
AW>=   VW4, 4                     // 状态码≥4视为错误
S      V303.4, 1                  // M_Alarm_SyringePump
MOVB   99, VB2
MOVB   0, VB3
LPP


// 注: 注射泵速度参数(40009-11)写入、复位指令(40003)由Story 1.1补充
// 注: 注射泵通讯超时检测由Story 1.1补充


// ============================================================
// 文件结束
// ============================================================
