// ============================================================
// 文件: FC13_State_S3_Dosing.stl
// 功能: S3加药 (VW2=3)
// Story: AQEX-6 状态机骨架 + 注射泵控制(AQEX-50)
// 说明: 计算加药步数, 通过Modbus FC06依次下发抽液/排液指令,
//       每次动作后发强停(40002=1)恢复96就绪态, 出错转S_ERROR
//
// 2026-09-06修正(基于FC99现场调试):
//   1. 地址格式: 40006→16#9C46, 40007→16#9C47, 40002→16#9C42
//   2. 状态码: VW4=0(96就绪), VW4=1(64空闲), VW4=2(100运动中), VW4≥4(错误)
//   3. 强停恢复: 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪
//      原因: 泵抽液/排液后状态变100(运动中), 需强停才能恢复96接受下条命令
//   4. 运动检测: VW4=2→M12.1/M12.2置位(已开始), VW4≠2且已开始→运动完成
//   5. 运动超时: T102(30秒)防止泵卡在运动态无法退出
//   6. 全局错误: VW4≥4才报错(VW4=2运动中不算错误)
//
// 2026-09-15代码压缩:
//   1. 提取公共错误退出逻辑到 FC13A_PumpErrExit(子程序符号 PumpErrExit)
//      NETWORK 2/4/7/10/13 的重复错误处理统一为 CALL PumpErrExit
//   2. 合并子状态1/5(写完成)、2/6(等运动)、3/7(强停)的重复NETWORK
//      原15个NETWORK压缩至11个,减少程序体积
// ============================================================

// 符号说明:
// VW226 : S3_SubState  S3子状态机
//          0=进入计算  1=写抽液  2=等抽液运动完成
//          3=写强停恢复  4=等强停完成+恢复就绪
//          5=写排液  6=等排液运动完成
//          7=写强停恢复  8=等强停完成+计算/循环
//          9=完成转S3.5
// VD90  : VD_Current_InletVolume 本次进水量(S1差值法结果)
// VD584 : VD_Vol_Target    目标抽取母液体积(µL)
// VD372 : VD_Remaining_Vol 本轮剩余待加药量(µL),S3进入时=VD_Vol_Target
// VD102 : VD_Dose_Steps    本次循环目标步数(REAL)
// VW204 : MB_Pump_Aspirate 抽液步数缓冲(映射40006)
// VW206 : MB_Pump_Dispense 排液步数缓冲(映射40007)
// VD232 : PumpWrite_Addr   FC06写目标Modbus地址
// VW230 : PumpWrite_Data   FC06写数据
// M11.6 : PumpWrite_Req    写请求(FC13置位,FC4执行后清零)
// M11.7 : PumpWrite_Busy   写忙标志(FC4管理)
// M12.0 : PumpWrite_Done   写完成(FC4置位,FC13清零)
// M12.1 : Pump_Asp_Started 抽液运动已开始(VW4曾=2)
// M12.2 : Pump_Disp_Started 排液运动已开始(VW4曾=2)
// V303.4: M_Alarm_SyringePump 注射泵通讯/动作异常
// VW4   : 注射泵归一化状态码(0=就绪96,1=空闲64,2=运动中100,≥4=错误)
// VD346 : 运算中间变量(避免污染HMI设定区)
// T102  : 运动超时定时器(30秒,子状态2/6复用)
// 子程序: PumpErrExit(FC13A_PumpErrExit.stl) - 公共泵错误退出处理
// ============================================================


NETWORK 1
// S3进入/子状态0 - 计算目标加药量,初始化剩余量,启动潜水泵搅拌,清握手位
// 仅在VW226=0时执行一次(FC12进入S3时已清VW226=0)
// [已修复 v2.2] 用 V61.4 缓存条件,避免 LPS/LPP 内 S/R 链栈空
LD     SM0.0
AW=    VW226, 0
=      V61.4
// ✅ v2.0 浓度参数删除: 目标加药量由用户直接输入VD370(HMI设定)
LD     V61.4
MOVR   VD584, VD372                  // VD_Remaining_Vol = 目标加药量
LD     V61.4
S      Q0.0, 1                       // 潜水泵1开
LD     V61.4
S      Q0.1, 1                       // 潜水泵2开
// 清写握手位,避免上一周期残留误判
LD     V61.4
R      M12.0, 1
LD     V61.4
R      M12.1, 1
LD     V61.4
R      M12.2, 1
LD     V61.4
R      M11.6, 1
LD     V61.4
R      M11.7, 1
LD     V61.4
R      T102, 1
LD     V61.4
MOVW   1, VW226                      // 进入子状态1:计算并写抽液步数


// S3全局错误检测 - 注射泵通讯/动作异常或状态码报错(≥4)
// 注: VW4=2(运动中)不算错误,不会触发此检测
// 错误处理统一调用子程序 PumpErrExit(停泵+转S_ERROR+清握手)
LD     V303.4                        // FC4已置位的通讯/动作故障
LD     SM0.0
AW=    VW2, 3
AW>=   VW4, 4                        // 状态码≥4(归一化错误码,不含运动中)
OLD
LPS
CALL   PumpErrExit                   // 公共错误退出(FC13A)
LPP


// 子状态1 - 计算本次循环步数并下发抽液指令(16#9C46)
// 条件: 无进行中的写请求/写忙/写完成
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
// 计算本次循环步数 = VD_Remaining_Vol / VD_StepResolution
MOVR   VD372, VD346                  // VD346 = VD_Remaining_Vol(µL)
/R     VD350, VD346                  // VD346 = steps(REAL)
// 限制最大6000步(25ml注射器容量)
LD     SM0.0
AR>=   VD346, 6000.0                 // steps >= 6000 ?
JMP    20                            // 是 -> 限制为6000
ROUND  VD346, AC0
MOVR   AC0, VD102                    // VD_Dose_Steps < 6000
JMP    21                            // 跳过限制分支
LBL    20
MOVR   6000.0, VD102                 // 限制为6000步
LBL    21
// 检查步数有效性(ROUND后剩余量不足一步时直接完成)
ROUND  VD102, AC0
LD     SM0.0
AR<=   AC0, 0.0                      // 本次循环步数 <= 0 ?
JMP    22                            // 是 -> 直接转完成
// 同步写入抽/排液步数缓冲(供HMI/调试查看)
MOVW   AC0, VW204
MOVW   AC0, VW206
// 重新建立执行条件后下发抽液指令
// ★泵就绪(VW4=0)才允许写, 避免运动中下发导致异常码4
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
MOVW   AC0, VW230                    // 写数据=本次循环步数
MOVD   16#9C46, VD232                // ★十六进制地址(40006=16#9C46)
S      M11.6, 1                      // 置写请求
JMP    23
LBL    22
// 剩余量不足一步,无需再加药,直接转完成
MOVW   9, VW226
LBL    23


// 子状态1/5 - 写完成处理(抽液/排液共享,公共错误路径)
// 错误路径(共享): 子状态1或5 + V303.4(写失败) → 调用 PumpErrExit
LD     M12.0
LD     SM0.0
AW=    VW226, 1
LD     SM0.0
AW=    VW226, 5
OLD
A      V303.4
CALL   PumpErrExit
// 成功: 子状态1→2(抽液写成功 → 等抽液运动完成)
LD     M12.0
AW=    VW226, 1
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   2, VW226                      // →子状态2:等抽液运动完成
// 成功: 子状态5→6(排液写成功 → 等排液运动完成)
LD     M12.0
AW=    VW226, 5
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   6, VW226                      // →子状态6:等排液运动完成


// 子状态2/6 - 等待运动完成(抽液M12.1/排液M12.2)
// T102: 30秒超时(防止泵卡在运动态),子状态2/6复用
// M12.1: 抽液运动已开始(VW4曾=2)
// M12.2: 排液运动已开始(VW4曾=2)
// 完成: (M12.x=1 AND VW4≠2) OR T102超时 → 子状态3/7(写强停)

// T102运行(子状态2或6)
LD     SM0.0
AW=    VW226, 2
LD     SM0.0
AW=    VW226, 6
OLD
TON    T102, 300                     // 30秒(300×100ms)

// 检测运动开始: 子状态2
LD     SM0.0
AW=    VW226, 2
AW=    VW4, 2
S      M12.1, 1
// 检测运动开始: 子状态6
LD     SM0.0
AW=    VW226, 6
AW=    VW4, 2
S      M12.2, 1

// 运动完成: 子状态2→3(写强停恢复)
LD     M12.1
AW=    VW226, 2
AW<>   VW4, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226

// 运动完成: 子状态6→7(写强停恢复)
LD     M12.2
AW=    VW226, 6
AW<>   VW4, 2
R      T102, 1
R      M12.2, 1
MOVW   7, VW226

// 超时: 子状态2→3(强停恢复,防止卡死)
LD     T102
AW=    VW226, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226

// 超时: 子状态6→7
LD     T102
AW=    VW226, 6
R      T102, 1
R      M12.2, 1
MOVW   7, VW226


// 子状态3/7 - 下发强停指令(16#9C42=1)恢复96就绪
// ★强停无需就绪门控: 用于紧急停止/恢复, 不检查VW4=0
LD     SM0.0
AW=    VW226, 3
LD     SM0.0
AW=    VW226, 7
OLD
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230                      // 强停数据=1
MOVD   16#9C42, VD232                // ★十六进制地址(40002=16#9C42)
S      M11.6, 1                      // 置写请求
LPP


// 子状态3/7 - 强停写完成处理(共享错误路径)
// 错误路径(共享): 子状态3或7 + V303.4(写失败) → 调用 PumpErrExit
LD     M12.0
LD     SM0.0
AW=    VW226, 3
LD     SM0.0
AW=    VW226, 7
OLD
A      V303.4
CALL   PumpErrExit
// 成功: 子状态3→4(等强停完成+恢复就绪)
LD     M12.0
AW=    VW226, 3
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   4, VW226                      // →子状态4:等恢复就绪
// 成功: 子状态7→8(等强停完成+计算/循环)
LD     M12.0
AW=    VW226, 7
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   8, VW226                      // →子状态8:等恢复就绪+计算/循环


// 子状态4 - 等待泵恢复就绪(VW4=0=96就绪态)
// 强停后泵从100→96, 需等待VW4回到0才能接受下一条命令
LD     SM0.0
AW=    VW226, 4
AW=    VW4, 0
MOVW   5, VW226                      // →子状态5:写排液步数


// 子状态5 - 下发排液指令(16#9C47)
// ★泵就绪(VW4=0)才允许写, 避免运动中下发导致异常码4
LD     SM0.0
AW=    VW226, 5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
LPS
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232                // ★十六进制地址(40007=16#9C47)
S      M11.6, 1
LPP


// 子状态8 - 等待泵恢复就绪 + 计算本轮体积 + 判断循环/完成
// 等待VW4=0(就绪), 然后计算本轮排出药量, 判断是否完成全部加药量
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
LPS
// 计算本次循环实际排出药量 = VD_Dose_Steps × VD_StepResolution
MOVR   VD102, AC0                    // AC0 = 本次循环步数(REAL)
*R     VD350, AC0                    // AC0 = 本次循环体积(µL)
// 累加本次循环排出药量到累计加药量
+R     AC0, VD440                    // VD_Dosed_Volume_Total += 本次循环体积
// 扣减剩余待加药量
-R     AC0, VD372                    // VD_Remaining_Vol -= 本次循环体积
LPP
// 判断是否完成全部加药量(与恢复就绪条件AND)
AR>=   VD440, VD584                  // 累计加药量 >= 目标量 ?
JMP    30                            // 是 -> 完成
// 未完成: 清本轮握手位,返回子状态1继续下一轮
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
AR<    VD440, VD584                  // 确认未完成
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
MOVW   1, VW226                      // 返回子状态1:下一轮抽液
JMP    31
LBL    30
// 完成: 转子状态9
LD     SM0.0
AW=    VW226, 8
MOVW   9, VW226
LBL    31


// 子状态9 - S3完成,停潜水泵,转S3.5
LD     SM0.0
AW=    VW226, 9
LPS
R      Q0.0, 1
R      Q0.1, 1
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
MOVW   0, VW226
MOVW   4, VW2                        // VW2=4(S3.5)
LD     SM0.0
R      T39, 1                        // 进入S3.5前复位T39,避免FC14每周期R导致TON不累计
LPP


// ============================================================
// 文件结束
// 说明:
//   1. 采用VW226子状态机(0~9),抽液/排液分两步下发,每步等待FC4写完成(M12.0)
//   2. 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪态:
//      抽液→等运动→强停→等就绪→排液→等运动→强停→等就绪→计算/循环
//   3. 运动检测: VW4=2(100运动中)→M12.1/M12.2置位,VW4≠2且已运动→运动完成
//   4. 运动超时: T102(30秒)防止泵卡在运动态,T102超时直接发强停恢复
//   5. 支持多次抽液+排液循环:单循环步数限制6000步(25ml注射器容量),
//      每次排液后强停恢复→累加实际体积到VD378并扣减VD372,直到累计>=目标量
//   6. 全局错误: VW4≥4(不含VW4=2运动中)或V303.4立即转S_ERROR并安全停泵
//   7. S3期间Q0.0/Q0.1保持运行,完成/出错时停止
//   8. 所有Modbus地址使用十六进制格式(16#9C46/16#9C47/16#9C42)
//      避免十进制大数被解析为INT导致MBUS_MSG Error=6
//   9. 2026-09-15代码压缩: 提取公共错误退出逻辑到FC13A_PumpErrExit,
//      合并子状态1/5(写完成)、2/6(等运动)、3/7(强停)的重复NETWORK
//      原15个NETWORK压缩至11个,减少程序体积
// ============================================================
