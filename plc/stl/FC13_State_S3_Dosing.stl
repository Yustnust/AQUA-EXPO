// ============================================================
// 文件: FC13_State_S3_Dosing.stl
// 功能: S3加药 (VW2=3)
// Story: AQEX-6 状态机骨架 + 注射泵控制(AQEX-50)
// 说明: 计算加药步数, 通过Modbus FC06依次下发抽液/排液指令,
//       每次动作后发强停(40002=1)恢复96就绪态, 出错转S_ERROR
//
// 2026-09-06修正(基于FC99现场调试):
//   1. 地址格式: 40006→16#9C46, 40007→16#9C47, 40002→16#9C42
//   2. 状态码: VW4=0(96就绪), VW4=1(64空闲), VW4=2(100运动中), VW4≥4(错误)
//   3. 强停恢复: 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪
//      原因: 泵抽液/排液后状态变100(运动中), 需强停才能恢复96接受下条命令
//   4. 运动检测: VW4=2→M12.1/M12.2置位(已开始), VW4≠2且已开始→运动完成
//   5. 运动超时: T102(30秒)防止泵卡在运动态无法退出
//   6. 全局错误: VW4≥4才报错(VW4=2运动中不算错误)
// ============================================================

// 符号说明:
// VW226 : S3_SubState  S3子状态机
//          0=进入计算  1=写抽液  2=等抽液运动完成
//          3=写强停恢复  4=等强停完成+恢复就绪
//          5=写排液  6=等排液运动完成
//          7=写强停恢复  8=等强停完成+计算/循环
//          9=完成转S3.5
// VD90  : VD_Current_InletVolume 本次进水量(S1差值法结果)
// VD370 : VD_Vol_Target    目标抽取母液体积(µL)
// VD372 : VD_Remaining_Vol 本轮剩余待加药量(µL),S3进入时=VD_Vol_Target
// VD102 : VD_Dose_Steps    本次循环目标步数(REAL)
// VW204 : MB_Pump_Aspirate 抽液步数缓冲(映射40006)
// VW206 : MB_Pump_Dispense 排液步数缓冲(映射40007)
// VD232 : PumpWrite_Addr   FC06写目标Modbus地址
// VW230 : PumpWrite_Data   FC06写数据
// M11.6 : PumpWrite_Req    写请求(FC13置位,FC4执行后清零)
// M11.7 : PumpWrite_Busy   写忙标志(FC4管理)
// M12.0 : PumpWrite_Done   写完成(FC4置位,FC13清零)
// M12.1 : Pump_Asp_Started 抽液运动已开始(VW4曾=2)
// M12.2 : Pump_Disp_Started 排液运动已开始(VW4曾=2)
// V303.4: M_Alarm_SyringePump 注射泵通讯/动作异常
// VW4   : 注射泵归一化状态码(0=就绪96,1=空闲64,2=运动中100,≥4=错误)
// VD346 : 运算中间变量(避免污染HMI设定区)
// T102  : 运动超时定时器(30秒,子状态2/6复用)


NETWORK 1
// S3进入/子状态0 - 计算目标加药量,初始化剩余量,启动潜水泵搅拌,清握手位
// 仅在VW226=0时执行一次(FC12进入S3时已清VW226=0)
LD     SM0.0
AW=    VW226, 0
LPS
// 目标母液体积 = C_Set(VD10) × 本次进水量(VD90) / C_Stock(VD14)
MOVR   VD90, VD346
*R     VD10, VD346
/R     VD14, VD346
MOVR   VD346, VD370                  // VD_Vol_Target(µL)
MOVR   VD346, VD372                  // VD_Remaining_Vol = 目标量
// S3期间保持潜水泵运行(搅拌+加药同时进行)
S      Q0.0, 1
S      Q0.1, 1
// 清写握手位,避免上一周期残留误判
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
MOVW   1, VW226                      // 进入子状态1:计算并写抽液步数
LPP


NETWORK 2
// S3全局错误检测 - 注射泵通讯/动作异常或状态码报错(≥4)
// 注: VW4=2(运动中)不算错误,不会触发此检测
LD     V303.4                        // FC4已置位的通讯/动作故障
LD     SM0.0
AW=    VW2, 3
AW>=   VW4, 4                        // 状态码≥4(归一化错误码,不含运动中)
OLD
LPS
R      Q0.0, 1                       // 停潜水泵1
R      Q0.1, 1                       // 停潜水泵2
S      V303.4, 1                     // 确保报警位
MOVW   99, VW2                       // 转S_ERROR
MOVW   0, VW226                      // 清子状态
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
LPP


NETWORK 3
// 子状态1 - 计算本次循环步数并下发抽液指令(16#9C46)
// 条件: 无进行中的写请求/写忙/写完成
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
// 计算本次循环步数 = VD_Remaining_Vol / VD_StepResolution
MOVR   VD372, VD346                  // VD346 = VD_Remaining_Vol(µL)
/R     VD350, VD346                  // VD346 = steps(REAL)
// 限制最大6000步(25ml注射器容量)
LD     SM0.0
AR>=   VD346, 6000.0                 // steps >= 6000 ?
JMP    20                            // 是 -> 限制为6000
ROUND  VD346, AC0
MOVR   AC0, VD102                    // VD_Dose_Steps < 6000
JMP    21                            // 跳过限制分支
LBL    20
MOVR   6000.0, VD102                 // 限制为6000步
LBL    21
// 检查步数有效性(ROUND后剩余量不足一步时直接完成)
ROUND  VD102, AC0
LD     SM0.0
AR<=   AC0, 0.0                      // 本次循环步数 <= 0 ?
JMP    22                            // 是 -> 直接转完成
// 同步写入抽/排液步数缓冲(供HMI/调试查看)
MOVW   AC0, VW204
MOVW   AC0, VW206
// 重新建立执行条件后下发抽液指令
LD     SM0.0
AW=    VW226, 1
AN     M11.6
AN     M11.7
AN     M12.0
MOVW   AC0, VW230                    // 写数据=本次循环步数
MOVD   16#9C46, VD232                // ★十六进制地址(40006=16#9C46)
S      M11.6, 1                      // 置写请求
JMP    23
LBL    22
// 剩余量不足一步,无需再加药,直接转完成
MOVW   9, VW226
LBL    23


NETWORK 4
// 子状态1 - 抽液写完成处理
LD     M12.0
AW=    VW226, 1
LPS
A      V303.4                        // 写失败(FC4已置报警)
R      Q0.0, 1
R      Q0.1, 1
MOVW   99, VW2
MOVW   0, VW226
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
LPP
LD     M12.0
AW=    VW226, 1
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   2, VW226                      // →子状态2:等抽液运动完成


NETWORK 5
// 子状态2 - 等待抽液运动完成
// T102: 30秒超时(防止泵卡在运动态)
// M12.1: 抽液运动已开始(VW4曾=2)
// 完成: (M12.1=1 AND VW4≠2) OR T102超时 → 子状态3(写强停)

// T102运行(仅在子状态2时计时)
LD     SM0.0
AW=    VW226, 2
TON    T102, 300                     // 30秒(300×100ms)

// 检测运动开始: VW4=2 → 置M12.1
LD     SM0.0
AW=    VW226, 2
AW=    VW4, 2
S      M12.1, 1

// 运动完成: M12.1=1 AND VW4≠2 → 子状态3(写强停恢复)
LD     M12.1
AW=    VW226, 2
AW<>   VW4, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226

// 超时: T102 → 强制子状态3(强停恢复,防止卡死)
LD     T102
AW=    VW226, 2
R      T102, 1
R      M12.1, 1
MOVW   3, VW226


NETWORK 6
// 子状态3 - 下发强停指令(16#9C42=1)恢复96就绪
// 强停无需就绪门控(FC4任务4已实现: VD232=16#9C42时跳过VW4=0检查)
LD     SM0.0
AW=    VW226, 3
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230                      // 强停数据=1
MOVD   16#9C42, VD232                // ★十六进制地址(40002=16#9C42)
S      M11.6, 1                      // 置写请求
LPP


NETWORK 7
// 子状态3 - 强停写完成处理
LD     M12.0
AW=    VW226, 3
LPS
A      V303.4                        // 写失败
R      Q0.0, 1
R      Q0.1, 1
MOVW   99, VW2
MOVW   0, VW226
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
LPP
LD     M12.0
AW=    VW226, 3
AN     V303.4                        // 写成功
R      M12.0, 1
R      M11.6, 1
MOVW   4, VW226                      // →子状态4:等恢复就绪


NETWORK 8
// 子状态4 - 等待泵恢复就绪(VW4=0=96就绪态)
// 强停后泵从100→96, 需等待VW4回到0才能接受下一条命令
LD     SM0.0
AW=    VW226, 4
AW=    VW4, 0
MOVW   5, VW226                      // →子状态5:写排液步数


NETWORK 9
// 子状态5 - 下发排液指令(16#9C47)
LD     SM0.0
AW=    VW226, 5
AN     M11.6
AN     M11.7
AN     M12.0
LPS
ROUND  VD102, AC0
MOVW   AC0, VW230
MOVW   AC0, VW206
MOVD   16#9C47, VD232                // ★十六进制地址(40007=16#9C47)
S      M11.6, 1
LPP


NETWORK 10
// 子状态5 - 排液写完成处理
LD     M12.0
AW=    VW226, 5
LPS
A      V303.4
R      Q0.0, 1
R      Q0.1, 1
MOVW   99, VW2
MOVW   0, VW226
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
LPP
LD     M12.0
AW=    VW226, 5
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   6, VW226                      // →子状态6:等排液运动完成


NETWORK 11
// 子状态6 - 等待排液运动完成
// (逻辑同子状态2, 使用M12.2替代M12.1)
LD     SM0.0
AW=    VW226, 6
TON    T102, 300                     // 30秒

LD     SM0.0
AW=    VW226, 6
AW=    VW4, 2
S      M12.2, 1

// 运动完成: M12.2=1 AND VW4≠2 → 子状态7(写强停恢复)
LD     M12.2
AW=    VW226, 6
AW<>   VW4, 2
R      T102, 1
R      M12.2, 1
MOVW   7, VW226

// 超时: T102 → 强制子状态7
LD     T102
AW=    VW226, 6
R      T102, 1
R      M12.2, 1
MOVW   7, VW226


NETWORK 12
// 子状态7 - 下发强停指令(16#9C42=1)恢复96就绪
LD     SM0.0
AW=    VW226, 7
AN     M11.6
AN     M11.7
AN     M12.0
LPS
MOVW   1, VW230
MOVD   16#9C42, VD232
S      M11.6, 1
LPP


NETWORK 13
// 子状态7 - 强停写完成处理
LD     M12.0
AW=    VW226, 7
LPS
A      V303.4
R      Q0.0, 1
R      Q0.1, 1
MOVW   99, VW2
MOVW   0, VW226
R      M12.0, 1
R      M11.6, 1
R      M11.7, 1
LPP
LD     M12.0
AW=    VW226, 7
AN     V303.4
R      M12.0, 1
R      M11.6, 1
MOVW   8, VW226                      // →子状态8:等恢复就绪+计算/循环


NETWORK 14
// 子状态8 - 等待泵恢复就绪 + 计算本轮体积 + 判断循环/完成
// 等待VW4=0(就绪), 然后计算本轮排出药量, 判断是否完成全部加药量
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
LPS
// 计算本次循环实际排出药量 = VD_Dose_Steps × VD_StepResolution
MOVR   VD102, AC0                    // AC0 = 本次循环步数(REAL)
*R     VD350, AC0                    // AC0 = 本次循环体积(µL)
// 累加本次循环排出药量到累计加药量
+R     AC0, VD378                    // VD_Dosed_Volume_Total += 本次循环体积
// 扣减剩余待加药量
-R     AC0, VD372                    // VD_Remaining_Vol -= 本次循环体积
LPP
// 判断是否完成全部加药量(与恢复就绪条件AND)
AR>=   VD378, VD370                  // 累计加药量 >= 目标量 ?
JMP    30                            // 是 -> 完成
// 未完成: 清本轮握手位,返回子状态1继续下一轮
LD     SM0.0
AW=    VW226, 8
AW=    VW4, 0
AR<    VD378, VD370                  // 确认未完成
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
MOVW   1, VW226                      // 返回子状态1:下一轮抽液
JMP    31
LBL    30
// 完成: 转子状态9
LD     SM0.0
AW=    VW226, 8
MOVW   9, VW226
LBL    31


NETWORK 15
// 子状态9 - S3完成,停潜水泵,转S3.5
LD     SM0.0
AW=    VW226, 9
LPS
R      Q0.0, 1
R      Q0.1, 1
R      M12.0, 1
R      M12.1, 1
R      M12.2, 1
R      M11.6, 1
R      M11.7, 1
R      T102, 1
MOVW   0, VW226
MOVW   4, VW2                        // VW2=4(S3.5)
LPP


// ============================================================
// 文件结束
// 说明:
//   1. 采用VW226子状态机(0~9),抽液/排液分两步下发,每步等待FC4写完成(M12.0)
//   2. 每次抽液/排液运动完成后发强停(40002=1)恢复96就绪态:
//      抽液→等运动→强停→等就绪→排液→等运动→强停→等就绪→计算/循环
//   3. 运动检测: VW4=2(100运动中)→M12.1/M12.2置位,VW4≠2且已运动→运动完成
//   4. 运动超时: T102(30秒)防止泵卡在运动态,T102超时直接发强停恢复
//   5. 支持多次抽液+排液循环:单循环步数限制6000步(25ml注射器容量),
//      每次排液后强停恢复→累加实际体积到VD378并扣减VD372,直到累计>=目标量
//   6. 全局错误: VW4≥4(不含VW4=2运动中)或V303.4立即转S_ERROR并安全停泵
//   7. S3期间Q0.0/Q0.1保持运行,完成/出错时停止
//   8. 所有Modbus地址使用十六进制格式(16#9C46/16#9C47/16#9C42)
//      避免十进制大数被解析为INT导致MBUS_MSG Error=6
// ============================================================
