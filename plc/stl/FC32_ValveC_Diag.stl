// ============================================================
// 文件: FC32_ValveC_Diag.stl
// 功能: 阀C诊断（液位低位+延时验证+开关到位+超时保护）
// Story: AQEX-7 阀门诊断 + v10.4 硬件变更(去流量开关C)
// 调用方: FC17(S6下缸排水)
// 说明: 【v10.4 硬件变更 2026-09-20】去除流量开关C(I0.2,保留未使用)
//       排水完成判定改为「液位计B低位(I1.0)持续ON达VD_Delay_ValveC_Verify(VD60)」
//       报警码45/47/61废弃(V302.5/V302.7/V303.1改为保留位,不再置位)
//       排水超时(液位低位未到)与关到位超时统一由报警码60(V303.0)覆盖
//       诊断子状态VW264: 0空闲/1等开到位/2排水中/3延时验证/4等关到位
// ============================================================

// 符号说明:
// VW264 : Diag_State_C     阀C诊断子状态
// VW270 : Diag_Result_C    阀C诊断结果(0/1/2)
// VW276 : VD_Timeout_ValveC(VD54)×10 转换值(FC17计算写入)
// VW284 : VD_Delay_ValveC_Verify(VD60)×10 转换值(FC17计算写入)【v10.4新增】
// T56   : 阀C开到位超时
// T57   : 阀C排水超时(液位低位到达超时)【v10.4改制: 原流量开关超时】
// T58   : 阀C关到位超时
// T64   : 阀C液位低位延时验证【v10.4新增】
// I1.0  : 液位计B低位(下缸排空)
// I8.4  : 阀C开到位反馈
// I8.5  : 阀C关到位反馈
// Q0.4  : 阀C
// V303.0: M_Alarm_ValveC_CloseTimeout(报警码60,覆盖关到位超时+排水超时)


NETWORK 1
// ============================================================
// NETWORK 1 - 单NETWORK版 FC32
// P2修复: 单NETWORK合并, 所有JMP/LBL在同一NETWORK内
// 解决STEP7导入跨NETWORK跳转失效
// ============================================================

// 漫溢保护（全程，优先级最高）
// [v2.2] 阀C增加下缸漫溢保护:液位计B高位=ON立即报警+关阀C+转S_ERROR
LD     I0.7
S      V300.1, 1                   // M_Alarm_Overflow_BHigh
R      Q0.4, 1                     // 关阀C
MOVW   99, VW2
MOVB   2, VB270                    // 故障
JMP    6

// 诊断子状态调度
LDW=   VW264, 0
JMP    1
LDW=   VW264, 1
JMP    2
LDW=   VW264, 2
JMP    3
LDW=   VW264, 3
JMP    4
LDW=   VW264, 4
JMP    5
JMP    6

// ---- 子状态0: 空闲 ----
// S0空闲
LBL    1
JMP    6

// ---- 子状态1: 等待开到位 ----
// S1等待开到位
LBL    2
// T56开到位超时 + T57排水超时(两套独立判据, PT均=VW276)
LD     SM0.0
TON    T56, VW276                  // PT=VD_Timeout_ValveC(VD54)×10
TON    T57, VW276                  // 排水超时: 液位低位未在VD_Timeout_ValveC内到达

// 开到位=ON → 转S2排水中
// [已修复 v2.2] 用 V63.2 缓存 EU 结果,避免 R 指令链栈空
LD     I8.4
EU
=      V63.2
LD     V63.2
MOVW   2, VW264
LD     V63.2
R      T56, 1
LD     V63.2
R      T57, 1
JMP    6

// 开到位超时 → 报警46
LD     T56
S      V302.6, 1                   // M_Alarm_ValveC_OpenTimeout
MOVW   99, VW2
MOVW   2, VW270
JMP    6

// 排水超时(开阀后液位低位仍未到达) → 报警60
LD     T57
AN     I1.0                        // 确认液位计B低位仍OFF
S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout(排水超时同用码60)
MOVW   99, VW2
MOVW   2, VW270
JMP    6

// ---- 子状态2: 排水中(等待液位低位) ----
// S2排水中
LBL    3
// 液位计B低位=ON → 转S3延时验证
LD     I1.0
MOVW   3, VW264
JMP    6
// 液位低位=OFF → 继续排水,无动作

// ---- 子状态3: 延时验证(液位低位须持续ON) ----
// S3延时验证
LBL    4
// I1.0持续ON达VD_Delay_ValveC_Verify → 排水完成,关阀C
// 注: I1.0中途OFF时TON输入断开,T64自动清零,液位低位须连续保持
LD     I1.0
TON    T64, VW284                  // PT=VD_Delay_ValveC_Verify(VD60)×10
LD     T64
R      Q0.4, 1                     // 关阀C
MOVW   4, VW264                    // 转S4等关到位
JMP    6
// 液位低位丢失 → 回S2排水中(T64已自动复位)
LDN    I1.0
MOVW   2, VW264
JMP    6

// ---- 子状态4: 等待关到位 ----
// S4等待关到位
LBL    5
// T58关到位超时
LD     SM0.0
TON    T58, VW276                  // PT=VD_Timeout_ValveC×10

// 关到位=ON → 正常完成
// [已修复 v2.2] 用 V63.3 缓存条件,避免 R 指令链栈空
LD     I8.5
=      V63.3
LD     V63.3
MOVW   0, VW264                    // VW264=0空闲
LD     V63.3
MOVW   1, VW270                    // Diag_Result_C=1正常完成
LD     V63.3
R      T58, 1
JMP    6

// 关到位超时 → 报警60
LD     T58
AN     I8.5
S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout
MOVW   99, VW2
MOVW   2, VW270                    // Diag_Result_C=2故障(已修正:用MOVW)
JMP    6

// 诊断结束
LBL    6


// ============================================================
// 文件结束
// 说明:
//   1. FC17调用本FC前置VW264=1启动
//   2. FC17检查VW270: 0等待, 1正常完成转S5/S7, 2故障
//   3. VW276=VD_Timeout_ValveC(VD54)×10转换值
//      VW284=VD_Delay_ValveC_Verify(VD60)×10转换值【v10.4新增】
//   4. 【v10.4硬件变更】I0.2保留未使用
//      V302.5/V302.7/V303.1改为保留位(报警码45/47/61废弃,不再置位)
//      T57由"流量开关超时"改制为"排水超时"(液位低位到达超时)
//      排水异常=开到位超时(46)或排水/关到位超时(60)
//   5. VW270写入统一用MOVW(写完整WORD),确保FC17的AW=VW270判断正确
// ============================================================
