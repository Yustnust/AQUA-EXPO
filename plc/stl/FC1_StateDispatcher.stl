// ============================================================
// 文件: FC1_StateDispatcher.stl
// 功能: 状态机调度器（每周期根据VW2调用对应下缸状态FC）
// Story: v2.2 流程重构 (替代 AQEX-6 状态机骨架)
// 说明: v2.2 取消上缸流程作为下缸主状态的 S1/S2/S3/S3.5
//       上缸流程已拆出到 VW304 State_UpTank 子流程,由 OB1 NET 7 直接调度
//       本 FC1 仅调度下缸 VW2 路径: S0/S4/S5/S6/S7/S_ERROR
//   修复记录:
//     P1-NETWORK标题去掉冒号(错误66)
//     P2-JMP/LBL跨NETWORK问题修复: 全部合并到NETWORK 1
//     【v2.2 修订 2026-09-15】删除 S1/S2/S3/S3.5 LBL;上缸流程外移至 OB1
// ============================================================

NETWORK 1
// 状态调度 (JMP/LBL必须在同一NETWORK内)
// 读取VW2并与各状态值比较，相等则调用对应FC

// VW2 = 0 → S0初始化
LDW<=  VW2, 0
JMP    1

// VW2 = 5 → S4上→下转移
LDW=   VW2, 5
JMP    2

// VW2 = 6 → S5实验运行中
LDW=   VW2, 6
JMP    3

// VW2 = 7 → S6下缸排水
LDW=   VW2, 7
JMP    4

// VW2 = 8 → S7实验结束
LDW=   VW2, 8
JMP    5

// VW2 = 99 → S_ERROR故障锁定
LDW=   VW2, 99
JMP    6

// 其他非法值 → 强制回S0
LDW>=  VW2, 100
JMP    7

// 若未匹配任何状态(0<VW2<99但非上述值),也回S0
JMP    7

// S0入口
LBL    1
CALL State_S0_Init
JMP    8

// S4入口
LBL    2
CALL State_S4_Transfer
JMP    8

// S5入口
LBL    3
CALL State_S5_Run
JMP    8

// S6入口
LBL    4
CALL State_S6_Drain
JMP    8

// S7入口
LBL    5
CALL State_S7_End
JMP    8

// S_ERROR入口
LBL    6
CALL State_Error
JMP    8

// 非法状态处理(强制回S0)
LBL    7
MOVW   0, VW2                       // VW2=0

// 调度结束
LBL    8
// 状态调度完成,返回 OB1
// 注: 上缸子流程(VW304=1/2)由 OB1 NET 7 在本 FC1 之后调度


// ============================================================
// 文件结束
// 说明:
//   1. JMP/LBL必须在同一NETWORK内
//   2. 每个状态FC内部负责状态转移(修改VW2)
//   3. 【v2.2】删除 S1/S2/S3/S3.5 入口:上缸流程移至 VW304 子流程
//   4. 【v2.2】VW2 路径:0(S0)→5(S4)→6(S5)→7(S6)→8(S7) 或 99(S_ERROR)
//   5. 【v2.2】VW304 路径:0(空闲)→1(S1)→2(S2搅拌+加药)→4(已转移)
//                          或 3(配完等待),由 OB1 NET 7 调度 FC11/FC1A
// ============================================================