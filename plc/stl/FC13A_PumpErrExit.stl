// ============================================================
// 文件: FC13A_PumpErrExit.stl
// 功能: FC13 公共泵错误退出处理(停泵+转S_ERROR+清握手)
// Story: 压缩 FC13 程序体积,提取 NETWORK 2/4/7/10/13 重复的错误退出代码
// 说明: 本 FC 由 FC13 各错误路径 CALL 调用,统一执行:
//       1. 安全停潜水泵 Q0.0/Q0.1
//       2. 置位注射泵报警位 V303.4
//       3. 状态机转 S_ERROR(VW2=99)
//       4. 清 S3 子状态 VW226=0
//       5. 清写握手位 M12.0/M11.6/M11.7
//       6. 清运动标志 M12.1/M12.2
//       7. 清超时定时器 T102
// 调用方: FC13 NETWORK 2(全局错误检测) / NETWORK 4(子状态1/5写失败)
//         NETWORK 7(子状态3/7写失败)
// ============================================================

NETWORK 1
// FC13泵错误退出公共处理
// 由FC13各错误路径CALL,统一执行安全停泵+转S_ERROR+清握手
R      Q0.0, 1                       // 停潜水泵1
R      Q0.1, 1                       // 停潜水泵2
S      V303.4, 1                     // 确保报警位
MOVW   99, VW2                       // 转S_ERROR
MOVW   0, VW226                      // 清子状态
R      M12.0, 1                      // 清写完成
R      M12.1, 1                      // 清抽液运动标志
R      M12.2, 1                      // 清排液运动标志
R      M11.6, 1                      // 清写请求
R      M11.7, 1                      // 清写忙
R      T102, 1                       // 清超时定时器


// ============================================================
// 文件结束
// 说明:
//   1. 本 FC 仅在错误路径被 CALL 调用,不单独从 OB1 调用
//   2. 调用前由调用方保证执行条件(已检测到 V303.4 或 VW4≥4)
//   3. 所有复位操作为幂等,重复调用安全
// ============================================================
