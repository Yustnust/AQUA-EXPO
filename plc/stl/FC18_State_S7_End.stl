// ============================================================
// 文件: FC18_State_S7_End.stl
// 功能: S7实验结束 (VW2=8)
// Story: AQEX-6 状态机骨架
// 说明: 实验完成，状态锁定，等待HMI确认重启
// ============================================================

NETWORK 1
// S7进入动作 - 安全停机
LD     SM0.0
// 复位所有DO(安全状态)
MOVB   0, QB0                      // 泵停、阀关
R      Q0.7, 1                     // 报警声音关
R      Q1.0, 1                     // 报警灯光关
// 停止实验时长累加(VD_ExperimentDuration_Accum锁定最终值)
R      T47, 1                      // 停1分钟基准计时
// 置实验结束标志(供S6判断)
S      M10.6, 1


NETWORK 2
// 等待HMI确认重启
// CMD_Start(V0.0)上升沿 → 转S0重新开始
LD     V0.0
EU
R      M10.6, 1                   // 清实验结束标志
R      V1.0, 1                    // 清握手位(由S0重新管理)
MOVB   0, VB2                     // VW2=0(S0)
MOVB   0, VB3


// S7状态锁定，仅响应启动命令和急停(FC2处理)
// ============================================================
// 文件结束
// ============================================================
