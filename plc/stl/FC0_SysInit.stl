// ============================================================
// 文件: FC0_SysInit.stl (调度骨架)
// 功能: 系统初始化入口 — 首次扫描 + Modbus清零 + 冷启/断电路径调度
// Story: AQEX-6 + AQEX-11 + AQEX-51
// 说明: 拆分自原单一 FC0,冷启/断电恢复逻辑分别独立到 SBR25/SBR26
//   跨 SBR 无 JMP/LBL 依赖,每个 SBR 内部 LBL 空间独立
// LBL 分配: FC0 用 1(断电恢复入口)、2(完成汇合)
//          SBR25 用 8/9/10/88/89(冷启动)
//          SBR26 用 1/3/4/5/6/7(断电恢复)
//   跨 SBR 编号相同不冲突,POU 内 LBL 空间独立
// 修复记录:
//   2026-09-13: 拆分前 FC0 12KB 导致 STEP7 下载"块过大"误判,
//               拆分后 FC0(~3KB) + SBR25(~4KB) + SBR26(~4KB) 三个小块
// ============================================================

// 符号说明:
// M16.4: M_InitDone        初始化完成标志(断电保持;v2.2迁移自V304.0,2026-09-15)
// VW198 : VW_Init_Step      初始化步骤号(调试用,0=完成)
// ColdStart  : SBR25 冷启动路径
// WarmRecovery: SBR26 断电恢复路径


NETWORK 1
// SM0.1首次扫描 + Modbus库清零 + FC21计数器清零
// ★ 2026-09-07修复: 每次首次扫描统一清零,库状态机在STOP→RUN后必须复位

LD     SM0.1
MOVW   1, VW198

LD     SM0.1
FILL   0, VW600, 143     // VB600~VB885清零(Modbus库存储区)
LD     SM0.1
MOVB   0, VB378           // 清MBUS_CTRL Error
LD     SM0.1
MOVB   0, VB379           // 清MBUS_MSG Error(注射泵状态)
LD     SM0.1
MOVB   0, VB380           // 清MBUS_MSG Error(流量计)
LD     SM0.1
MOVB   0, VB381           // 清MBUS_MSG Error(注射泵位置)
LD     SM0.1
R      M10.0, 6           // 清M10.0~M10.5(Done位/降级标志)
LD     SM0.1
R      M11.0, 1           // 清MBUS_CTRL Done位
LD     SM0.1
MOVW   0, VW390           // 清手动注射泵子状态
LD     SM0.1
R      M11.6, 1           // 清注射泵写请求
LD     SM0.1
R      T104, 1            // 清回零冷却定时器


NETWORK 2
// 冷启/断电路径调度 + 完成汇合
// 判断冷启动/断电恢复
// M16.4=1 → JMP 1 (LBL 1: CALL WarmRecovery → JMP 2)
// M16.4=0 → 冷启动 → CALL ColdStart → RET回 FC0 继续到 LBL 2
// 【v2.2迁移 2026-09-15】M_InitDone 从 V304.0 迁至 M16.4（位对象，无字节级冲突）

LD     M16.4
JMP    1                  // M16.4=1 → 跳断电恢复路径

// ========== 冷启动路径 ==========
LD     SM0.1
AN     M16.4              // 冷启动(M16.4=0)
CALL   ColdStart          // SBR25: 出厂硬编码 + 用户默认覆盖 + TODR + 安全初始化
                          // ColdStart 自然结束返回
LD     SM0.0
JMP    2                  // ★ 关键: 无条件跳过 LBL 1,否则会形成死循环

// ========== 断电恢复路径 ==========
LBL    1
LD     SM0.1
CALL   WarmRecovery       // SBR26: TODR + RTC检测 + BCD转秒 + 状态机恢复
                          // WarmRecovery 自然结束后,顺序执行到 LBL 2 汇合

// ========== 初始化完成汇合 ==========
LBL    2
LD     SM0.1
S      M16.4, 1           // M_InitDone=1(初始化完成,断电保持;从V304.0迁移)
MOVW   0, VW198           // 步骤=0(完成)
// 汇合后自然结束 FC0,返回 OB1


// ============================================================
// 文件结束
// ============================================================
