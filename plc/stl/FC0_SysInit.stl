// ============================================================
// 文件: FC0_SysInit.stl
// 功能: 系统初始化（首次扫描SM0.1调用）
// Story: AQEX-6 状态机骨架
// 说明: 上电首次扫描时初始化所有变量到安全状态
// ============================================================

NETWORK 1: 状态机初始化为S0
LD     SM0.1
MOVB   0, VB2                       // VW2低字节=0
MOVB   0, VB3                       // VW2高字节=0，VW2=0即S0


NETWORK 2: 复位上下缸状态
LD     SM0.1
R      V1.6, 1                      // 上缸状态=0(空)
R      V1.7, 1                      // 下缸状态=0(空)


NETWORK 3: 复位所有DO输出（安全状态）
LD     SM0.1
MOVB   0, QB0                       // Q0.0~Q0.7=0
MOVB   0, QB1                       // Q1.0=0


NETWORK 4: 清除急停锁存
LD     SM0.1
R      V300.4, 1                    // M_EStop_Latch=0


NETWORK 5: 清除报警字和报警码
LD     SM0.1
FILL   0, VW300, 4                  // VB300~VB303清零(报警字)
MOVB   0, VB6                       // VW6低字节=0
MOVB   0, VB7                       // VW6高字节=0，VW6=0无报警


NETWORK 6: 清除命令握手位
LD     SM0.1
R      V1.0, 6                      // V1.0~V1.5=0


NETWORK 7: 实验轮次清零
LD     SM0.1
MOVB   0, VB8
MOVB   0, VB9                       // VW8=0


// 注: 首次扫描不初始化VD参数区(VD10~VD140)，保留断电保持值
// 注: DT10时间戳不初始化，由FC15(S4)转移完成时写入
// 注: RTC丢失检测、断电恢复逻辑由Story 1.7在FC0中补充


// ============================================================
// 文件结束
// ============================================================
