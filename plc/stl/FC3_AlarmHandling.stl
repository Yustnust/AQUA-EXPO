// ============================================================
// 文件: FC3_AlarmHandling.stl
// 功能: 报警处理（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-10 报警分级与消音/消光逻辑(详细实现)
// 说明: 优先级链计算VW6 + 消音(I0.4/V0.4) + 消光(V0.3确认)
//       自动恢复模式(V200.0=0时一般故障级条件消失自动复位)
//       高优先级(漫溢/节奏滞后/继电器故障)强制人工确认,不受模式影响
// ============================================================

// 符号说明:
// VW6   : 当前最高优先级未确认报警码(0=无,99=继电器故障,10~14漫溢,20~21节奏,30~65一般)
// V200.0: M_AlarmAckMode 报警确认模式(0=自动恢复,1=人工确认)
// Q0.7  : 报警声音(FC2/FC19置位,FC3管理消音)
// Q8.0  : 报警灯光(FC3统一管理,避免双写冲突)
// I0.4  : 就地消音按钮(常开点动)
// V0.3  : CMD_AckAlarm HMI报警确认命令
// V0.4  : CMD_Mute HMI消音命令
// V1.3  : STA_AlarmAckDone 报警确认握手
// V1.4  : STA_MuteDone 消音握手
// M11.1 : M_Sound_Latched 声音已消音标志(新报警时清,实现重鸣)
// M11.2 : M_PrevAlarm 上一周期有报警标志(新报警检测用)


NETWORK 1
// 优先级链计算 VW6(最高优先级未确认报警码)
// 压缩版: 用 LDW=+A+MOVW 条件赋值,替代 LD/JMP/LBL 结构
// 优先级: 99 > 10~14 > 20~21 > 66 > 30~36 > 40~47 > 49 > 60~61 > 64~65
// 原理: 从最高优先级开始逐个检查,VW6一旦被赋值,后续 LDW= VW6,0 为假,自动跳过

LD     SM0.0
MOVW   0, VW6                    // 默认无报警

// 1. 安全继电器故障(99)
LD     V300.5
MOVW   99, VW6

// 2. 漫溢级(10~14) - 逐位检查
LDW=   VW6, 0
A      V300.0
MOVW   10, VW6
LDW=   VW6, 0
A      V300.1
MOVW   11, VW6
LDW=   VW6, 0
A      V300.2
MOVW   12, VW6
LDW=   VW6, 0
A      V300.3
MOVW   13, VW6
LDW=   VW6, 0
A      V300.4
MOVW   14, VW6

// 3. 节奏滞后(20~21)
LDW=   VW6, 0
A      V300.6
MOVW   20, VW6
LDW=   VW6, 0
A      V300.7
MOVW   21, VW6

// 4. 单轮换水周期超时(66)
LDW=   VW6, 0
A      V303.6
MOVW   66, VW6

// 5. 阀A类(30~36) - 逐位检查
LDW=   VW6, 0
A      V301.0
MOVW   30, VW6
LDW=   VW6, 0
A      V301.2
MOVW   32, VW6
LDW=   VW6, 0
A      V301.3
MOVW   33, VW6
LDW=   VW6, 0
A      V301.4
MOVW   34, VW6
LDW=   VW6, 0
A      V301.5
MOVW   35, VW6
LDW=   VW6, 0
A      V301.6
MOVW   36, VW6

// 6. 阀B/C类(40~47) - 逐位检查
LDW=   VW6, 0
A      V302.0
MOVW   40, VW6
LDW=   VW6, 0
A      V302.1
MOVW   41, VW6
LDW=   VW6, 0
A      V302.2
MOVW   42, VW6
LDW=   VW6, 0
A      V302.3
MOVW   43, VW6
LDW=   VW6, 0
A      V302.4
MOVW   44, VW6
LDW=   VW6, 0
A      V302.5
MOVW   45, VW6
LDW=   VW6, 0
A      V302.6
MOVW   46, VW6
LDW=   VW6, 0
A      V302.7
MOVW   47, VW6

// 7. 其他类(49,60,61,64,65)
LDW=   VW6, 0
A      V303.2
MOVW   49, VW6
LDW=   VW6, 0
A      V303.0
MOVW   60, VW6
LDW=   VW6, 0
A      V303.1
MOVW   61, VW6
LDW=   VW6, 0
A      V303.4
MOVW   64, VW6
LDW=   VW6, 0
A      V303.5
MOVW   65, VW6


// 报警输出管理(灯光常亮 + 新报警声音重鸣)
// 有活动报警(VW6≠0) → 灯光Q8.0常亮
// 新报警(VW6由0变非0) → 清M_Sound_Latched,声音重鸣
LDW<> VW6, 0
S      Q8.0, 1                       // 灯光常亮

// 新报警检测: 本周期VW6≠0 且 上一周期M11.2=0(无报警) → 新报警
LDW<> VW6, 0
AN     M11.2                         // 上一周期无报警 → 新报警
R      M11.1, 1                      // 清消音标志(新报警重鸣)

// 声音管理: 有报警且未消音 → 声音开
LDW<> VW6, 0
AN     M11.1                         // 未消音
S      Q0.7, 1                       // 声音开

// 自动恢复模式: VW6=0且自动模式 → 自动消光
LDW= VW6, 0
AN     V200.0                        // M_AlarmAckMode=0(自动模式)
R      Q8.0, 1                       // 无报警自动消光
R      Q0.7, 1                       // 无报警关声音
R      M11.1, 1                      // 清消音标志

// 更新上一周期报警标志
LDW<> VW6, 0
=      M11.2                         // 记录本周期有报警(供下周期新报警检测)


// 消音处理(I0.4就地按钮 OR V0.4 HMI命令)
// 消音源: I0.4上升沿 OR V0.4上升沿
LD     I0.4
EU
LD     V0.4
EU
OLD                                 // 两者任一上升沿
R      Q0.7, 1                       // 关声音
S      M11.1, 1                      // 置消音标志(新报警时清)
S      V1.4, 1                       // STA_MuteDone握手
R      V0.4, 1                       // 清HMI消音命令
// 注: 消音只关声音,灯光Q8.0和报警位保持;新报警(VW6变化)时M11.1清,声音重鸣


// 报警确认处理(V0.3 HMI确认 → 条件消失才消光+清锁存)
// V0.3上升沿 = HMI报警确认命令(高优先级HMI侧二次确认,PLC只收V0.3)
// 确认规则: V0.3上升沿后,逐个检查报警位条件,条件消失的复位报警位,再由NETWORK1重算VW6
// ★ 关键修复(2026-09-04): NETWORK 4 缺 V0.3 上升沿门控(JMP),导致每周期无条件
//   执行所有条件复位,包括 LD V303.5; R V303.5, 1——使 S_ERROR 立即被清
//   修复: V0.3 无上升沿时跳过整个网络,避免误清报警位
// ★★★ 2026-09-11 发现 JMP 条件写反了！ ★★★
//   原代码 LD V0.3; EU; JMP 40：EU=1(有上升沿)时跳转 → 反而跳过了 R V0.3,1
//   正确：用 V60.5 缓存 EU 结果,LDN 取反后触发 JMP,再用 LD 恢复栈顶执行线圈
//   注意：STL 的 S/R/= 线圈指令依赖栈顶=1 才执行,不能用 NOT+JMP（会清掉栈顶）
//   注意：S7-200 SMART 不支持 JMPN 指令,必须用 JMP + LDN 中转
LD     V0.3
EU
=      V60.5                         // 缓存 EU 结果: 有上升沿=1, 无上升沿=0
LDN    V60.5                         // 无上升沿时栈顶=1
JMP    40                            // ★ 无上升沿则跳转到 LBL 40,跳过确认处理
LD     V60.5                         // 有上升沿时栈顶=1,恢复执行条件

S      V1.3, 1                       // STA_AlarmAckDone握手
R      V0.3, 1                       // 清确认命令

// 漫溢级: 条件消失才复位(液位计高位=OFF)
LD     V300.0                        // 上缸漫溢
AN     I0.5                          // 液位计A-高位已OFF
R      V300.0, 1                     // 复位
LD     V300.1                        // 下缸漫溢
AN     I0.7                          // 液位计B-高位已OFF
R      V300.1, 1
// NC阀动作: 由人工确认复位(无DI直接条件,保持锁存需HMI强制,此处不自动复位)
// 急停V300.4/继电器故障V300.5: 由FC19系统复位按钮/HMI高权限确认处理,FC3不碰

// 节奏滞后级: 条件消失(新一轮开始)由FC40重置,FC3不直接处理
// 但V0.3确认时,若V300.6/7已由FC40清除,NETWORK1会重算VW6

// 一般故障级: 条件消失则复位(调用公共子程序,与 NETWORK 5 共享)
CALL   AlarmReset_Common

LBL    40                            // ★ NETWORK 4 跳转目标(无V0.3上升沿时跳过确认处理)

// 注: 报警位复位后,下一周期NETWORK1重算VW6;若VW6=0,NETWORK2自动消光
// 注: 漫溢级(V300.2/3 NC阀)、急停(V300.4)、继电器故障(V300.5)不由FC3复位
//      由FC19系统复位按钮/HMI高权限确认处理


// 自动恢复模式(M_AlarmAckMode=0时一般故障级条件消失自动复位)
// 自动模式: V200.0=0时,一般故障级报警位条件消失自动R复位
// 漫溢/节奏滞后/继电器故障不受此模式影响,保持锁存
// ★ 2026-09-11 修复 AQEX-XX: 状态机已进S_ERROR(VW2=99)时禁止自动清报警位
//   原因: 一般故障触发MOVW 99,VW2后，若自动恢复立即清报警位，
//   会导致 VW2=99 + VW6=0 的状态机/报警系统不一致
//   场景: 阀A开到位超时(V301.4)后阀A终于开到位(I8.0=ON),
//         FC3 NETWORK 5 自动清V301.4→VW6=0,但VW2已锁99无人解锁,
//         OB1 NETWORK12 按VW6=0算VB305=0(良好),掩盖故障
//   防御: S_ERROR态暂停自动恢复,让FC19 NETWORK5自动解锁或人工复位处理
LDW=    VW2, 99
JMP    50                    // S_ERROR态 → 跳过自动恢复,报警位保持

LD     V200.0                        // M_AlarmAckMode
NOT                                     // =0(自动模式)时执行后续

// 一般故障级: 条件消失则复位(调用公共子程序,与 NETWORK 4 共享)
CALL   AlarmReset_Common

LBL    50                        // ★ S_ERROR态跳过自动恢复的跳转目标(2026-09-11新增)

// 注: 漫溢(V300.0~3)、急停(V300.4)、继电器故障(V300.5)、节奏滞后(V300.6/7)不在此处理
// 注: 自动复位后下一周期NETWORK1重算VW6,NETWORK2自动消光


// NETWORK 6 报警日志已删除(压缩体积)
// HMI 侧已有完整报警历史记录,PLC 仅保留 VW6 供 HMI 轮询即可


// ============================================================
// 文件结束
// 说明:
//   1. FC3每周期调用,负责报警码计算+输出管理+确认处理+自动恢复+日志
//   2. 报警位置位由各FC(FC2/FC30~32/FC40等)负责,FC3只复位
//   3. Q8.0灯光由FC3统一管理,FC2/FC19不操作Q8.0(避免双写)
//   4. Q0.7声音由FC2/FC19置位(急停/故障态),FC3管理消音+新报警重鸣
//   5. 编址修正: M_AlarmAckMode=V200.0(避VD124冲突),SafetyRelayAck=V0.7(避V0.5冲突)
//   6. 高优先级(漫溢/节奏滞后/继电器故障)强制人工确认,不受M_AlarmAckMode影响
//   7. NETWORK4/5的报警位复位条件需与各FC置位条件严格对应(现场调试时核实)
// ============================================================
