// ============================================================
// 文件: FC20_ManualControl.stl
// 功能: 手动控制FC (由OB1仅在S0态调用)
// Story: AQEX-60 手动控制页
// 说明:
//       由OB1在S0态调用；非S0态不调用，避免覆盖其他状态输出
//       手动命令为脉冲方式(按1松0),由M位锁存输出状态
//       手动开阀自动打开串联的NC球阀,关阀自动关闭
// 修复记录:
//   P1-改为M位锁存,解决FC10每周期清QB0导致手动输出无法保持的问题
//   P2-NC球阀串联主路,手动开阀时自动打开对应NC阀
//   P3-【重大修复2026-09-03】手动命令位从V2.4~V3.7迁移至V306.0~V307.3
//      原地址V2.4~V3.7与VW2(状态机当前状态)物理地址完全重叠(VB2+VB3),
//      写入任何手动命令位会直接改写VW2,触发非预期状态切换(如V3.1=1→VW2=2→S2预循环→两台泵同时启动)
//      新地址V306.0~V307.3落在地址表"预留扩展区",与VW2/VW6/VW8等状态/报警字无冲突
//   P4-【2026-09-03 调试模式】新增V303.5调试模式开关,=1时跳过阀B/阀C的液位联锁(V1.6/V1.7)
//      联机调试时上下缸无水,V1.6/V1.7=0,导致阀B/阀C手动永远卡死
//      调试期间V303.5置1可绕过联锁直接开阀;生产前必须V303.5=0(默认)
// ============================================================

// 符号表:
// V306.0 : CMD_Manual_ValveA_Open  手动开阀A   (旧地址V2.4,2026-09-03迁移避开VW2重叠)
// V306.1 : CMD_Manual_ValveA_Close 手动关阀A   (旧地址V2.5)
// V306.2 : CMD_Manual_ValveB_Open  手动开阀B   (旧地址V2.6)
// V306.3 : CMD_Manual_ValveB_Close 手动关阀B   (旧地址V2.7)
// V306.4 : CMD_Manual_ValveC_Open  手动开阀C   (旧地址V3.0)
// V306.5 : CMD_Manual_ValveC_Close 手动关阀C   (旧地址V3.1)
// V306.6 : CMD_Manual_Pump1_On     手动启泵1   (旧地址V3.2)
// V306.7 : CMD_Manual_Pump1_Off    手动停泵1   (旧地址V3.3)
// V307.0 : CMD_Manual_Pump2_On     手动启泵2   (旧地址V3.4)
// V307.1 : CMD_Manual_Pump2_Off    手动停泵2   (旧地址V3.5)
// V309.0 : M_DebugMode_BypassInterlock 调试模式-跳过液位联锁(0=生产/1=调试,默认0,调试结束后必须清0)
// V1.6   : STA_TankA_State         上缸液位状态(自动流程FC12置1/FC15清0)
// V1.7   : STA_TankB_State         下缸液位状态(自动流程FC15/FC16维护)
// Q0.2   : DO_ValveA 阀A输出
// Q0.3   : DO_ValveB 阀B输出
// Q0.4   : DO_ValveC 阀C输出
// Q0.5   : DO_NCValve_Top NC球阀-上缸(常闭型,得电打开)
// Q0.6   : DO_NCValve_Bottom NC球阀-下缸(常闭型,得电打开)
// M13.0  : 阀A手动锁存(=1开阀A,=0关阀A)
// M13.1  : 阀B手动锁存
// M13.2  : 阀C手动锁存
// M13.3  : 泵1手动锁存
// M13.4  : 泵2手动锁存
// ============================================================

NETWORK 1
// 手动阀A控制(开/关)
LD     SM0.0
A      V306.0
EU
S      M13.0, 1
R      V306.0, 1

LD     SM0.0
A      V306.1
EU
R      M13.0, 1
R      V306.1, 1

NETWORK 2
// 手动阀B控制(开/关)
// 联锁条件: 上缸满(V1.6) AND 下缸空(V1.7=0) [生产]
// 调试模式: V309.0=1 跳过联锁(空缸调试用,生产前必须V309.0=0)
LD     SM0.0
A      V306.2
EU
LD     V1.6
AN     V1.7
O      V309.0
ALD
S      M13.1, 1
R      V306.2, 1

LD     SM0.0
A      V306.3
EU
R      M13.1, 1
R      V306.3, 1

NETWORK 3
// 手动阀C控制(开/关)
// 联锁条件: 下缸满(V1.7) [生产]
// 调试模式: V309.0=1 跳过联锁(空缸调试用,生产前必须V309.0=0)
LD     SM0.0
A      V306.4
EU
LD     V1.7
O      V309.0
ALD
S      M13.2, 1
R      V306.4, 1

LD     SM0.0
A      V306.5
EU
R      M13.2, 1
R      V306.5, 1

NETWORK 4
// 手动泵1控制(启/停)
LD     SM0.0
A      V306.6
EU
S      M13.3, 1
R      V306.6, 1

LD     SM0.0
A      V306.7
EU
R      M13.3, 1
R      V306.7, 1

NETWORK 5
// 手动泵2控制(启/停)
LD     SM0.0
A      V307.0
EU
S      M13.4, 1
R      V307.0, 1

LD     SM0.0
A      V307.1
EU
R      M13.4, 1
R      V307.1, 1

NETWORK 6
// 手动输出映射到Q点
// 在S0态用=线圈覆盖FC10_State_S0_Init中的QB0清零
LD     M13.0
=      Q0.2

LD     M13.1
=      Q0.3

LD     M13.2
=      Q0.4

LD     M13.3
=      Q0.0

LD     M13.4
=      Q0.1

NETWORK 7
// NC球阀自动跟随(串联主路,保证手动开阀有水流通)
// 上缸NC阀跟随阀A;下缸NC阀跟随阀B
LD     Q0.2
=      Q0.5

LD     Q0.3
=      Q0.6
