// ============================================================
// 文件: FC20_ManualControl.stl
// 功能: 手动控制FC (由OB1仅在S0态调用)
// Story: AQEX-60 手动控制页
// 说明:
//       由OB1在S0态调用；非S0态不调用，避免覆盖其他状态输出
//       手动命令为脉冲方式(按1松0),由M位锁存输出状态
//       手动开阀自动打开串联的NC球阀,关阀自动关闭
// 修复记录:
//   P1-改为M位锁存,解决FC10每周期清QB0导致手动输出无法保持的问题
//   P2-NC球阀串联主路,手动开阀时自动打开对应NC阀
// ============================================================

// 符号表:
// V2.4  : CMD_Manual_ValveA_Open 手动开阀A
// V2.5  : CMD_Manual_ValveA_Close 手动关阀A
// V2.6  : CMD_Manual_ValveB_Open 手动开阀B
// V2.7  : CMD_Manual_ValveB_Close 手动关阀B
// V3.0  : CMD_Manual_ValveC_Open 手动开阀C
// V3.1  : CMD_Manual_ValveC_Close 手动关阀C
// V3.2  : CMD_Manual_Pump1_On 手动启泵1
// V3.3  : CMD_Manual_Pump1_Off 手动停泵1
// V3.4  : CMD_Manual_Pump2_On 手动启泵2
// V3.5  : CMD_Manual_Pump2_Off 手动停泵2
// V1.6  : STA_TankA_State 上缸状态 1=满
// V1.7  : STA_TankB_State 下缸状态 1=满
// M13.0 : Manual_ValveA_Latch 手动阀A锁存
// M13.1 : Manual_ValveB_Latch 手动阀B锁存
// M13.2 : Manual_ValveC_Latch 手动阀C锁存
// M13.3 : Manual_Pump1_Latch  手动泵1锁存
// M13.4 : Manual_Pump2_Latch  手动泵2锁存
// Q0.0  : DO_Pump1 潜水泵1
// Q0.1  : DO_Pump2 潜水泵2
// Q0.2  : DO_ValveA 阀A
// Q0.3  : DO_ValveB 阀B
// Q0.4  : DO_ValveC 阀C
// Q0.5  : DO_NCValve_Top NC球阀-上缸(常闭型,得电打开)
// Q0.6  : DO_NCValve_Bottom NC球阀-下缸(常闭型,得电打开)
// ============================================================

NETWORK 1
// 手动阀A控制(开/关)
LD     SM0.0
A      V2.4
EU
S      M13.0, 1
R      V2.4, 1

LD     SM0.0
A      V2.5
EU
R      M13.0, 1
R      V2.5, 1

NETWORK 2
// 手动阀B控制(开/关)
LD     SM0.0
A      V2.6
EU
A      V1.6
AN     V1.7
S      M13.1, 1
R      V2.6, 1

LD     SM0.0
A      V2.7
EU
R      M13.1, 1
R      V2.7, 1

NETWORK 3
// 手动阀C控制(开/关)
LD     SM0.0
A      V3.0
EU
A      V1.7
S      M13.2, 1
R      V3.0, 1

LD     SM0.0
A      V3.1
EU
R      M13.2, 1
R      V3.1, 1

NETWORK 4
// 手动泵1控制(启/停)
LD     SM0.0
A      V3.2
EU
S      M13.3, 1
R      V3.2, 1

LD     SM0.0
A      V3.3
EU
R      M13.3, 1
R      V3.3, 1

NETWORK 5
// 手动泵2控制(启/停)
LD     SM0.0
A      V3.4
EU
S      M13.4, 1
R      V3.4, 1

LD     SM0.0
A      V3.5
EU
R      M13.4, 1
R      V3.5, 1

NETWORK 6
// 手动输出映射到Q点
// 在S0态用=线圈覆盖FC10_State_S0_Init中的QB0清零
LD     M13.0
=      Q0.2

LD     M13.1
=      Q0.3

LD     M13.2
=      Q0.4

LD     M13.3
=      Q0.0

LD     M13.4
=      Q0.1

NETWORK 7
// NC球阀自动跟随(串联主路,保证手动开阀有水流通)
// 上缸NC阀跟随阀A;下缸NC阀跟随阀B
LD     Q0.2
=      Q0.5

LD     Q0.3
=      Q0.6
