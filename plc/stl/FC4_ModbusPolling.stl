// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-33修复 + AQEX-5完善(错误重试+降级)
// 说明: 轮询注射泵(站号1)+流量计(站号2),基于Done位顺序轮询
//       含3次重试机制 + 降级模式(连续失败5次→进入降级,使用上一有效值)
//       超时检测(10秒/任务无Done响应→报警)
// ============================================================

// 符号说明:
// VW250 : 轮询从站计数器(0~3,4个轮询任务)
// VW252 : 当前任务重试计数(0~3,3次失败标记本任务失败)
// VW254 : 注射泵连续失败计数(≥5次→降级模式)
// VW256 : 流量计连续失败计数(≥5次→降级模式)
// M10.0 : 注射泵状态码轮询Done位(MBUS_MSG任务0输出,LAD引脚)
// M10.1 : 流量计累计值轮询Done位(MBUS_MSG任务1输出,LAD引脚)
// M10.2 : 注射泵步数读取Done位(任务2,预留)
// M10.3 : 注射泵速度读取Done位(任务3,预留)
// M10.4 : 注射泵降级模式标志(1=使用上一有效值)
// M10.5 : 流量计降级模式标志
// M11.0 : MBUS_CTRL Done位(LAD引脚,每周期脉冲)
// VB378 : MBUS_CTRL Error错误码(LAD引脚)
// VB379 : 注射泵轮询错误码(MBUS_MSG任务0输出,LAD引脚)
// VB384 : 流量计轮询错误码(MBUS_MSG任务1输出,LAD引脚,避开VD380暂存区)
// VW4   : 注射泵状态码(映射自41001)
// VD86  : 流量计当前计量值(映射自40009)
//        注: AQEX-42 流量计选型变更(K24微小流量计→BPM32FC积算仪+涡轮流量计)
//        BPM32FC累积流量寄存器地址0x08, FC03读2字(32位IEEE-754浮点)
//        Modbus地址=40001+8=40009, 数据格式与K24一致, FC30差值法逻辑不变
// VW204 : 注射泵目标步数低字(映射自40006)
// VW206 : 注射泵目标步数高字(映射自40007)
// VW208 : 注射泵启动速度(映射自40009)
// VW210 : 注射泵最高速度(映射自40010)
// VW212 : 注射泵截止速度(映射自40011)
// VD96  : 注射泵状态码上一有效值(降级用)
// VD374 : 流量计累计值上一有效值(降级用,避开VD102冲突)
// T50   : 注射泵轮询超时(10秒)
// T51   : 流量计轮询超时(10秒)


NETWORK 1
// Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600, Parity=0(无), Port=0, Timeout=1000ms
// 注: MBUS_CTRL是LAD指令盒,STL中无法直接调用,需在LAD网络中插入
LD     SM0.0
// MBUS_CTRL 1, 9600, 0, 0, 1000   // 改为在LAD中实现


NETWORK 2
// 任务0 - 注射泵状态码(站号1,41001,FC03读1字,写VW4)
// 降级模式时跳过实际轮询,直接使用VD96上一有效值
LD     SM0.0
LPS
AW=    VW250, 0
AN     M10.4                         // 非降级模式
// MBUS_MSG 1, 1, 0, 41001, 1, &VB4, M10.0, MW12   // 改为在LAD中实现
LPP

// 降级模式: 用上一有效值
LD     M10.4                         // 降级模式
AW=    VW250, 0
MOVW   VW96, VW4                     // VW4=上一有效值

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW250, 0
AN     M10.4
TON    T50, 100                      // 10秒(100×100ms)

// 任务0完成或超时处理
LD     M10.0                         // Done位=成功
AW=    VW250, 0
EU
// 成功: 保存有效值+清失败计数+清重试计数+转下一任务
MOVW   VW4, VW96                     // 保存当前值为"上一有效值"
MOVW   0, VW254                      // 清连续失败计数
MOVW   0, VW252                      // 清重试计数
R      V303.4, 1                     // 清注射泵故障报警(通讯恢复)
R      T50, 1
R      M10.0, 1
MOVB   1, VB250
MOVB   0, VB251

// 任务0超时(10秒未Done)
LD     T50
AN     M10.0
AW=    VW250, 0
EU
// 超时: 重试计数+1
INCW   VW252
R      T50, 1
// 重试<3次: 重新发起本任务(保持VW250=0)
LDW<   VW252, 3
R      M10.0, 1
// 重试≥3次: 标记本任务失败,连续失败计数+1,转下一任务
LDW>=  VW252, 3
S      V303.4, 1                     // M_Alarm_SyringePump
INCW   VW254                         // 连续失败计数+1
MOVW   0, VW252                      // 清重试计数
// 连续失败≥5次: 进入降级模式
LDW>=  VW254, 5
S      M10.4, 1                      // 降级模式标志
// 转下一任务
LD     SM0.0
MOVB   1, VB250
MOVB   0, VB251
R      T50, 1
R      M10.0, 1


NETWORK 3
// 任务1 - 流量计累计值(站号2,40009,FC03读2字,写VD86)
// AQEX-42: K24微小流量计→BPM32FC积算仪,累积流量寄存器0x08→Modbus地址40009
// BPM32FC同时支持FC03/FC04,此处保持FC03(4xxxx),数据格式IEEE-754浮点不变
LD     SM0.0
LPS
AW=    VW250, 1
AN     M10.5                         // 非降级模式
// MBUS_MSG 1, 2, 0, 40009, 2, &VB86, M10.1, MW14   // 改为在LAD中实现
LPP

// 降级模式
LD     M10.5
AW=    VW250, 1
MOVD   VD374, VD86                   // VD86=上一有效值

// 超时计时器
LD     SM0.0
AW=    VW250, 1
AN     M10.5
TON    T51, 100                      // 10秒

// 任务1完成
LD     M10.1
AW=    VW250, 1
EU
MOVD   VD86, VD374                   // 保存有效值
MOVW   0, VW256                      // 清失败计数
MOVW   0, VW252
R      V303.6, 1                     // 清流量开关异常报警
R      T51, 1
R      M10.1, 1
MOVB   2, VB250
MOVB   0, VB251

// 任务1超时
LD     T51
AN     M10.1
AW=    VW250, 1
EU
INCW   VW252
R      T51, 1
LDW<   VW252, 3
R      M10.1, 1
LDW>=  VW252, 3
S      V303.6, 1                     // M_Alarm_FlowSwitch_Instant
INCW   VW256
MOVW   0, VW252
LDW>=  VW256, 5
S      M10.5, 1                      // 流量计降级模式
LD     SM0.0
MOVB   2, VB250
MOVB   0, VB251
R      T51, 1
R      M10.1, 1


NETWORK 4
// 任务2 - 注射泵步数读取(站号1,40006,FC03读2字,写VW204)
LD     SM0.0
LPS
AW=    VW250, 2
AN     M10.4                         // 注射泵降级时跳过
// MBUS_MSG 1, 1, 0, 40006, 2, &VB204, M10.2, MW12   // 改为在LAD中实现
LPP

LD     SM0.0
AW=    VW250, 2
AN     M10.4
TON    T50, 100

LD     M10.2
AW=    VW250, 2
EU
MOVW   0, VW252
R      T50, 1
R      M10.2, 1
MOVB   3, VB250
MOVB   0, VB251

LD     T50
AN     M10.2
AW=    VW250, 2
EU
INCW   VW252
R      T50, 1
LDW<   VW252, 3
R      M10.2, 1
LDW>=  VW252, 3
// 步数读取失败不单独报警(已由任务0覆盖V303.4)
MOVW   0, VW252
LD     SM0.0
MOVB   3, VB250
MOVB   0, VB251
R      T50, 1
R      M10.2, 1


NETWORK 5
// 任务3 - 注射泵速度读取(站号1,40009,FC03读3字,写VW208)
LD     SM0.0
LPS
AW=    VW250, 3
AN     M10.4
// MBUS_MSG 1, 1, 0, 40009, 3, &VB208, M10.3, MW12   // 改为在LAD中实现
LPP

LD     SM0.0
AW=    VW250, 3
AN     M10.4
TON    T50, 100

LD     M10.3
AW=    VW250, 3
EU
MOVW   0, VW252
R      T50, 1
R      M10.3, 1
// 任务3完成 → 回任务0(循环轮询)
MOVB   0, VB250
MOVB   0, VB251

LD     T50
AN     M10.3
AW=    VW250, 3
EU
INCW   VW252
R      T50, 1
LDW<   VW252, 3
R      M10.3, 1
LDW>=  VW252, 3
MOVW   0, VW252
MOVB   0, VB250
MOVB   0, VB251
R      T50, 1
R      M10.3, 1


NETWORK 6
// 降级模式退出检测(通讯恢复自动退出)
// 注射泵: 连续3次成功(在任务0成功分支累加计数)→退出降级
// 简化版: 任何一次任务0成功就退出降级(已在NETWORK2中清VW254+R M10.4)
// 此处仅做日志记录,无需额外逻辑
LD     M10.4
EU
TODR VB520                       // 记录进入降级模式时间
LD     M10.5
EU
TODR VB530                       // 记录流量计进入降级时间


// ============================================================
// 文件结束
// 说明:
//   1. AQEX-5完善: 3次重试+5次连续失败进入降级模式
//   2. 降级模式: 使用上一有效值(VW4←VD96, VD86←VD100),避免数据跳变
//   3. 通讯恢复: 一次成功即退出降级(自动恢复)
//   4. 报警逻辑: 超时3次→置V303.4(注射泵)/V303.6(流量计)
//   5. 降级模式不触发新报警(已报警),仅维持上一有效值
//   6. 注射泵写指令(FC06写40006/40007步数)由FC13触发,本FC仅读轮询
//   7. 完整Modbus错误码处理(重试间隔/降级深度)属Story 1.1后续整定
//   8. MBUS_MSG的First参数=1表示首次启动新请求(Done后自动清零)
// ============================================================
