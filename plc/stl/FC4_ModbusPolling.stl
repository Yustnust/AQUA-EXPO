// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-33修复 + AQEX-5完善(错误重试+降级)
// 说明: 轮询注射泵(站号1)+流量计(站号2),基于Done位顺序轮询
//       含3次重试机制 + 降级模式(连续失败5次→进入降级,使用上一有效值)
//       超时检测(10秒/任务无Done响应→报警)
// 修复记录:
//   AQEX-46: 修复MBUS_MSG EN/First条件未正确传入SBR21,导致First常通报Error=6
//   AQEX-46: 补全任务1完成分支与超时分支(原STL仅调用SBR21,无状态切换)
// ============================================================

// 符号说明:
// VW290 : 轮询从站计数器(0~4,5个轮询任务;4为注射泵写任务)
// VW292 : 当前任务重试计数(0~3,3次失败标记本任务失败)
// VW294 : 注射泵连续失败计数(≥5次→降级模式)
// VW296 : 流量计连续失败计数(≥5次→降级模式)
// M10.0 : 注射泵状态码轮询Done位(MBUS_MSG任务0输出,LAD引脚)
// M10.1 : 流量计累计值轮询Done位(MBUS_MSG任务1输出,LAD引脚)
// M10.2 : 注射泵位置读取Done位(任务2)
// M10.3 : 注射泵速度读取/写命令Done位(任务3/任务4复用)
// M10.4 : 注射泵降级模式标志(1=使用上一有效值)
// M10.5 : 流量计降级模式标志
// M11.0 : MBUS_CTRL Done位(LAD引脚,每周期脉冲)
// M11.6 : PumpWrite_Req  注射泵写请求(FC13/FC20置位,FC4清零)
// M11.7 : PumpWrite_Busy 注射泵写忙标志(FC4置位/清零)
// M12.0 : PumpWrite_Done 注射泵写完成(FC4置位,请求方清零)
// VB378 : MBUS_CTRL Error错误码(LAD引脚)
// VB379 : 注射泵轮询/写错误码(MBUS_MSG任务0/2/3/4输出,LAD引脚)
// VB384 : 流量计轮询错误码(MBUS_MSG任务1输出,LAD引脚,避开VD380暂存区)
// VW4   : 注射泵状态码(映射自41001,归一化后:0=完成/空闲,1=运行,2=抽液,3=排液,≥4=错误)
// VW224 : 注射泵状态码原始值(41001原始值,调试用)
// VD86  : 流量计当前计量值(映射自40009)
//        注: AQEX-42 流量计选型变更(K24微小流量计→BPM32FC积算仪+涡轮流量计)
//        BPM32FC累积流量寄存器地址0x08, FC03读2字(32位IEEE-754浮点)
//        Modbus地址=40001+8=40009, 数据格式与K24一致, FC30差值法逻辑不变
// VW204 : 注射泵抽液目标步数(映射自40006)
// VW206 : 注射泵排液目标步数(映射自40007)
// VW208 : 注射泵启动速度(映射自40009)
// VW210 : 注射泵最高速度(映射自40010)
// VW212 : 注射泵截止速度(映射自40011)
// VW222 : 注射泵位置反馈(映射自41007)
// VD232 : PumpWrite_Addr  FC06写目标Modbus地址(FC13/FC20写入)
// VW230 : PumpWrite_Data  FC06写数据(FC13/FC20写入)
// VW96  : 注射泵状态码上一有效值(降级用,归一化后)
// VD374 : 流量计累计值上一有效值(降级用,避开VD102/VD380冲突)
// T50   : 注射泵读任务超时(10秒,任务0/2/3复用)
// T51   : 流量计轮询超时(10秒)
// T53   : 注射泵写任务超时(10秒)


NETWORK 1
// Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600, Parity=0(无), Port=0, Timeout=1000ms
// 注: MBUS_CTRL在STL中通过库子程序SBR20调用
LD     SM0.0
=      L60.0                          // EN
LD     SM0.0
=      L63.7                          // Mode=1(RTU)
LD     L60.0
CALL   SBR20, L63.7, 9600, 16#00, 16#00, 1000, M11.0, VB378


NETWORK 2
// 任务0 - 注射泵状态码(站号1,41001,FC03读1字,写VW4)
// 降级模式时跳过实际轮询,直接使用VD96上一有效值
LD     SM0.0
AW=    VW290, 0
AN     M10.4                         // 非降级模式
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 0
AN     M10.4
=      L63.7                          // First,与EN同条件
LD     L60.0
CALL   SBR21, L63.7, 16#01, 16#00, 41001, 16#01, &VB4, M10.0, VB379

// 降级模式: 用上一有效值
LD     M10.4                         // 降级模式
AW=    VW290, 0
MOVW   VW96, VW4                     // VW4=上一有效值

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 0
AN     M10.4
TON    T50, 100                      // 10秒(100×100ms)

// 任务0完成处理
LD     M10.0                         // Done位=成功
AW=    VW290, 0
EU
// 成功: 保存原始值、归一化状态码、清失败计数+转下一任务
// 状态码归一化(基于SY-03BM说明书与泵阀一体Modbus协议V1.7)
// 状态字bit7-6=01固定; bit5=0忙/1就绪; bit3-0=错误码(0=无错)
// 0x0040=忙无错,0x0060=就绪无错; 0x0041/0x0061等=错误码1初始化错误...
// 归一化: 就绪无错→0; 忙无错→1; 错误码N(1-15)→N+4
MOVW   VW4, VW224                    // 保存原始状态码到VW224(供调试)
MOVW   VW4, AC0
ANDW   16#000F, AC0                  // AC0 = 错误码
MOVW   AC0, VW4                      // VW4 = 错误码(0-15)
LDW<>  VW4, 0                        // 有错?
JMP    10                            // 跳错误处理
// 无错: 按bit5区分忙/就绪
LD     SM0.0
MOVW   VW224, AC0
ANDW   16#0020, AC0                  // 取bit5
LDW=   AC0, 0                        // bit5=0 → 忙
MOVW   1, VW4
LDW<>  AC0, 0                        // bit5=1 → 就绪
MOVW   0, VW4
JMP    11                            // 跳过错误处理

LBL    10
// 错误处理: VW4 = 错误码 + 4
+I     4, VW4

LBL    11
MOVW   VW4, VW96                     // 保存归一化值为"上一有效值"
MOVW   0, VW294                      // 清连续失败计数
MOVW   0, VW292                      // 清重试计数
R      V303.4, 1                     // 清注射泵故障报警(通讯恢复)
S      V304.1, 1                     // 注射泵RTU通讯在线(AQEX-49:新增HMI通讯维护页显示)
R      T50, 1
R      M10.0, 1
MOVW   1, VW290

// 任务0超时(10秒未Done)
LD     T50
AN     M10.0
AW=    VW290, 0
EU
// 超时: 重试计数+1
INCW   VW292
R      T50, 1
// 重试<3次: 重新发起本任务(保持VW290=0)
LDW<   VW292, 3
R      M10.0, 1
// 重试≥3次: 标记本任务失败,连续失败计数+1,转下一任务
LDW>=  VW292, 3
S      V303.4, 1                     // M_Alarm_SyringePump
INCW   VW294                         // 连续失败计数+1
MOVW   0, VW292                      // 清重试计数
// 连续失败≥5次: 进入降级模式
LDW>=  VW294, 5
S      M10.4, 1                      // 降级模式标志
R      V304.1, 1                     // 注射泵RTU通讯离线(AQEX-49)
// 转下一任务
LD     SM0.0
MOVW   1, VW290
R      T50, 1
R      M10.0, 1


NETWORK 3
// 任务1 - 流量计累计值(站号2,40009,FC03读2字,写VD86)
// AQEX-42: K24微小流量计→BPM32FC积算仪,累积流量寄存器0x08→Modbus地址40009
// BPM32FC同时支持FC03/FC04,此处保持FC03(4xxxx),数据格式IEEE-754浮点不变
LD     SM0.0
AW=    VW290, 1
AN     M10.5                         // 非降级模式
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 1
AN     M10.5
=      L63.7                          // First,与EN同条件
LD     L60.0
CALL   SBR21, L63.7, 16#02, 16#00, 40009, 16#02, &VB86, M10.1, VB384

// 降级模式: 用上一有效值
LD     M10.5
AW=    VW290, 1
MOVD   VD374, VD86                   // VD86=上一有效值

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 1
AN     M10.5
TON    T51, 100                      // 10秒

// 任务1完成处理
LD     M10.1
AW=    VW290, 1
EU
MOVD   VD86, VD374                   // 保存有效值到降级值
MOVW   0, VW296                      // 清流量计连续失败计数
MOVW   0, VW292                      // 清重试计数
R      V303.6, 1                     // 清流量开关异常报警(通讯恢复)
S      V304.2, 1                     // 流量计RTU通讯在线(AQEX-49:新增HMI通讯维护页显示)
R      T51, 1
R      M10.1, 1
MOVW   2, VW290

// 任务1超时(10秒未Done)
LD     T51
AN     M10.1
AW=    VW290, 1
EU
INCW   VW292
R      T51, 1
// 重试<3次: 重新发起本任务(保持VW290=1)
LDW<   VW292, 3
R      M10.1, 1
// 重试≥3次: 标记本任务失败,连续失败计数+1
LDW>=  VW292, 3
S      V303.6, 1                     // M_Alarm_FlowSwitch_Instant
INCW   VW296                         // 连续失败计数+1
MOVW   0, VW292                      // 清重试计数
// 连续失败≥5次: 进入降级模式
LDW>=  VW296, 5
S      M10.5, 1                      // 流量计降级模式
R      V304.2, 1                     // 流量计RTU通讯离线(AQEX-49)
// 转下一任务
LD     SM0.0
MOVW   2, VW290
R      T51, 1
R      M10.1, 1


NETWORK 4
// 任务2 - 注射泵位置读取(站号1,41007,FC03读1字,写VW222)
LD     SM0.0
AW=    VW290, 2
AN     M10.4                         // 注射泵降级时跳过
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 2
AN     M10.4
=      L63.7                          // First,与EN同条件
LD     L60.0
CALL   SBR21, L63.7, 16#01, 16#00, 41007, 16#01, &VB222, M10.2, VB379

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 2
AN     M10.4
TON    T50, 100

// 任务2完成处理
LD     M10.2
AW=    VW290, 2
EU
MOVW   0, VW292
R      T50, 1
R      M10.2, 1
MOVW   3, VW290

// 任务2超时处理
LD     T50
AN     M10.2
AW=    VW290, 2
EU
INCW   VW292
R      T50, 1
LDW<   VW292, 3
R      M10.2, 1
LDW>=  VW292, 3
// 步数读取失败不单独报警(已由任务0覆盖V303.4)
MOVW   0, VW292
LD     SM0.0
MOVW   3, VW290
R      T50, 1
R      M10.2, 1


NETWORK 5
// 任务3 - 注射泵速度读取(站号1,40009,FC03读3字,写VW208/VW210/VW212)
LD     SM0.0
AW=    VW290, 3
AN     M10.4
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 3
AN     M10.4
=      L63.7                          // First,与EN同条件
LD     L60.0
CALL   SBR21, L63.7, 16#01, 16#00, 40009, 16#03, &VB208, M10.3, VB379

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 3
AN     M10.4
TON    T50, 100

// 任务3完成处理
LD     M10.3
AW=    VW290, 3
EU
MOVW   0, VW292
R      T50, 1
R      M10.3, 1
// 任务3完成 → 若有写请求去任务4,否则回任务0
LD     M11.6
MOVW   4, VW290
LDN    M11.6
MOVW   0, VW290

// 任务3超时处理
LD     T50
AN     M10.3
AW=    VW290, 3
EU
INCW   VW292
R      T50, 1
LDW<   VW292, 3
R      M10.3, 1
LDW>=  VW292, 3
MOVW   0, VW292
MOVW   0, VW290
R      T50, 1
R      M10.3, 1


NETWORK 6
// 任务4 - 注射泵写命令(FC06单写)
// 触发源: FC13/FC20置位M11.6(PumpWrite_Req),并写入VD232(目标地址)和VW230(数据)
// 执行: 本任务调用MBUS_MSG,RW=1,向VD232地址写VW230
// 完成: FC4置位M12.0(PumpWrite_Done),请求方负责清零;失败时同时置V303.4

// 无写请求时跳过本任务(直接回任务0)
LD     SM0.0
AW=    VW290, 4
AN     M11.6
AN     M11.7
MOVW   0, VW290

// 进入写任务时置写忙标志(保持到完成/超时)
LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7
S      M11.7, 1

// 写命令MBUS_MSG调用(RW=1)
LD     SM0.0
AW=    VW290, 4
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 4
=      L63.7                          // First,与EN同条件
LD     L60.0
CALL   SBR21, L63.7, 16#01, 16#01, VD232, 16#01, &VB230, M10.3, VB379

// 启动写超时计时器
LD     SM0.0
AW=    VW290, 4
TON    T53, 100                      // 10秒

// 任务4完成处理
LD     M10.3
AW=    VW290, 4
EU
MOVW   0, VW292                      // 清重试计数
R      T53, 1
R      M10.3, 1
R      M11.6, 1                      // 清写请求
R      M11.7, 1                      // 清写忙
S      M12.0, 1                      // 置写完成
MOVW   0, VW290                      // 回任务0

// 任务4超时处理(10秒未Done)
LD     T53
AN     M10.3
AW=    VW290, 4
EU
S      V303.4, 1                     // 注射泵通讯/动作异常
MOVW   0, VW292
R      T53, 1
R      M10.3, 1
R      M11.6, 1
R      M11.7, 1
S      M12.0, 1                      // 通知请求方写操作已结束(失败)
MOVW   0, VW290


NETWORK 7
// 降级模式退出检测(通讯恢复自动退出)
// 注射泵: 连续3次成功(在任务0成功分支累加计数)→退出降级
// 简化版: 任何一次任务0成功就退出降级(已在NETWORK2中清VW294+R M10.4)
// 此处仅做日志记录,无需额外逻辑
LD     M10.4
EU
TODR   VB520                       // 记录进入降级模式时间
LD     M10.5
EU
TODR   VB530                       // 记录流量计进入降级时间


// ============================================================
// 文件结束
// 说明:
//   1. AQEX-5完善: 3次重试+5次连续失败进入降级模式
//   2. 降级模式: 使用上一有效值(VW4←VD96, VD86←VD374),避免数据跳变
//   3. 通讯恢复: 一次成功即退出降级(自动恢复)
//   4. 报警逻辑: 超时3次→置V303.4(注射泵)/V303.6(流量计)
//   5. 降级模式不触发新报警(已报警),仅维持上一有效值
//   6. 注射泵写指令(FC06)由FC13/FC20通过VD232/VW230/M11.6触发,任务4执行
//   7. MBUS_CTRL/MBUS_MSG在STL中通过SBR20/SBR21调用,L60.0=EN,L63.7=Mode/First
//   8. MBUS_MSG的First参数=1表示启动新请求,必须与EN同条件,不可常通
//   9. 状态码41001原始值存VW224,归一化后存VW4,供HMI与FC13统一判断
//  10. 任务4写完成/失败均置M12.0=1,请求方清零;失败时额外置V303.4报警
// ============================================================
