// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-33修复(MBUS_MSG参数填充+超时框架)
// 说明: 轮询注射泵(站号1)状态码+流量计(站号2)累计值
//       S7-200 SMART使用MBUS_MSG指令,基于Done位顺序轮询
//       含超时检测(10秒无Done响应→V303.4注射泵/V303.6流量开关异常)
// ============================================================

// 符号说明:
// VW250 : 轮询从站计数器(0~3,4个轮询任务)
// M10.0 : 注射泵状态码轮询Done位
// M10.1 : 流量计累计值轮询Done位
// M10.2 : 注射泵步数写入Done位(由FC13触发)
// M10.3 : 注射泵速度读取Done位
// MW12  : 注射泵轮询错误码
// MW14  : 流量计轮询错误码
// VW4   : 注射泵状态码(映射自41001)
// VD86  : 流量计当前计量值(映射自40010)
// VW204 : 注射泵目标步数低字(映射自40006)
// VW206 : 注射泵目标步数高字(映射自40007)
// VW208 : 注射泵启动速度(映射自40009)
// VW210 : 注射泵最高速度(映射自40010)
// VW212 : 注射泵截止速度(映射自40011)
// T50   : 注射泵轮询超时(10秒)
// T51   : 流量计轮询超时(10秒)


NETWORK 1: Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600, Parity=0(无), Port=0, Timeout=1000ms
LD     SM0.0
MBUS_CTRL 1, 9600, 0, 0, 1000


NETWORK 2: 轮询状态机(基于VW250顺序执行4个轮询任务)
// 任务0: 注射泵状态码(站号1,41001,FC03读1字,写VW4)
// 任务1: 流量计累计值(站号2,40010,FC03读2字,写VD86)
// 任务2: 注射泵步数(站号1,40006,FC03读2字,写VW204)
// 任务3: 注射泵速度(站号1,40009,FC03读3字,写VW208)

// 任务0: 注射泵状态码
LD     SM0.0
LPS
AW=    VW250, 0
MBUS_MSG 1, 1, 0, 41001, 1, &VW4, M10.0, MW12
// 启动超时计时器(任务开始计时,Done到位或超时复位)
LD     SM0.0
AW=    VW250, 0
TON    T50, 100                      // 10秒(100×100ms)
LPP

// 任务0完成或超时 → 转任务1
LD     M10.0                         // Done位
O      T50                           // 或超时
AW=    VW250, 0
EU
// 超时未Done → 注射泵通讯异常报警
LD     T50
AN     M10.0
S      V303.4, 1                     // M_Alarm_SyringePump
// 转下一任务
LD     SM0.0
MOVB   1, VB250
MOVB   0, VB251
R      T50, 1
R      M10.0, 1


// 任务1: 流量计累计值
LD     SM0.0
LPS
AW=    VW250, 1
MBUS_MSG 1, 2, 0, 40010, 2, &VD86, M10.1, MW14
LD     SM0.0
AW=    VW250, 1
TON    T51, 100                      // 10秒
LPP

LD     M10.1
O      T51
AW=    VW250, 1
EU
LD     T51
AN     M10.1
S      V303.6, 1                     // M_Alarm_FlowSwitch_Instant(流量计通讯异常归此位)
LD     SM0.0
MOVB   2, VB250
MOVB   0, VB251
R      T51, 1
R      M10.1, 1


// 任务2: 注射泵步数读取(供HMI显示,写入由FC13触发FC06)
LD     SM0.0
LPS
AW=    VW250, 2
MBUS_MSG 1, 1, 0, 40006, 2, &VW204, M10.2, MW12
LD     SM0.0
AW=    VW250, 2
TON    T50, 100
LPP

LD     M10.2
O      T50
AW=    VW250, 2
EU
LD     T50
AN     M10.2
S      V303.4, 1
LD     SM0.0
MOVB   3, VB250
MOVB   0, VB251
R      T50, 1
R      M10.2, 1


// 任务3: 注射泵速度读取
LD     SM0.0
LPS
AW=    VW250, 3
MBUS_MSG 1, 1, 0, 40009, 3, &VW208, M10.3, MW12
LD     SM0.0
AW=    VW250, 3
TON    T50, 100
LPP

LD     M10.3
O      T50
AW=    VW250, 3
EU
LD     T50
AN     M10.3
S      V303.4, 1
// 任务3完成 → 回任务0(循环轮询)
LD     SM0.0
MOVB   0, VB250
MOVB   0, VB251
R      T50, 1
R      M10.3, 1


// 注: 注射泵写指令(FC06写40006/40007步数)由FC13(S3加药)中MBUS_MSG单独触发
// 注: 完整轮询时序基于Done位顺序执行,每个任务Done/超时后转下一任务
// 注: 超时10秒兼顾网络抖动与故障捕获灵敏度,可现场整定
// 注: MW12/MW14错误码非0时记录到报警日志(由FC3 NETWORK6统一处理)
// 注: MBUS_MSG的First参数=1表示首次启动新请求(Done后自动清零)


// ============================================================
// 文件结束
// 说明:
//   1. AQEX-33修复: 填充MBUS_MSG实际参数(站号1注射泵/站号2流量计)
//   2. 4个轮询任务顺序执行,基于Done位或10秒超时切换
//   3. 超时未响应→置V303.4(注射泵)/V303.6(流量计)报警位
//   4. 注射泵写指令(FC06)由FC13触发,本FC仅读轮询
//   5. 完整错误处理(重试/降级)属Story 1.1范围,本FC仅基础超时检测
//   6. 实际导入STEP7时需在Modbus主站库中配置MBUS_MSG实例
// ============================================================
