// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架（详细逻辑由Story 1.1填充）
// 说明: 轮询注射泵状态码(41001)和流量计累计值(0x0009)
//       S7-200 SMART使用MBUS_MSG指令，需配置Modbus主站
// ============================================================

// 注: S7-200 SMART Modbus主站需先调用MBUS_CTRL初始化
// 此处为骨架，实际MBUS_MSG调用时序由Story 1.1细化
// 以下展示轮询框架，实际使用时需处理Done位和错误码


NETWORK 1: Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600(待确认), Parity=0(无), Port=0
LD     SM0.0
MBUS_CTRL 1, 9600, 0, 0, 1000      // 待确认参数，Story 1.1核实


NETWORK 2: 轮询状态机（简化骨架）
// 用VW250作为轮询从站计数器：0=注射泵, 1=流量计
// 实际应基于MBUS_MSG的Done位顺序执行，此处仅展示框架

// 注射泵状态码轮询 (从站=注射泵站号, 地址41001=0x03E8, FC03读, 写入VW4)
LD     SM0.0
LPS
AW=    VW250, 0                    // 当前轮询注射泵
// MBUS_MSG First, Slave, RW, Addr, Count, DataPtr, Done, Error
// MBUS_MSG 1, 注射泵站号, 0(读), 41001, 1, &VW4, M10.0, MW12
// 实际参数待Story 1.1确认站号后填入
LPP

// 流量计累计值轮询 (从站=流量计站号, 地址0x0009, FC03读, 写入VD86)
LD     SM0.0
LPS
AW=    VW250, 1                    // 当前轮询流量计
// MBUS_MSG 1, 流量计站号, 0(读), 40010, 2, &VD86, M10.1, MW14
// 注: 流量计0x0009在Modbus保持寄存器中对应40010
LPP


// 注: 完整的轮询时序、错误处理、超时检测由Story 1.1补充
// 注: 注射泵写指令(抽液/排液步数)在FC13(S3加药)中触发
// 注: 流量计差值法在FC11(S1进水)中计算


// ============================================================
// 文件结束
// 说明: MBUS_MSG指令的参数(站号/地址/功能码)待
//       Story 1.1确认设备通讯参数后填入实际值
// ============================================================
