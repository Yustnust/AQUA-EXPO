TITLE=
NETWORK 1
//   MBUS_CTRL: 9600/8/N/1, 超时1000ms
LD     SM0.0
=      L60.0
LD     SM0.0
=      L63.7
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#0, 16#0, 1000, M11.0, VB378
//   T103: MBUS_MSG超时定时器(100ms时基, PT=100=10s)
//   任一任务活跃(M15.0~M15.4)时计时, 超时后强制切换任务
LD     M15.0
O      M15.1
O      M15.2
O      M15.3
O      M15.4
TON    T103, 100
//   任务0: 注射泵状态读(41001)
//   EN=VW290==0 AND M15.0, First=M15.0上升沿(EU)
LDW=   VW290, 0
=      L60.0
LD     M15.0
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A029, 16#1, &VB410, M10.0, VB379
//   任务1: 流量计读(40009)
//   EN=VW290==1 AND M15.1, First=M15.1上升沿(EU)
LDW=   VW290, 1
=      L60.0
LD     M15.1
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C49, 16#02, &VB410, M14.0, VB380
//   任务2: 注射泵位置读(41007)
//   EN=VW290==2 AND M15.2, First=M15.2上升沿(EU)
LDW=   VW290, 2
=      L60.0
LD     M15.2
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A02F, 16#1, &VB410, M10.1, VB381
//   任务3: 流量计瞬时流量读(40007) → VD94
//   EN=VW290==3 AND M15.3, First=M15.3上升沿(EU)
LDW=   VW290, 3
=      L60.0
LD     M15.3
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C47, 16#02, &VB410, M14.1, VB382
//   === 任务0: 成功/失败/切换 合并 (原 7/12/13) ===
//   任务0成功处理: VW410->VW4, 成功计数, 清失败计数
LD     M10.0
A      M15.0
AB=    VB379, 0
MOVW   VW410, VW4
AENO
MOVW   0, VW292
AENO
R      V303.4, 1
//   任务0失败计数
LD     M10.0
A      M15.0
AB<>   VB379, 0
INCW   VW292
//   任务0完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.1 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M10.0
O      T103
=      V60.1
LD     V60.1
R      M15.0, 1
LD     V60.1
S      M15.1, 1
LD     V60.1
MOVW   1, VW290
LD     V60.1
R      M10.0, 1
LD     V60.1
R      T103, 1
//   [已修复 v2.2] 删除 VW224→VW4 归一化死代码。任务0成功时已直接 MOVW VW410, VW4。
//   === 任务1: 成功/失败/切换 合并 (原 14/15/16) ===
//   任务1成功处理: VD410->VD86, 成功计数, 清失败计数
//   流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.0
A      M15.1
AB=    VB380, 0
MOVD   VD410, VD86
AENO
MOVW   0, VW294
//   【2026-09-24修复】删除"AENO / R V303.6"：V303.6 已于 2026-09-08 起划归 FC40
//   报警66(单轮换水周期超时)，此处残留复位会在流量计读成功时悄悄清掉周期超时报警
//   任务1失败计数
LD     M14.0
A      M15.1
AB<>   VB380, 0
INCW   VW294
//   任务1完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.2 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M14.0
O      T103
=      V60.2
LD     V60.2
R      M15.1, 1
LD     V60.2
S      M15.2, 1
LD     V60.2
MOVW   2, VW290
LD     V60.2
R      M14.0, 1
LD     V60.2
R      T103, 1
//   === 任务2: 成功/失败/切换 合并 (原 17/18/19) ===
//   任务2成功处理: VW410->VW222, 成功计数, 清失败计数
LD     M10.1
A      M15.2
AB=    VB381, 0
MOVW   VW410, VW222
AENO
MOVW   0, VW296
//   任务2失败计数
LD     M10.1
A      M15.2
AB<>   VB381, 0
INCW   VW296
//   任务2完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.6 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
LD     M10.1
O      T103
=      V60.6
LD     V60.6
R      M15.2, 1
LD     V60.6
S      M15.3, 1
LD     V60.6
MOVW   3, VW290
LD     V60.6
R      M10.1, 1
LD     V60.6
R      T103, 1
//   === 任务3: 成功/失败/切换 合并 (原 20/21/22-25) ===
//   任务3成功处理: VD410->VD94(瞬时流量), 成功计数, 清失败计数
//   流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.1
A      M15.3
AB=    VB382, 0
MOVD   VD410, VD94
AENO
MOVW   0, VW298
//   任务3失败计数
LD     M14.1
A      M15.3
AB<>   VB382, 0
INCW   VW298
//   任务3完成切换: 有写请求 → 任务4, 否则 → 任务0
//   用V60.0做完成事件中间继电器(仅此处赋值,无冲突)
LD     M14.1
O      T103
=      V60.0
//  // 复位任务3相关标志
LD     V60.0
R      M15.3, 1
R      M14.1, 1
R      T103, 1
//  // 进入任务4: 有写请求(M11.6=1)
LD     V60.0
A      M11.6
S      M15.4, 1
MOVW   4, VW290
//  // 未进入任务4则回任务0
LD     V60.0
AN     M15.4
S      M15.0, 1
MOVW   0, VW290
//   === 任务4: 写数据准备 + 写命令 合并 (原 27/29/30) ===
//   任务4写数据准备: 有写请求时把VW230复制到统一缓冲区VW410
//   DataPtr用&VB410, 避免直接使用&VW230导致MBUS_MSG写失败(Error=104)
LD     M11.6
MOVW   VW230, VW410
//   任务4: 注射泵写命令(仅在M11.6=1时执行)
//   EN=VW290==4 AND M15.4 AND M11.6, First=M15.4上升沿(EU)
//   写目标地址VD232由FC0/FC13/FC21设置(16#9C42=40002强停,16#9C43=40003复位,16#9C46=40006抽液,16#9C47=40007排液)
LDW=   VW290, 4
A      M15.4
A      M11.6
=      V60.3
LDW=   VW290, 4
A      M15.4
A      M11.6
=      L60.0
LD     M15.4
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#1, VD232, 16#1, &VB410, M12.0, VB383
//   === 任务4: 成功/失败/切换 合并 (原 31/32/33) ===
//   任务4成功处理: 清写请求, 成功计数, 清失败计数
//   ★关键: 写完成后立即清M11.6, 防止复位命令在轮询中反复写
LD     M12.0
A      M15.4
AB=    VB383, 0
R      M11.6, 1
R      M11.7, 1
MOVW   0, VW510
R      V303.4, 1
//   任务4失败计数 + 从站异常立即报警
LD     M12.0
A      M15.4
LPS
AB<>   VB383, 0
INCW   VW510
LPP
AB>=   VB383, 101
S      V303.4, 1
//   任务4完成切换(成功或T103超时)
//   [已修复 v2.2] 用 V60.7 保存切换条件，避免 LD+O+R 后栈空导致后续指令失效
//   R M15.4, S M15.0, 更新VW290=0, 清握手, 清超时定时器
//  // ★M12.0不清! 由FC13/FC21请求方清零, 否则请求方看不到写完成
LD     M12.0
O      T103
=      V60.7
LD     V60.7
R      M11.6, 1
LD     V60.7
R      M11.7, 1
LD     V60.7
R      M15.4, 1
LD     V60.7
S      M15.0, 1
LD     V60.7
MOVW   0, VW290
LD     V60.7
R      T103, 1
//   === 软件滤波 合并 (原 34/35/36) ===
//   V303.4软件滤波: 连续读失败<5次时不报警
LDW<   VW292, 5
R      V303.4, 1
//   V303.4写任务软件滤波: 连续写失败<5次且无从站异常时不报警
LDW<   VW510, 5
AB<    VB383, 101
R      V303.4, 1
//   【2026-09-24修复】删除 V303.6 软件滤波(VW294<5 时复位)：V303.6 已划归 FC40
//   报警66(单轮换水周期超时)，Modbus任务1失败不再使用此位(通讯失败报警待Story1.1)

