// ============================================================
// 文件: FC4_ModbusPolling.stl
// 功能: Modbus通讯轮询（每周期调用）
// Story: AQEX-6 状态机骨架 + AQEX-33修复 + AQEX-5完善(错误重试+降级)
// 说明: 轮询注射泵(站号1)+流量计(站号2),基于Done位顺序轮询
//       含3次重试机制 + 降级模式(连续失败5次→进入降级,使用上一有效值)
//       超时检测(10秒/任务无Done响应→报警)
//
// ★★★ 重要! STL调用Modbus RTU Master库函数必须用符号名! ★★★
//   正确: CALL MBUS_CTRL, 参数...
//   正确: CALL MBUS_MSG, 参数...
//   错误: CALL SBR20, ...   (SBR20是MBUS_CTRL的内部编号,不能直接用)
//   错误: CALL SBR21, ...   (SBR21是MBUS_MSG的内部编号,不能直接用)
//   原因: S7-200 SMART库函数由STEP 7 Micro/WIN SMART自动分配SBR编号,
//         不同工程/不同版本可能编号不同;必须用符号名MBUS_CTRL/MBUS_MSG
//
// 修复记录:
//   AQEX-46: 修复MBUS_MSG EN/First条件未正确传入,导致First常通报Error=6
//   AQEX-46: 补全任务1完成分支与超时分支(原STL仅调用MBUS_MSG,无状态切换)
//   2026-09-04v1: MBUS_MSG任务4 EN/First加M11.6门控,防反复触发
//   2026-09-04v2: 修正EN/First门控逻辑:EN仅M11.6(保持),First=M11.6+AN M11.7(仅启动瞬间)
//   2026-09-04v3: 所有CALL SBR20/SBR21改为CALL MBUS_CTRL/MBUS_MSG(符号名)
//   2026-09-04v5: 任务0/1/2的MBUS_MSG First改为上升沿触发(M14.0~M14.2),
//                 EN保持为电平,First仅在启动瞬间=1,修复Error=6
//   2026-09-05: BPM32FC积算仪联调修正:
//               (1) MBUS_MSG地址参数改用16进制(41001=16#A029,
//                   40009=16#9C49,41007=16#A02F),避免>32767的十进制被解析为INT出错;
//               (2) 16位数据(VW4/VW222)读取后SWAP,修正大端→小端;
//               (3) 32位浮点VD86读取后做SWAP+字交换,修正BPM32FC高字节在前到PLC REAL。
// ============================================================

// 符号说明:
// VW290 : 轮询从站计数器(0~2,4个轮询任务;任务3速度读取已停用,使用泵自身默认速度)
// VW292 : 当前任务重试计数(0~3,3次失败标记本任务失败)
// VW294 : 注射泵连续失败计数(≥5次→降级模式)
// VW296 : 流量计连续失败计数(≥5次→降级模式)
// M10.0 : 注射泵状态码轮询Done位(MBUS_MSG任务0输出,LAD引脚)
// M10.1 : 流量计累计值轮询Done位(MBUS_MSG任务1输出,LAD引脚)
// M10.2 : 注射泵位置读取Done位(任务2)
// M10.3 : 注射泵写命令Done位(任务4;原任务3速度读取已停用)
// M10.4 : 注射泵降级模式标志(1=使用上一有效值)
// M10.5 : 流量计降级模式标志
// M11.0 : MBUS_CTRL Done位(LAD引脚,每周期脉冲)
// M11.6 : PumpWrite_Req  注射泵写请求(FC13/FC20置位,FC4清零)
// M11.7 : PumpWrite_Busy 注射泵写忙标志(FC4置位/清零)
// M12.0 : PumpWrite_Done 注射泵写完成(FC4置位,请求方清零)
// M14.0 : Task0_Enable 任务0(注射泵状态码)使能条件(EN)
// M14.1 : Task1_Enable 任务1(流量计累计值)使能条件(EN)
// M14.2 : Task2_Enable 任务2(注射泵位置)使能条件(EN)
// VW288 : Modbus字节顺序转换临时字(任务1浮点转换用)
// VB378 : MBUS_CTRL Error错误码(LAD引脚)
// VB379 : 注射泵轮询/写错误码(MBUS_MSG任务0/2/3/4输出,LAD引脚)
// VB384 : 流量计轮询错误码(MBUS_MSG任务1输出,LAD引脚,避开VD380暂存区)
// VW4   : 注射泵状态码(映射自41001,归一化后:0=就绪(96),1=空闲(64),2=运动中(100),≥4=错误)
// VW224 : 注射泵状态码原始值(41001原始值,调试用)
// VD86  : 流量计当前计量值(映射自40009)
//        注: AQEX-42 流量计选型变更(K24微小流量计→BPM32FC积算仪+涡轮流量计)
//        BPM32FC累积流量寄存器地址0x08, FC03读2字(32位IEEE-754浮点)
//        Modbus地址=40001+8=40009, 数据格式与K24一致, FC30差值法逻辑不变
// VW204 : 注射泵抽液目标步数(映射自40006)
// VW206 : 注射泵排液目标步数(映射自40007)
// VW208 : (已停用)注射泵启动速度原映射40009,速度由泵自身默认值决定
// VW210 : (已停用)注射泵最高速度原映射40010,速度由泵自身默认值决定
// VW212 : (已停用)注射泵截止速度原映射40011,速度由泵自身默认值决定
// VW222 : 注射泵位置反馈(映射自41007)
// VD232 : PumpWrite_Addr  FC06写目标Modbus地址(FC13/FC20写入)
// VW230 : PumpWrite_Data  FC06写数据(FC13/FC20写入)
// VW96  : 注射泵状态码上一有效值(降级用,归一化后)
// VD374 : 流量计累计值上一有效值(降级用,避开VD102/VD380冲突)
// T50   : 注射泵读任务超时(10秒,任务0/2/3复用)
// T51   : 流量计轮询超时(10秒)
// T53   : 注射泵写任务超时(10秒)


NETWORK 1
// Modbus主站初始化（每周期调用MBUS_CTRL）
// Mode=1(RTU), Baud=9600, Parity=0(无), Port=0, Timeout=1000ms
// 注: MBUS_CTRL在STL中通过库子程序SBR20调用
LD     SM0.0
=      L60.0                          // EN
LD     SM0.0
=      L63.7                          // Mode=1(RTU)
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#00, 16#00, 1000, M11.0, VB378


NETWORK 2
// 任务0 - 注射泵状态码(站号1,41001,FC03读1字,写VW4)
// 降级模式时跳过实际轮询,直接使用VD96上一有效值
LD     SM0.0
AW=    VW290, 0
AN     M10.4                         // 非降级模式
=      M14.0                          // 任务0使能条件(EN)

// T37: 2000ms重试脉冲(>1000ms MBUS_CTRL超时, 仅任务0活跃时计时)
// 解决EU上升沿只触发一次的问题: Error≠0时Done位保持, EU不再产生脉冲
// T37定期清除Done并重新触发First, 实现自动重试(移植FC99调试经验)
LD     M14.0
AN     T37
TON    T37, 20                        // 2000ms(20×100ms)
LD     T37
R      M10.0, 1                      // T37脉冲时清除Done(为新请求做准备)

// First = EU(首次启动) OR T37(定时重试)
LD     M14.0
EU
=      L63.7
LD     T37
O      L63.7
=      L63.7

LD     M14.0
=      L60.0                          // EN(整个请求周期保持1)
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#01, 16#00, 16#A029, 16#01, &VB4, M10.0, VB379

// 降级模式: 用上一有效值
LD     M10.4                         // 降级模式
AW=    VW290, 0
MOVW   VW96, VW4                     // VW4=上一有效值

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 0
AN     M10.4
TON    T50, 100                      // 10秒(100×100ms)

// 任务0完成处理
// ★ 2026-09-06修正: 基于FC99现场调试确认的状态码含义
//   96(60H)=就绪(可接受命令), 64(40H)=空闲, 100(64H)=运动中, 103(67H)=未初始化
//   bit5=1表示激活(非忙), bit5=0表示空闲; 之前bit5=0忙/1就绪是错误的
//   读成功判断: M10.0=1 且 VB379=0(无错误), 避免超时也置Done导致用旧值
LD     M10.0                         // Done位=1
AW=    VW290, 0
LDB=   VB379, 0                     // 必须无错误才处理(超时VB379=3也置Done)
EU
SWAP   VW4                           // 大端→小端:注射泵状态码为16位,高字节在前
// 成功: 保存原始值、归一化状态码、清失败计数+转下一任务
// 状态码归一化(2026-09-06修正,基于现场调试):
//   96(60H)=就绪→VW4=0; 64(40H)=空闲→VW4=1; 100(64H)=运动中→VW4=2;
//   103(67H)=未初始化→VW4=11; 其他错误码N(1-3,5-15)→VW4=N+4(≥5)
// bit5=1(激活/96类)→就绪; bit5=0(空闲/64类)→空闲; 错误码非0→错误
MOVW   VW4, VW224                    // 保存原始状态码到VW224(供调试)
MOVW   VW4, AC0
ANDW   16#000F, AC0                  // AC0 = 错误码
MOVW   AC0, VW4                      // VW4 = 错误码(0-15)
LDW<>  VW4, 0                        // 有错?
JMP    10                            // 跳错误处理
// 无错: 按bit5区分就绪/空闲(bit5=1→就绪,bit5=0→空闲)
LD     SM0.0
MOVW   VW224, AC0
ANDW   16#0020, AC0                  // 取bit5
LDW<>  AC0, 0                        // bit5=1 → 就绪(96)
MOVW   0, VW4                        // 就绪=0
LDW=   AC0, 0                        // bit5=0 → 空闲(64)
MOVW   1, VW4                        // 空闲=1
JMP    11                            // 跳过错误处理

LBL    10
// 错误处理: VW4 = 错误码 + 4(错误码7=未初始化→11)
+I     4, VW4
// ★ 2026-09-06修正: 100(运动中,错误码4)非真错误,改VW4=2
//   原因: 100表示泵正在执行命令(抽液/排液运动中),FC13需检测此状态;
//         若VW4=8(≥4)会被FC13全局错误检测误判为故障转S_ERROR
LD     SM0.0
LDW=   VW224, 100
MOVW   2, VW4

LBL    11
MOVW   VW4, VW96                     // 保存归一化值为"上一有效值"
MOVW   0, VW294                      // 清连续失败计数
MOVW   0, VW292                      // 清重试计数
R      V303.4, 1                     // 清注射泵故障报警(通讯恢复)
S      V304.1, 1                     // 注射泵RTU通讯在线(AQEX-49:新增HMI通讯维护页显示)
R      T50, 1
R      M10.0, 1
MOVW   1, VW290

// 任务0超时(10秒未Done, 或Done=1但Error≠0时T37重试期间T50也会到)
LD     T50
AW=    VW290, 0
EU
// 超时: 重试计数+1,本轮失败→实时清在线标志
INCW   VW292
R      T50, 1
R      V304.1, 1                     // ★实时刷新:本轮超时→注射泵离线
// 重试<3次: 重新发起本任务(保持VW290=0)
LDW<   VW292, 3
R      M10.0, 1
// 重试≥3次: 标记本任务失败,连续失败计数+1,转下一任务
LDW>=  VW292, 3
S      V303.4, 1                     // M_Alarm_SyringePump
INCW   VW294                         // 连续失败计数+1
MOVW   0, VW292                      // 清重试计数
// 连续失败≥5次: 进入降级模式
LDW>=  VW294, 5
S      M10.4, 1                      // 降级模式标志
R      V304.1, 1                     // 注射泵RTU通讯离线(AQEX-49)
// 转下一任务
LD     SM0.0
MOVW   1, VW290
R      T50, 1
R      M10.0, 1


NETWORK 3
// 任务1 - 流量计累计值(站号2,40009,FC03读2字,写VD86)
// AQEX-42: K24微小流量计→BPM32FC积算仪,累积流量寄存器0x08→Modbus地址40009
// BPM32FC同时支持FC03/FC04,此处保持FC03(4xxxx),数据格式IEEE-754浮点不变
LD     SM0.0
AW=    VW290, 1
AN     M10.5                         // 非降级模式
=      M14.1                          // 任务1使能条件(EN)
LD     M14.1
EU                                     // 上升沿:仅启动瞬间=1
=      L63.7                          // First
LD     M14.1
=      L60.0                          // EN(整个请求周期保持1)
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#00, 16#9C49, 16#02, &VB86, M10.1, VB384

// 降级模式: 用上一有效值
LD     M10.5
AW=    VW290, 1
MOVD   VD374, VD86                   // VD86=上一有效值

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 1
AN     M10.5
TON    T51, 100                      // 10秒

// 任务1完成处理
LD     M10.1
AW=    VW290, 1
EU
// BPM32FC积算仪:32位IEEE-754浮点高字节在前,需大端→小端转换
// 原数据:VB86=byte3,VB87=byte2,VB88=byte1,VB89=byte0
// 目标:  VB86=byte0,VB87=byte1,VB88=byte2,VB89=byte3
SWAP   VW86                          // byte3,byte2 → byte2,byte3
SWAP   VW88                          // byte1,byte0 → byte0,byte1
MOVW   VW86, VW288                   // 暂存原高字
MOVW   VW88, VW86                    // 低字移到前16位
MOVW   VW288, VW88                   // 高字移到后16位
MOVD   VD86, VD374                   // 保存有效值到降级值
MOVW   0, VW296                      // 清流量计连续失败计数
MOVW   0, VW292                      // 清重试计数
R      V303.6, 1                     // 清流量开关异常报警(通讯恢复)
S      V304.2, 1                     // 流量计RTU通讯在线(AQEX-49:新增HMI通讯维护页显示)
R      T51, 1
R      M10.1, 1
MOVW   2, VW290

// 任务1超时(10秒未Done)
LD     T51
AN     M10.1
AW=    VW290, 1
EU
INCW   VW292
R      T51, 1
R      V304.2, 1                     // ★实时刷新:本轮超时→流量计离线
// 重试<3次: 重新发起本任务(保持VW290=1)
LDW<   VW292, 3
R      M10.1, 1
// 重试≥3次: 标记本任务失败,连续失败计数+1,转下一任务
LDW>=  VW292, 3
S      V303.6, 1                     // M_Alarm_FlowSwitch_Instant
INCW   VW296                         // 连续失败计数+1
MOVW   0, VW292                      // 清重试计数
// 连续失败≥5次: 进入降级模式
LDW>=  VW296, 5
S      M10.5, 1                      // 流量计降级模式
R      V304.2, 1                     // 流量计RTU通讯离线(AQEX-49)
// 转下一任务
LD     SM0.0
MOVW   2, VW290
R      T51, 1
R      M10.1, 1


NETWORK 4
// 任务2 - 注射泵位置读取(站号1,41007,FC03读1字,写VW222)
LD     SM0.0
AW=    VW290, 2
AN     M10.4                         // 注射泵降级时跳过
=      M14.2                          // 任务2使能条件(EN)
LD     M14.2
EU                                     // 上升沿:仅启动瞬间=1
=      L63.7                          // First
LD     M14.2
=      L60.0                          // EN(整个请求周期保持1)
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#01, 16#00, 16#A02F, 16#01, &VB222, M10.2, VB379

// 启动超时计时器(非降级模式)
LD     SM0.0
AW=    VW290, 2
AN     M10.4
TON    T50, 100

// 任务2完成处理
LD     M10.2
AW=    VW290, 2
EU
SWAP   VW222                         // 大端→小端:注射泵位置为16位,高字节在前
MOVW   0, VW292
R      T50, 1
R      M10.2, 1
// 原"MOVW 3, VW290"已停用任务3(速度读取,使用泵自身默认速度)
// 改为: 若有写请求(M11.6)去任务4,否则回任务0
LD     M11.6
MOVW   4, VW290
LDN    M11.6
MOVW   0, VW290

// 任务2超时处理
LD     T50
AN     M10.2
AW=    VW290, 2
EU
INCW   VW292
R      T50, 1
LDW<   VW292, 3
R      M10.2, 1
LDW>=  VW292, 3
// 步数读取失败不单独报警(已由任务0覆盖V303.4)
MOVW   0, VW292
LD     SM0.0
MOVW   0, VW290                      // 任务3已删除,直接回任务0
R      T50, 1
R      M10.2, 1


NETWORK 5
// 任务4 - 注射泵写命令(FC06单写)
// 触发源: FC13/FC20置位M11.6(PumpWrite_Req),并写入VD232(目标地址)和VW230(数据)
// 执行: 本任务调用MBUS_MSG,RW=1,向VD232地址写VW230
// 完成: FC4置位M12.0(PumpWrite_Done),请求方负责清零;失败时同时置V303.4
//
// ★ 2026-09-06移植FC99调试经验:
//   1. 写命令需就绪门控: VW4=0(就绪态96)才允许进入写任务,避免命令溢出导致103错误
//   2. 写Done位(M10.3)已正确清零(原代码已实现)
//   3. 强停恢复: 100状态(运动中)需写40002=1恢复96, 由FC13触发(VD232=16#9C42, VW230=1)
//      强停属于特殊写命令, 无需就绪门控(100状态时VW4≠0)

// 无写请求时跳过本任务(直接回任务0)
LD     SM0.0
AW=    VW290, 4
AN     M11.6
AN     M11.7
MOVW   0, VW290

// ★ 写命令就绪门控(VW4=0表示泵就绪96,可接受命令)
// 非强停命令需就绪: VW4=0(就绪)才允许; 强停(VD232=16#9C42)无需就绪
// 逻辑: (VW4=0 OR 是强停命令) 才允许继续, 否则回任务0
LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7
LDD=   VD232, 16#9C42           // 是强停命令?
JMP    20                        // 是强停→跳过就绪检查
LDW<>  VW4, 0                    // 非强停, 且VW4≠0(未就绪)
MOVW   0, VW290                  // 未就绪→回任务0
LBL    20

// 进入写任务时置写忙标志(保持到完成/超时)
// ★ 新请求启动瞬间(First=1前)强制清历史Done/完成通知,避免旧M10.3=1导致电平检测误触发
LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7
S      M11.7, 1
R      M10.3, 1
R      M12.0, 1

// 写命令MBUS_MSG调用(RW=1)
// ★ 关键修复1(2026-09-04v1): 原始代码EN/First=VW290=4常通,无M11.6门控
//   每个扫描周期First=1,MBUS_MSG被反复触发→从站乱序→Error=6超时
// ★ 关键修复2(2026-09-04v2): v1修复中EN/First都加了AN M11.7,错误！
//   M11.7置位后EN也变0,MBUS_MSG发完立刻被停→从站没机会回复
//   正确: EN仅检查M11.6(整个请求周期保持1);First检查M11.6+AN M11.7(仅启动瞬间=1)
LD     SM0.0
AW=    VW290, 4
A      M11.6                          // ★ EN:只要有写请求就保持1(整个请求周期)
=      L60.0                          // EN
LD     SM0.0
AW=    VW290, 4
A      M11.6
AN     M11.7                          // ★ First:仅启动瞬间(M11.7置位前)=1
=      L63.7                          // First
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#01, 16#01, VD232, 16#01, &VB230, M10.3, VB379

// 启动写超时计时器
LD     SM0.0
AW=    VW290, 4
TON    T53, 100                      // 10秒

// 任务4完成处理
// ★ 2026-09-04v4: 由EU上升沿改为电平检测;M10.3=1且VW290=4即执行
//   原因:联机调试中发现M10.3=1但EU未触发,M12.0/VW290卡死;电平检测更稳健
LD     M10.3
AW=    VW290, 4
MOVW   0, VW292                      // 清重试计数
R      T53, 1
R      M10.3, 1
R      M11.6, 1                      // 清写请求
R      M11.7, 1                      // 清写忙
S      M12.0, 1                      // 置写完成
MOVW   0, VW290                      // 回任务0

// 任务4超时处理(10秒未Done)
// ★ 2026-09-04v4: 同样由EU改为电平检测
LD     T53
AN     M10.3
AW=    VW290, 4
S      V303.4, 1                     // 注射泵通讯/动作异常
MOVW   0, VW292
R      T53, 1
R      M10.3, 1
R      M11.6, 1
R      M11.7, 1
S      M12.0, 1                      // 通知请求方写操作已结束(失败)
MOVW   0, VW290


NETWORK 7
// 降级模式退出检测(通讯恢复自动退出)
// 注射泵: 连续3次成功(在任务0成功分支累加计数)→退出降级
// 简化版: 任何一次任务0成功就退出降级(已在NETWORK2中清VW294+R M10.4)
// 此处仅做日志记录,无需额外逻辑
LD     M10.4
EU
TODR   VB520                       // 记录进入降级模式时间
LD     M10.5
EU
TODR   VB530                       // 记录流量计进入降级时间


// ============================================================
// 文件结束
// 说明:
//   1. AQEX-5完善: 3次重试+5次连续失败进入降级模式
//   2. 降级模式: 使用上一有效值(VW4←VD96, VD86←VD374),避免数据跳变
//   3. 通讯恢复: 一次成功即退出降级(自动恢复)
//   4. 报警逻辑: 超时3次→置V303.4(注射泵)/V303.6(流量计)
//   5. 降级模式不触发新报警(已报警),仅维持上一有效值
//   6. 注射泵写指令(FC06)由FC13/FC20通过VD232/VW230/M11.6触发,任务4执行
//   7. MBUS_CTRL/MBUS_MSG在STL中必须用符号名调用,不可用SBR20/SBR21
//   8. MBUS_MSG的EN在整个请求周期保持1;First用上升沿触发(EU),仅启动瞬间=1,
//      任务0/1/2通过M14.x(使能条件)的EU生成First脉冲
//   9. 状态码41001原始值存VW224,归一化后存VW4,供HMI与FC13统一判断;
//      注意41001数据为大端16位,读取后需SWAP,归一化前已完成
//  10. 任务4写完成/失败均置M12.0=1,请求方清零;失败时额外置V303.4报警
//  11. BPM32FC积算仪数据格式为大端:16位数据读取后SWAP,32位浮点读取后
//      先SWAP两个16位字再交换两个字的位置,方可得到正确的PLC REAL/INT
// ============================================================
