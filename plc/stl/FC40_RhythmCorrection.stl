// ============================================================
// 文件: FC40_RhythmCorrection.stl
// 功能: 双倒计时器周期管理(v2.2 重写,替代原三层纠偏)
// Story: v2.2 流程重构 (替代 AQEX-8 节奏纠偏)
// 说明: v2.2 取消原"三层自动纠偏"机制,改为通过 FC40 管理两个交替工作
//       的周期倒计时器(T46/T48),严格保证 24h 换水次数硬约束
// 调用: OB1 每周期调用(在 FC1 状态调度之前)
// 输出: 触发 S6 排水 / 触发下一轮 S1 / 倒计时到 0 报警 / 双计时器显示值
// ============================================================

// 符号说明:
// VD414 : VD_24h_Target           24h 换水目标次数 (HMI 设定)
// VD426 : VD_Transfer_Margin      周期尾端转移余量 (秒, 默认 30, HMI 设定)
// VD430 : VD_Prep_Safety_Margin   上缸配液安全余量 (秒, 默认 10, HMI 设定)
// VD186 : VD_T_cycle              本轮倒计时总时长(秒,内部中间变量)
// VD190 : VD_T_cycle_x10          100ms 时基转换中间值(秒→100ms,内部中间变量)
// VW190 : VW_Timer_Current_PV     当前活动计时器 PV (100ms 时基, 内部中间)
// VW192 : VW_Timer_Current_PV     减法计算中间 (内部中间)
// VW194 : VW_S6_actual_x10        S6_actual × 10 (100ms 时基, 内部中间)
// VW196 : VW_S6_Default_x10       VD108 × 10 (100ms 时基, 内部中间)
// VW200 : VW_Prep_Needed_x10      Prep_Needed × 10 (100ms 时基, 内部中间)
// VD256 : VD_TimerA_Display       TimerA 显示值(秒, 从 T46_PV/10, 真空闲区)
// VD244 : VD_TimerB_Display       TimerB 显示值(秒, 从 T48_PV/10, 真空闲区)
// T46   : T_CycleA                周期倒计时器 A (100ms 时基)
// T48   : T_CycleB                周期倒计时器 B (100ms 时基)
// VW286 : VW_T46_PT               TimerA PT 转换值(由 FC11 计算写入)
// VW288 : VW_T48_PT               TimerB PT 转换值(由 FC11 计算写入)
// VW2   : 下缸主状态机
// VW304 : 上缸配液子流程状态
// VW6   : 当前报警码 (=0 才允许触发)
// VW306 : 已完成换水次数
// VD70  : S1 实测时长 (秒)
// VD28  : S2 搅拌固定时长 (秒)
// VD108 : S4/S6 默认时长 (秒)
// VD116 : S6 滚动实测时长 (秒)
// M16.0 : M_TimerA_Active         当前下缸轮次使用 TimerA 标志
// M16.1 : M_NextCycleTrigger      触发下一轮 S1 脉冲
// V303.6: M_Alarm_CycleTimeout    单轮换水周期超时报警 (v2.2 复用原流量开关瞬时异常位)

NETWORK 1
// 计算 T_single 和 T_cycle
// T_single = 86400.0 / VD414          // 单次目标周期(秒)
// T_cycle = T_single - VD426 - VD430  // 实际倒计时总时长(秒)
LD     SM0.0
MOVR   86400.0, VD186
/R     VD414, VD186                 // T_single
-R     VD426, VD186                 // - Transfer_Margin
-R     VD430, VD186                 // - Safety_Margin = T_cycle


NETWORK 2
// T_cycle <= 0 检查:周期参数过激进,报警并禁止启动
LD     SM0.0
AR>    VD186, 0.0                   // T_cycle > 0 ?
JMP    10                          // 是 → 正常路径
// 否 → 参数过激进
LD     SM0.0
S      V303.6, 1                   // M_Alarm_CycleTimeout=1(强制人工确认)
JMP    9                           // → 跳到本FC末尾

LBL    10
// 正常路径继续
LD     SM0.0
MOVR   VD186, VD190                // T_cycle 备份
*R     10.0, VD190                 // → 100ms 时基


NETWORK 3
// 选择当前活动计时器当前值(取 T46 或 T48 的 PV,100ms 时基)
// VW190 = 当前活动计时器 PV
LD     M16.0                       // 当前使用 TimerA?
MOVW   T46_PV, VW190               // → 取 TimerA 当前 PV
LDN    M16.0                       // 当前使用 TimerB?
MOVW   T48_PV, VW190               // → 取 TimerB 当前 PV


NETWORK 4
// S6 触发条件
// 当前 PV <= S6_actual × 10 时,触发 S6 排水
// S6_actual: 首轮用 VD108(默认),后续用 VD116(滚动实测)
LD     SM0.0
MOVR   VD116, VD190                // S6_actual = VD116(滚动实测)
AW=    VW306, 0                    // 首次换水?
MOVR   VD108, VD190                // → S6_actual = VD108(默认)

LD     SM0.0
*R     10.0, VD190                 // S6_actual × 10 (100ms 时基)
ROUND  VD190, AC0
MOVW   AC0, VW194                  // VW194 = S6_actual × 10

LD     SM0.0
MOVW   VW190, VW192                // VW192 = 当前 PV
-I     VW194, VW192                // PV - S6_actual×10
AR<=   VW192, 0                    // PV <= S6_actual×10 ?

LDW=   VW2, 6                      // 当前在 S5
AW=    VW6, 0                      // 无报警
OLD
ALD
MOVW   7, VW2                      // 转 S6 排水


NETWORK 5
// 下一轮 S1 触发条件
// 当前 PV <= Prep_Needed × 10 时,触发下一轮 S1 (M16.1 脉冲)
// Prep_Needed = VD70 + VD28 + VD430 (S1 实测 + S2 固定 + 上缸安全余量)
LD     SM0.0
MOVR   VD70, VD190                 // VD_S1_Actual
+R     VD28, VD190                 // + VD_PreMixTime(固定)
+R     VD430, VD190                // + Prep_Safety_Margin
*R     10.0, VD190                 // → 100ms 时基
ROUND  VD190, AC0
MOVW   AC0, VW200                  // VW200 = Prep_Needed × 10

LD     SM0.0
MOVW   VW190, VW192                // VW192 = 当前 PV
-I     VW200, VW192                // PV - Prep_Needed×10
AR<=   VW192, 0                    // PV <= Prep_Needed×10 ?

LDW=   VW304, 0                    // 上缸空闲(可启动下一轮)
AW=    VW6, 0                      // 无报警
ALD
S      M16.1, 1                    // 触发下一轮 S1 脉冲


NETWORK 6
// 倒计时到 0 报警 (V303.6)
// TimerA/B 计时完成 + 不在 S7 → 报警
LD     M16.0                       // 当前使用 TimerA?
A      T46                         // TimerA 计时完成?
LDN    M16.0                       // 当前使用 TimerB?
A      T48                         // TimerB 计时完成?
OLD
AN     VW2.7                       // VW2 != 8 (不在 S7)
S      V303.6, 1                   // 单轮换水周期超时报警


NETWORK 7
// 双倒计时器显示值写入 (HMI 读取)
// 真空闲区 VD256/VD244 (从 VD442/446 迁移,v2.2)
LD     M16.0                       // 当前使用 TimerA?
MOVW   T46_PV, AC0
/I     +10, AC0
ITD    AC0, VD256                  // VD_TimerA_Display = T46_PV/10 (秒)
LDN    M16.0                       // 当前使用 TimerB?
MOVW   T48_PV, AC0
/I     +10, AC0
ITD    AC0, VD244                  // VD_TimerB_Display = T48_PV/10 (秒)


LBL    9
// 本FC结束
// 返回 OB1 (OB1 在调度 FC1 之前调用本FC,保证 M16.1 下一轮 S1 触发脉冲及时响应)


// ============================================================
// 文件结束
// ============================================================
// 说明:
//   1. 调用时机: OB1 在 FC22(RTC Sync) 之后、FC1(状态调度) 之前调用
//   2. 计时器启动: S1 开始时由 FC11 根据 M16.0 启动 T46 或 T48 (PT = T_cycle×10)
//   3. 计时器切换: S4 完成后由 FC17 切 M16.0 = NOT M16.0
//   4. 报警 V303.6: 不受 V200.0 模式影响,必须 V0.3 人工确认
//   5. T_cycle ≤ 0: 直接报警并跳过本周期其他计算(跳到 LBL 9)
//   6. 显示值 VD256/VD244: 真空闲区(原 VD442/VD446 与 VD440/444 字节重叠已迁移)
// ============================================================