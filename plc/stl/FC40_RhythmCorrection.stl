// ============================================================
// 文件: FC40_RhythmCorrection.stl
// 功能: 配液节奏三层纠偏核心算法
// Story: AQEX-8 节奏纠偏 (AQEX-6 状态机骨架预留接口填充)
// 说明: 纯数学算法,输入Available/Needed,输出S2/RestTime/CycleExtend目标+报警
//       模式VW182: 0=预规划(S5上升沿触发), 1=二次校正(S1完成触发)
//       三层额度: 第0层压缩静止等候→第1层压缩S2→第2层顺延周期
// ============================================================

// 符号说明:
// VW182 : VW_Corr_Mode       纠偏模式(0预规划/1二次校正)
// VD150 : VD_Available       剩余可用时间(s) [调用方填入]
// VD154 : VD_Needed          所需时间(s) [调用方填入]
// VD158 : VD_Delta           缺口 = Needed - Available(s)
// VD162 : VD_Layer0_Quota    第0层额度(静止等候可压缩量)
// VD166 : VD_Layer1_Quota    第1层额度(S2可压缩量)
// VD170 : VD_Layer2_Quota    第2层额度(周期可顺延量,s)
// VD120 : VD_S2_Target       输出:本轮S2目标时长(s)
// VD124 : VD_RestTime_Target 输出:本轮S3.5目标时长(s)
// VD128 : VD_CycleExtend_Target 输出:允许下缸空等时长(min)
// VW184 : VW_Corr_Result     输出:0进行中/1正常/2已纠偏/3滞后提示/4人工介入
// V300.6: M_Alarm_ScheduleLag     严重滞后(人工介入)报警
// V300.7: M_Alarm_ScheduleLag_Warn 滞后提示报警


NETWORK 1: 计算三层额度 + 清结果
LD     SM0.0
MOVW   0, VW184                    // 清纠偏结果
// 第0层额度 = VD_RestTime - VD_RestTime_Min
MOVR   VD36, VD162                 // VD_RestTime
-R     VD40, VD162                 // - VD_RestTime_Min
// 第1层额度 = VD_PreMixTime - VD_PreMixTime_MinSafe
MOVR   VD28, VD166                 // VD_PreMixTime
-R     VD32, VD166                 // - VD_PreMixTime_MinSafe
// 第2层额度 = VD_CycleExtend_Max × 60 (min→s)
MOVR   VD44, VD170                 // VD_CycleExtend_Max(min)
*R     60.0, VD170                 // →秒


NETWORK 2: 判断是否需要纠偏(Available >= Needed → 无需纠偏)
LD     SM0.0
AR>=   VD150, VD154                // Available >= Needed ?
JMP    nNoCorrection               // 是 → 无需纠偏
// 否 → 继续计算缺口


NETWORK 3: 计算缺口Delta + 第0层扣减(压缩静止等候)
LD     SM0.0
// Delta = Needed - Available
MOVR   VD154, VD158                // Delta = Needed
-R     VD150, VD158                // - Available
// 第0层判断: Delta <= Layer0_Quota ?
LD     SM0.0
AR<=   VD158, VD162                // Delta <= 第0层额度 ?
JMP    nLayer0OK                   // 是 → 第0层够
// 否 → 第0层用满,Delta减去第0层额度,继续第1层
LD     SM0.0
MOVR   VD40, VD124                 // VD_RestTime_Target = VD_RestTime_Min(用满)
MOVR   VD158, AC0                  // 暂存Delta
-R     VD162, AC0                  // Delta - Layer0_Quota
MOVR   AC0, VD158                  // 更新Delta
JMP    nLayer1                     // → 第1层

nLayer0OK:
LD     SM0.0
MOVR   VD36, VD124                 // VD_RestTime_Target = VD_RestTime - Delta
-R     VD158, VD124
MOVR   VD28, VD120                 // VD_S2_Target = VD_PreMixTime(不动)
MOVR   0.0, VD128                  // VD_CycleExtend_Target = 0
MOVB   2, VB184                   // Result=2(已纠偏)
JMP    nCorrEnd


NETWORK 4: 第1层扣减(压缩S2预循环)
LBL    nLayer1
LD     SM0.0
AR<=   VD158, VD166                // Delta <= 第1层额度 ?
JMP    nLayer1OK                   // 是 → 第1层够
// 否 → 第1层用满,Delta减去第1层额度,继续第2层
LD     SM0.0
MOVR   VD32, VD120                 // VD_S2_Target = VD_PreMixTime_MinSafe(用满)
MOVR   VD158, AC0                  // 暂存Delta
-R     VD166, AC0                  // Delta - Layer1_Quota
MOVR   AC0, VD158                  // 更新Delta
JMP    nLayer2                     // → 第2层

nLayer1OK:
LD     SM0.0
MOVR   VD28, VD120                 // VD_S2_Target = VD_PreMixTime - Delta
-R     VD158, VD120
MOVR   0.0, VD128                  // VD_CycleExtend_Target = 0
MOVB   2, VB184                   // Result=2(已纠偏)
JMP    nCorrEnd


NETWORK 5: 第2层扣减(顺延换水周期)
LBL    nLayer2
LD     SM0.0
AR<=   VD158, VD170                // Delta <= 第2层额度(总顺延上限) ?
JMP    nLayer2OK                   // 是 → 顺延可覆盖
// 否 → 三层额度全部用尽,人工介入
LD     SM0.0
MOVB   4, VB184                   // Result=4(人工介入)
S      V300.6, 1                  // M_Alarm_ScheduleLag(严重滞后,强制人工确认)
MOVB   99, VB2                    // 转S_ERROR(VW2=99)
JMP    nCorrEnd

nLayer2OK:
// 顺延周期可覆盖,触发滞后提示报警
LD     SM0.0
MOVR   VD158, VD128                // VD_CycleExtend_Target = Delta(s)
/R     60.0, VD128                 // →min写回
MOVB   3, VB184                   // Result=3(滞后提示)
// 滞后提示报警:预规划已置位则不重复(二次校正微调场景)
LD     SM0.0
AN     V300.7                      // 预规划未触发过滞后提示?
S      V300.7, 1                   // 才置位(避免二次校正重复报警)
JMP    nCorrEnd


NETWORK 6: 无需纠偏分支(Available >= Needed)
LBL    nNoCorrection
LD     SM0.0
MOVR   VD28, VD120                 // VD_S2_Target = VD_PreMixTime(标称)
MOVR   VD36, VD124                 // VD_RestTime_Target = VD_RestTime(标称)
MOVR   0.0, VD128                  // VD_CycleExtend_Target = 0(无需顺延)
MOVB   1, VB184                   // Result=1(正常无需纠偏)


NETWORK 7: 纠偏计算结束
LBL    nCorrEnd
// 返回调用方(FC16预规划 或 FC11二次校正)
// 调用方检查VW184:
//   1=正常 → 按标称执行
//   2=已纠偏 → 按Target执行
//   3=滞后提示 → 按Target执行,HMI显示顺延量
//   4=人工介入 → FC40已转S_ERROR,调用方本周期结束


// ============================================================
// 文件结束
// 说明:
//   1. 本FC为纯数学算法,不读取RTC/不操作阀门,时间由调用方(FC16)准备
//   2. AR>=/AR<=为A型浮点比较,前需LD压栈,JMP为条件跳转(栈顶=1跳转)
//   3. V300.6(严重滞后)由本FC置位,转S_ERROR;复位由FC3人工确认后执行
//   4. V300.7(滞后提示)二次校正不重复置位,体现7.3"不重复触发滞后报警"
//   5. 单位:内部统一秒,VD_CycleExtend_Target输出min(÷60写回)
// ============================================================
