// ============================================================
// 文件: FC99_TestFlow.stl
// 功能: 注射泵 Modbus RTU 测试 (读+写)
// 2个CALL MBUS_MSG(读/写各一个), VD330做写地址
//
// 关键设计(v2):
//   1. 首次扫描清库存储区(VB608~VB893), 清除残留状态
//   2. 不再上电自动复位(断电重启后96=就绪态, 无需复位)
//   3. 读First用定时器T37脉冲(每2000ms), 必须大于MBUS_CTRL超时(1000ms)
//   4. 写First用M22.1的EU(上升沿, 仅触发一次)
//   5. 写命令就绪条件: VW192=96(就绪态)才允许写
//   6. 读成功(M20.1=1且VB201=0)才更新VW192, 避免从站离线后保持旧值
//
// 状态码定义(经现场确认):
//   96 (60H) = 就绪/激活态(可接受命令), bit5=1
//   64 (40H) = 空闲/休眠态, bit5=0
//   103(67H) = 设备未初始化(命令时序冲突导致)
//   100(64H) = 运动中状态(需强停40002=1才能恢复96)
//
// 监控变量:
//   M20.0 = MBUS_CTRL Done
//   VB200 = MBUS_CTRL Error
//   M20.1 = 读 Done
//   M20.2 = 写 Done
//   VB201 = MBUS_MSG Error
//   VW190 = 读回数据/写数据缓冲
//   VW192 = 状态码保存
//   VW196 = 抽液步数(默认100)
//   VW198 = 排液步数(默认100)
//   VW320 = 任务号(0=读, 10=写复位, 11=写抽液, 12=写排液, 13=强停)
//   M21.1 = 手动触发:写复位
//   M21.2 = 手动触发:写抽液
//   M21.3 = 手动触发:写排液
//   M21.5 = 手动触发:强停(写40002=1, 用于100状态恢复96)
//   M21.4 = 就绪标志(VW192=96)
//   M22.0 = 读使能(VW320<10)
//   M22.1 = 写使能(VW320>=10且未完成)
// ============================================================

NETWORK 1
// 首次扫描: 清库存储区VB608~VB893(286字节=143字)
// V区断电不丢, 之前实验残留导致库状态机卡死
LD     SM0.1
FILL   0, VW608, 143

// 首次扫描: 初始化参数
LD     SM0.1
MOVW   100, VW196           // 抽液步数默认100
MOVW   100, VW198           // 排液步数默认100

// 首次扫描: 默认读任务(不再自动触发复位)
LD     SM0.1
MOVW   0, VW320


NETWORK 2
// MBUS_CTRL: 9600/8/N/1, 无校验, 1000ms超时
LD     SM0.0
=      L60.0
LD     SM0.0
=      L63.7
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#00, 16#00, 1000, M20.0, VB200


NETWORK 3
// 就绪判断: VW192=96 表示泵就绪, 可接受写命令
LDW=   VW192, 96
=      M21.4


NETWORK 4
// 任务调度
// 写请求触发(上升沿), 必须满足就绪条件M21.4=1
// 强停M21.5除外: 100状态时VW192≠96, M21.4=0, 仍需能触发
LD     M21.1
EU
A      M21.4
MOVW   10, VW320

LD     M21.2
EU
A      M21.4
MOVW   11, VW320

LD     M21.3
EU
A      M21.4
MOVW   12, VW320

// 强停: 无需就绪条件(用于100状态恢复)
LD     M21.5
EU
MOVW   13, VW320

// 写Done: 清触发位, 清写Done(否则M22.1=0无法触发下次写), 切回读
LDW>=  VW320, 10
A      M20.2
R      M21.1, 1
R      M21.2, 1
R      M21.3, 1
R      M21.5, 1
R      M20.2, 1
MOVW   0, VW320


NETWORK 5
// 设置写地址(VD330)和写数据(VW190)
// 任务10: 写复位 40003=1
LDW=   VW320, 10
MOVD   16#9C43, VD330
MOVW   1, VW190

// 任务11: 写抽液 40006=VW196
LDW=   VW320, 11
MOVD   16#9C46, VD330
MOVW   VW196, VW190

// 任务12: 写排液 40007=VW198
LDW=   VW320, 12
MOVD   16#9C47, VD330
MOVW   VW198, VW190

// 任务13: 强停 40002=1
LDW=   VW320, 13
MOVD   16#9C42, VD330
MOVW   1, VW190


NETWORK 6
// 读MBUS_MSG (固定地址41001=16#A029, RW=0)
// EN=M22.0(读使能), First=T37(定时器脉冲每300ms)
// 定时器仅在读模式下运行(VW320<10)
LDW<   VW320, 10
=      M22.0

// T37: 2000ms脉冲发生器(必须>1000ms超时, 否则读请求被反复取消无法超时)
LD     M22.0
AN     T37
TON    T37, 20

LD     M22.0
=      L60.0
LD     T37
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#01, 16#00, 16#A029, 16#01, &VB190, M20.1, VB201

// 读Done且无错误(直接判断VB201=0): 才更新状态码到VW192
// 超时(VB201=3)时M20.1也可能=1, 必须同时判断VB201
LD     M20.1
LDB=   VB201, 0
MOVW   VW190, VW192


NETWORK 7
// 写MBUS_MSG (VD330做地址, RW=1)
// EN=M22.1(写使能), First=M22.1的EU(上升沿)
LDW>=  VW320, 10
AN     M20.2
=      M22.1

LD     M22.1
=      L60.0
LD     M22.1
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#01, 16#01, VD330, 16#01, &VB190, M20.2, VB201
