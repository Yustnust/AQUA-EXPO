// ============================================================
// 文件: FC19_State_Error.stl
// 功能: S_ERROR故障锁定 (VW2=99)
// Story: AQEX-6 状态机骨架
// 说明: 急停或最高级报警触发后的故障锁定，强制输出安全状态
//       等待急停解除+系统复位按钮才能回S0
//       详细安全逻辑由Story 1.5补充
// ============================================================

NETWORK 1: 故障态输出强制安全
LD     SM0.0
// 所有DO安全状态：泵停、阀关、NC电磁阀失电(关闭=安全)
MOVB   0, QB0
// 报警输出：声音+灯光开(提示故障)
S      Q0.7, 1                     // 声音
S      Q1.0, 1                     // 灯光


NETWORK 2: 等待急停解除
// I1.1=ON(急停按钮恢复) AND I2.3(系统复位按钮)上升沿 → 回S0
LD     I1.1                        // 急停已解除(常闭触点恢复ON)
A      I2.3                        // 系统复位按钮按下
EU                                 // 上升沿(按下瞬间)
// 检查安全继电器故障是否已消除
A      I1.2                        // 安全继电器反馈正常(动力回路已断开确认)
// 清急停锁存
R      V300.4, 1                  // M_EStop_Latch=0
R      V300.5, 1                  // M_Alarm_SafetyRelay=0
// 转S0
MOVB   0, VB2                     // VW2=0(S0)
MOVB   0, VB3


// 注: 若安全继电器故障未消除(I1.2异常)，不允许离开S_ERROR
// 注: 详细双通道诊断、故障记录由Story 1.5补充


// ============================================================
// 文件结束
// ============================================================
