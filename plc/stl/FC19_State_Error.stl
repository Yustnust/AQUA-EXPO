// ============================================================
// 文件: FC19_State_Error.stl
// 功能: S_ERROR故障锁定 (VW2=99)
// Story: AQEX-6 状态机骨架 + AQEX-9 急停双通道+安全继电器反馈(详细实现) + AQEX-10 编址修正(V0.5→V0.7)
// 说明: 急停或最高级报警触发后的故障锁定,强制输出安全状态
//       继电器故障(V300.5)禁止复位,必须HMI高权限确认(V0.7)+I1.2正常后清除
// 急停解除(I1.1=OFF,NO 触点释放)+系统复位按钮(I0.3)→回S0  v1.3 改 NO 接法
// ============================================================

// 符号说明:
// I1.1  : DI_EStop           急停反馈(常开 NO,OFF=正常,ON=急停触发)  v1.3 改为接 NO 触点
// I1.2  : DI_SafetyRelay_FB  安全继电器辅助反馈(ON=动力回路已断开确认)
// I0.3  : DI_Btn_SystemReset 系统复位按钮(无源常开点动)
// V0.7  : CMD_SafetyRelayAck HMI高权限确认继电器故障已检修(需二次确认/高权限)
// V300.4: M_EStop_Latch      急停触发锁存(漫溢级)
// V300.5: M_Alarm_SafetyRelay 安全继电器故障(最高级)
// V1.6  : M_TankA_State      上缸状态(0=空,1=满)
// V1.7  : M_TankB_State      下缸状态(0=空,1=满)
// VW2   : 状态机状态(FC19写0回S0)
// VW6   : 报警码


NETWORK 1
// 故障态输出强制安全(与FC2 NETWORK3双保险)
// S_ERROR态双保险:即使FC2未执行,QB0也强制安全
LD     SM0.0
MOVB   0, QB0                      // 潜水泵停/阀关/NC电磁阀失电(关闭=安全)
S      Q0.7, 1                     // 报警声音(FC3管理消音)
// Q8.0灯光由FC3按报警优先级管理(急停/继电器故障=常亮)


NETWORK 2
// 继电器故障禁止复位检测
// 9.4: 继电器故障不允许任何自动恢复,必须人工检修
// V300.5=1时,即使I1.1恢复+I0.3按下,也不允许回S0
LD     V300.5                      // 继电器故障=1
JMP    1               // 跳过系统复位,转NETWORK4检查HMI确认
// V300.5=0(无继电器故障) → 继续NETWORK3系统复位


NETWORK 3
// 急停解除+系统复位按钮 → 回S0
// 复位条件(全部满足):
//   I1.1=OFF(急停按钮已释放,NO 触点恢复)
//   I0.3上升沿(系统复位按钮按下)
//   V300.5=0(NETWORK2已确认无继电器故障)
LDN    I1.1                        // 急停已释放(常开 NO 触点恢复 OFF)  v1.3 改 NO 接法
A      I0.3                        // 系统复位按钮按下
EU                                 // 上升沿(按下瞬间)
// 清急停锁存
R      V300.4, 1                   // M_EStop_Latch=0
// 清漫溢级报警(含NC阀动作报警V300.2/V300.3,这些锁存位需系统复位清除)
R      V300.0, 4                   // V300.0~V300.3=0
// 强制上下缸状态置空(9.3:复位后上下缸状态强制置"空")
R      V1.6, 1                     // 上缸=空
R      V1.7, 1                     // 下缸=空
// ★ 2026-09-11 新增: 清阀门诊断子状态和计时器
// 与OB1停止命令同根因: FC11/FC15/FC17的AW=VW2xx,0前置条件
FILL   0, VW260, 8                 // 清 VB260~VB275 (阀A/B/C 诊断)
R      T50, 6                      // 清 T50~T55 (阀A/B 诊断计时器)
// 转S0初始化(9.3:回到S0重新开始,不支持从中断点继续)
MOVW   0, VW2                      // VW2=0(S0)
// 清报警码
MOVW   0, VW6
// 清启动命令残留,防止复位后MCGS残留V0.0=1导致立即重启动
R      V0.0, 1
// 停报警声音(灯光由FC3按确认流程管理)
R      Q0.7, 1
JMP    2                    // 复位完成,结束


NETWORK 4
// 继电器故障HMI高权限确认清除
// 9.4: 继电器故障确认需更高权限/二次确认,通过HMI下发V0.7命令
// V0.7=1表示HMI高权限确认"继电器已检修,动力回路已验证正常"
// 此时要求I1.2=ON(反馈确实正常)才允许清除V300.5
LBL    1
LD     V0.7                        // HMI高权限确认命令(编址修正:V0.5→V0.7)
EU                                 // 上升沿(命令下发瞬间)
A      I1.2                        // 且安全继电器反馈确实正常(已检修)
R      V300.5, 1                   // 清除继电器故障报警
R      V0.7, 1                     // 清确认命令
// 注: 清除V300.5后,下一周期NETWORK2不再跳过,NETWORK3允许系统复位按钮回S0
// 注: 若I1.2仍OFF(检修未完成),V300.5保持,不允许清除


NETWORK 5
// ★ 自动解锁: S_ERROR锁死但所有报警已被自动恢复清除
// 2026-09-11 修复 AQEX-XX: FC3 NETWORK5自动恢复清一般故障报警位
//   (如V301.4阀A开到位超时→I8.0终于ON→FC3自动R V301.4)，
//   导致 VW2=99(状态机锁S_ERROR) + VW6=0(报警清零) 的状态不一致，
//   OB1 NETWORK12按VW6=0计算VB305=0(良好)，掩盖故障。
// 覆盖场景: V301.4/V301.5/V302.0/V302.1/V303.4 等所有可自恢复的一般故障级
// 解锁条件(全部满足):
//   VW2=99(确实锁在S_ERROR) AND VW6=0(报警系统已清零)
//   AND V300.4=0(非急停锁存) AND V300.5=0(非继电器故障)
//   AND I1.1=OFF(急停按钮已释放,NO触点) AND V303.5=0(非RTC丢失)
LDW=    VW2, 99
AW=     VW6, 0
AN      V300.4               // 不是急停锁存
AN      V300.5               // 不是继电器故障
AN      I1.1                 // 急停按钮已释放(NO触点OFF)
AN      V303.5               // 不是RTC丢失(RTC不会被自动清,保险检查)
// ★ 2026-09-11 新增: 清阀门诊断子状态和计时器(同OB1停止/系统复位根因)
FILL    0, VW260, 8
R       T50, 6
MOVW    0, VW2               // 自动回S0
MOVW    0, VW6               // 清报警码
R       Q0.7, 1              // 关报警声音
// 注: 不清V1.6/V1.7(缸状态),让FC0/FC10正常处理
// 注: 不碰V300.4/V300.5,上面AN已确认它们为0
JMP     2                    // → FC19结束


NETWORK 6
// FC19结束
LBL    2


// 注: 继电器故障(V300.5)优先级最高,禁止系统复位按钮清除
// 注: 继电器故障清除必须HMI高权限V0.7+I1.2双确认,防止误清除
// 注: 系统复位后上下缸状态强制置空,从S0重新开始(不支持断点续运行)
// 注: Q8.0报警灯光由FC3统一管理,本FC不操作


// ============================================================
// 文件结束
// ============================================================
