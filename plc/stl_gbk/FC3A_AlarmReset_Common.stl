// ============================================================
// 文件: FC3A_AlarmReset_Common.stl
// 功能: FC3 公共报警位复位逻辑（条件消失则复位）
// Story: 压缩 FC3 程序体积，提取 NETWORK 4/5 重复代码
// 说明: 本 FC 仅包含一般故障级报警位的条件消失自动复位逻辑，
//       漫溢级(V300.0~3)、急停(V300.4)、继电器故障(V300.5)、
//       节奏滞后(V300.6/7)不由本 FC 处理。
// 调用方: FC3 NETWORK 4(人工确认时)、FC3 NETWORK 5(自动恢复模式)
// ============================================================

NETWORK 1
// 阀A类：条件消失则复位
LD     V301.0                        // 阀A关后仍有流
AN     I0.0                          // 流量开关A已OFF
R      V301.0, 1

LD     V301.2                        // 阀A关到位超时
A      I8.1                          // 阀A关到位反馈已ON
R      V301.2, 1

LD     V301.3                        // 阀A关到位但仍有流
AN     I0.0                          // 流量开关A已OFF
R      V301.3, 1

LD     V301.4                        // 阀A开到位超时
A      I8.0                          // 阀A开到位反馈已ON
R      V301.4, 1

LD     V301.5                        // 阀A开到位但无流
A      I0.0                          // 流量开关A已ON
R      V301.5, 1

LD     V301.6                        // S5触发S1时上缸≠空
AN     V1.6                          // 上缸已=空
R      V301.6, 1


// 阀B/C类：条件消失则复位
LD     V302.0                        // 阀B诊断异常
LD     I0.1                          // 流量开关B=ON
O      I0.6                          // 或液位计A-低位=ON
ALD
R      V302.0, 1

LD     V302.1                        // 阀B开到位超时
A      I8.2
R      V302.1, 1

LD     V302.2                        // 阀B开到位但无流
A      I0.1
R      V302.2, 1

LD     V302.3                        // 阀B关到位超时
A      I8.3
R      V302.3, 1

LD     V302.4                        // 阀B关到位但仍有流
AN     I0.1
R      V302.4, 1

// 【v10.4硬件变更】V302.5(报警码45)/V302.7(报警码47)已废弃为保留位,
//   FC32不再置位,此处删除原基于I0.2的复位条件
LD     V302.6                        // 阀C开到位超时
A      I8.4
R      V302.6, 1


// 其他类：条件消失则复位
// 注: V303.0(报警码60)现覆盖关到位超时+排水超时两种触发,
//     复位条件统一为阀C关到位反馈I8.5=ON
LD     V303.0                        // 阀C关到位超时/排水超时
A      I8.5
R      V303.0, 1

// 【v10.4硬件变更】V303.1(报警码61,阀C关到位仍有流)已废弃为保留位,
//   内漏判定依赖I0.2已去除,此处删除原复位条件
LD     V303.4                        // 注射泵通讯异常
AW=    VW4, 0                        // 状态码=0(空闲正常)
R      V303.4, 1

// 注: V303.5(RTC丢失)不自动清除，需HMI校时后确认


// ============================================================
// 文件结束
// 说明:
//   1. 本 FC 被 FC3 调用，不要单独从 OB1 调用
//   2. 调用前由调用方保证执行时机（NETWORK 4 的 V0.3 上升沿 / NETWORK 5 的自动模式）
//   3. 报警位复位后，下一周期 FC3 NETWORK 1 会重算 VW6
// ============================================================
