NETWORK 1
// 孤儿态自恢复
// [已修复 v2.2] 用 V62.2 缓存条件,避免 R 指令链栈空
LDW<>  VW390, 0
AW<>   VW390, 30
AN     M11.6
AN     M11.7
AN     M12.0
AN     M13.5
AN     M13.6
=      V62.2
LD     V62.2
MOVW   0, VW390
LD     V62.2
R      M13.7, 1


// 启动命令检测 - 仅空闲态(VW390=0)响应
// [已修复 v2.2] 用 V62.3 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.2
EU
AW=    VW390, 0
=      V62.3
LD     V62.3
MOVR   0.0, VD392
LD     V62.3
MOVR   VD452, VD396
LD     V62.3
R      M13.7, 1
LD     V62.3
R      M13.5, 1
LD     V62.3
R      M13.6, 1
LD     V62.3
R      M12.0, 1
LD     V62.3
R      M11.6, 1
LD     V62.3
R      M11.7, 1
LD     V62.3
MOVW   1, VW390
LD     V62.3
R      V307.2, 1


// 停止命令检测 - 非空闲态响应
// [已修复 v2.2] 用 V62.4 缓存 EU 结果,避免 S/R 指令链栈空
LD     SM0.0
A      V307.3
EU
AW<>   VW390, 0
=      V62.4
LD     V62.4
S      M13.7, 1
LD     V62.4
R      V307.3, 1


// 全局错误检测
// [已修复 v2.2] 用 V62.5 缓存全局错误条件,避免 R 指令链栈空
LDW=   VW390, 1
OW=    VW390, 2
OW=    VW390, 3
LD     V303.4
LD     SM0.0
AW>=   VW4, 4
OLD
ALD
=      V62.5
LD     V62.5
MOVW   99, VW390
LD     V62.5
R      M13.5, 1
LD     V62.5
R      M13.6, 1
LD     V62.5
R      M13.7, 1
LD     V62.5
R      M12.0, 1
LD     V62.5
R      M11.6, 1
LD     V62.5
R      M11.7, 1


// 子状态1-1 - 计算本次抽液步数
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
MOVR   VD396, VD102
/R     VD350, VD102
AR>=   VD102, 6000.0
JMP    10
ROUND  VD102, AC0
MOVR   AC0, VD102
JMP    11
LBL    10
MOVR   6000.0, VD102
LBL    11


// 子状态1-2 - 检查步数并下发抽液指令(40006)
LD     SM0.0
AW=    VW390, 1
AN     M13.5
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V60.4
LD     V60.4
ROUND  VD102, AC0
AR>    AC0, 0.0
JMP    12
// [已修复 v2.2] 复用 V60.4 缓存条件,补齐 R/S 链前面的 LD
LD     V60.4
R      M12.0, 1
LD     V60.4
R      M11.6, 1
LD     V60.4
R      M11.7, 1
LD     V60.4
MOVW   3, VW390
JMP    13
LBL    12
MOVW   AC0, VW204
MOVW   AC0, VW230
MOVD   16#9C46, VD232
LD     V60.4
S      M11.6, 1
LD     V60.4
S      M13.5, 1
LBL    13


// 子状态1-3 - 抽液写失败处理
// [已修复 v2.2] 用 V64.0 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
A      V303.4
=      V64.0
LD     V64.0
MOVW   99, VW390
LD     V64.0
R      M13.5, 1
LD     V64.0
R      M13.7, 1
LD     V64.0
R      M12.0, 1
LD     V64.0
R      M11.6, 1
LD     V64.0
R      M11.7, 1


// 子状态1-3 - 抽液写成功处理
// [已修复 v2.2] 用 V64.1 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 1
AN     V303.4
=      V64.1
LD     V64.1
R      M12.0, 1
LD     V64.1
R      M11.6, 1


// 子状态1-4 - 等待抽液执行完成
// [已修复 v2.2] 用 V65.4 缓存条件,避免 R 指令链栈空
LD     M13.5
AW=    VW390, 1
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V65.4
LD     V65.4
R      M13.5, 1
LD     V65.4
MOVW   2, VW390


// 子状态2-1 - 下发排液指令(40007)
// [已修复 v2.2] 用 V65.3 缓存条件,避免 S 指令链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AN     M11.6
AN     M11.7
AN     M12.0
AW=    VW4, 0
=      V65.3
