LD     M13.6
AW=    VW390, 2
AW=    VW4, 0
AN     M11.6
AN     M11.7
AN     M12.0
=      V64.4
LD     V64.4
MOVR   VD102, AC0
LD     V64.4
*R     VD350, AC0
LD     V64.4
+R     AC0, VD392
LD     V64.4
-R     AC0, VD396
LD     V64.4
R      M13.6, 1


// 子状态2-4 - 判断分支: 停止请求 → 回零
// [已修复 v2.2] 用 V64.5 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
A      M13.7
=      V64.5
LD     V64.5
R      M12.0, 1
LD     V64.5
R      M11.6, 1
LD     V64.5
R      M11.7, 1
LD     V64.5
MOVW   3, VW390


// 子状态2-4 - 判断分支: 单次模式 → 回零
