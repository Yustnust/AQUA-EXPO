LD     V64.2
R      M13.6, 1
LD     V64.2
R      M13.7, 1
LD     V64.2
R      M12.0, 1
LD     V64.2
R      M11.6, 1
LD     V64.2
R      M11.7, 1


// 子状态2-2 - 排液写成功处理
// [已修复 v2.2] 用 V64.3 缓存条件,避免 S/R 链栈空
LD     M12.0
AW=    VW390, 2
AN     V303.4
=      V64.3
LD     V64.3
R      M12.0, 1
LD     V64.3
R      M11.6, 1


// 子状态2-3 - 等待排液执行完成,累加本循环体积
