LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 0
=      V64.6
LD     V64.6
R      M12.0, 1
LD     V64.6
R      M11.6, 1
LD     V64.6
R      M11.7, 1
LD     V64.6
MOVW   3, VW390


// 子状态2-4 - 判断分支: 循环模式且累计>=目标 → 回零
// [已修复 v2.2] 用 V64.7 缓存条件,避免 S/R 链栈空
LD     SM0.0
AW=    VW390, 2
AN     M13.6
AW=    VW388, 1
AR>=   VD392, VD452
=      V64.7
LD     V64.7
R      M12.0, 1
LD     V64.7
R      M11.6, 1
LD     V64.7
R      M11.7, 1
LD     V64.7
