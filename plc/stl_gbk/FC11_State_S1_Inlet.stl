// ============================================================
// 文件: FC11_State_S1_Inlet.stl
// 功能: S1上缸进水 (VW2=1)
// Story: AQEX-6 状态机骨架 + AQEX-7 阀门诊断(已集成) + AQEX-8 节奏纠偏(已集成二次校正)
// 说明: 开阀A进水，调用FC30阀A诊断(差值法+延时验证)
//       诊断结果VW266: 0进行中/1正常完成/2故障
//       诊断正常完成 → 调用FC40二次校正(模式1) → 更新VD_T_Rolling → 转S2
// ============================================================

// 符号说明:
// VW260 : Diag_State_A  阀A诊断子状态
// VW266 : Diag_Result_A 阀A诊断结果
// VW278 : VD_Timeout_ValveA×10 转换值(供FC30的T50用,已修正避FC32冲突)
// VW280 : VD_Delay_ValveA_Verify×10 转换值(供FC30的T51用)
// VD332 : VD358运算中间变量(避免修改HMI参数VD358)
// VD316 : 目标进水量(HMI设定,SBR25冷启动默认10L,用户默认区VD500覆盖)


NETWORK 1
// S1首次进入 - 开阀A+NC球阀+复位+流量计快照+参数计算+启动诊断(合并)
// [已修复 v2.2] 用 V61.1 缓存 M10.2 AND VW260=0 条件,避免 S/R 指令链栈空
LD     M10.2
AW=    VW260, 0
=      V61.1
LD     V61.1
S      Q0.2, 1                     // 开阀A
LD     V61.1
S      Q0.5, 1                     // 开上缸NC球阀
LD     V61.1
R      T37, 1                      // 复位S1计时器
LD     V61.1
TON    T37, 32767                  // 【v2.3修复】启动S1实测计时(原只复位不启动,导致VD70恒为0)
LD     V61.1
R      V1.6, 1                     // 置上缸状态=空
LD     V61.1
MOVD   VD86, VD82                  // 流量计快照
LD     V61.1
MOVR   VD358, VD332                // 计算超时参数 VW278
*R     10.0, VD332
ROUND  VD332, AC0
MOVW   AC0, VW278
LD     V61.1
MOVR   VD66, VD320                 // 计算延时参数 VW280
*R     10.0, VD320
ROUND  VD320, AC0
MOVW   AC0, VW280
LD     V61.1
MOVW   1, VW260
MOVB   0, VB266                    // 清诊断结果
MOVB   0, VB267


// v2.3 双倒计时器: S1 首次进入时清零【非活动】Elapsed 计数器
// 【v2.3修复】原"清零当前活动计数器"与流水线时序矛盾:
//   S1 由 FC40 按"本轮剩余<=Prep_Needed"触发,启动于本轮中段,
//   活动计数器正服务本轮(NET4/NET6节奏判定),清零会导致本轮节奏失效;
//   非活动计数器属于下一轮,其计时从本轮S6完成切换后才开始,此处清零安全。
LDW=   VW304, 1                    // 上缸进入 S1
AN     M16.2                       // S1 尚未开始(防止重复启动)
S      M16.2, 1                    // 置 S1 已开始标志
LD     M16.0                       // 当前活动计时器为 TimerA?
MOVR   0.0, VD252                  // 清零【非活动】TimerB_Elapsed
LDN    M16.0                       // 当前活动计时器为 TimerB?
MOVR   0.0, VD248                  // 清零【非活动】TimerA_Elapsed


// 调用阀A诊断FC30
LD     SM0.0
CALL ValveA_Diag


// 检查阀A诊断结果 + 二次校正 + 转S2
// ★ 关键: FC30 用 MOVB 写 VB266(只写低字节,高字节VB267=0)
//   所以 VW266 = VB266×256, 必须用 LDB= 字节比较,不能用 AW= 字比较
//   字节值 0=进行中, 1=正常完成, 2=故障(FC30已转S_ERROR)
LDB=   VB266, 1                    // 诊断正常完成(字节比较,与FC30的MOVB匹配)
JMP    1                   // 是 → 跳转处理
LD     SM0.0
JMP    2                 // 否 → 结束本NETWORK

LBL    1
LD     SM0.0
MOVW   T37, VW236                   // 【v2.3修复】先读当前值再复位(R在前读到的恒为0)
ITD    VW236, VD444                 // 整数→双整数
DTR    VD444, VD70                  // 双整数→实数(VD_S1_Actual)
R      T37, 1                      // 停S1计时(读后复位)
// 【v2.2 修订 2026-09-15】删除原 Story1.4 二次校正 FC40 调用
// v2.2 取消三层纠偏,FC40 改为双倒计时器周期管理(由 OB1 顶层调用)
// 原 VD354/VW182/VW184/VD150/154/158 全部废弃
// 保留位置仅为保留 S1 完成 → 转 S2/VW304=2 的状态机逻辑

// 【v2.2 新增】S1 完成时清 M16.2 (S1 已开始标志) + 切 M16.0 (计时器切换, 由 FC17 S6 完成时切)
LD     SM0.0
R      M16.2, 1                    // 清 S1 已开始标志
R      M16.3, 1                    // 清 S2 首次进入标志(防御性)

// 【v2.2】S1 完成 → 转 VW304=2 (上缸 S2 搅拌+加药)
// v2.2 取消原"二次校正 VW184≠4"条件,改为无条件转移
// (FC40 已删除三层纠偏, 不再有"人工介入→S_ERROR"分支)
// 累加本次进水量到本次实验累计流量
MOVR   VD90, AC0                   // AC0 = VD_Current_InletVolume
+R     AC0, VD364                  // VD_ExpTotal_Flow += 本次进水量
MOVW   2, VW304                    // 状态转移 S1→S2 (v2.2: VW304 上缸子流程而非 VW2)
R      M10.2, 1                    // 清S1首次进入标志
R      T38, 1                      // 进入S2前复位T38(防御性,FC1A 首次进入会再次启动 T38)

LBL    2


// 注: 漫溢保护、差值法计量、延时验证、内漏检测、开关到位诊断
//      全部由FC30统一处理，FC11仅负责状态转移调度
// 注: VD316(目标进水量)由HMI设定或SBR25用户默认覆盖写入,FC30用它做达标比较
// 注: 二次校正(Story 1.4)在转S2前调用
// 注: VD358运算已改用独立中间变量VD332,不再修改HMI设定参数
// 注: 断电恢复由FC0统一处理,VW2=1(S1阀A动作中断)时FC0转S_ERROR


// ============================================================
// 文件结束
// ============================================================
