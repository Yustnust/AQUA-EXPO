// ============================================================
// 文件: FC32_ValveC_Diag.stl
// 功能: 阀C诊断（四态诊断+开关到位+超时保护）
// Story: AQEX-7 阀门诊断
// 调用方: FC17(S6下缸排水)
// 说明: 阀C四态诊断(流量开关C+液位计B低位)，与阀B对称
//       阀C无漫溢保护(下缸排水不会漫溢)
//       诊断子状态VW264: 0空闲/1等开到位/2开启完成/3运行中/4等关到位
// ============================================================

// 符号说明:
// VW264 : Diag_State_C     阀C诊断子状态
// VW270 : Diag_Result_C    阀C诊断结果(0/1/2)
// T56   : 阀C开到位超时
// T57   : 阀C流量开关超时保护
// T58   : 阀C关到位超时
// I0.2  : 流量开关C
// I1.0  : 液位计B低位(下缸排空)
// I1.7  : 阀C开到位反馈
// I2.0  : 阀C关到位反馈
// Q0.4  : 阀C


NETWORK 1
// 诊断子状态调度
// 注: 阀C无漫溢保护，直接进入状态调度
LDW=   VW264, 0
JMP    1
LDW=   VW264, 1
JMP    2
LDW=   VW264, 2
JMP    3
LDW=   VW264, 3
JMP    4
LDW=   VW264, 4
JMP    5
JMP    6


// ---- 子状态0: 空闲 ----
NETWORK 2
// S0空闲
LBL    1
JMP    6


// ---- 子状态1: 等待开到位 ----
NETWORK 3
// S1等待开到位
LBL    2
// T56开到位超时 + T57流量开关超时(两套独立判据)
LD     SM0.0
TON    T56, VW276                  // PT=VD_Timeout_ValveC(VD54)×10
TON    T57, VW276                  // 流量开关超时

// 开到位=ON → 转S2
LD     I1.7
EU
MOVB   2, VB264
MOVB   0, VB265
R      T56, 1
R      T57, 1
JMP    6

// 开到位超时 → 报警
LD     T56
S      V302.6, 1                   // M_Alarm_ValveC_OpenTimeout
MOVW   99, VW2
MOVW   2, VW270
JMP    6

// 流量开关超时 → 报警
LD     T57
AN     I0.2
S      V302.7, 1                   // M_Alarm_ValveC_OpenNoFlow
MOVW   99, VW2
MOVW   2, VW270
JMP    6


// ---- 子状态2: 开启完成检查 ----
NETWORK 4
// S2开启完成检查
LBL    3
// 流量开关C=ON → 正常，转S3
LD     I0.2
MOVB   3, VB264
MOVB   0, VB265
JMP    6

// 开到位但无流 → 报警
LD     I1.7
AN     I0.2
S      V302.7, 1                   // M_Alarm_ValveC_OpenNoFlow
MOVW   99, VW2
MOVW   2, VW270
JMP    6


// ---- 子状态3: 运行中(四态诊断持续扫描) ----
NETWORK 5
// S3四态诊断
LBL    4
// 四态诊断: 流量开关C(I0.2) + 液位计B低位(I1.0)
// 状态3: 流量开关OFF + 液位低位ON → 下缸排空，关阀触发
LD     I1.0                        // 液位计B低位=ON(下缸空)
AN     I0.2                        // 且流量开关C=OFF(排水结束)
R      Q0.4, 1                     // 关阀C
MOVB   4, VB264                    // 转S4等关到位
MOVB   0, VB265
JMP    6

// 状态4: 流量开关OFF + 液位低位OFF → 设备故障
LD     I0.2
NOT
AN     I1.0
S      V302.5, 1                   // M_Alarm_ValveC_Diag
MOVW   99, VW2
MOVW   2, VW270
JMP    6

// 状态1/2: 流量开关ON → 正常排水中，继续
LD     I0.2
JMP    6


// ---- 子状态4: 等待关到位 ----
NETWORK 6
// S4等待关到位
LBL    5
// T58关到位超时
LD     SM0.0
TON    T58, VW276                  // PT=VD_Timeout_ValveC×10

// 关到位=ON AND 流量开关=OFF → 正常完成
LD     I2.0
AN     I0.2
MOVB   0, VB264                    // VW264=0空闲
MOVB   0, VB265
MOVW   1, VW270                    // Diag_Result_C=1正常完成(已修正:用MOVW写完整WORD)
R      T58, 1
JMP    6

// 关到位=ON AND 流量开关=ON → 内漏
LD     I2.0
A      I0.2
S      V303.1, 1                   // M_Alarm_ValveC_CloseLeak
MOVW   99, VW2
MOVW   2, VW270
JMP    6

// 关到位超时 → 报警
LD     T58
AN     I2.0
S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout
MOVW   99, VW2
MOVW   2, VW270                    // Diag_Result_C=2故障(已修正:用MOVW)
JMP    6


NETWORK 7
// 诊断结束
LBL    6


// ============================================================
// 文件结束
// 说明:
//   1. FC17调用本FC前置VW264=1启动
//   2. FC17检查VW270: 0等待, 1正常完成转S5/S7, 2故障
//   3. VW276=VD_Timeout_ValveC(VD54)×10转换值
//   4. 阀C无漫溢保护(下缸排水不漫溢)
//   5. VW270写入统一用MOVW(写完整WORD),确保FC17的AW=VW270判断正确
// ============================================================
