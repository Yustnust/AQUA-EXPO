// ============================================================
// 文件: FC32_ValveC_Diag.stl
// 功能: 阀C诊断（液位低位+延时验证+开关到位+超时保护）
// Story: AQEX-7 阀门诊断 + v10.4 硬件变更(去流量开关C)
// 调用方: FC17(S6下缸排水)
// 说明: 【v10.4 硬件变更 2026-09-20】去除流量开关C(I0.2,保留未使用)
//       排水完成判定改为「液位计B低位(I1.0)持续ON达VD_Delay_ValveC_Verify(VD472)」
//       报警码45/47/61废弃(V302.5/V302.7/V303.1改为保留位,不再置位)
//       排水超时(液位低位未到)与关到位超时统一由报警码60(V303.0)覆盖
//       诊断子状态VW264: 0空闲/1等开到位/2排水中/3延时验证/4等关到位
//       【v2.3.8 2026-09-30】同FC30去JMP/LBL化: 状态条件直接门控直线结构
// ============================================================

// 符号说明:
// VW264 : Diag_State_C     阀C诊断子状态
// VW270 : Diag_Result_C    阀C诊断结果(0/1/2)
// VW276 : VD_Timeout_ValveC(VD54)×10 转换值(FC17计算写入)
// VW284 : VD_Delay_ValveC_Verify(VD472)×10 转换值(FC17计算写入)【v10.4新增】
// T56   : 阀C开到位超时(输入=VW264=1门控)
// T57   : 阀C排水超时(液位低位到达超时,输入=VW264=1门控)【v10.4改制】
// T58   : 阀C关到位超时(输入=VW264=4门控)
// T101  : 阀C液位低位延时验证(输入=VW264=3 AND I1.0门控)【v10.4新增】
// I1.0  : 液位计B低位(下缸排空)
// I8.4  : 阀C开到位反馈
// I8.5  : 阀C关到位反馈
// Q0.4  : 阀C
// V303.0: M_Alarm_ValveC_CloseTimeout(报警码60,覆盖关到位超时+排水超时)


NETWORK 1
// ============================================================
// v2.3.8 直线结构版 FC32 - 无JMP/LBL
// 结构: 漫溢保护 → 子状态1(等开到位) → 子状态2(排水中)
//       → 子状态3(延时验证) → 子状态4(等关到位)
// ============================================================

// 漫溢保护（全程，优先级最高）
// [v2.2] 阀C增加下缸漫溢保护:液位计B高位=ON立即报警+关阀C+转S_ERROR
LD     I0.7
S      V300.1, 1                   // M_Alarm_Overflow_BHigh
R      Q0.4, 1                     // 关阀C
MOVW   99, VW2
MOVB   2, VB270                    // 故障


// ---- 子状态1: 等待开到位 ----
// T56开到位超时 + T57排水超时(两套独立判据, PT均=VW276)
// 【v2.3.8】输入=VW264=1门控: 仅子状态1内计时,离开自动复位
LDW=   VW264, 1
TON    T56, VW276                  // PT=VD_Timeout_ValveC(VD54)×10
TON    T57, VW276                  // 排水超时: 液位低位未在VD_Timeout_ValveC内到达

// 开到位=ON(上升沿) → 转S2排水中
// [已修复 v2.2] 用 V63.2 缓存 EU 结果,避免 R 指令链栈空
LDW=   VW264, 1
A      I8.4
EU
=      V63.2
LD     V63.2
LPS
MOVW   2, VW264
LPS
R      T56, 1
LPS
R      T57, 1
LPP
LPP
LPP

// 开到位超时 → 报警46(仅子状态1内判定)
LDW=   VW264, 1
A      T56
LPS
S      V302.6, 1                   // M_Alarm_ValveC_OpenTimeout
LPS
MOVW   99, VW2
LPS
MOVW   2, VW270
LPP
LPP
LPP

// 排水超时(开阀后液位低位仍未到达) → 报警60(仅子状态1内判定)
LDW=   VW264, 1
A      T57
AN     I1.0                        // 确认液位计B低位仍OFF
LPS
S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout(排水超时同用码60)
LPS
MOVW   99, VW2
LPS
MOVW   2, VW270
LPP
LPP
LPP


// ---- 子状态2: 排水中(等待液位低位) ----
// 液位计B低位=ON → 转S3延时验证
LDW=   VW264, 2
A      I1.0
MOVW   3, VW264
// 液位低位=OFF → 继续排水,无动作


// ---- 子状态3: 延时验证(液位低位须持续ON) ----
// I1.0持续ON达VD_Delay_ValveC_Verify → 排水完成,关阀C
// 注: I1.0中途OFF时TON输入断开,T101自动清零,液位低位须连续保持
// 【v2.3.8】输入加VW264=3门控: 离开子状态3自动复位
LDW=   VW264, 3
A      I1.0
TON    T101, VW284                 // PT=VD_Delay_ValveC_Verify(VD472)×10

// T101到点 → 关阀C转S4
LDW=   VW264, 3
A      T101
LPS
R      Q0.4, 1                     // 关阀C
LPS
MOVW   4, VW264                    // 转S4等关到位
LPP
LPP

// 液位低位丢失 → 回S2排水中(T101已自动复位)
LDW=   VW264, 3
AN     I1.0
MOVW   2, VW264


// ---- 子状态4: 等待关到位 ----
// T58关到位超时
// 【v2.3.8】输入=VW264=4门控
LDW=   VW264, 4
TON    T58, VW276                  // PT=VD_Timeout_ValveC×10

// 关到位=ON → 正常完成
// [已修复 v2.2] 用 V63.3 缓存条件,避免 R 指令链栈空
LDW=   VW264, 4
A      I8.5
=      V63.3
LD     V63.3
LPS
MOVW   0, VW264                    // VW264=0空闲
LPS
MOVW   1, VW270                    // Diag_Result_C=1正常完成
LPS
R      T58, 1
LPP
LPP
LPP

// 关到位超时 → 报警60(仅子状态4内判定)
LDW=   VW264, 4
A      T58
AN     I8.5
LPS
S      V303.0, 1                   // M_Alarm_ValveC_CloseTimeout
LPS
MOVW   99, VW2
LPS
MOVW   2, VW270                    // Diag_Result_C=2故障
LPP
LPP
LPP


// ============================================================
// 文件结束
// 说明:
//   1. FC17调用本FC前置VW264=1启动
//   2. FC17检查VW270: 0等待, 1正常完成转S5/S7, 2故障
//   3. VW276=VD_Timeout_ValveC(VD54)×10转换值
//      VW284=VD_Delay_ValveC_Verify(VD472)×10转换值【v10.4新增】
//   4. 【v10.4硬件变更】I0.2保留未使用
//      V302.5/V302.7/V303.1改为保留位(报警码45/47/61废弃,不再置位)
//      T57由"流量开关超时"改制为"排水超时"(液位低位到达超时)
//      排水异常=开到位超时(46)或排水/关到位超时(60)
//   5. VW270写入统一用MOVW(写完整WORD),确保FC17的AW=VW270判断正确
//   6. 【v2.3.8】全块无JMP/LBL;定时器输入全部状态门控,离开子状态自动复位
// ============================================================
