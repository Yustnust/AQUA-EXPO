// ============================================================
// 文件: FC22_RTC_Sync.stl
// 功能: RTC时间同步处理
// Story: AQEX-51 PLC长时间停机后HMI校时
// 说明: 
//   1. HMI通过McgsPro将当前时间(BCD格式)写入VB900~VB905
//   2. HMI置位V0.6(CMD_RTC_Sync)
//   3. 本FC检测V0.6上升沿，调用TODW将VB900~VB907写入PLC RTC
//   4. 写入成功后复位V303.7(M_Need_RTC_Sync)和V0.6
//   5. 若V303.7=1持续5分钟(300秒)未同步，置V303.5并转S_ERROR
// ============================================================

// 符号说明:
// V0.6  : CMD_RTC_Sync     HMI校时命令(上升沿触发)
// V303.5: M_Alarm_RTC_Lost RTC时钟丢失报警(超时未同步后置位)
// V303.7: M_Need_RTC_Sync  请求HMI同步PLC时间
// VB900~VB907: RTC时间缓冲区(BCD格式)
// T59   : 校时超时定时器(100ms时基,5分钟=3000×100ms)


NETWORK 1
// HMI校时命令上升沿检测
// 检测V0.6上升沿 -> 跳到LBL1执行TODW写入RTC
LD     V0.6
EU
JMP    1

// 超时保护: V303.7=1时启动5分钟超时定时器
LD     V303.7
TON    T59, 3000
LD     T59
EU
S      V303.5, 1
MOVW   99, VW2
JMP    2

// 正常路径: 无校时命令且未超时，直接结束
LD     SM0.0
JMP    2

// ============================================================
// LBL1: 执行TODW写入RTC
// ============================================================
LBL    1
LD     SM0.0
MOVB   0, VB906
MOVB   0, VB907
TODW   VB900
R      V303.7, 1
R      V0.6, 1

// ============================================================
// LBL2: 结束
// ============================================================
LBL    2