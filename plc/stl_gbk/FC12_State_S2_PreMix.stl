// ============================================================
// 文件: FC12_State_S2_PreMix.stl
// 功能: S2预循环搅拌 (VW2=2)
// Story: AQEX-6 状态机骨架 + A1/A3修复(计时转换+泵超时)
// 说明: 开潜水泵1/2搅拌，计时到达VD_S2_Target转S3
// ============================================================

// 符号说明:
// VW252 : VD_S2_Target×10 转换值(100ms时基,供T38用)
// VD336 : VD120运算中间变量(避免修改VD_S2_Target)
// VD344 : VD58/VD62运算中间变量(泵超时转换)

NETWORK 1: S2进入动作
// 启动潜水泵1和2
LD     SM0.0
S      Q0.0, 1                     // 潜水泵1开
S      Q0.1, 1                     // 潜水泵2开
// 计算T38 PT值: VW252 = VD_S2_Target(VD120) × 10 (REAL秒→100ms时基)
// A1修复: 原骨架标注"待Story1.4补充转换",FC40只输出REAL秒到VD120,
//         从未写入VW252导致T38计时失效。现补转换逻辑。
MOVR   VD120, VD336                // 复制到中间变量(避免修改VD_S2_Target)
*R     10.0, VD336
ROUND  VD336, AC0
MOVW   AC0, VW252                  // VW252 = VD120×10
R      T38, 1
TON    T38, VW252                  // PT=VD_S2_Target×10(100ms时基)
// 置上缸状态=满
S      V1.6, 1


NETWORK 2: 潜水泵流量检测
// A3修复: 原用固定+100(10秒),现改读VD_Timeout_Pump1/2×10
// 潜水泵1: VD58×10 转换
MOVR   VD58, VD344                 // 复制VD_Timeout_Pump1
*R     10.0, VD344
ROUND  VD344, AC0
MOVW   AC0, VW282                  // VW282 = VD58×10(泵1超时PT)
LD     Q0.0                        // 潜泵1已开
AN     I0.3                        // 流量开关未到
TON    T44, VW282                  // PT=VD_Timeout_Pump1×10
LD     T44
S      V303.2, 1                   // M_Alarm_Pump1_Abnormal
MOVB   99, VB2
MOVB   0, VB3

// 潜水泵2: VD62×10 转换
MOVR   VD62, VD344                 // 复制VD_Timeout_Pump2
*R     10.0, VD344
ROUND  VD344, AC0
MOVW   AC0, VW284                  // VW284 = VD62×10(泵2超时PT)
LD     Q0.1
AN     I0.4
TON    T45, VW284                  // PT=VD_Timeout_Pump2×10
LD     T45
S      V303.3, 1                   // M_Alarm_Pump2_Abnormal
MOVB   99, VB2
MOVB   0, VB3


NETWORK 3: 预循环完成转移至S3
LD     T38                         // 计时到达
R      Q0.0, 1                    // 停潜水泵1
R      Q0.1, 1                    // 停潜水泵2
MOVB   3, VB2                     // VW2=3(S3)
MOVB   0, VB3


// ============================================================
// 文件结束
// 说明:
//   1. A1修复: VW252由VD120×10转换写入(原骨架遗漏,导致T38计时失效)
//   2. A3修复: T44/T45改读VD58/VD62×10(原固定+100=10秒)
//   3. VD336/VD344为运算中间变量,不污染HMI设定参数
//   4. VW282/VW284为泵1/2超时PT转换值(专用,无冲突)
// ============================================================
