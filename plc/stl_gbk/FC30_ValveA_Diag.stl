﻿// ============================================================
// 文件: FC30_ValveA_Diag.stl
// 功能: 阀A诊断（差值法计量+延时验证4项并行+漫溢保护）
// Story: AQEX-7 阀门诊断
// 调用方: FC11(S1上缸进水)
// 说明: 阀A不使用四态诊断，采用差值法+延时验证
//       诊断子状态VW260: 0空闲/1等开到位/2开启完成/3运行中/5关闭后验证
//
//   修复记录:
//   P1 - MOVR/-R 替换 MOVD/-D: 流量计数据为REAL浮点,之前用双整数指令导致VD90=NAN
//   P2 - 单NETWORK合并: 所有JMP/LBL在同一NETWORK内,解决STEP7导入跨NETWORK跳转失效
//   P3 - I8.0 去掉EU: 子状态1→2改用常开触点,PLC冷启动时阀已开到位也能正常进入子状态2
//   P4 - 关阀快照MOVD改MOVR: 语义一致,REAL数据用MOVR搬运
//   P5 - 子状态5 RLO修复: 比较指令(AR>/AR<=)会切断RLO,改用LD T51 + LPS/ALD维持AND链
//   P6 - 进水量达标后补关Q0.5(NC球阀),避免S1→S2后NC阀常开
// ============================================================

// 符号说明:
// VW260 : Diag_State_A     阀A诊断子状态
// VW266 : Diag_Result_A    阀A诊断结果(0进行中/1正常/2故障)
// VD308 : VD_FlowMeter_CloseSnapshot  阀A关阀瞬间流量计快照(保留供HMI查看)
// VD312 : 已删除(原阀A内漏差值,2026-09-14废弃)
// VD316 : 目标进水量(HMI设定)
// T50   : 阀A开到位超时(100ms时基)
// T51   : 阀A关阀后延时验证(100ms时基)
// T52   : 开到位但无流2s确认(100ms时基)
// I0.0  : 流量开关A(有流=ON)
// I0.5  : 液位计A高位(漫溢=ON)
// I8.0  : 阀A开到位反馈
// I8.1  : 阀A关到位反馈
// Q0.2  : 阀A(电动球阀)
// Q0.5  : NC球阀-上缸


NETWORK 1
// ============================================================
// NETWORK 1 - 单NETWORK版 FC30
// 所有JMP/LBL在同一NETWORK内,避免STEP7导入后跳转失效
// ============================================================

// ========== 第一部分: 漫溢保护(优先级最高,全程监控) ==========
LD     I0.5                        // 液位计A高位=漫溢
S      V300.0, 1                   // M_Alarm_Overflow_AHigh
S      V300.2, 1                   // M_Alarm_NCValve_Top
R      Q0.5, 1                     // 关NC球阀(切断水流)
R      Q0.2, 1                     // 关阀A
MOVW   99, VW2                     // 转S_ERROR
MOVB   2, VB266                    // Diag_Result_A=2故障
JMP    1                           // 跳到结束


// ==== Part 2: Sub-state dispatch (VW260 word) ====
// VW260 word storage: MOVW write + LDW= compare (matches FC31/FC32)
//
LDW=   VW260, 0
JMP    2                           // 子状态0: 空闲
LDW=   VW260, 1
JMP    3                           // 子状态1: 等开到位
LDW=   VW260, 2
JMP    4                           // 子状态2: 等流量开关
LDW=   VW260, 3
JMP    5                           // 子状态3: ★运行中算VD90★
LDW=   VW260, 5
JMP    6                           // 子状态5: 关阀后延时验证
JMP    1                           // 兜底: 非法状态跳到结束


// ========== 第三部分: 子状态0 - 空闲 ==========
LBL    2
// 等待FC11触发置VW260=1, 无额外动作
JMP    1


// ========== 第四部分: 子状态1 - 等待开到位 ==========
LBL    3
// T50超时计时(PT=VW278, 由FC11计算VD358×10写入)
LD     SM0.0
TON    T50, VW278

// I8.0开到位反馈=ON → 转子状态2
// ★P3修复: 去掉EU(上升沿),改用常开触点
//   正常: 阀A打开后I8.0从OFF→ON,直接触发
//   异常: PLC冷启动时阀已开到位(I8.0本来就是ON),也能立即进入子状态2
LD     I8.0
MOVW   2, VW260                    // VW260=2
R      T50, 1                      // 复位超时计时
JMP    1

// T50超时 → 开到位超时报警
LD     T50
S      V301.4, 1                   // M_Alarm_ValveA_OpenTimeout
MOVW   99, VW2
MOVB   2, VB266
JMP    1


// ========== 第五部分: 子状态2 - 等待流量开关 ==========
LBL    4
// I0.0流量开关A=ON → 正常有流, 转子状态3运行中
LD     I0.0
MOVW   3, VW260                    // VW260=3运行中
JMP    1

// 开到位但无流 → 加2s延时确认避免瞬时波动
LD     I8.0                        // 阀确实已开到位
AN     I0.0                        // 但无流量
TON    T52, 20                     // 2s确认(20×100ms)
LD     T52
S      V301.5, 1                   // M_Alarm_ValveA_OpenNoFlow
MOVW   99, VW2
MOVB   2, VB266
JMP    1


// ========== 第六部分: 子状态3 - ★运行中差值法持续计量★ ==========
LBL    5
// ★P1修复: 用MOVR/-R实数指令计算进水量(原MOVD/-D导致NAN)
// VD_Current_InletVolume(VD90) = VD86(当前累计) - VD82(开启快照)
LD     SM0.0
MOVR   VD86, AC0                   // ★MOVR: 实数搬运
-R     VD82, AC0                   // ★-R: 实数减法
MOVR   AC0, VD90                   // 当前进水量

// 进水量达标 → 关阀A + 快照关阀瞬间流量计值 + 转子状态5
// [已修复 v2.2] 用 V63.0 缓存达标条件,避免 LPS/LPP 内 R 指令链栈空
LD     SM0.0
AR>=   VD90, VD316                 // 当前进水量 ≥ 目标进水量
=      V63.0
LD     V63.0
R      Q0.2, 1                     // 关阀A
LD     V63.0
R      Q0.5, 1                     // 关上缸NC球阀
LD     V63.0
MOVR   VD86, VD308                 // VD_FlowMeter_CloseSnapshot
LD     V63.0
MOVW   5, VW260                    // VW260=5(关闭后验证)
LD     V63.0
R      T52, 1                      // 复位开到位无流确认计时
JMP    1


// ========== 第七部分: 子状态5 - 关阀后延时验证(4项并行) ==========
LBL    6
// T51延时验证计时(PT=VW280, 由FC11计算VD66×10写入)
LD     SM0.0
TON    T51, VW280

// --- 延时到达后3项并行校验 ---
// ★ 2026-09-14: 删除原校验2(流量计差值法内漏,V301.1),仅保留流量开关/关到位相关校验
//   关键修复: 每项必须在 T51 到达后才置位, 且用 ALD 维持 RLO 串联,
//   防止比较指令(AR>/AR<=)切断 RLO 导致误触发

// 校验1: 关阀后仍有流(流量开关A=ON)
LD     T51                         // RLO=T51
A      I0.0                        // RLO=T51 AND I0.0
S      V301.0, 1                   // M_Alarm_ValveA_CloseFlow

// 校验2: 关到位反馈超时(I8.1=OFF)
LD     T51
AN     I8.1                        // RLO=T51 AND (NOT I8.1)
S      V301.2, 1                   // M_Alarm_ValveA_CloseTimeout

// 校验3: 关到位但仍有流(交叉验证)
LD     T51
A      I8.1                        // RLO=T51 AND I8.1
A      I0.0                        // RLO=T51 AND I8.1 AND I0.0
S      V301.3, 1                   // M_Alarm_ValveA_CloseLeak


// --- 校验结果判定 ---
// 3项全通过: T51到 AND 流量开关OFF AND 关到位ON
// 用 LPS/ALD 维持 AND 链
LD     T51
LPS
AN     I0.0                        // RLO=T51 AND (NOT I0.0)
LPS
A      I8.1                        // RLO=I8.1
ALD                                // (NOT I0.0) AND I8.1
ALD                                // AND T51
// → 诊断正常完成
MOVW   0, VW260                    // VW260=0空闲(等待下轮)
MOVB   1, VB266                    // Diag_Result_A=1正常完成
R      T51, 1                      // 复位延时计时
JMP    1
LPP
LPP

// 任一项报警 → 转S_ERROR
// 先OR 3个报警标志, 最后再 AND T51, 防止旧的报警位在T51复位后误触发
LD     V301.0                      // RLO=V301.0
O      V301.2
O      V301.3
A      T51                         // RLO=(任意报警) AND T51
MOVW   99, VW2                     // 转S_ERROR
MOVB   2, VB266                    // 故障
JMP    1


// ========== 结束 ==========
LBL    1


// ============================================================
// 文件结束
// 说明:
//   1. FC11调用本FC前需置VW260=1启动诊断
//   2. FC11检查VW266: 0=进行中等待, 1=正常完成转S2, 2=故障(已转S_ERROR)
//   3. VD316(目标进水量)由HMI设定或SBR25用户默认覆盖写入
//   4. VW278=T50×10(开到位超时), VW280=T51×10(延时验证), 由FC11计算写入
//   5. 2026-09-14: 已删除流量计差值法内漏判定(V301.1),保留VD308快照供查看
//   6. 所有JMP/LBL在单NETWORK内, 避免STEP7导入后跳转失效(P2修复)
// ============================================================
