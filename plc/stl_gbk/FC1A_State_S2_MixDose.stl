// ============================================================
// 文件: FC1A_State_S2_MixDose.stl
// 功能: S2 搅拌 + 加药合并子状态 (VW418=2)
// Story: v2.2 流程重构 - 新建(由原 FC12 + FC13 合并)
// 说明: v2.2 取消独立 S3 加药子状态,改为"搅拌 + 加药"组合子状态
//       潜水泵常开(整个 S2 期间不停),T38 计时到达 VD28 (固定搅拌时长) + VW226=9 (加药完成)
//       共同触发 VW418=3 (上缸配完等待转移)
//       【2026-10-08 v2.3.9】T38改SM0.0驱动,修复单扫描脉冲致永不计时
//
// 调用方: OB1 NET 7 仅在 VW418=2 时调用本 FC
// 关联 FC: 本 FC 内部调用 FC13(自动壳) → CALL FC23_PumpEngine 完成加药
//         子状态机逻辑(v2.5引擎化; VW226 0~9 语义不变,仅由本 FC 触发)
//
// 【v2.2 合并说明】
//   - 原 FC12(预循环搅拌)功能: S2 启动潜水泵 + T38 计时 → 已集成到本 FC NETWORK 1
//   - 原 FC13(加药)功能: VW226 0~9 子状态机(15 个 NETWORK) → 本 FC 内部 CALL FC13
//   - 原 FC14(S3.5 静止等候)功能: 取消(v2.2 取消静止等候环节)
// ============================================================
// 符号说明:
// VW402 : T38_PT  S2搅拌定时器PT(VD28×10, v2.3.2由VW252迁入,避让VD252 TimerB_Elapsed低字)
// VW226 : 加药子状态机 (0~9, FC13内部使用)

NETWORK 1
// 首次进入 S2 - 启动潜水泵 + T38 计时 + 初始化加药子状态机
// 触发条件: VW418=2 (上缸 S2 入口) + M16.3=0 (首次进入门控)
// 启动动作: 开潜水泵1/2 + T38 PT = VD28 × 10 + 清 VW226 + R 注射泵异常 + 初始化 VD372/VD440

// [已修复 v2.2] 用 V61.2 缓存 S2 首次进入条件,避免 S/R/LPS 后栈空
LDW=   VW418, 2
AN     M16.3
=      V61.2
LD     V61.2
S      M16.3, 1                     // 置 S2 首次进入标志
LD     V61.2
S      Q0.0, 1                      // 潜水泵1开
LD     V61.2
S      Q0.1, 1                      // 潜水泵2开
LD     V61.2
MOVR   VD28, VD336                  // T38 PT = VD28 × 10
*R     10.0, VD336
ROUND  VD336, AC0
MOVW   AC0, VW402                   // VW402 = T38 PT 【v2.3.2迁移: 原VW252与VD252(TimerB_Elapsed REAL)低字重叠,互踩】
// 【2026-10-08修复 v2.3.9】T38输入改SM0.0: 原V61.2为首次进入单扫描脉冲,
//   TON输入断开即复位,搅拌定时器永不累计,T38永不到点→S2完成判定
//   (VW226=9 AND T38)永不成立,S2无限滞留。与v2.3.6修T37同款。
//   安全性: FC1A仅被OB1在VW418=2时调用,SM0.0驱动等价于"S2期间持续计时";
//   转出S2后FC1A不再被调用,T38停止刷新,完成/停止/复位路径均有R T38兜底。
LD     SM0.0
TON    T38, VW402                   // 启动 S2 搅拌定时器(S2全程计时)
LD     V61.2
MOVW   0, VW226                     // 清 VW226 加药子状态机
LD     V61.2
R      V303.4, 1                    // 清注射泵异常报警
LD     V61.2
MOVR   VD584, VD372                 // VD_Remaining_Vol = 目标加药量
LD     V61.2
MOVR   0.0, VD440                   // 累计加药量清零


// 调用 FC13(自动壳) → FC23 注射泵引擎完成加药子状态机(v2.5引擎化)
// FC23 内部使用 VW226 子状态推进加药流程(自动路径):
//   0: 初始化(VD372=VD584)   1: 写抽液   2: 等抽液运动   3: 强停1
//   4: 等就绪1   5: 写排液   6: 等排液运动   7: 强停2   8: 结算/循环
//   9: 完成闩锁(本FC消费)   手动专用30/40/99见FC23文件头
LD     SM0.0
CALL State_S3_Dosing


// 完成判定 - 搅拌计时到 AND 加药子状态 9 → VW418=3 (上缸配完等待转移)
// [已修复 v2.2] 用 V61.3 缓存完成条件,避免 R 指令链栈空
// 潜水泵在判定完成后停止(Q0.0/Q0.1 复位)
LDW=   VW226, 9                    // 加药子状态 9 = 已完成
A      T38                         // 搅拌 T38 计时到
=      V61.3
LD     V61.3
R      Q0.0, 1                     // 潜水泵1关
LD     V61.3
R      Q0.1, 1                     // 潜水泵2关
LD     V61.3
R      T38, 1                      // 清 T38
LD     V61.3
MOVW   3, VW418                    // 上缸进入"配完等待转移"


// 注: S2 期间潜水泵与加药并行(同时进行),而非原"先搅拌后加药"
// 注: T38 计时由 VD28 (S2 固定时长) 决定,v2.2 严格不可压缩
// 注: VW226=9 + T38 到达 共同触发 VW418=3 (任一未达都不转)
// 注: 故障时 FC13 内部已置 V303.4 并转 S_ERROR,由 FC19 处理
// 注: 断电恢复时 VW418=2 由 SBR26 决定是否保持(详见 SBR26)

// ============================================================
// 文件结束
// ============================================================
