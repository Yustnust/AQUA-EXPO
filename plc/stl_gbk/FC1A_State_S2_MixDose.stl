// ============================================================
// 文件: FC1A_State_S2_MixDose.stl
// 功能: S2 搅拌 + 加药合并子状态 (VW304=2)
// Story: v2.2 流程重构 - 新建(由原 FC12 + FC13 合并)
// 说明: v2.2 取消独立 S3 加药子状态,改为"搅拌 + 加药"组合子状态
//       潜水泵常开(整个 S2 期间不停),T38 计时到达 VD28 (固定搅拌时长) + VW226=9 (加药完成)
//       共同触发 VW304=3 (上缸配完等待转移)
//
// 调用方: OB1 NET 7 仅在 VW304=2 时调用本 FC
// 关联 FC: 本 FC 内部调用 FC13_State_S3_Dosing 完成加药子状态机逻辑
//         (FC13 文件保留,VW226 子状态机不变,仅由本 FC 触发)
//
// 【v2.2 合并说明】
//   - 原 FC12(预循环搅拌)功能: S2 启动潜水泵 + T38 计时 → 已集成到本 FC NETWORK 1
//   - 原 FC13(加药)功能: VW226 0~9 子状态机(15 个 NETWORK) → 本 FC 内部 CALL FC13
//   - 原 FC14(S3.5 静止等候)功能: 取消(v2.2 取消静止等候环节)
// ============================================================
// 符号说明:
// VW402 : T38_PT  S2搅拌定时器PT(VD28×10, v2.3.2由VW252迁入,避让VD252 TimerB_Elapsed低字)
// VW226 : 加药子状态机 (0~9, FC13内部使用)

NETWORK 1
// 首次进入 S2 - 启动潜水泵 + T38 计时 + 初始化加药子状态机
// 触发条件: VW304=2 (上缸 S2 入口) + M16.3=0 (首次进入门控)
// 启动动作: 开潜水泵1/2 + T38 PT = VD28 × 10 + 清 VW226 + R 注射泵异常 + 初始化 VD372/VD440

// [已修复 v2.2] 用 V61.2 缓存 S2 首次进入条件,避免 S/R/LPS 后栈空
LDW=   VW304, 2
AN     M16.3
=      V61.2
LD     V61.2
S      M16.3, 1                     // 置 S2 首次进入标志
LD     V61.2
S      Q0.0, 1                      // 潜水泵1开
LD     V61.2
S      Q0.1, 1                      // 潜水泵2开
LD     V61.2
MOVR   VD28, VD336                  // T38 PT = VD28 × 10
*R     10.0, VD336
ROUND  VD336, AC0
MOVW   AC0, VW402                   // VW402 = T38 PT 【v2.3.2迁移: 原VW252与VD252(TimerB_Elapsed REAL)低字重叠,互踩】
LD     V61.2
TON    T38, VW402                   // 启动 S2 搅拌定时器
LD     V61.2
MOVW   0, VW226                     // 清 VW226 加药子状态机
LD     V61.2
R      V303.4, 1                    // 清注射泵异常报警
LD     V61.2
MOVR   VD584, VD372                 // VD_Remaining_Vol = 目标加药量
LD     V61.2
MOVR   0.0, VD440                   // 累计加药量清零


// 调用 FC13 加药子状态机(15 个 NETWORK,完整保留)
// FC13 内部使用 VW226 子状态 0~9 推进加药流程:
//   0: 初始化
//   1: 计算并写抽液步数
//   2: 等待 Modbus 写完成
//   3: 等待抽液动作完成
//   4: 计算并写排液步数
//   5: 等待 Modbus 写完成
//   6: 等待排液动作完成
//   7: 校验累计加药量
//   8: 完成判定
//   9: 已完成
LD     SM0.0
CALL State_S3_Dosing


// 完成判定 - 搅拌计时到 AND 加药子状态 9 → VW304=3 (上缸配完等待转移)
// [已修复 v2.2] 用 V61.3 缓存完成条件,避免 R 指令链栈空
// 潜水泵在判定完成后停止(Q0.0/Q0.1 复位)
LDW=   VW226, 9                    // 加药子状态 9 = 已完成
A      T38                         // 搅拌 T38 计时到
=      V61.3
LD     V61.3
R      Q0.0, 1                     // 潜水泵1关
LD     V61.3
R      Q0.1, 1                     // 潜水泵2关
LD     V61.3
R      T38, 1                      // 清 T38
LD     V61.3
MOVW   3, VW304                    // 上缸进入"配完等待转移"


// 注: S2 期间潜水泵与加药并行(同时进行),而非原"先搅拌后加药"
// 注: T38 计时由 VD28 (S2 固定时长) 决定,v2.2 严格不可压缩
// 注: VW226=9 + T38 到达 共同触发 VW304=3 (任一未达都不转)
// 注: 故障时 FC13 内部已置 V303.4 并转 S_ERROR,由 FC19 处理
// 注: 断电恢复时 VW304=2 由 SBR26 决定是否保持(详见 SBR26)

// ============================================================
// 文件结束
// ============================================================
