TITLE=
Network 1 
//  MBUS_CTRL: 9600/8/N/1, 超时1000ms
LD     SM0.0
=      L60.0
LD     SM0.0
=      L63.7
LD     L60.0
CALL   MBUS_CTRL, L63.7, 9600, 16#0, 16#0, 1000, M11.0, VB378
Network 2 
//  T103: MBUS_MSG超时定时器(100ms时基, PT=100=10s)
//  任一任务活跃(M15.0~M15.4)时计时, 超时后强制切换任务
LD     M15.0
O      M15.1
O      M15.2
O      M15.3
O      M15.4
TON    T103, 100
Network 3 
//  任务0: 注射泵状态读(41001)
//  EN=VW290==0 AND M15.0, First=M15.0上升沿(EU)
LDW=   VW290, 0
=      L60.0
LD     M15.0
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A029, 16#1, &VB410, M10.0, VB379
Network 4 
//  任务1: 流量计读(40009)
//  EN=VW290==1 AND M15.1, First=M15.1上升沿(EU)
LDW=   VW290, 1
=      L60.0
LD     M15.1
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C49, 16#02, &VB410, M14.0, VB380
Network 5 
//  任务2: 注射泵位置读(41007)
//  EN=VW290==2 AND M15.2, First=M15.2上升沿(EU)
LDW=   VW290, 2
=      L60.0
LD     M15.2
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#0, 16#A02F, 16#1, &VB410, M10.1, VB381
Network 6 
//  任务3: 流量计瞬时流量读(40007) → VD94
//  EN=VW290==3 AND M15.3, First=M15.3上升沿(EU)
LDW=   VW290, 3
=      L60.0
LD     M15.3
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#02, 16#0, 16#9C47, 16#02, &VB410, M14.1, VB382
Network 7
//  任务0成功处理: VW410->VW4, 成功计数, 清失败计数
LD     M10.0
A      M15.0
AB=    VB379, 0
MOVW   VW410, VW4
AENO
INCW   VW500
AENO
MOVW   0, VW292
AENO
R      V303.4, 1
Network 8 
//  任务0失败计数
LD     M10.0
A      M15.0
AB<>   VB379, 0
INCW   VW292
Network 9 
//  任务0完成切换(成功或T103超时)
//  R M15.0, S M15.1, 更新VW290=1, 清Done位, 清超时定时器
LD     M10.0
O      T103
R      M15.0, 1
S      M15.1, 1
MOVW   1, VW290
R      M10.0, 1
R      T103, 1
Network 10 
//  任务1成功处理: VD410->VD86, 成功计数, 清失败计数
//  流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.0
A      M15.1
AB=    VB380, 0
MOVD   VD410, VD86
AENO
INCW   VW502
AENO
MOVW   0, VW294
AENO
R      V303.6, 1
Network 11 
//  任务1失败计数
LD     M14.0
A      M15.1
AB<>   VB380, 0
INCW   VW294
Network 12 
//  任务1完成切换(成功或T103超时)
//  R M15.1, S M15.2, 更新VW290=2, 清Done位, 清超时定时器
LD     M14.0
O      T103
R      M15.1, 1
S      M15.2, 1
MOVW   2, VW290
R      M14.0, 1
R      T103, 1
Network 13 
//  任务2成功处理: VW410->VW222, 成功计数, 清失败计数
LD     M10.1
A      M15.2
AB=    VB381, 0
MOVW   VW410, VW222
AENO
INCW   VW504
AENO
MOVW   0, VW296
Network 14 
//  任务2失败计数
LD     M10.1
A      M15.2
AB<>   VB381, 0
INCW   VW296
Network 15 
//  任务2完成切换(成功或T103超时)
//  R M15.2, S M15.3, 更新VW290=3, 清Done位, 清超时定时器
LD     M10.1
O      T103
R      M15.2, 1
S      M15.3, 1
MOVW   3, VW290
R      M10.1, 1
R      T103, 1
Network 16 
//  任务3成功处理: VD410->VD94(瞬时流量), 成功计数, 清失败计数
//  流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.1
A      M15.3
AB=    VB382, 0
MOVD   VD410, VD94
AENO
INCW   VW506
AENO
MOVW   0, VW298
Network 17 
//  任务3失败计数
LD     M14.1
A      M15.3
AB<>   VB382, 0
INCW   VW298
Network 18 
//  任务3完成切换: 有写请求 → 任务4, 否则 → 任务0
//  用V60.0做完成事件中间继电器(仅此处赋值,无冲突)


LD     M14.1
O      T103
=      V60.0
Network 19 
// // 复位任务3相关标志
LD     V60.0
R      M15.3, 1
R      M14.1, 1
R      T103, 1
Network 20 
// // 进入任务4: 有写请求(M11.6=1)
LD     V60.0
A      M11.6
S      M15.4, 1
MOVW   4, VW290
Network 21 
// // 未进入任务4则回任务0
LD     V60.0
AN     M15.4
S      M15.0, 1
MOVW   0, VW290
Network 22 
LD     V60.0
EU
INCW   VW514
Network 23 
//  任务4写数据准备: 有写请求时把VW230复制到统一缓冲区VW410
//  DataPtr用&VB410, 避免直接使用&VW230导致MBUS_MSG写失败(Error=104)
LD     M11.6
MOVW   VW230, VW410
Network 24 
LD     M12.0
EU
INCW   VW512
Network 25 
LDW=   VW290, 4
A      M15.4
A      M11.6
=      V60.3
Network 26
//  任务4: 注射泵写命令(仅在M11.6=1时执行)
//  ★EN和First同源(V60.3), 避免EN=0时First触发导致Error=104
//  写目标地址VD232由FC0/FC13/FC21设置(16#9C42=40002强停,16#9C43=40003复位,16#9C46=40006抽液,16#9C47=40007排液)
LD     V60.3
=      L60.0
LD     V60.3
EU
=      L63.7
LD     L60.0
CALL   MBUS_MSG, L63.7, 16#1, 16#1, VD232, 16#1, &VB410, M12.0, VB383
Network 27 
//  任务4成功处理: 清写请求, 成功计数, 清失败计数
//  ★关键: 写完成后立即清M11.6, 防止复位命令在轮询中反复写
LD     M12.0
A      M15.4
AB=    VB383, 0
R      M11.6, 1
R      M11.7, 1
INCW   VW508
MOVW   0, VW510
R      V303.4, 1
Network 28 
//  任务4失败计数 + 从站异常立即报警
LD     M12.0
A      M15.4
LPS
AB<>   VB383, 0
INCW   VW510
LPP
AB>=   VB383, 101
S      V303.4, 1
Network 29 
//  任务4完成切换(成功或T103超时)
//  R M15.4, S M15.0, 更新VW290=0, 清握手, 清超时定时器
// // ★M12.0不清! 由FC13/FC21请求方清零, 否则请求方看不到写完成
LD     M12.0
O      T103
R      M11.6, 1
R      M11.7, 1
R      M15.4, 1
S      M15.0, 1
MOVW   0, VW290
R      T103, 1
Network 30 
//  V303.4软件滤波: 连续读失败<5次时不报警
LDW<   VW292, 5
R      V303.4, 1
Network 31 
//  V303.4写任务软件滤波: 连续写失败<5次且无从站异常时不报警
LDW<   VW510, 5
AB<    VB383, 101
R      V303.4, 1
Network 32 
//  V303.6软件滤波: 连续失败<5次时不报警
LDW<   VW294, 5
R      V303.6, 1

Network 33 
