TITLE=子程序注释
Network 1 
// MBUS_CTRL: 9600/8/N/1, 超时1000ms
LD     SM0.0
=      L60.0
LD     SM0.0
=      L63.7
LD     L60.0
CALL   SBR20, L63.7, 9600, 16#0, 16#0, 1000, M11.0, VB378
Network 2 
// T103: MBUS_MSG超时定时器(100ms时基, PT=100=10s)
// 任一任务活跃(M15.0/M15.1/M15.2)时计时, 超时后强制切换任务
LD     M15.0
O      M15.1
O      M15.2
TON    T103, 100
Network 3 
// 任务0: 注射泵状态读(41001)
// EN=VW290==0 AND M15.0, First=M15.0
LDW=   VW290, 0
=      L60.0
LD     M15.0
=      L63.7
LD     L60.0
CALL   SBR21, L63.7, 16#1, 16#0, 16#A029, 16#1, &VB410, M10.0, VB379
Network 4 
// 任务1: 流量计读(40009)
// EN=VW290==1 AND M15.1, First=M15.1
LDW=   VW290, 1
=      L60.0
LD     M15.1
=      L63.7
LD     L60.0
CALL   SBR21, L63.7, 16#02, 16#0, 16#9C49, 16#02, &VB410, M14.0, VB380
Network 5 
// 任务2: 注射泵位置读(41007)
// EN=VW290==2 AND M15.2, First=M15.2
LDW=   VW290, 2
=      L60.0
LD     M15.2
=      L63.7
LD     L60.0
CALL   SBR21, L63.7, 16#1, 16#0, 16#A02F, 16#1, &VB410, M10.1, VB381
Network 6 
// 任务0成功处理: VW410->VW4, 成功计数, 清失败计数
LD     M10.0
A      M15.0
AB=    VB379, 0
MOVW   VW410, VW4
AENO
INCW   VW500
AENO
MOVW   0, VW292
AENO
R      V303.4, 1
Network 7 
// 任务0失败计数
LD     M10.0
A      M15.0
AB<>   VB379, 0
INCW   VW292
Network 8 
// 任务0完成切换(成功或T103超时)
// R M15.0, S M15.1, 更新VW290=1, 清Done位, 清超时定时器
LD     M10.0
O      T103
R      M15.0, 1
S      M15.1, 1
MOVW   1, VW290
R      M10.0, 1
R      T103, 1
Network 9 
// 任务1成功处理: VD410->VD86, 成功计数, 清失败计数
// 流量计32位浮点数据已按正确顺序存储,直接搬运即可
LD     M14.0
A      M15.1
AB=    VB380, 0
MOVD   VD410, VD86
AENO
INCW   VW502
AENO
MOVW   0, VW294
AENO
R      V303.6, 1
Network 10 
// 任务1失败计数
LD     M14.0
A      M15.1
AB<>   VB380, 0
INCW   VW294
Network 11 
// 任务1完成切换(成功或T103超时)
// R M15.1, S M15.2, 更新VW290=2, 清Done位, 清超时定时器
LD     M14.0
O      T103
R      M15.1, 1
S      M15.2, 1
MOVW   2, VW290
R      M14.0, 1
R      T103, 1
Network 12 
// 任务2成功处理: VW410->VW222, 成功计数, 清失败计数
LD     M10.1
A      M15.2
AB=    VB381, 0
MOVW   VW410, VW222
AENO
INCW   VW504
AENO
MOVW   0, VW296
Network 13 
// 任务2失败计数
LD     M10.1
A      M15.2
AB<>   VB381, 0
INCW   VW296
Network 14 
// 任务2完成切换(成功或T103超时)
// R M15.2, S M15.0, 更新VW290=0, 清Done位, 清超时定时器
LD     M10.1
O      T103
R      M15.2, 1
S      M15.0, 1
MOVW   0, VW290
R      M10.1, 1
R      T103, 1
Network 15 
// V303.4软件滤波: 连续失败<5次时不报警
LDW<   VW292, 5
R      V303.4, 1
Network 16 
// V303.6软件滤波: 连续失败<5次时不报警
LDW<   VW294, 5
R      V303.6, 1
